 "split": "test",
 "definitions": {
  "arm": "an INITIAL arm: the prompt arm of each cohort (natural or prompted phase); a branch cell has no row (the design log)",
  "attempts": "the arm's attempts with a record",
  "a": "timed-out store queries (sparql_query calls whose recorded error kind is timeout), total, over the arm's attempts",
  "b": "of (a), load-induced: the query was answered when replayed alone on a quiet spare",
  "c": "of (a), intrinsic: the query timed out again when replayed alone",
  "other_pending": "of (a), neither: an error of another kind on the replay, or not replayed (0 in a final list)",
  "d": "the load-induced share of (a): (b) / (a)",
  "any_timeout": "attempts touched by at least one time-out of any class",
  "e": "attempts touched by at least one load-induced time-out",
  "g": "the exclusion's count (exclusion call): the attempts excluded, i.e. the design log's units in this initial arm: an attempt touched itself by a load-induced time-out or a cut call, or a natural parent whose family has a branch cell so touched (a natural parent leaves with its branch cells as one family). A prompted attempt is its own unit",
  "g_share": "(g) / attempts"
 },
