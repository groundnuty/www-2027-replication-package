diff --git a/harness/baselines/cells.py b/harness/baselines/cells.py
new file mode 100644
index 00000000..e74a2147
--- /dev/null
+++ b/harness/baselines/cells.py
@@ -0,0 +1,134 @@
+"""The baseline retry cells as a grid spec names them and the grid runner builds them (design log).
+
+A baseline cell is a branch cell like the checker arms (``branch_attempt`` over a parent's recorded initial phase) whose
+decision needs no ontology source, so its spec entry has ``sources: []``:
+
+    {"id": "base:empty", "parent": "none", "mode": "empty", "arm": "empty", "sources": []}
+    {"id": "base:judge", "parent": "none", "mode": "judge", "arm": "judge", "sources": [],
+     "detection": {"plan_sha256": "<sha256 of the detection judge directory's plan.json>",
+                   "rows_sha256": "<sha256 of its sealed rows: judge_sealed.rows_sha256>"}}
+
+``empty`` is retry on empty (harness/baselines/empty.py); ``judge`` is the judge's reject-then-retry cell driven by the
+detection run's sealed verdicts (harness/baselines/judge_sealed.py). The spec, the manifest pins, the per-try checker and
+the replay all go through this module, so a new baseline mode is one entry in ``MODES`` (with its spec checks, its pin and
+its constructor) and the runner's other code does not know the modes.
+
+Nothing here is reached by a spec without a baseline cell: ``cell_modes`` of a feedback/generic spec is empty and the
+runner's and the builder's paths for such a spec are the ones they had.
+"""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Mapping
+from dataclasses import dataclass
+from typing import Any
+
+from harness.checkloop.online import RetryBudget
+
+EMPTY = "empty"
+JUDGE = "judge"
+_SHA256 = re.compile(r"[0-9a-f]{64}\Z")
+_NO_BUDGET = RetryBudget(max_turns=0, max_wall_s=0.0, max_nudges=0)  # dropped from a pinned setting (per model)
+
+
+@dataclass(frozen=True)
+class Mode:
+    needs_detection: bool
+    extra_keys: tuple[str, ...]  # keys a spec cell of this mode may carry beyond id/parent/mode/arm/sources
+
+
+MODES: dict[str, Mode] = {EMPTY: Mode(False, ()), JUDGE: Mode(True, ("detection",))}
+
+
+def is_baseline(mode: Any) -> bool:
+    return mode in MODES
+
+
+def cell_modes(branch_cells: list[dict] | None) -> set[str]:
+    """The baseline modes a spec's branch cells use."""
+    return {b.get("mode") for b in branch_cells or [] if is_baseline(b.get("mode"))}
+
+
+def spec_problems(b: Mapping) -> list[str]:
+    """Why a baseline branch cell of a spec is not well formed (the spec's other checks, the parent among them, are
+    the grid builder's own)."""
+    mode = b.get("mode")
+    if not is_baseline(mode):
+        return [f"branch cell {b.get('id')!r}: not a baseline mode"]
+    info, problems = MODES[mode], []
+    if b.get("arm") != mode:
+        problems.append(f"branch cell {b.get('id')!r}: a {mode} cell's arm is {mode!r}, not {b.get('arm')!r}")
+    if b.get("sources") != []:
+        problems.append(f"branch cell {b.get('id')!r}: a {mode} cell reads no source: sources is [] "
+                        f"(found {b.get('sources')!r})")
+    extra = sorted(set(b) - {"id", "parent", "mode", "arm", "sources", *info.extra_keys})
+    if extra:
+        problems.append(f"branch cell {b.get('id')!r}: keys {extra} are not a {mode} cell's")
+    if info.needs_detection:
+        d = b.get("detection")
+        if not (isinstance(d, dict) and set(d) == {"plan_sha256", "rows_sha256"}
+                and all(isinstance(v, str) and _SHA256.match(v) for v in d.values())):
+            problems.append(f"branch cell {b.get('id')!r}: a {mode} cell pins its detection run, its plan and its "
+                            f'sealed rows, as {{"plan_sha256": <64 lowercase hex>, "rows_sha256": <64 lowercase hex>}}')
+    return problems
+
+
+def manifest_cell(b: Mapping) -> dict:
+    """The manifest's entry of a baseline cell (build_dev_grid.cells): the checker cells' keys, no source, and the
+    detection pin where the mode has one."""
+    out = {"id": b["id"], "phase": "branch", "parent": b["parent"], "mode": b["mode"], "arm": b["arm"], "sources": [],
+           "verdict_sources": []}
+    if MODES[b["mode"]].needs_detection:
+        out["detection"] = dict(b["detection"])
+    return out
+
+
+def open_detection(cell: Mapping, directory: Any, model_name: str, route_model: str, route_info: dict) -> Any:
+    """The cell's detection run (judge_sealed.DetectionRun), checked against the cell's pin and the agent's route."""
+    from harness.baselines.judge_sealed import DetectionRun
+
+    return DetectionRun(directory, expect_plan_sha256=cell["detection"]["plan_sha256"],
+                        expect_rows_sha256=cell["detection"]["rows_sha256"], model_name=model_name,
+                        route_model=route_model, route_info=route_info)
+
+
+def pin_settings(cell: Mapping, detection: Any | None) -> dict[str, Any]:
+    """A baseline cell's checker settings as the manifest pins them, without the retry budget (each model's own)."""
+    mode = cell["mode"]
+    if mode == EMPTY:
+        from harness.baselines.empty import EmptyRetryChecker
+
+        settings = EmptyRetryChecker(budget=_NO_BUDGET).settings()
+    elif mode == JUDGE:
+        if detection is None:
+            raise ValueError(f"cell {cell['id']!r}: a judge cell is pinned with its detection run")
+        from harness.baselines.judge import JUDGE_RETRY_ID
+        from harness.baselines.judge_sealed import cell_settings
+        from harness.checkloop.online import set_aside_on
+
+        settings = cell_settings(detection, JUDGE_RETRY_ID, _NO_BUDGET, set_aside_on(None))
+    else:
+        raise ValueError(f"cell {cell['id']!r}: {mode!r} is not a baseline mode")
+    del settings["retry_budget"]
+    return settings
+
+
+def make_checker(cell: Mapping, *, budget: RetryBudget, parent: Any, parent_sha256: str | None,
+                 detection: Any | None) -> Any:
+    """The checker of one try: ``parent`` is the parent's RunRecord, ``parent_sha256`` the sha256 of its file's bytes."""
+    mode = cell["mode"]
+    if mode == EMPTY:
+        from harness.baselines.empty import EmptyRetryChecker
+
+        return EmptyRetryChecker(budget=budget)
+    if mode == JUDGE:
+        from harness.baselines.judge import question_text
+        from harness.baselines.judge_sealed import SealedJudgeRetryChecker
+
+        if detection is None or parent_sha256 is None:
+            raise ValueError(f"cell {cell['id']!r}: a judge cell needs its detection run and its parent's sha256")
+        return SealedJudgeRetryChecker(detection, question_text(parent.to_json()), parent.run_id, parent_sha256,
+                                       budget=budget)
+    raise ValueError(f"cell {cell['id']!r}: {mode!r} is not a baseline mode")
+
