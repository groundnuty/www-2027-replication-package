diff --git a/harness/baselines/judge_sealed.py b/harness/baselines/judge_sealed.py
new file mode 100644
index 00000000..7f7d86bd
--- /dev/null
+++ b/harness/baselines/judge_sealed.py
@@ -0,0 +1,548 @@
+"""The judge's reject-then-retry cell, driven by the test-time detection run's sealed verdicts (design log, AC2;
+design ruling of 23 Oct 22:3xZ on the lead's relay: one judge draw per output).
+
+``harness/baselines/judge.py``'s ``JudgeRetryChecker`` asks the agent's own model for a verdict inside the runner, so
+an output would be judged twice: once by the detection run (results/judge-test-20261022/judge_test.py, which judges
+every output of a model's complete natural set once) and once more by the retry cell, and the two draws need not
+agree. This cell makes no judge call. For each parent output it reads the detection run's sealed row (the judge's
+recorded call: its verdict and reason, its usage and cost), checks that the row is that parent's, and retries exactly
+when the detection judge rejected it, with the judge's recorded reason as in ``JudgeRetryChecker``: the same
+message, the same record shape (``checker.initial.judge`` is the detection call verbatim), so the frozen
+``replay_judge_decision`` recomputes the decision from the record alone, with no model and without the sealed rows.
+
+Only the runner process reads a sealed row, and only through ``DetectionRun``; this module prints nothing, forms no
+count of verdicts, and its refusals and audit problems name run ids and the part that differs, never which way a verdict
+went. (The runner's own runs.jsonl and logs, like those of every branch cell, show which attempts made a retry: they are
+barred to operators by entry 191, and the cell's records hold the detection call verbatim.) What identifies the detection run is recorded in the cell's settings (``detection``):
+the sha256 of its plan.json, its model, deployment, route base URL, the fingerprints it was pinned to and served by, and
+whether its deployment is the retry's (``same_deployment``), so a model whose detection judge ran on another deployment
+than its retry is visible in every record.
+
+A detection run made with judge_test.py's ``--move-deployment`` is refused (its rows name another base URL than its plan
+does); a run is one deployment here. Checks, each a refusal (``DetectionError``) before any attempt: the plan's sha256 is the one the spec pins, the plan
+is for the agent's own model, every planned record has a sealed row and its ledger line (the row's bytes hash to the
+ledger's sha256), and nothing waits under SEALED/held (the judge directory is complete as its files show). For a parent: the row names the parent's run id, question and
+model, holds the sha256 of the parent record's bytes (the plan's own entry for it), and the judge input rebuilt from the
+branch's replayed initial phase hashes to the recorded one. A parent whose detection row holds no verdict (nothing
+judgeable, a context overflow) is an unparsed decision with no retry, as an unparsed verdict is in ``judge.py``.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from collections.abc import Sequence
+from dataclasses import asdict
+from pathlib import Path
+from typing import Any
+
+from harness.agent.replay import ReplayDivergence
+from harness.baselines.judge import (
+    JUDGE_MESSAGES,
+    JUDGE_MODE,
+    JUDGE_RETRY_ID,
+    JUDGE_VERSION,
+    TEMPLATE_ID,
+    VERDICT_NOT_JUDGED,
+    _verdict,
+    judge_message,
+    judge_message_sha256,
+    output_judge_item,
+    parse_verdict,
+    render,
+    template_sha256,
+)
+from harness.checkloop.feedback import retry_turn_text
+from harness.checkloop.online import (
+    BASELINE_MODES,
+    RETRY_KINDS,
+    CheckInput,
+    Decision,
+    RetryBudget,
+    set_aside_on,
+    set_aside_setting,
+)
+
+SEALED_JUDGE_VERSION = "judge-retry-sealed/1"
+PLAN_VERSION = "judge-test/1"  # results/judge-test-20261022/judge_test.py VERSION
+ROW_VERSION = "judge-test-row/1"  # ... and ROW_VERSION
+# The producer's row statuses (judge_test.py): "judged" has a call; the others hold none. A parent that was branched
+# submitted an output, so "no_submitted_output" cannot be its row.
+NOT_JUDGED_STATUSES = ("unjudgeable", "context_overflow")
+ROW_STATUSES = ("judged", "no_submitted_output", *NOT_JUDGED_STATUSES)
+SEALED_TRIGGER = ("the detection run's own-model judge (llm-judge-v3) rejected the initial output: its sealed verdict "
+                  "is read, no judge call is made here")
+
+
+class DetectionError(Exception):
+    """The detection run cannot drive the cell (the run is refused, nothing is attempted)."""
+
+
+def _sha256(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+class DetectionRun:
+    """A complete test-time judge directory, read only. ``plan_sha256`` is the sha256 of its plan.json bytes;
+    ``expect_plan_sha256`` (the spec's pin) must equal it, ``model_name`` is the agent's model in the runner's table
+    and ``route_model`` its route id; ``route_info`` is the retry route's, to compare the deployment."""
+
+    def __init__(self, root: Path, *, expect_plan_sha256: str, expect_rows_sha256: str, model_name: str,
+                 route_model: str, route_info: dict | None = None):
+        self.root = Path(root)
+        try:
+            self._open(expect_plan_sha256, expect_rows_sha256, model_name, route_model, route_info)
+        except (ValueError, KeyError, TypeError, AttributeError, IndexError) as exc:
+            # a damaged or foreign file is a refusal, not a traceback (the message names the kind of failure only)
+            raise DetectionError(f"{self.root}: not a readable detection run ({type(exc).__name__})") from None
+
+    def _open(self, expect_plan_sha256: str, expect_rows_sha256: str, model_name: str, route_model: str,
+              route_info: dict | None) -> None:
+        plan_bytes = self._read(self.root / "plan.json")
+        self.plan_sha256 = _sha256(plan_bytes)
+        if self.plan_sha256 != expect_plan_sha256:
+            raise DetectionError(f"{self.root}: plan.json has sha256 {self.plan_sha256}, the spec pins "
+                                 f"{expect_plan_sha256}")
+        self.plan = json.loads(plan_bytes)
+        if self.plan.get("version") != PLAN_VERSION:
+            raise DetectionError(f"{self.root}: plan version {self.plan.get('version')!r}, not {PLAN_VERSION!r}")
+        if self.plan.get("model_name") != model_name or self.plan.get("route_model") != route_model:
+            raise DetectionError(f"{self.root}: the detection judge is for {self.plan.get('model_name')!r} "
+                                 f"({self.plan.get('route_model')!r}), not {model_name!r} ({route_model!r}): the "
+                                 f"judge is the agent's own model")
+        if self.plan.get("template", {}).get("id") != TEMPLATE_ID or self.plan["template"].get("sha256") != template_sha256():
+            raise DetectionError(f"{self.root}: the detection judge ran another template than this code's "
+                                 f"{TEMPLATE_ID} ({template_sha256()})")
+        self.items = {e["run_id"]: e for e in self.plan["items"]}
+        if len(self.items) != len(self.plan["items"]):
+            raise DetectionError(f"{self.root}: a run id twice in the plan")
+        self.rows_dir = self.root / "SEALED" / "rows"
+        self.ledger = self._ledger()
+        names = {p.name[:-len(".json")] for p in self.rows_dir.glob("*.json")}
+        if names != set(self.items):
+            raise DetectionError(f"{self.root}: the sealed rows are not exactly the plan's records: the detection run "
+                                 f"is not complete")  # no number: an interim count of rows would show how far it is
+        held = self.root / "SEALED" / "held"
+        if held.is_dir() and any(held.iterdir()):  # rows with nothing to judge move into rows/ when the run ends
+            raise DetectionError(f"{self.root}: rows still wait under SEALED/held: the detection run did not end")
+        # Every row is read once, here, by this process: its bytes hash to the ledger's line, the sealed results as a
+        # whole hash to the spec's pin (the plan alone would let a second run of the same plan, with other draws,
+        # replace this one), and each row has the shape its status says. Nothing of a row is printed.
+        self.rows: dict[str, dict] = {}
+        digests = []
+        for run_id in sorted(self.items):
+            raw = self._read(self.rows_dir / f"{run_id}.json")
+            digest = _sha256(raw)
+            if digest != self.ledger[run_id]:
+                raise DetectionError(f"{run_id}: the sealed row does not hash to the ledger's sha256")
+            digests.append((run_id, digest))
+            self.rows[run_id] = self._checked(run_id, json.loads(raw))
+        self.rows_sha256 = rows_digest(digests)
+        if self.rows_sha256 != expect_rows_sha256:
+            raise DetectionError(f"{self.root}: the sealed rows have sha256 {self.rows_sha256}, the spec pins "
+                                 f"{expect_rows_sha256}")
+        # Complete means what the files show: a sealed row and a ledger line for every planned record, none held.
+        # progress.json's own flag is not asked for: the runs made before it existed (the first Claude batches) lack it,
+        # and a run that stopped between its last row and its last write has all its rows.
+        progress = json.loads(self._read(self.root / "progress.json"))
+        self.served_identity = progress.get("served_identity")
+        if self.served_identity is None:  # the identity the run was pinned to and served by (no verdict, no count)
+            identity = self.root / "SEALED" / "identity.json"
+            self.served_identity = json.loads(self._read(identity)) if identity.is_file() else None
+        judge = self.plan["judge"]
+        self._check_served(judge)
+        self.route_info = judge["route"]
+        info = route_info or {}
+        self.same_deployment = (judge["route"].get("base_url") == info.get("base_url")
+                                and judge["route"].get("provider") == info.get("provider")
+                                and judge["route"].get("model") == info.get("model"))
+
+    @staticmethod
+    def _read(path: Path) -> bytes:
+        try:
+            return path.read_bytes()
+        except OSError as exc:
+            raise DetectionError(f"{path}: cannot be read ({type(exc).__name__})") from None
+
+    def _ledger(self) -> dict[str, str]:
+        """run id -> the sha256 the ledger recorded for its sealed row (the last 'sealed' line)."""
+        out: dict[str, str] = {}
+        for line in self._read(self.root / "SEALED" / "ledger.jsonl").decode("utf-8").splitlines():
+            if line.strip():
+                e = json.loads(line)
+                if e.get("event") == "sealed":
+                    out[e["run_id"]] = e["sha256"]
+        missing = sorted(set(self.items) - set(out))
+        if missing:
+            raise DetectionError(f"{self.root}: sealed rows have no ledger line")
+        return out
+
+    def _check_served(self, judge: dict) -> None:
+        """The served identity recorded beside the run (progress.json or the sealed identity file, neither of which the
+        pins cover) agrees with the pinned rows: every judged row was served by a recorded model and fingerprint, and by
+        the plan's expected fingerprint where it names one."""
+        expect = judge.get("expect_fingerprint")
+        identity = self.served_identity if isinstance(self.served_identity, dict) else None
+        models = set((identity or {}).get("served_models") or [])
+        prints = set((identity or {}).get("system_fingerprints") or [])
+        seen_prints: set[str] = set()
+        seen_models: set[str] = set()
+        for run_id, row in self.rows.items():
+            if row["status"] != "judged":
+                continue
+            fp = (row.get("call") or {}).get("system_fingerprint")
+            served = row["initial"]["judge"].get("served_model")
+            if (expect is not None and fp != expect) or (fp is not None and prints and fp not in prints) or (
+                    served is not None and models and served not in models):
+                raise DetectionError(f"{run_id}: the row was served by a model or fingerprint the detection run's "
+                                     f"recorded identity (or its expected fingerprint) does not name")
+            if fp is not None:
+                seen_prints.add(fp)
+            if served is not None:
+                seen_models.add(served)
+        # and the other way: what is recorded as the identity is what the rows show (the file is outside the pins)
+        judged_any = any(r["status"] == "judged" for r in self.rows.values())
+        if judged_any and (prints != seen_prints or models != seen_models):
+            raise DetectionError(f"{self.root}: the recorded served identity names a model or fingerprint no row shows")
+
+    def check_parents(self, records_dirs: Path | Sequence[Path]) -> None:
+        """Every record the detection plan judged is in ``records_dirs`` (the OUT's records/; the OUTs of one graph, for the
+        coverage check) with the bytes it judged, found by the runner's file name '<claim digest>.<run id>.json'; refused
+        before any attempt, so a copy of the wrong records is not found one attempt at a time. Names and hashes only: no
+        row and no verdict is touched."""
+        records_dir = records_dirs if isinstance(records_dirs, Path) else records_dirs[0]
+        have: dict[str, list[Path]] = {}
+        for d in [records_dirs] if isinstance(records_dirs, Path) else records_dirs:
+            for p in d.glob("*.json"):
+                parts = p.name.split(".")
+                if len(parts) == 3 and len(parts[0]) == 40:
+                    have.setdefault(parts[1], []).append(p)
+        bad = [run_id for run_id, e in sorted(self.items.items())
+               if len(have.get(run_id, [])) != 1 or _sha256(have[run_id][0].read_bytes()) != e["record_sha256"]]
+        if bad:
+            raise DetectionError(f"{self.root}: records the detection run judged are missing from {records_dir} or "
+                                 f"differ from the bytes it judged: {', '.join(bad[:5])}")
+
+    def _checked(self, run_id: str, row: dict) -> dict:
+        """A sealed row, refused unless it is this plan record's and has the shape its status says: a judged row holds
+        its call, the verdict read again from that call's reply, and its submission; any other status holds none."""
+        entry = self.items[run_id]
+        if (not isinstance(row, dict) or row.get("version") != ROW_VERSION or row.get("run_id") != run_id
+                or row.get("record_sha256") != entry["record_sha256"] or row.get("question_id") != entry["question_id"]):
+            raise DetectionError(f"{run_id}: the sealed row is not this record's")
+        if row.get("model") != self.plan["route_model"]:  # judge_test.py's row names the record's (route) model
+            raise DetectionError(f"{run_id}: the sealed row is another model's ({row.get('model')!r}), not the "
+                                 f"plan's {self.plan['route_model']!r}")
+        status = row.get("status")
+        if status not in ROW_STATUSES:
+            raise DetectionError(f"{run_id}: the sealed row has an unknown status {status!r}")
+        initial = row.get("initial")
+        if status != "judged":
+            if initial is not None or row.get("submission_index") is not None:
+                raise DetectionError(f"{run_id}: a {status} row holds a call or a submission")
+            return row
+        judged = (initial or {}).get("judge")
+        if (not isinstance(judged, dict) or not isinstance(row.get("submission_index"), int)
+                or any(k not in initial for k in ("checked_query", "checked_query_status", "verdict"))
+                or any(k not in judged for k in ("input_sha256", "tool_calls", "stop_reason", "refusal", "verdict",
+                                                  "reason", "parse_status"))):
+            raise DetectionError(f"{run_id}: a judged row without its call, verdict or submission")
+        if parse_verdict(judged["tool_calls"], judged["stop_reason"], judged["refusal"]) != (
+                judged["verdict"], judged["reason"], judged["parse_status"]) or initial["verdict"] != _verdict(judged):
+            raise DetectionError(f"{run_id}: the judge's recorded reply, read again, gives another verdict")
+        # the call is the plan's judge's: the agent's own model on the route the plan names (a row from another
+        # model or deployment would otherwise pass the byte pins)
+        plan_route = self.plan["judge"]["route"]
+        if (judged.get("model") != self.plan["route_model"] or judged.get("same_model") is False
+                or judged.get("route") != plan_route):
+            raise DetectionError(f"{run_id}: the recorded call is not the plan's judge's (model or route)")
+        return row
+
+    def identity(self) -> dict[str, Any]:
+        """What the cell's settings record of the detection run (no verdict, no count)."""
+        judge = self.plan["judge"]
+        return {"plan_sha256": self.plan_sha256, "rows_sha256": self.rows_sha256, "version": self.plan["version"],
+                "model_name": self.plan["model_name"], "route_model": self.plan["route_model"], "mode": judge["mode"],
+                "deployment": judge.get("deployment"),
+                "route": {k: self.route_info.get(k) for k in ("provider", "model", "base_url")},
+                "expect_fingerprint": judge.get("expect_fingerprint"), "served_identity": self.served_identity,
+                "template": {"id": self.plan["template"]["id"], "sha256": self.plan["template"]["sha256"]},
+                "max_tokens": judge["max_tokens"], "same_deployment": self.same_deployment}
+
+    def row(self, run_id: str, parent_sha256: str) -> dict:
+        """The sealed row of a parent output, checked to be that parent's: the planned record's sha256 is the parent
+        record file's. A parent that was branched submitted an output, so its row cannot say it submitted none."""
+        entry = self.items.get(run_id)
+        if entry is None:
+            raise DetectionError(f"{run_id}: not a record of the detection run's plan")
+        if entry["record_sha256"] != parent_sha256:
+            raise DetectionError(f"{run_id}: the parent record is not the one the detection run judged (sha256)")
+        row = self.rows[run_id]
+        if row["status"] == "no_submitted_output":
+            raise DetectionError(f"{run_id}: the detection run found no submitted output in a record that submitted one")
+        return row
+
+
+def _same_attempt_as(rec: dict, parent: dict) -> list[str]:
+    """The ways a branch record's initial phase is not its parent's: the attempt's identity, the transcript up to the retry
+    (the loop's own replay check), the tool calls the parent made (their name, arguments, status, shown result and
+    terminal mark) and the answer submitted. It matters for every row, a no-call one above all: nothing there is rebuilt
+    from the output, so a record replaying another output under this parent's name would pass otherwise."""
+    from harness.agent.record import RunRecord
+    from harness.checkloop.online import _same_initial_phase, initial_transcript
+
+    problems = []
+    if any(rec.get(k) != parent.get(k) for k in ("question_id", "repetition", "model", "split")):
+        problems.append("its question, repetition or model is not its parent's")
+    try:
+        got, want = initial_transcript(RunRecord.from_json(rec)), RunRecord.from_json(parent).transcript
+    except (KeyError, TypeError, ValueError):
+        return problems + ["its transcript cannot be compared with its parent's"]
+    if not _same_initial_phase(got, want):
+        problems.append("its initial transcript is not its parent's")
+    keys = ("name", "arguments", "status", "result_shown", "terminal")
+    theirs = [{k: c.get(k) for k in keys} for c in parent.get("tool_calls") or []]
+    ours = [{k: c.get(k) for k in keys} for c in (rec.get("tool_calls") or [])[:len(theirs)]]
+    if ours != theirs:
+        problems.append("its tool calls do not begin with its parent's")
+    initial = (rec.get("checker") or {}).get("initial") or {}
+    if initial.get("final_rows") != parent.get("final_rows"):
+        problems.append("its initial answer is not its parent's")
+    from harness.checkloop.checked import submissions
+
+    # the initial answer is the parent's, so its score is the parent's (the scorer is not rerun here: no gold); a record that
+    # made no retry ends on that answer, so its own score is the parent's too
+    if initial.get("score") != parent.get("score"):
+        problems.append("its initial score is not its parent's")
+    if (rec.get("checker") or {}).get("retry") is None and rec.get("score") != parent.get("score"):
+        problems.append("its score is not its parent's, though it made no retry")
+    subs = submissions(parent.get("tool_calls") or [])
+    if not subs or initial.get("submission_index") != subs[-1]:  # the one the loop checks (and the producer judged)
+        problems.append("its initial submission is not its parent's")
+    return problems
+
+
+def audit_record(rec: dict, detection: DetectionRun, parent_sha256: str, parent_rec: dict | None = None) -> list[str]:
+    """What a judge-cell record must be, given the detection run's sealed row of its parent: the problems found (none: the
+    record is what the cell decides from that row). The record alone cannot show this (a forged no-call decision with both
+    pins kept replays cleanly), so the runner at the end of a phase, and the coverage check when given the run, hold every
+    record to its sealed row. A problem names the record and the part that differs, never the verdict: what is printed
+    must not show which outputs the detection judge rejected."""
+    chk = rec.get("checker") or {}
+    settings, initial, parent = chk.get("settings") or {}, chk.get("initial") or {}, chk.get("branched_from")
+    try:
+        row = detection.row(parent, parent_sha256)
+    except DetectionError as exc:
+        return [f"{rec.get('run_id')}: {exc}"]
+    problems: list[str] = _same_attempt_as(rec, parent_rec) if parent_rec is not None else []
+    want = {"plan_sha256": detection.plan_sha256, "rows_sha256": detection.rows_sha256, "row_status": row["status"],
+            "row_sha256": detection.ledger[parent]}
+    if initial.get("detection") != want:
+        problems.append("its decision names another detection row than its parent's")
+    named = dict(settings.get("detection") or {})
+    claimed_same = named.pop("same_deployment", None)
+    identity = detection.identity()
+    identity.pop("same_deployment")
+    if named != identity:
+        problems.append("its settings name another detection run")
+    route = rec.get("route") or {}  # the retry's route as the record holds it: the same deployment as the judge's?
+    plan_route = detection.route_info
+    same = all(route.get(k) == plan_route.get(k) for k in ("provider", "base_url", "model"))
+    if claimed_same is not same:
+        problems.append("its settings say the detection ran on another deployment than its retry's route shows")
+    if row["status"] != "judged":
+        verdict = {"status": "unparsed", "retry": False, "reason": None,
+                   "parse_status": f"{VERDICT_NOT_JUDGED}:{row['status']}"}
+        if (initial.get("judge") is not None or initial.get("verdict") != verdict or chk.get("retry") is not None
+                or initial.get("checked_query") is not None or initial.get("checked_query_status") is not None):
+            problems.append("its decision is not what its parent's sealed row decides (call, verdict or retry)")
+        if any(t.get("role") == "user" and t.get("kind") in RETRY_KINDS for t in rec.get("transcript") or []):
+            problems.append("the retry turns in its transcript are not what its parent's sealed row decides")
+        return [f"{rec.get('run_id')}: {x}" for x in problems]
+    recorded = row["initial"]
+    judged = recorded["judge"]
+    if initial.get("judge") != judged or initial.get("verdict") != recorded["verdict"]:
+        problems.append("its judge call or verdict is not its parent's sealed one")
+    if initial.get("submission_index") != row.get("submission_index"):
+        problems.append("its initial submission is not the one its parent's sealed row judged")
+    if (initial.get("checked_query"), initial.get("checked_query_status")) != (
+            recorded["checked_query"], recorded["checked_query_status"]):
+        problems.append("its checked query is not the one the detection judge saw")
+    retry = chk.get("retry")
+    expected = judge_message(JUDGE_RETRY_ID, judged["reason"]) if recorded["verdict"]["retry"] else None
+    if (retry is None) != (expected is None) or (retry is not None and retry.get("message") != expected):
+        problems.append("its retry (made or not, and its message) is not what its parent's sealed row decides")
+    elif retry is not None and retry.get("message_kind") != BASELINE_MODES[JUDGE_MODE]:
+        problems.append("its retry is not a judge cell's kind of turn")
+    # the retry turns in its transcript: one of the judge cell's kind with the message, or none
+    turns = [t for t in rec.get("transcript") or [] if t.get("role") == "user" and t.get("kind") in RETRY_KINDS]
+    if (expected is None and turns) or (expected is not None and (
+            len(turns) != 1 or turns[0].get("kind") != BASELINE_MODES[JUDGE_MODE]
+            or not str(turns[0].get("text", "")).startswith(expected))):
+        problems.append("the retry turns in its transcript are not what its parent's sealed row decides")
+    return [f"{rec.get('run_id')}: {x}" for x in problems]
+
+
+def _in_scope(rec: dict, cell_ids: Sequence[str]) -> bool:
+    """Whether a run record is, or claims or hides being, a judge-cell record: ANY of its identifying fields says so (its
+    checker mode, version, its cell by ``load.arm`` or ``checker.branch.arm``, a detection block). A record that changes
+    some of these and not the others cannot leave the audit by choosing which one it shows."""
+    chk = rec.get("checker") or {}
+    settings, initial = chk.get("settings") or {}, chk.get("initial") or {}
+    cells = set(cell_ids)
+    return bool(settings.get("mode") == JUDGE_MODE or settings.get("version") == SEALED_JUDGE_VERSION
+                or (rec.get("load") or {}).get("arm") in cells or (chk.get("branch") or {}).get("arm") in cells
+                or "detection" in settings or "detection" in initial)
+
+
+def audit_records(records_dir: Path, detections: Sequence[DetectionRun], cell_ids: Sequence[str]) -> list[str]:
+    """``audit_record`` over every judge-cell record in ``records_dir`` (the OUT's records/). Every ``*.json`` file is read,
+    whatever its name: a set-aside sidecar (schema setaside/1, no tool calls) is skipped, anything else without a run
+    record's shape is a problem. A record is in scope if any of its identifying fields says it is a judge-cell one
+    (``_in_scope``), and then all of them must agree (mode judge, the sealed version, its cell one of ``cell_ids``);
+    its detection run is the one of its model (a record of a model with none is a problem), its parent is the one run
+    record of the run id it names, and the parent's bytes are hashed. Two run records of one run id are a problem.
+    Records are read by this process only; the problems name run ids, never a verdict. (A record that disguised itself as
+    another cell on every field is for the coverage check, which counts a cell's records by its mode and finds it twice
+    or missing.)"""
+    by_model = {d.plan["route_model"]: d for d in detections}
+    problems: list[str] = []
+    runs: dict[str, list[tuple[bytes, dict]]] = {}
+    for p in sorted(records_dir.iterdir()):  # nothing else sits among the records but the runner's temp files (.tmp)
+        if p.suffix == ".tmp":  # a temp file is not a record; one that reads as a run record or a checker decision is
+            try:
+                temp = json.loads(p.read_bytes())
+            except (ValueError, OSError):
+                continue
+            if isinstance(temp, dict) and any(k in temp for k in ("run_id", "checker", "tool_calls")):
+                problems.append(f"{p.name}: a temp file that holds a run record")
+        elif p.suffix != ".json":
+            problems.append(f"{p.name}: not a record file")
+    for p in sorted(records_dir.glob("*.json")):
+        raw = p.read_bytes()
+        try:
+            rec = json.loads(raw)
+        except ValueError:
+            problems.append(f"{p.name}: not JSON")
+            continue
+        if not isinstance(rec, dict):
+            problems.append(f"{p.name}: not a JSON object")
+        elif isinstance(rec.get("tool_calls"), list) and isinstance(rec.get("run_id"), str):
+            runs.setdefault(rec["run_id"], []).append((raw, rec))
+        elif not (rec.get("schema") == "setaside/1" and "checker" not in rec and "tool_calls" not in rec):
+            # a sidecar names no checker and holds no tool calls; a record that dropped its tool calls is not exempted by
+            # claiming the schema
+            problems.append(f"{p.name}: neither a run record nor a set-aside sidecar")
+    for run_id in sorted(runs):
+        if len(runs[run_id]) > 1:
+            problems.append(f"{run_id}: more than one run record carries this run id")
+            continue
+        raw, rec = runs[run_id][0]
+        if not _in_scope(rec, cell_ids):
+            continue
+        chk = rec.get("checker") or {}
+        settings = chk.get("settings") or {}
+        branch_arm = (chk.get("branch") or {}).get("arm")
+        arm = (rec.get("load") or {}).get("arm")
+        if (settings.get("version") != SEALED_JUDGE_VERSION or settings.get("mode") != JUDGE_MODE
+                or arm not in cell_ids or branch_arm != arm):  # (a runner's record names its cell in both)
+            # the record says it is one cell on one field and another on the next: it is not left out of the audit
+            problems.append(f"{run_id}: a judge-cell record whose mode, version and cell do not agree")
+            continue
+        detection = by_model.get(rec.get("model"))
+        if detection is None:
+            problems.append(f"{run_id}: no detection run was given for its model")
+            continue
+        parents = runs.get(chk.get("branched_from")) or []
+        if len(parents) != 1:
+            problems.append(f"{run_id}: its parent record is not one file of {records_dir}")
+            continue
+        problems += audit_record(rec, detection, _sha256(parents[0][0]), parents[0][1])
+    return problems
+
+
+def rows_digest(digests: list[tuple[str, str]]) -> str:
+    """The sha256 of a detection run's sealed rows: its lines '<run id> <sha256 of the row file's bytes>', sorted by run
+    id (baseline_run.py detection-pin computes the same from the files without parsing them)."""
+    return _sha256("".join(f"{run_id} {digest}\n" for run_id, digest in sorted(digests)).encode("utf-8"))
+
+
+class SealedJudgeRetryChecker:
+    """The judge cell's checker for one parent output, in the interface the agent loop and ``branch_attempt`` call
+    (``budget``, ``settings()``, ``check()``). ``question`` is the question text as the agent saw it,
+    ``parent_run_id`` and ``parent_sha256`` identify the parent (its record file's bytes)."""
+
+    mode = JUDGE_MODE
+    label = JUDGE_MODE
+
+    def __init__(self, detection: DetectionRun, question: str, parent_run_id: str, parent_sha256: str, *,
+                 budget: RetryBudget, message_id: str = JUDGE_RETRY_ID, set_aside: bool | None = None):
+        if message_id not in JUDGE_MESSAGES:
+            raise ValueError(f"unknown judge retry message {message_id!r}; known: {sorted(JUDGE_MESSAGES)}")
+        self.detection = detection
+        self.question = question
+        self.parent_run_id = parent_run_id
+        self.parent_sha256 = parent_sha256
+        self.budget = budget
+        self.message_id = message_id
+        self.set_aside = set_aside_on(set_aside)
+
+    def settings(self) -> dict[str, Any]:
+        return cell_settings(self.detection, self.message_id, self.budget, self.set_aside)
+
+    def check(self, inp: CheckInput) -> Decision:
+        row = self.detection.row(self.parent_run_id, self.parent_sha256)
+        r = inp.rules
+        matching = {"multiset": r.multiset, "rel_tol": r.rel_tol, "abs_tol": r.abs_tol,
+                    "column_order": r.column_order}
+        source = {"plan_sha256": self.detection.plan_sha256, "rows_sha256": self.detection.rows_sha256,
+                  "row_status": row["status"], "row_sha256": self.detection.ledger[self.parent_run_id]}
+        if row["status"] != "judged":  # nothing was judged (unjudgeable, context overflow): unknown, never a retry
+            verdict = {"status": "unparsed", "retry": False, "reason": None,
+                       "parse_status": f"{VERDICT_NOT_JUDGED}:{row['status']}"}
+            initial = {"matching": matching, "checked_query": None, "checked_query_status": None, "verdict": verdict,
+                       "reports": [], "store_log": None, "judge": None, "detection": source}
+            return Decision(False, None, None, json.loads(json.dumps(initial, ensure_ascii=False)), None)
+        item, status = output_judge_item(self.question, inp.tool_calls, inp.final_rows, inp.rules, inp.row_cap,
+                                         inp.submission_index)
+        recorded = row["initial"]
+        judged = recorded["judge"]
+        if row["submission_index"] != inp.submission_index or recorded["verdict"] != _verdict(judged):
+            raise ReplayDivergence("the detection row is not this output's submission or verdict")
+        if render(item).input_sha256 != judged["input_sha256"]:
+            raise ReplayDivergence("the judge input rebuilt from the replayed parent differs from the detection "
+                                   "run's")
+        if (item.query, status) != (recorded["checked_query"], recorded["checked_query_status"]):
+            raise ReplayDivergence("the checked query rebuilt from the replayed parent differs from the detection "
+                                   "run's")
+        if parse_verdict(judged["tool_calls"], judged["stop_reason"], judged["refusal"]) != (
+                judged["verdict"], judged["reason"], judged["parse_status"]):
