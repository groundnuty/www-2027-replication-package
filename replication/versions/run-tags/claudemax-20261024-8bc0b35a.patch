-def shape_difference(got: dict, want: dict) -> str | None:
-    parts = []
-    for k in SHAPE_KEYS:
-        g, w = set(got.get(k) or ()), set(want.get(k) or ())
-        if g != w:
-            parts.append(f"{k} " + ", ".join([*(f"+{x}" for x in sorted(g - w)), *(f"-{x}" for x in sorted(w - g))]))
-    return "; ".join(parts) or None
