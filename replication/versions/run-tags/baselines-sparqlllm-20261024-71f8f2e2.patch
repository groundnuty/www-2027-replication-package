+    spec = manifest["spec"]
+    given = {}
+    for item in dirs:
+        model, sep, path = item.partition("=")
+        if not sep or not model or not path or model in given:
+            raise Refused(f"--baseline-judge-dir {item!r}: MODEL=DIR, once per model")
+        given[model] = Path(path)
+    cells = {b["id"]: b for b in spec.get("branch_cells") or [] if b.get("mode") == "judge"}
+    detections = []
