--- /dev/null
+++ b/harness/baselines/sparqlllm/void_build.py
@@ -0,0 +1,712 @@
+"""The VoID map SPARQL-LLM validates against, rebuilt from our own store (design log).
+
+SPARQL-LLM (sib-swiss/sparql-llm, pinned at 88c62e79822403b26a8fc970444328a9ad65de56) checks a query against
+``dict[class IRI][predicate IRI] -> list[object class IRI or datatype IRI]``, which upstream reads out of a VoID
+description (``sparql_llm.utils.GET_VOID_DESC``: class partitions with property partitions, their object class
+partitions and datatype partitions, and linksets). We do not ship SIB's file: this module reads the same three facts
+off the store we evaluate on, in the manner of SIB's void-generator, and writes them as ``voidmap.json``. The
+validator is applied elsewhere; ``as_validator_dict`` turns the file into the shape upstream's
+``validate_sparql_with_void`` takes as ``endpoints_void_dict``.
+
+Definition (over the endpoint's default graph, which QLever makes the union of all graphs; no FROM, no GRAPH)
+    class C            an IRI that is the rdf:type object of some triple; ``entities`` = its distinct subjects
+    property P of C    a predicate (rdf:type included) of some triple whose subject has rdf:type C
+    entry of (C, P)    every IRI class OC that some object of a (C, P) triple has as rdf:type, and every datatype
+                       IRI of the literal objects of (C, P) (``DATATYPE()``: rdf:langString for a language-tagged
+                       literal, xsd:string for a plain one); an empty list when the objects have neither
+    object nodes       by default only IRI objects supply object classes (``object_nodes="iri"``, the task's
+                       wording). The task's Q2 sketch had no such filter, so a typed blank-node object would also
+                       count; ``object_nodes="any"`` gives that reading (CLI ``--object-nodes any``).
+
+Queries, sent one at a time by one thread with a pause between requests (QLever 9bebc60 aborted once under
+concurrent load, stores/OPERATIONS.md):
+    Q0   classes and entities, one grouped query (on a time-out: the class list, then one count per class)
+    Q1   per class, its predicates
+    Q2   per class, (predicate, object class)
+    Q3   per class, (predicate, datatype)
+A per-class query that does not answer (time-out or error) is repeated once, split by predicate, with the
+predicate written into the pattern (one query per predicate of the class for Q2 and Q3). Q1 has no predicate
+list of the class to split over, so its split goes over the store's predicate list (one more store-wide query,
+made on first need): one existence probe per predicate. A (class, predicate) that still fails is recorded in
+``incomplete`` and the map is built without it. Nothing is retried a third time. A query the store rejects as
+malformed ends the build at once (the shape is wrong, not the data).
+
+Identity: ``?cmd=stats`` must report the expected ``name-index`` before the first query and after the last; a
+different one ends the build with no map. Nothing of the endpoint (host, port) is written into any output.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import time
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+import httpx
+
+from harness.sparql import SparqlError
+from harness.store_identity import EXPECTED_STORES, expected_identity
+from harness.terms import IRI, Literal
+
+SCHEMA = "sparqlllm-voidmap/1"
+PREFIXES_SCHEMA = "sparqlllm-prefixes/1"
+MANIFEST_SCHEMA = "sparqlllm-index-manifest/1"
+ENDPOINT_KEY_PREFIX = "urn:www2027:endpoint:"
+MODULE_PATH = "harness/baselines/sparqlllm/void_build.py"
+OUTPUT_NAMES = ("voidmap.json", "prefixes.json", "queries.jsonl", "manifest.json")
+
+PARTS = ("properties", "object_classes", "datatypes")
+OBJECT_NODES = ("iri", "any")
+DEFAULT_SERVER_TIMEOUT_S = 240.0
+MAX_SERVER_TIMEOUT_S = 280.0  # the client time-out is this plus the margin below: at most 290 s (QLever caps at 300)
+# harness.sparql.SparqlClient sends its time-out to QLever as the server time-out and waits this much longer
+# (``timeout_s + 10``) for the answer. One knob, so the client time-out is always the server's plus the margin.
+CLIENT_TIMEOUT_MARGIN_S = 10.0
+DEFAULT_PAUSE_S = 0.5
+MAX_CONSECUTIVE_TRANSPORT_ERRORS = 3  # a store that does not answer: stop, do not walk every class
+
+EXIT_OK, EXIT_IDENTITY, EXIT_ABORT, EXIT_INCOMPLETE, EXIT_USAGE = 0, 2, 3, 4, 64
+
+_UNSAFE_IRI = re.compile(r'[\x00-\x20<>"{}|^`\\]')
+
+
+# --- failures ---------------------------------------------------------------------------------------------------
+
+class BuildFailure(RuntimeError):
+    """The build ended without a map. ``queries`` holds the log of the requests sent so far."""
+
+    exit_code = EXIT_ABORT
+
+    def __init__(self, message: str, queries: list[dict] | None = None):
+        super().__init__(message)
+        self.queries = list(queries or [])
+
+
+class IdentityMismatch(BuildFailure):
+    """The endpoint is not the expected store, or its identity cannot be established (exit 2)."""
+
+    exit_code = EXIT_IDENTITY
+
+
+class BuildAborted(BuildFailure):
+    """A store-wide query failed, the store refused a query shape, or it stopped answering (exit 3)."""
+
+    exit_code = EXIT_ABORT
+
+
+class UnsafeIri(ValueError):
+    """An IRI that cannot be written between angle brackets in a query."""
+
+
+class _Unusable(Exception):
+    """An answer the builder cannot read (its message is a fixed phrase: it ends up in ``incomplete``)."""
+
+
+def iri_ref(iri: str) -> str:
+    if not iri or _UNSAFE_IRI.search(iri):
+        raise UnsafeIri("an IRI that cannot be written in a query")
+    return f"<{iri}>"
+
+
+# --- the queries --------------------------------------------------------------------------------------------------
+
+class Shapes:
+    """The query texts. ``c`` and ``p`` are IRIs already written as ``<...>`` (``iri_ref``)."""
+
+    def __init__(self, object_nodes: str = "iri"):
+        if object_nodes not in OBJECT_NODES:
+            raise ValueError(f"object_nodes must be one of {OBJECT_NODES}")
+        self.object_nodes = object_nodes
+        self._object_filter = "isIRI(?o) && isIRI(?oc)" if object_nodes == "iri" else "isIRI(?oc)"
+
+    classes = "SELECT ?c (COUNT(DISTINCT ?s) AS ?n) WHERE { ?s a ?c . FILTER(isIRI(?c)) } GROUP BY ?c ORDER BY ?c"
+    class_list = "SELECT ?c WHERE { ?s a ?c . FILTER(isIRI(?c)) } GROUP BY ?c ORDER BY ?c"
+    predicates = "SELECT ?p (COUNT(*) AS ?n) WHERE { ?s ?p ?o } GROUP BY ?p"
+
+    @staticmethod
+    def class_count(c: str) -> str:
+        return f"SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {{ ?s a {c} }}"
+
+    @staticmethod
+    def properties(c: str) -> str:
+        return f"SELECT ?p WHERE {{ ?s a {c} . ?s ?p ?o }} GROUP BY ?p"
+
+    @staticmethod
+    def probe(c: str, p: str) -> str:
+        return f"SELECT ?s WHERE {{ ?s a {c} . ?s {p} ?o }} LIMIT 1"
+
+    def object_classes(self, c: str) -> str:
+        return (f"SELECT ?p ?oc WHERE {{ ?s a {c} . ?s ?p ?o . ?o a ?oc . FILTER({self._object_filter}) }} "
+                "GROUP BY ?p ?oc")
+
+    def object_classes_split(self, c: str, p: str) -> str:
+        return (f"SELECT ?oc WHERE {{ ?s a {c} . ?s {p} ?o . ?o a ?oc . FILTER({self._object_filter}) }} "
+                "GROUP BY ?oc")
+
+    @staticmethod
+    def datatypes(c: str) -> str:
+        return (f"SELECT ?p ?dt WHERE {{ ?s a {c} . ?s ?p ?o . FILTER(isLiteral(?o)) "
+                "BIND(DATATYPE(?o) AS ?dt) } GROUP BY ?p ?dt")
+
+    @staticmethod
+    def datatypes_split(c: str, p: str) -> str:
+        return (f"SELECT ?dt WHERE {{ ?s a {c} . ?s {p} ?o . FILTER(isLiteral(?o)) "
+                "BIND(DATATYPE(?o) AS ?dt) } GROUP BY ?dt")
+
+    def templates(self) -> list[tuple[str, str]]:
+        c, p = "<CLASS>", "<PREDICATE>"
+        return [
+            ("Q0 classes", self.classes),
+            ("Q0 fallback, class list", self.class_list),
+            ("Q0 fallback, one per class", self.class_count(c)),
+            ("Q1 properties", self.properties(c)),
+            ("Q1 split: store predicates (once)", self.predicates),
+            ("Q1 split: one probe per predicate", self.probe(c, p)),
+            ("Q2 object classes", self.object_classes(c)),
+            ("Q2 split: one per predicate", self.object_classes_split(c, p)),
+            ("Q3 datatypes", self.datatypes(c)),
+            ("Q3 split: one per predicate", self.datatypes_split(c, p)),
+        ]
+
+
+def semantics_text(object_nodes: str) -> str:
+    objects = "an IRI that has" if object_nodes == "iri" else "an IRI or a blank node that has"
+    return (
+        "Rebuilt from the store itself over its default graph (the union of all its graphs), in the manner of SIB's "
+        "void-generator and of the VoID description SPARQL-LLM reads. A class entry C exists when some subject has "
+        "rdf:type C (C an IRI); entities counts the distinct subjects of rdf:type C. A property P of C is any "
+        "predicate, rdf:type included, used by at least one subject of rdf:type C. The list for (C, P) holds every "
+        f"IRI class OC such that some object of a (C, P) triple is {objects} rdf:type OC, and every datatype IRI of "
+        "the literal objects of (C, P) as the store's DATATYPE() reports it (rdf:langString for language-tagged "
+        "literals, xsd:string for plain ones); it is empty when the objects have neither. A subject with several "
+        "types counts under each of them. No subclass or other inference is applied. Lists are sorted and unique. "
+        "Entries named in 'incomplete' are missing because their queries timed out or failed; with an empty "
+        "'incomplete' list the map is complete under this definition."
+    )
+
+
+# --- identity -----------------------------------------------------------------------------------------------------
+
+REPO_ROOT = Path(__file__).resolve().parents[3]
+
+
+def committed_identity(graph: str, root: Path | None = None) -> str | None:
+    """``<store>@<sha256 of stores/<store>/build/index.sha256>``: the identity ``stores/serve.sbatch`` gives a server
+    started on that store (``--index-description``), from the repository's committed build record; None when the store
+    has no such file."""
+    path = (root or REPO_ROOT) / "stores" / graph / "build" / "index.sha256"
+    if not path.is_file():
+        return None
+    return f"{graph}@{hashlib.sha256(path.read_bytes()).hexdigest()}"
+
+
+def resolve_expected_identity(graph: str, expected: str, root: Path | None = None) -> str:
+    """``expected`` (the caller's identity string) once it agrees with the store's recorded identity; otherwise
+    IdentityMismatch. Local: no request. A store in ``harness.store_identity.EXPECTED_STORES`` must agree with that
+    table (and, when the store has a committed build record, with it too). A store not in the table (the opaque
+    graphs) is known by its committed build record alone: ``stores/<graph>/build/index.sha256``, which is what the
+    server's identity is a digest of; without that file the build is refused."""
+    committed = committed_identity(graph, root)
+    specs = [s for s in EXPECTED_STORES.values() if s["store"] == graph]
+    if len(specs) > 1:
+        raise IdentityMismatch(f"more than one recorded identity for the store {graph!r}")
+    if specs:
+        recorded = expected_identity(specs[0])
+        if committed is not None and committed != recorded:
+            raise IdentityMismatch(f"harness.store_identity.EXPECTED_STORES ({recorded!r}) and the committed build "
+                                   f"record ({committed!r}) disagree about {graph!r}")
+    elif committed is not None:
+        recorded = committed
+    else:
+        raise IdentityMismatch(f"no recorded identity for the store {graph!r}: not in "
+                               f"harness.store_identity.EXPECTED_STORES and no stores/{graph}/build/index.sha256")
+    if expected != recorded:
+        raise IdentityMismatch(f"the expected identity {expected!r} differs from the recorded one ({recorded!r})")
+    return recorded
+
+
+def fetch_stats(endpoint: str, timeout_s: float = 20.0) -> dict:
+    """QLever's ``?cmd=stats`` (plain httpx; OSError when it cannot be read)."""
+    try:
+        resp = httpx.get(endpoint, params={"cmd": "stats"}, timeout=timeout_s)
+    except httpx.HTTPError as exc:
+        raise OSError(f"stats request failed: {type(exc).__name__}") from exc
+    if resp.status_code != 200:
+        raise OSError(f"stats request answered HTTP {resp.status_code}")
+    data = resp.json()
+    if not isinstance(data, dict):
+        raise OSError("stats answer is not a JSON object")
+    return data
+
+
+def _now() -> str:
+    return datetime.now(timezone.utc).isoformat(timespec="seconds")
+
+
+def check_identity(read_stats: Callable[[], dict], expected: str, when: str, queries: list[dict] | None = None) -> dict:
+    """The store's identity record, once ``name-index`` equals ``expected``; IdentityMismatch otherwise."""
+    try:
+        stats = read_stats()
+    except Exception as exc:  # any failure to read it means the identity is not established
+        raise IdentityMismatch(f"store identity {when} the build: the stats could not be read ({type(exc).__name__})",
+                               queries) from None
+    name = stats.get("name-index") if isinstance(stats, dict) else None
+    if name != expected:
+        raise IdentityMismatch(f"store identity {when} the build: the endpoint reports name-index {name!r}, "
+                               f"expected {expected!r}", queries)
+    return {"name_index": name, "num_triples_normal": stats.get("num-triples-normal"),
+            "git_hash_server": stats.get("git-hash-server")}
+
+
+# --- sending queries ------------------------------------------------------------------------------------------------
+
+@dataclass
+class Outcome:
+    ok: bool
+    value: Any = None
+    reason: str | None = None
+
+
+def _count(cell) -> int:
+    if not isinstance(cell, Literal):
+        raise _Unusable("unexpected result")
+    try:
+        return int(cell.lexical)
+    except ValueError:
+        raise _Unusable("unexpected result") from None
+
+
+def _iri(cell) -> str:
+    if not isinstance(cell, IRI):
+        raise _Unusable("unexpected result")
+    return cell.value
+
+
+def _cells(rows, width: int):
+    for row in rows:
+        if len(row) != width:
+            raise _Unusable("unexpected result")
+        yield row
+
+
+def _parse_class_counts(rows) -> dict[str, int]:
+    return {_iri(c): _count(n) for c, n in _cells(rows, 2)}
+
+
+def _parse_class_list(rows) -> list[str]:
+    return [_iri(c) for (c,) in _cells(rows, 1)]
+
+
+def _parse_scalar(rows) -> int:
+    cells = list(_cells(rows, 1))
+    if len(cells) != 1:
+        raise _Unusable("unexpected result")
+    return _count(cells[0][0])
+
+
+def _parse_predicate_counts(rows) -> list[str]:
+    return [_iri(p) for p, _n in _cells(rows, 2)]
+
+
+def _parse_predicates(rows) -> list[str]:
+    return [_iri(p) for (p,) in _cells(rows, 1)]
+
+
+def _parse_exists(rows) -> bool:
+    return bool(list(_cells(rows, 1)))
+
+
+def _parse_pairs(rows) -> list[tuple[str, str]]:
+    return [(_iri(p), _iri(oc)) for p, oc in _cells(rows, 2)]
+
+
+def _parse_objects(rows) -> list[str]:
+    return [_iri(oc) for (oc,) in _cells(rows, 1)]
+
+
+def _parse_datatype_pairs(rows) -> list[tuple[str, str]]:
+    out = []
+    for p, dt in _cells(rows, 2):
+        if dt is None:
+            raise _Unusable("unbound datatype")
+        out.append((_iri(p), _iri(dt)))
+    return out
+
+
+def _parse_datatypes(rows) -> list[str]:
+    out = []
+    for (dt,) in _cells(rows, 1):
+        if dt is None:
+            raise _Unusable("unbound datatype")
+        out.append(_iri(dt))
+    return out
+
+
+def sha256_hex(data: bytes | str) -> str:
+    return hashlib.sha256(data.encode("utf-8") if isinstance(data, str) else data).hexdigest()
+
+
+class _Session:
+    """The one place a query leaves from: pacing, the request log, and the failure vocabulary."""
+
+    def __init__(self, client, *, pause_s: float, server_timeout_s: float, sleep: Callable[[float], None],
+                 clock: Callable[[], float]):
+        self.client = client
+        self.pause_s = pause_s
+        self.server_timeout_s = server_timeout_s
+        self.sleep = sleep
+        self.clock = clock
+        self.log: list[dict] = []
+        self._owed_s = 0.0  # wait out the server's time-out after a request that may still be running
+        self._transport_run = 0
+
+    def run(self, part: str, cls: str | None, predicate: str | None, text: str, parse: Callable) -> Outcome:
+        wait = max(self.pause_s if self.log else 0.0, self._owed_s)
+        self._owed_s = 0.0
+        if wait > 0:
+            self.sleep(wait)
+        rec = {"n": len(self.log) + 1, "part": part, "class": cls, "predicate": predicate, "elapsed_s": 0.0,
+               "rows": 0, "status": "error", "query_sha256": sha256_hex(text)}
+        self.log.append(rec)
+        start = self.clock()
+        fatal = None
+        outcome = None
+        try:
+            result = self.client.query(text)
+            rec["rows"] = len(result.rows)
+            if getattr(result, "truncated", False):
+                raise _Unusable("truncated")
+            outcome = Outcome(True, parse(result.rows))
+            rec["status"] = "ok"
+            self._transport_run = 0
+        except SparqlError as exc:
+            if exc.kind == "timeout":
+                rec["status"], reason = "timeout", "timeout"
+            else:
+                rec["status"] = "error"
+                reason = f"error: {exc.kind}" + (f" {exc.status}" if exc.status else "")
+            if exc.kind == "transport":
+                self._transport_run += 1
+                if exc.sent is not False:  # the request may have reached the store, which may still be running it
+                    self._owed_s = self.server_timeout_s
+            else:
+                self._transport_run = 0
+                if exc.kind == "too_large":  # the client stopped reading; the store may still be exporting the result
+                    self._owed_s = self.server_timeout_s
+            if exc.kind in ("parse", "not_read_only"):
+                fatal = f"the store rejected a query of part {part!r} as malformed ({exc.kind}); the shape needs fixing"
+            outcome = Outcome(False, reason=reason)
+        except _Unusable as exc:
+            rec["status"] = "error"
+            outcome = Outcome(False, reason=f"error: {exc}")
+        rec["elapsed_s"] = round(self.clock() - start, 3)
+        if fatal:
+            raise BuildAborted(fatal, self.log)
+        if self._transport_run >= MAX_CONSECUTIVE_TRANSPORT_ERRORS:
+            raise BuildAborted(f"the store did not answer {self._transport_run} requests in a row", self.log)
+        return outcome
+
+
+# --- the build ------------------------------------------------------------------------------------------------------
+
+@dataclass
+class BuildResult:
+    voidmap: dict
+    queries: list[dict]
+    identity_before: dict
+    identity_after: dict
+    elapsed_s: float
+    client_timeout_s: float
+    server_timeout_s: float
+    restricted: bool = False
+    incomplete: list[dict] = field(default_factory=list)
+
+
+def _incomplete_entry(cls: str, part: str, predicate: str | None, reason: str, attempts: int) -> dict:
+    return {"class": cls, "part": part, "predicate": predicate, "reason": reason, "attempts": attempts}
+
+
+def _incomplete_key(e: dict):
+    return e["class"], PARTS.index(e["part"]), e["predicate"] is not None, e["predicate"] or ""
+
+
+class _Builder:
+    def __init__(self, session: _Session, shapes: Shapes):
+        self.s = session
+        self.shapes = shapes
+        self.incomplete: list[dict] = []
+        self._store_predicates: list[str] | None | bool = None  # None: not asked yet; False: asked, no answer
+
+    # Q0
+    def list_classes(self) -> dict[str, int]:
+        first = self.s.run("classes", None, None, self.shapes.classes, _parse_class_counts)
+        if first.ok:
+            return first.value
+        listed = self.s.run("classes_list", None, None, self.shapes.class_list, _parse_class_list)
+        if not listed.ok:
+            raise BuildAborted(f"the classes could not be listed ({first.reason}; then {listed.reason})", self.s.log)
+        counts = {}
+        for c in sorted(listed.value):
+            try:
+                ref = iri_ref(c)
+            except UnsafeIri:
+                raise BuildAborted("a class IRI cannot be written in a query, so its entities cannot be counted",
+                                   self.s.log) from None
+            got = self.s.run("classes_count", c, None, self.shapes.class_count(ref), _parse_scalar)
+            if not got.ok:
+                raise BuildAborted(f"the entities of a class could not be counted ({got.reason})", self.s.log)
+            counts[c] = got.value
+        return counts
+
+    # Q1 split
+    def store_predicates(self) -> list[str] | None:
+        if self._store_predicates is None:
+            r = self.s.run("predicates", None, None, self.shapes.predicates, _parse_predicate_counts)
+            self._store_predicates = sorted(set(r.value)) if r.ok else False
+        return self._store_predicates or None
+
+    def build_class(self, cls: str, entities: int) -> dict:
+        try:
+            c = iri_ref(cls)
+        except UnsafeIri:
+            for part in PARTS:
+                self.incomplete.append(_incomplete_entry(cls, part, None, "error: unsafe iri", 0))
+            return {"entities": entities, "properties": {}}
+        objects: dict[str, set[str]] = {}
+
+        # Q1
+        known: list[str] = []
+        complete = True
+        r = self.s.run("properties", cls, None, self.shapes.properties(c), _parse_predicates)
+        if r.ok:
+            known = sorted(set(r.value))
+        else:
+            predicates = self.store_predicates()
+            if predicates is None:
+                self.incomplete.append(_incomplete_entry(cls, "properties", None, r.reason, 1))
+                complete = False
+            else:
+                found = []
+                for p in predicates:
+                    try:
+                        pr = iri_ref(p)
+                    except UnsafeIri:
+                        self.incomplete.append(_incomplete_entry(cls, "properties", p, "error: unsafe iri", 1))
+                        complete = False
+                        continue
+                    probe = self.s.run("properties", cls, p, self.shapes.probe(c, pr), _parse_exists)
+                    if not probe.ok:
+                        self.incomplete.append(_incomplete_entry(cls, "properties", p, probe.reason, 2))
+                        complete = False
+                    elif probe.value:
+                        found.append(p)
+                known = sorted(found)
+        for p in known:
+            objects.setdefault(p, set())
+
+        # Q2 and Q3
+        self._two_step(cls, "object_classes", self.shapes.object_classes(c), _parse_pairs,
+                       lambda pr: self.shapes.object_classes_split(c, pr), _parse_objects, known, complete, objects)
+        self._two_step(cls, "datatypes", self.shapes.datatypes(c), _parse_datatype_pairs,
+                       lambda pr: self.shapes.datatypes_split(c, pr), _parse_datatypes, known, complete, objects)
+        return {"entities": entities, "properties": {p: sorted(objects[p]) for p in sorted(objects)}}
+
+    def _two_step(self, cls, part, whole, parse_whole, split_text, parse_split, known, complete, objects) -> None:
+        r = self.s.run(part, cls, None, whole, parse_whole)
+        if r.ok:
+            for p, o in r.value:
+                objects.setdefault(p, set()).add(o)
+            return
+        if not complete:  # the class's predicates are not all known, so the split below cannot cover it
+            self.incomplete.append(_incomplete_entry(cls, part, None, r.reason, 1))
+        for p in known:
+            try:
+                pr = iri_ref(p)
+            except UnsafeIri:
+                self.incomplete.append(_incomplete_entry(cls, part, p, "error: unsafe iri", 1))
+                continue
+            sr = self.s.run(part, cls, p, split_text(pr), parse_split)
+            if sr.ok:
+                objects.setdefault(p, set()).update(sr.value)
+            else:
+                self.incomplete.append(_incomplete_entry(cls, part, p, sr.reason, 2))
+
+
+def build_voidmap(
+    client,
+    *,
+    graph: str,
+    read_stats: Callable[[], dict],
+    expected: str,
+    server_timeout_s: float = DEFAULT_SERVER_TIMEOUT_S,
+    pause_s: float = DEFAULT_PAUSE_S,
+    object_nodes: str = "iri",
+    only_classes: list[str] | None = None,
+    endpoint_key: str | None = None,
+    sleep: Callable[[float], None] = time.sleep,
+    clock: Callable[[], float] = time.monotonic,
+    log: Callable[[str], None] | None = None,
+) -> BuildResult:
+    """The VoID map of the store ``client`` reads, or a BuildFailure (IdentityMismatch, BuildAborted).
+
+    ``client`` has ``query(text)`` returning a QueryResult (``harness.sparql.SparqlClient``, built with
+    ``timeout_s=server_timeout_s`` and no row cap) and ``settings()``. ``expected`` is the identity string, already
+    agreed with EXPECTED_STORES (``resolve_expected_identity``)."""
+    say = log or (lambda _m: None)
+    if not 0 < server_timeout_s <= MAX_SERVER_TIMEOUT_S:
+        raise ValueError(f"the server time-out must be within (0, {MAX_SERVER_TIMEOUT_S:g}] s")
+    if pause_s < 0:
+        raise ValueError("the pause must not be negative")
+    shapes = Shapes(object_nodes)
+    configured = client.settings().get("timeout_s")
+    if isinstance(configured, (int, float)) and float(configured) != float(server_timeout_s):
+        raise BuildAborted(f"the client was built with a time-out of {configured:g} s, not {server_timeout_s:g} s")
+    before = check_identity(read_stats, expected, "before")
+    checked_before = _now()
+    t0 = clock()
+    session = _Session(client, pause_s=pause_s, server_timeout_s=server_timeout_s, sleep=sleep, clock=clock)
+    builder = _Builder(session, shapes)
+    restricted = bool(only_classes)
+    all_classes = builder.list_classes()
+    if not all_classes:
+        raise BuildAborted("the store has no class (no IRI is the rdf:type object of any triple)", session.log)
+    if restricted:
+        missing = sorted(set(only_classes) - set(all_classes))
+        if missing:
+            raise BuildAborted(f"{len(missing)} of the requested classes are not classes of the store", session.log)
+        wanted = sorted(set(only_classes))
+    else:
+        wanted = sorted(all_classes)
+    say(f"classes: {len(wanted)} to build (of {len(all_classes)}) after {len(session.log)} queries")
+    classes = {}
+    for i, cls in enumerate(wanted, 1):
+        classes[cls] = builder.build_class(cls, all_classes[cls])
+        say(f"class {i}/{len(wanted)}: {len(classes[cls]['properties'])} properties, queries {len(session.log)}, "
+            f"incomplete {len(builder.incomplete)}, +{clock() - t0:.0f}s")
+    after_queries = list(session.log)
+    after = check_identity(read_stats, expected, "after", after_queries)
+    if {k: after[k] for k in before} != before:
+        raise IdentityMismatch("store identity after the build differs from the one before it", after_queries)
+    checked_after = _now()
+    incomplete = sorted(builder.incomplete, key=_incomplete_key)
+    voidmap: dict[str, Any] = {
+        "schema": SCHEMA,
+        "graph": graph,
+        "endpoint_key": endpoint_key or ENDPOINT_KEY_PREFIX + graph,
+        "semantics": semantics_text(object_nodes),
+        "store": before,
+        "classes": classes,
+        "incomplete": incomplete,
+    }
+    if restricted:
+        voidmap["restricted_to_classes"] = wanted
+    expected_rec = {"expected_identity": expected}
+    return BuildResult(
+        voidmap=voidmap, queries=after_queries,
+        identity_before={**expected_rec, **before, "checked_at": checked_before},
+        identity_after={**expected_rec, **after, "checked_at": checked_after},
+        elapsed_s=round(clock() - t0, 3), client_timeout_s=server_timeout_s + CLIENT_TIMEOUT_MARGIN_S,
+        server_timeout_s=server_timeout_s, restricted=restricted, incomplete=incomplete)
+
+
+# --- the validator's view -------------------------------------------------------------------------------------------
+
+def as_validator_dict(voidmap: dict, allow_incomplete: bool = False) -> dict[str, dict[str, dict[str, list[str]]]]:
+    """``{endpoint_key: {class: {predicate: [object class or datatype, ...]}}}``: upstream's ``EndpointsSchemaDict``,
+    what ``validate_sparql_with_void(..., endpoints_void_dict=...)`` takes. The query's ``endpoint_url`` must equal
+    ``endpoint_key`` exactly: upstream fetches an unknown endpoint's schema over the network and, when that fails,
+    validates nothing and says nothing. A map with ``incomplete`` entries (or one restricted to some classes) is
+    refused unless ``allow_incomplete``: its absences would read as "the data has no such thing"."""
+    if voidmap.get("schema") != SCHEMA:
+        raise ValueError(f"not a {SCHEMA} document")
+    if "restricted_to_classes" in voidmap:  # never usable, whatever the caller allows (as validator.voidmap_from_bytes)
+        raise ValueError("the map was built for some classes only")
+    if voidmap.get("incomplete") and not allow_incomplete:
+        raise ValueError(f"the map is incomplete ({len(voidmap['incomplete'])} entries); pass allow_incomplete")
+    return {voidmap["endpoint_key"]: {
+        c: {p: list(objs) for p, objs in entry["properties"].items()} for c, entry in voidmap["classes"].items()}}
+
+
+# --- files ------------------------------------------------------------------------------------------------------------
+
+def dump_json(obj: Any) -> str:
+    return json.dumps(obj, sort_keys=True, indent=1, ensure_ascii=False) + "\n"
+
+
+def dump_jsonl(records: list[dict]) -> str:
+    return "".join(json.dumps(r, sort_keys=True, ensure_ascii=False, separators=(",", ":")) + "\n" for r in records)
+
+
+def atomic_write(path: Path, data: bytes) -> None:
+    tmp = path.with_name(f".{path.name}.tmp{os.getpid()}")
+    with open(tmp, "wb") as fh:
+        fh.write(data)
+        fh.flush()
+        os.fsync(fh.fileno())
+    os.replace(tmp, path)
+
+
+NEUTRAL_NAMESPACES = ("http://www.w3.org/", "http://example.org/opaque/")  # W3C vocabularies and the opaque names
+
+
+def load_prefix_table(neutral: bool = False) -> tuple[tuple[str, str], ...]:
+    """The harness's prefix table, imported when needed (the render module pulls in the tokenizer). ``neutral`` keeps
+    only the prefixes of the W3C vocabularies and the opaque graphs' own namespace: the prefix map is used to shorten
+    IRIs in the validator's error lines and to complete a query's missing declarations, so an opaque graph's map must
+    hold no namespace of a natural source (CHEBI, rh, up, ...), which would name the graph the opaque one renames."""
+    from harness.sources.render import PREFIX_TABLE
+
+    if not neutral:
+        return PREFIX_TABLE
+    return tuple((p, ns) for p, ns in PREFIX_TABLE if ns.startswith(NEUTRAL_NAMESPACES))
+
+
+def check_writable(out_dir: Path) -> None:
+    """Make ``out_dir`` and prove a file can be written there, before the first request (OSError otherwise): a
+    build of hours must not find at its end that it cannot save."""
+    out_dir.mkdir(parents=True, exist_ok=True)
+    probe = out_dir / f".write-check{os.getpid()}"
+    probe.write_bytes(b"")
+    probe.unlink()
+
+
+def write_queries_log(out_dir: Path, queries: list[dict]) -> None:
+    """The request log alone, for a build that ended without a map."""
+    out_dir.mkdir(parents=True, exist_ok=True)
+    atomic_write(out_dir / "queries.jsonl", dump_jsonl(queries).encode("utf-8"))
+
+
+def write_outputs(out_dir: Path, result: BuildResult, prefix_table=None) -> dict:
+    """voidmap.json, prefixes.json, queries.jsonl, then manifest.json last, each written atomically. The manifest's
+    digests are of the bytes read back from disk. Returns the manifest."""
+    table = load_prefix_table() if prefix_table is None else prefix_table
+    out_dir.mkdir(parents=True, exist_ok=True)
+    texts = {
+        "voidmap.json": dump_json(result.voidmap),
+        "prefixes.json": dump_json({"schema": PREFIXES_SCHEMA, "source": "harness.sources.render.PREFIX_TABLE",
+                                    "prefixes": [[p, ns] for p, ns in table]}),
+        "queries.jsonl": dump_jsonl(result.queries),
+    }
+    for name, text in texts.items():
+        atomic_write(out_dir / name, text.encode("utf-8"))
+    build = {"queries": len(result.queries), "elapsed_s": result.elapsed_s,
+             "client_timeout_s": result.client_timeout_s, "server_timeout_s": result.server_timeout_s}
+    if result.restricted:
+        build["restricted_to_classes"] = True
+    manifest = {
+        "schema": MANIFEST_SCHEMA,
+        "graph": result.voidmap["graph"],
+        "files": {name: sha256_hex((out_dir / name).read_bytes()) for name in texts},
+        "store_identity_before": result.identity_before,
+        "store_identity_after": result.identity_after,
+        "build": build,
+        "code": {"module": MODULE_PATH, "sha256": sha256_hex(Path(__file__).read_bytes())},
+    }
+    atomic_write(out_dir / "manifest.json", dump_json(manifest).encode("utf-8"))
+    return manifest
