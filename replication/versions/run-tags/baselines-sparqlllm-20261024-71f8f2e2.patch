index 00000000..17c7e703
--- /dev/null
+++ b/scripts/build_sparqlllm_voidmap.py
@@ -0,0 +1,183 @@
+#!/usr/bin/env python3
+"""Build the VoID map SPARQL-LLM validates against from our own store (design log).
+
+    python -I scripts/build_sparqlllm_voidmap.py --endpoint http://HOST:PORT/ --graph uniprot-sp-2026_03 \\
+        --expected-identity 'uniprot-sp-2026_03@<sha256>' --out data/baselines/sparqlllm/uniprot-sp-2026_03 [--confirm]
+
+Without --confirm this is a dry run: it prints the plan (query shapes, pace, the identity it would check) and sends
+no request at all, not even ?cmd=stats. With --confirm it queries the store, one query at a time, and writes into
+--out (which must not already hold any of the four files): voidmap.json, prefixes.json, queries.jsonl and, last,
+manifest.json. See harness/baselines/sparqlllm/void_build.py for the definition of the map and the retry rule.
+
+Exit codes
+    0   the map is complete (or the dry run printed its plan)
+    2   identity: the endpoint's ?cmd=stats name-index is not the expected one (before the first query or after the
+        last), cannot be read, or --expected-identity differs from harness.store_identity.EXPECTED_STORES.
+        Before the first query nothing is sent and no file is written; after the last, no map is written
+    3   the build was aborted (the prefix table cannot be imported, a store-wide query failed, the store rejected a
+        query shape, it stopped answering, an unexpected error): no map is written, queries.jsonl is
+    4   the map has entries in "incomplete" (written, and said so in voidmap.json); 0 with --allow-incomplete
+    64  usage error (also: --out already holds output files, or cannot be written)
+
+The log carries counts, timings and exit codes only; no query result and no IRI of the store is printed or logged.
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+import time
+import traceback
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from harness.baselines.sparqlllm import void_build as vb  # noqa: E402
+
+
+class _Parser(argparse.ArgumentParser):
+    def error(self, message):  # a usage error is exit 64, not 2, which means "wrong store"
+        self.print_usage(sys.stderr)
+        self.exit(vb.EXIT_USAGE, f"{self.prog}: error: {message}\n")
+
+
+def make_parser() -> argparse.ArgumentParser:
+    ap = _Parser(description="Build the SPARQL-LLM VoID map of a store (dry run unless --confirm).")
+    ap.add_argument("--endpoint", required=True, help="the store's SPARQL endpoint (used for requests only; never written)")
+    ap.add_argument("--graph", required=True, help="the store's name, e.g. uniprot-sp-2026_03 (a key of EXPECTED_STORES)")
+    ap.add_argument("--expected-identity", required=True,
+                    help="'<store>@<sha256>' that ?cmd=stats name-index must equal (and EXPECTED_STORES must agree)")
+    ap.add_argument("--out", required=True, type=Path)
+    ap.add_argument("--confirm", action="store_true", help="really query the store (without it: dry run)")
+    ap.add_argument("--allow-incomplete", action="store_true", help="exit 0 although 'incomplete' is not empty")
+    ap.add_argument("--pause-s", type=float, default=vb.DEFAULT_PAUSE_S, help="pause between requests (default 0.5)")
+    ap.add_argument("--server-timeout-s", type=float, default=vb.DEFAULT_SERVER_TIMEOUT_S,
+                    help="QLever time-out per request (default 240, at most 280); the client waits 10 s longer")
+    ap.add_argument("--object-nodes", choices=vb.OBJECT_NODES, default="iri",
+                    help="iri (default): only IRI objects supply object classes; any: blank nodes too")
+    ap.add_argument("--endpoint-key", default=None, metavar="URN",
+                    help="the key the validator knows the endpoint by; it appears in every error line the agent is sent. "
+                         "Default urn:www2027:endpoint:<graph>; for an opaque graph give a neutral one (the graph's name "
+                         "would name the natural graph it renames)")
+    ap.add_argument("--neutral-prefixes", action="store_true",
+                    help="write only the W3C and opaque-graph prefixes into prefixes.json (for an opaque graph: the map "
+                         "shortens IRIs in the error lines the agent is sent, so it must hold no natural namespace)")
+    ap.add_argument("--only-class", action="append", default=[], metavar="IRI",
+                    help="smoke run: build only this class (repeatable); the map then says it is restricted")
+    return ap
+
+
+def plan_lines(args, expected: str, prefixes: int) -> list[str]:
+    shapes = vb.Shapes(args.object_nodes)
+    client_s = args.server_timeout_s + vb.CLIENT_TIMEOUT_MARGIN_S
+    lines = [
+        "DRY RUN: no request will be sent, not even ?cmd=stats. Re-run with --confirm to query the store.",
+        f"graph: {args.graph}   endpoint key: {args.endpoint_key or vb.ENDPOINT_KEY_PREFIX + args.graph}",
+        f"pre-flight: GET <endpoint>?cmd=stats; name-index must equal {expected}",
+        "  (this equals the identity recorded for the graph: harness.store_identity.EXPECTED_STORES, or its committed build record); checked again after the last query;",
+        "  a mismatch ends the build with exit 2 before any further query, and after the last no map is written",
+        f"pace: one thread, one query at a time, {args.pause_s:g} s between requests, QLever time-out "
+        f"{args.server_timeout_s:g} s, client time-out {client_s:g} s",
+        f"object nodes: {args.object_nodes}",
+        "query shapes (<CLASS> and <PREDICATE> stand for IRIs written in the query):",
+    ]
+    for name, text in shapes.templates():
+        lines.append(f"  {name}: {text}")
+    lines += [
+        "retry: a per-class query that times out or fails is repeated once, split by predicate; a (class, predicate)",
+        "  that still fails is recorded in 'incomplete' (exit 4 unless --allow-incomplete); nothing is retried again;",
+        "  a query the store rejects as malformed ends the build (exit 3)",
+        f"smoke: restricted to {len(args.only_class)} class(es)" if args.only_class else "scope: every class of the store",
+        f"outputs in {args.out}: " + ", ".join(vb.OUTPUT_NAMES) + " (manifest.json last; none may exist yet)",
+        f"prefix table: {prefixes} entries imported from harness.sources.render.PREFIX_TABLE",
+    ]
+    return lines
+
+
+def main(argv=None, *, client=None, stats_reader=None, sleep=time.sleep, clock=time.monotonic, out=None) -> int:
+    """``client`` and ``stats_reader`` are for tests; a run builds a SparqlClient and reads ?cmd=stats itself."""
+    stream = out or sys.stdout
+
+    def emit(msg: str) -> None:
+        print(msg, file=stream, flush=True)
+
+    args = make_parser().parse_args(argv)
+    if not 0 < args.server_timeout_s <= vb.MAX_SERVER_TIMEOUT_S:
+        emit(f"usage: --server-timeout-s must be within (0, {vb.MAX_SERVER_TIMEOUT_S:g}] so the client waits at most 290 s")
+        return vb.EXIT_USAGE
+    if args.pause_s < 0:
+        emit("usage: --pause-s must not be negative")
+        return vb.EXIT_USAGE
+    present = [n for n in vb.OUTPUT_NAMES if (args.out / n).exists()]
+    if present:
+        emit(f"usage: {args.out} already holds {', '.join(present)}; give a fresh --out directory")
+        return vb.EXIT_USAGE
+    try:
+        expected = vb.resolve_expected_identity(args.graph, args.expected_identity)
+    except vb.IdentityMismatch as exc:
+        emit(f"refused (exit {exc.exit_code}): {exc}")
+        return exc.exit_code
+    # needed at the end of a build of hours, so shown to work now, before any request
+    try:
+        prefix_table = vb.load_prefix_table(neutral=args.neutral_prefixes)
+    except Exception as exc:
+        emit(f"refused (exit {vb.EXIT_ABORT}): the prefix table cannot be imported ({type(exc).__name__}); "
+             "a build would stop before sending anything")
+        return vb.EXIT_ABORT
+    if not args.confirm:
+        for line in plan_lines(args, expected, len(prefix_table)):
+            emit(line)
+        return vb.EXIT_OK
+    try:
+        vb.check_writable(args.out)
+    except OSError as exc:
+        emit(f"usage: {args.out} cannot be written ({type(exc).__name__}); nothing was sent")
+        return vb.EXIT_USAGE
+
+    read_stats = stats_reader or (lambda: vb.fetch_stats(args.endpoint))
+    if client is None:
+        from harness.sparql import SparqlClient
+
+        client = SparqlClient(args.endpoint, timeout_s=args.server_timeout_s, row_cap=None)
+    t0 = clock()
+
+    def log(msg: str) -> None:
+        emit(f"+{clock() - t0:.0f}s {msg}")
+
+    log(f"building the map of {args.graph}: pause {args.pause_s:g} s, QLever time-out {args.server_timeout_s:g} s")
+    try:
+        result = vb.build_voidmap(
+            client, graph=args.graph, read_stats=read_stats, expected=expected,
+            server_timeout_s=args.server_timeout_s, pause_s=args.pause_s, object_nodes=args.object_nodes,
+            only_classes=args.only_class or None, endpoint_key=args.endpoint_key, sleep=sleep, clock=clock, log=log)
+    except vb.BuildFailure as exc:
+        log(f"ABORTED, no map written: {exc}")
+        if exc.queries:
+            vb.write_queries_log(args.out, exc.queries)
+            log(f"the {len(exc.queries)} requests sent are in {args.out / 'queries.jsonl'}")
+        log(f"exit {exc.exit_code}")
+        return exc.exit_code
+    except Exception as exc:  # a bug: say where, never what the store sent
+        frame = traceback.extract_tb(exc.__traceback__)[-1]
+        log(f"ABORTED, no map written: unexpected {type(exc).__name__} at {Path(frame.filename).name}:{frame.lineno}")
+        log(f"exit {vb.EXIT_ABORT}")
+        return vb.EXIT_ABORT
+
+    manifest = vb.write_outputs(args.out, result, prefix_table)
+    classes = result.voidmap["classes"]
+    log(f"classes {len(classes)}, properties {sum(len(c['properties']) for c in classes.values())}, "
+        f"queries {len(result.queries)}, incomplete {len(result.incomplete)}, elapsed {result.elapsed_s:.0f}s")
+    for name, digest in manifest["files"].items():
+        log(f"{name} sha256 {digest}")
+    if result.restricted:
+        log("RESTRICTED to the requested classes: a smoke run, not the map")
+    if result.incomplete and not args.allow_incomplete:
+        log(f"INCOMPLETE: {len(result.incomplete)} entries in 'incomplete' (see voidmap.json); exit {vb.EXIT_INCOMPLETE}")
+        return vb.EXIT_INCOMPLETE
+    log("exit 0")
+    return vb.EXIT_OK
+
+
+if __name__ == "__main__":
+    sys.exit(main())
