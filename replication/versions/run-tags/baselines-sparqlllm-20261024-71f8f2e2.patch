+"""SPARQL-LLM's metadata-grounded validation of one query (design log, AC3), with its index rebuilt from our store.
+
+What SPARQL-LLM validates (sib-swiss/sparql-llm ``validate_sparql.py``, pinned in upstream/PIN.json): a query's
+triple patterns against a "VoID map", ``class -> predicate -> [object classes and datatypes]``. A subject with an
+``rdf:type`` must be a class of the map and may use only that class's predicates; a variable object of such a
+pattern is checked, only against the FIRST object class the map lists for its parent's (class, predicate); a query that does not parse is
+reported with the parser's message. Upstream reads the map from the VoID description its endpoint publishes;
+here it is rebuilt from our own store (``void_build.py``) and read from ``voidmap.json``. Nothing else of
+SPARQL-LLM is used: not its example-query index (which is where SIB's questions would be), not its retrieval, its
+generation or its entity search.
+
+What this module adds to the vendored code, and why (each one is listed in the baseline's documentation table):
+
+* the query is validated directly (``validate_sparql``), not extracted from a markdown reply, because the agent
+  submits through a tool; upstream's extraction needs a code block with a ``#+ endpoint:`` comment, which only
+  carries the endpoint. The endpoint is a fixed key naming the graph;
+* the errors come back as a Python set that upstream turns into a list, whose order depends on
+  ``PYTHONHASHSEED``; here they are sorted, so the message is the same in every process and a replay can
+  recompute it;
+* the retry message is upstream's own text (``validate_output`` in ``agent/nodes/validation.py``), word for word,
+  with its two placeholders filled the way upstream fills them;
+* the prefix map is the harness's fixed prefix table (the same one that renders ontology prompts), because
+  upstream's comes from SIB's example repository through its endpoint. Prefixes matter only for the compact form
+  of IRIs in the messages and for adding prefix declarations a query lacks.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import re
+import threading
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+from harness.baselines.sparqlllm.loader import blocked_calls, load_upstream, reset_blocked_calls
+
+VALIDATOR_VERSION = "sparqlllm-validator/7"
+
+# validate_output (agent/nodes/validation.py, upstream commit in PIN.json), the message that asks the model to fix
+# a query: the two placeholders are the query as extracted and the errors, one "- " line each. Word for word.
+RETRY_TEMPLATE = (
+    "Fix the SPARQL query helping yourself with the error message and context from previous messages in a way "
+    "that it is a fully valid query.\n\nSPARQL query: {original_query}\n\nError messages:\n{error_str}"
+)
+RETRY_ID = "sparqlllm-retry-v1"
+
+_ONE_AT_A_TIME = threading.Lock()  # rdflib's SPARQL parser keeps process-wide parser state: validate one query at a time
+
+# The kind of each error line, from its text; decided before any score is seen, so that a report can split the flags
+# that are schema errors from those the vendored code raises for reasons of its own (fixed by the Opus review of the cell):
+#   predicate_variable_class  a subject typed with a VARIABLE class (`?x a ?c ; up:p ?o`): upstream looks the predicate up
+#                             in the (empty) predicate list of "the class" ?c and flags every such pattern;
+#   predicate_path            an inverse or negated property path: the vendored path expansion has no case for them and
+#                             checks the path's printed form ("Path(~...)") as if it were a predicate;
+#   predicate_inferred        an untyped variable checked against the FIRST object class the index lists for its parent's
+#                             (class, predicate), the only one upstream tries (both branches of its loop break); which one
+#                             is first is the index's order (sorted by IRI here; the endpoint's, unordered, natively);
+#   predicate                 a predicate that the subject's own class does not have: the published rule proper.
+_KINDS = (
+    ("parse", re.compile(r"^Error parsing the SPARQL query")),
+    ("recursion", re.compile(r"^Recursion limit reached")),
+    ("type_missing", re.compile(r"^Type \S+ for subject .* does not exist\.")),
+    ("predicate_variable_class",
+     re.compile(r"^Subject \S+ with type `\?[^`]*` in endpoint .* does not support the predicate")),
+    ("predicate_inferred", re.compile(r"\(we inferred this variable might be of the type ")),
+    ("predicate_path", re.compile(r"does not support the predicate `Path\(")),
+    ("predicate", re.compile(r"does not support the predicate")),
+)
+
+
+def retry_template_sha256() -> str:
+    return hashlib.sha256(RETRY_TEMPLATE.encode("utf-8")).hexdigest()
+
+
+def retry_message(original_query: str, errors: list[str]) -> str:
+    """Upstream's fix request for a query with ``errors`` (a non-empty list)."""
+    return RETRY_TEMPLATE.format(original_query=original_query, error_str="- " + "\n- ".join(errors))
+
+
+def error_kind(error: str) -> str:
+    for kind, pattern in _KINDS:
+        if pattern.search(error):
+            return kind
+    return "other"
+
+
+@dataclass(frozen=True)
+class VoidMap:
+    """The rebuilt index: what ``voidmap.json`` holds, with the hash of the file it was read from."""
+
+    graph: str
+    endpoint_key: str
+    sha256: str
+    schema: dict[str, dict[str, list[str]]]  # class -> predicate -> [object classes and datatypes]
+    store: dict[str, Any]
+    incomplete: tuple[dict[str, Any], ...]
+    restricted: bool = False
+    # the prefix map the validator runs with: read from the index's own ``prefixes.json`` (so that the file the SIB-absence
+    # proof scans is the file the validator loads), else the harness table; ``prefixes_sha256`` names which
+    prefixes: tuple[tuple[str, str], ...] = ()
+    prefixes_sha256: str = ""
+
+    def validator_dict(self) -> dict[str, dict[str, dict[str, list[str]]]]:
+        return {self.endpoint_key: self.schema}
+
+    def identity(self) -> dict[str, Any]:
+        """What a run record names about the index."""
+        n_predicates = sum(len(p) for p in self.schema.values())
+        return {"graph": self.graph, "sha256": self.sha256, "endpoint_key": self.endpoint_key,
+                "prefixes_sha256": self.prefixes_sha256,
+                "classes": len(self.schema), "class_predicate_pairs": n_predicates,
+                "store_name_index": self.store.get("name_index"), "incomplete": len(self.incomplete)}
+
+
+class IndexUnusable(ValueError):
+    """An index the validator must not run against: a smoke build of some classes only, or one with entries missing."""
+
+
+def read_prefixes(raw: bytes) -> tuple[tuple[str, str], ...]:
+    """The prefix map in a ``sparqlllm-prefixes/1`` file: ``[prefix, namespace]`` pairs, in order."""
+    data = json.loads(raw.decode("utf-8"))
+    if data.get("schema") != "sparqlllm-prefixes/1":
+        raise ValueError(f"not a sparqlllm-prefixes/1 file (schema {data.get('schema')!r})")
+    pairs = tuple((str(p), str(ns)) for p, ns in data["prefixes"])
+    if not pairs or len({p for p, _ in pairs}) != len(pairs):
+        raise ValueError("a prefix map needs at least one prefix, each once")
+    return pairs
+
+
+def voidmap_from_bytes(raw: bytes, *, prefixes_raw: bytes | None = None, allow_incomplete: bool = False) -> VoidMap:
+    """The index in ``raw``. A build restricted to some classes (``--only-class``) is refused always: a class it omits
+    would be reported as missing from the graph. An index with ``incomplete`` entries (queries that timed out or
+    failed) lacks predicates the graph has, so it would flag correct queries; it is refused unless the caller says it
+    knows (``allow_incomplete``; the cell then records the count in its settings)."""
+    data = json.loads(raw.decode("utf-8"))
+    if data.get("schema") != "sparqlllm-voidmap/1":
+        raise ValueError(f"not a sparqlllm-voidmap/1 file (schema {data.get('schema')!r})")
+    if data.get("restricted_to_classes"):
+        raise IndexUnusable("the index was built for some classes only (a smoke build)")
+    if data.get("incomplete") and not allow_incomplete:
+        raise IndexUnusable(f"the index is incomplete ({len(data['incomplete'])} entries missing)")
+    classes = data["classes"]
+    schema = {c: {p: list(objs) for p, objs in body["properties"].items()} for c, body in classes.items()}
+    if prefixes_raw is not None:
+        prefixes, prefixes_sha = read_prefixes(prefixes_raw), hashlib.sha256(prefixes_raw).hexdigest()
+    else:  # a fixture or a caller with no file: the harness's own table, named by its hash
+        prefixes, prefixes_sha = tuple(prefix_table()), "harness-table:" + prefix_table_sha256()
+    return VoidMap(graph=data["graph"], endpoint_key=data["endpoint_key"], sha256=hashlib.sha256(raw).hexdigest(),
+                   schema=schema, store=dict(data.get("store") or {}), incomplete=tuple(data.get("incomplete") or ()),
+                   prefixes=prefixes, prefixes_sha256=prefixes_sha)
+
+
+def load_voidmap(path: str | Path, expected_sha256: str | None = None, *, allow_incomplete: bool = False) -> VoidMap:
+    """The index in ``path`` with the ``prefixes.json`` beside it (the builder writes both; the SIB-absence proof scans both);
+    ``expected_sha256`` (a spec's pin) must match the voidmap file's bytes."""
+    raw = Path(path).read_bytes()
+    got = hashlib.sha256(raw).hexdigest()
+    if expected_sha256 is not None and got != expected_sha256:
+        raise ValueError(f"{path}: sha256 {got}, expected {expected_sha256}")
+    prefixes_path = Path(path).with_name("prefixes.json")
+    return voidmap_from_bytes(raw, prefixes_raw=prefixes_path.read_bytes(), allow_incomplete=allow_incomplete)
+
+
+def prefix_table() -> list[tuple[str, str]]:
+    """The harness's fixed prefix table, in its order (harness.sources.render.PREFIX_TABLE)."""
+    from harness.sources.render import PREFIX_TABLE
+
+    return [(p, ns) for p, ns in PREFIX_TABLE]
+
+
+def prefix_table_sha256() -> str:
+    text = json.dumps(prefix_table(), separators=(",", ":"), ensure_ascii=False)
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def library_versions() -> dict[str, str]:
+    import importlib.metadata as md
+
+    import sys
+
+    return {**{name: md.version(name) for name in ("rdflib", "curies", "pyparsing")},
+            "python": f"{sys.version_info.major}.{sys.version_info.minor}"}
+
+
+class _Warnings(logging.Handler):
+    """Collects what the vendored code logs at WARNING: it logs, instead of reporting, the failures it swallows."""
+
+    def __init__(self) -> None:
+        super().__init__(level=logging.WARNING)
+        self.messages: list[str] = []
+
+    def emit(self, record: logging.LogRecord) -> None:
+        self.messages.append(record.getMessage())
+
+
+_SWALLOWED = "Error validating triples for subject"  # validate_sparql_with_void: an exception while checking a subject
+
+
+_INVERSE_PATH = re.compile(r"^Path\(~(\S+)\)$")
+
+
+def outside_index(up: Any, query: str, endpoint_key: str, voidmap: "VoidMap") -> dict[str, list[str]] | None:
+    """Descriptive, never a verdict: what the query's triple patterns use that the index does not know at all, whether
+    or not the vendored rules looked at it.
+
+    ``predicates``  every predicate (not a variable, not ``rdf:type``) that no class of the index has;
+    ``untyped_predicates``  those among them used on a subject that has no ``rdf:type`` pattern: the case upstream's
+                    commented-out rule covers (in ``validate_sparql_with_void``, "If no type and no parent type we just
+                    check if the predicates used can be found in the VoID description"; reached for a subject with no
+                    direct type, at the top-level visit of every subject). A predicate on a typed subject is a published
+                    rule's business: reported there when its class is a class, and not checked by either rule when the
+                    class is a variable;
+    ``classes``     the classes of ``rdf:type`` patterns that the index lacks.
+
+    The rule upstream disabled would flag a variable predicate too (it is not in any class); that is a defect of the
+    stale code, not a reading we adopt, so variables are skipped here. An inverse path (`^up:p`) counts as its IRI; any
+    other path the vendored expansion leaves whole (a negated path) is skipped. Triples inside a FILTER EXISTS /
+    NOT EXISTS sub-pattern are not in the dict the vendored code builds for the endpoint, so they are not seen here
+    either (``unchecked_scopes`` says so). None when the query does not parse."""
+    try:
+        query_dict = up.validate_sparql.sparql_query_to_dict(query, endpoint_key)
+    except Exception:  # noqa: BLE001
+        return None
+    known_predicates = {p for preds in voidmap.schema.values() for p in preds}
+    predicates: set[str] = set()
+    untyped: set[str] = set()
+    classes: set[str] = set()
+    for preds in query_dict.get(endpoint_key, {}).values():
+        typed = RDF_TYPE in preds
+        for p, objs in preds.items():
+            p = str(p)
+            if p.startswith("?"):
+                continue
+            if p.startswith("Path("):  # a path the vendored expansion left whole: an inverse path is its IRI, the rest is skipped
+                inverse = _INVERSE_PATH.match(p)
+                if inverse is None:
+                    continue
+                p = inverse.group(1)
+            if p == RDF_TYPE:
+                classes.update(str(o) for o in objs if not str(o).startswith("?"))
+            elif p not in known_predicates:
+                predicates.add(p)
+                if not typed:
+                    untyped.add(p)
+    return {"predicates": sorted(predicates), "untyped_predicates": sorted(untyped),
+            "classes": sorted(c for c in classes if c not in voidmap.schema)}
+
+
+def adapted_validation(up: Any, query: str, endpoint_key: str, voidmap: "VoidMap") -> dict[str, Any] | None:
+    """The adapted row's reading of ``query`` (adapted.adapted_check: upstream's disabled rule enabled, inference
+    accepting any listed object class); a query that does not parse is flagged as upstream flags it. None when the index
+    has no class (nothing to read against)."""
+    from harness.baselines.sparqlllm import adapted
+
+    if not voidmap.schema:
+        return None
+    try:
+        query_dict = up.validate_sparql.sparql_query_to_dict(query, endpoint_key)
+    except Exception:  # noqa: BLE001  (upstream reports the same failure as its parse error)
+        return {"flagged": True, "kinds": {"parse": 1}, "budget_exceeded": False}
+    return adapted.adapted_check(query_dict.get(endpoint_key, {}), voidmap.schema)
+
+
+def coverage(up: Any, query: str, endpoint_key: str) -> dict[str, int] | None:
+    """What the typed-subject rules of the vendored validator had in front of them: the number of subjects of the
+    query's triple patterns, those with an ``rdf:type`` (``typed``), those among them that have a class (not a
+    variable) and at least one other predicate (``typed_examined``: the only subjects whose class and predicates
+    upstream checks directly) and the rest (``untyped``, checked only by inference from a typed parent). None when
+    the query does not parse (upstream reports that as an error)."""
+    try:
+        query_dict = up.validate_sparql.sparql_query_to_dict(query, endpoint_key)
+    except Exception:  # noqa: BLE001  (a parse failure is already an error of the validation)
+        return None
+    subjects = query_dict.get(endpoint_key, {})
+    typed = examined = multi = 0
+    for preds in subjects.values():
+        types = preds.get(RDF_TYPE, [])
+        if not types:
+            continue
+        typed += 1
+        if len({str(t) for t in types if not str(t).startswith("?")}) > 1:
+            multi += 1  # one variable typed with two classes: a UNION or subquery merged by name, or a multi-typed subject
+        if any(not str(t).startswith("?") for t in types) and any(p != RDF_TYPE for p in preds):
+            examined += 1
+    return {"subjects": len(subjects), "typed": typed, "typed_examined": examined, "untyped": len(subjects) - typed,
+            "multi_typed": multi}
+
+
+RDF_TYPE = "http://www.w3.org/1999/02/22-rdf-syntax-ns#type"
+
+
+# The most schema lookups one validation may make. The vendored checker follows every variable object of a typed
+# subject recursively with no visited set (bounded only by a depth of 500), so a query whose variables point at each
+# other twice over (`?a p ?b, ?c . ?b p ?a, ?c . ?c p ?a, ?b`) makes it do exponentially many; it was seen not to return
+# at all, with every other check of the process waiting behind it. Each step of that recursion looks something up in the
+# schema dict, which the wrapper hands it as a counting dict: past this many lookups every lookup raises, the vendored
+# code logs and drops the exception as it does any (counted in ``swallowed``) and unwinds at once. A normal query makes
+# some tens of lookups; the dev sample's largest made under a thousand. The verdict of such a query is ``unknown``.
+VALIDATION_BUDGET = 50_000
+
+
+class BudgetExceeded(Exception):
+    """The validation used up its lookups (see VALIDATION_BUDGET)."""
+
+
+class _Budget:
+    def __init__(self, left: int):
+        self.left = left
+        self.exceeded = False
+        self.used = 0
+
+
+class _CountingSchema(dict):
+    """A class -> predicate dict that counts its lookups against a shared budget and refuses once it is spent."""
+
+    def __init__(self, data: dict, budget: _Budget):
+        super().__init__(data)
+        self._budget = budget
+
+    def _spend(self) -> None:
+        b = self._budget
+        b.used += 1
+        if b.left <= 0:
+            b.exceeded = True
+            raise BudgetExceeded("the validation used up its schema lookups")
+        b.left -= 1
+
+    def get(self, key, default=None):
+        self._spend()
+        return super().get(key, default)
+
+    def __contains__(self, key):
+        self._spend()
+        return super().__contains__(key)
+
+    def __getitem__(self, key):
+        self._spend()
+        return super().__getitem__(key)
+
+    def keys(self):
+        self._spend()
+        return super().keys()
+
+
+def unchecked_scope(endpoint: str) -> str:
+    """The name of a part of a query that the validator had no index for: the endpoint of a SERVICE block, or, when the
+    vendored code takes a FILTER EXISTS / NOT EXISTS sub-pattern for a SERVICE block (it answers ``hasattr(node,
+    "term")`` for any algebra node), the string "None", reported as ``exists_subpattern``."""
+    return "exists_subpattern" if endpoint == "None" else endpoint
+
+
+def validate_query(query: str, voidmap: VoidMap) -> dict[str, Any]:
+    """Upstream's ``validate_sparql`` on ``query`` against ``voidmap``: a JSON-able result
+
+    ``original_query`` the query as validated (stripped, as upstream strips an extracted block);
+    ``errors`` the messages, sorted; ``kinds`` the count of each kind; ``prefix_fixed`` whether upstream added
+    missing prefix declarations (it does so silently and does not ask for a retry); ``unchecked_scopes`` the parts of
+    the query the validator had no index for and did not look at: a SERVICE block (its endpoint) or a FILTER EXISTS /
+    NOT EXISTS sub-pattern (``exists_subpattern``); ``swallowed`` the number of exceptions the vendored code caught and
+    logged instead of reporting (a subject it failed to check) and ``warnings`` the first 200 characters of each
+    warning it logged; ``budget_exceeded`` whether the validation hit VALIDATION_BUDGET; ``coverage`` (see
+    ``coverage``), ``outside_index`` (see ``outside_index``; descriptive only) and ``adapted`` (the adapted row's
+    reading, adapted.py; detection only). A pass is only as good as these: the
+    cell reads them into its verdict.
+    """
+    up = load_upstream()
+    text = query.strip()
+    handler = _Warnings()
+    budget = _Budget(VALIDATION_BUDGET)
+    logger = logging.getLogger("sparql_llm")
+    with _ONE_AT_A_TIME:
+        reset_blocked_calls()
+        logger.addHandler(handler)
+        try:
+            out = up.validate_sparql.validate_sparql(
+                text, voidmap.endpoint_key, dict(voidmap.prefixes),
+                {voidmap.endpoint_key: _CountingSchema(voidmap.schema, budget)})
+            cov = coverage(up, out["fixed_query"] or text, voidmap.endpoint_key)
+            outside = outside_index(up, out["fixed_query"] or text, voidmap.endpoint_key, voidmap)
+            adapted_row = adapted_validation(up, out["fixed_query"] or text, voidmap.endpoint_key, voidmap)
+        finally:
+            logger.removeHandler(handler)
+        unchecked = sorted({unchecked_scope(c["endpoint"]) for c in blocked_calls()})
+    errors = sorted(out["errors"])
+    kinds: dict[str, int] = {}
+    for e in errors:
+        k = error_kind(e)
+        kinds[k] = kinds.get(k, 0) + 1
+    return {"original_query": out["original_query"], "errors": errors, "kinds": dict(sorted(kinds.items())),
+            "prefix_fixed": out["fixed_query"] is not None and out["fixed_query"] != text,
+            "unchecked_scopes": unchecked, "swallowed": sum(m.startswith(_SWALLOWED) for m in handler.messages),
+            "warnings": [m[:200] for m in handler.messages], "budget_exceeded": budget.exceeded,
+            "coverage": cov, "outside_index": outside,
+            "adapted": adapted_row}
diff --git a/harness/baselines/sparqlllm/void_build.py b/harness/baselines/sparqlllm/void_build.py
