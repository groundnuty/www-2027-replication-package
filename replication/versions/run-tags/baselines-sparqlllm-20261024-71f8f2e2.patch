+                                           route_model=route_model))
+        except DetectionError as exc:
+            raise Refused(f"{model_name}: {exc}") from None
+    unused = sorted(set(given) - {m for m, ids in manifest["model_cells"].items() if any(c in cells for c in ids)})
+    if unused:
+        raise Refused(f"--baseline-judge-dir for {', '.join(unused)}: no judge cell of the manifest runs for them")
+    out: list[tuple[str, str]] = []
