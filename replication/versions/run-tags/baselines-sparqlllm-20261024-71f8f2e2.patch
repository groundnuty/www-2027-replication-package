@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Write the agent-visible view of a SPARQL-LLM index (harness/baselines/sparqlllm/agent_view.py) for the leak check.
+
+    python -I scripts/sparqlllm_agent_view.py --voidmap data/baselines/sparqlllm/<graph>/voidmap.json \\
+        --voidmap-sha256 SHA --prefixes-sha256 SHA --out VIEW.json
+
+Writes VIEW.json (mode 600, new): the endpoint key, the prefix map, the index's terms and the corpus of rendered messages.
+Prints only the counts. Exit 0 done; 2 refused (a pin differs, --out exists).
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+
+from harness.baselines.sparqlllm import agent_view, validator  # noqa: E402
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("--voidmap", type=Path, required=True)
+    ap.add_argument("--voidmap-sha256", required=True)
+    ap.add_argument("--prefixes-sha256", required=True)
+    ap.add_argument("--out", type=Path, required=True)
+    args = ap.parse_args(argv)
+    if args.out.exists():
+        print("refused: --out exists", file=sys.stderr)
+        return 2
+    prefixes = args.voidmap.with_name("prefixes.json")
+    try:
+        got = hashlib.sha256(prefixes.read_bytes()).hexdigest()
+        if got != args.prefixes_sha256:
+            print(f"refused: prefixes.json sha256 {got} is not the pinned {args.prefixes_sha256}", file=sys.stderr)
+            return 2
+        vm = validator.load_voidmap(args.voidmap, args.voidmap_sha256)
+    except (OSError, ValueError) as exc:
+        print(f"refused: {type(exc).__name__}: {exc}", file=sys.stderr)
+        return 2
+    view = agent_view.agent_view(vm)
+    fd = os.open(args.out, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    with os.fdopen(fd, "w", encoding="utf-8") as fh:
+        json.dump(view, fh, sort_keys=True, indent=1)
+        fh.write("\n")
+    print(f"wrote the view: {len(view['terms'])} terms, {len(view['prefixes'])} prefixes, "
+          f"{len(view['rendered_messages'])} rendered messages")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/sparqlllm_replay.py b/scripts/sparqlllm_replay.py
new file mode 100644
index 00000000..e7c648c2
--- /dev/null
+++ b/scripts/sparqlllm_replay.py
@@ -0,0 +1,197 @@
+#!/usr/bin/env python3
+"""SPARQL-LLM's validator and its adapted row as offline replay arms (design log, AC3), with no model, no store and no network.
+
+    python -I scripts/sparqlllm_replay.py --records OUT [OUT ...] --voidmap data/baselines/sparqlllm/<graph>/voidmap.json \\
+        --voidmap-sha256 SHA --split test --out DIR
+
+Reads the natural (cohort ``none``) initial outputs of the given run directories the way scripts/checker_replay.py reads them
+(``load_attempts``: a dev grid's initial cells' records, its branch records left out, a plain run's records) and, for each output
+with a checked query (rule 22), makes the decision of harness/baselines/sparqlllm/cell.py on it. Writes under DIR (new, mode 700):
+
+  matrix.jsonl.gz    one row per (output, arm), in the replay matrix's own row format, for two arms:
+                     ``sparqlllm`` (the published validator: its flags, the cell's four-way status) and
+                     ``sparqlllm-adapted`` ("SPARQL-LLM validator, our adaptation": upstream's disabled rule enabled and
+                     inference accepting any listed object class; detection only). Give it to scripts/export_checker_ledger.py
+                     --matrix (unchanged) to reach the analysis' checker ledger beside the other sources.
+  reach.json         mode 600: per model, the status counts, the share the published validator cannot examine, its flags by
+                     kind, the validations cut at the lookup budget, the outputs with an unchecked scope and the side-by-side
+                     counts of the two rows (harness/baselines/sparqlllm/second_arm.py). Never printed.
+  meta.json          the inputs' identity: the index and prefix map hashes, the vendored validator's hashes, the code hashes,
+                     the counts of records read.
+
+Every record must be bound to the index's store (its store identity is the identity the index was built under), or the run is
+refused. The frozen replay of the other arms is not touched: this script adds arms in a matrix of its own. It prints counts of
+records and rows only, never a flag, a kind or a status, whatever the split.
+
+Exit status: 0 done; 2 refused (an input is missing, the DIR exists, a record is not bound to the index's store, a record of
+another split); 3 a validator exception on some record (nothing is written).
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+
+from harness.baselines.sparqlllm import cell, second_arm, validator  # noqa: E402
+from harness.baselines.sparqlllm.loader import load_upstream  # noqa: E402
+from harness.checkloop.checked import checked_result_rows, rules_of, submissions  # noqa: E402
+from harness.checkloop.grid import GridError  # noqa: E402
+from harness.checkloop.matrix import MATRIX_VERSION, initial_of, load_attempts, write_jsonl_gz  # noqa: E402
+
+ARM_PUBLISHED = "sparqlllm"
+ARM_ADAPTED = "sparqlllm-adapted"
+CHECK_PUBLISHED = "sparqlllm.published"
+CHECK_ADAPTED = "sparqlllm.adapted"
+NATURAL = "none"
+
+
+def base_row(rec: dict, cohort: str) -> dict:
+    """The fields every replay-matrix row of an output starts with (harness/checkloop/matrix.check_record)."""
+    outcome, final_rows, score = initial_of(rec)
+    out = outcome["status"] == "submitted"
+    return {"run_id": rec["run_id"], "graph": (rec.get("store") or {}).get("name"), "question_id": rec["question_id"],
+            "base_question_id": rec.get("base_question_id"), "template": rec.get("template"), "split": rec.get("split"),
+            "model": rec["model"], "cohort": cohort, "repetition": rec.get("repetition"), "label": outcome.get("label"),
+            "output": out, "correct": (score or {}).get("exact") if out else None}
+
+
+def arm_row(base: dict, arm: str, check_id: str, status: str, any_unknown: bool, checked_query: str | None,
+            checked_status: str | None, reason: str | None, kinds: dict, result_rows: int | None,
+            tooling: list[str], detail: dict) -> dict:
+    flagged = status == "flagged"
+    fired = ([{"check_id": check_id, "reason": "validator_error", "key": ",".join(sorted(kinds)) or "-", "source": arm,
+               "branch_local": False, "data_fault": False}] if flagged else [])
+    return {"version": MATRIX_VERSION, **base, "result_rows": result_rows, "arm": arm, "variant": "primary",
+            "status": status, "any_unknown": any_unknown, "retry": flagged, "traceability": "not_applicable",
+            "per_source": {arm: status}, "fired_checks": fired, "fired": [], "reason": reason,
+            "checked_query_status": checked_status, "checked_query": checked_query, "negation": False,
+            "unsupported": [], "tooling_limits": tooling, "budget_used": 0, "graph_outside_census": 0,
+            "sparqlllm": detail}
+
+
+def rows_of(rec: dict, cohort: str, vm: validator.VoidMap) -> tuple[list[dict], dict | None]:
+    """The two arms' matrix rows of one record, and the reach row (None when it has no output)."""
+    base = base_row(rec, cohort)
+    cell.check_binding(vm, rec["store"])  # every record of the run, an attempt with no output included
+    if not base["output"]:
+        return [{"version": MATRIX_VERSION, **base, "arm": a, "variant": "primary", "status": None,
+                 "checked_query_status": None} for a in (ARM_PUBLISHED, ARM_ADAPTED)], None
+    outcome, final_rows, score = initial_of(rec)
+    upto = (rec.get("checker") or {}).get("initial", {}).get("submission_index")
+    if upto is None:
+        upto = submissions(rec["tool_calls"])[-1]
+    rules = rules_of(score)
+    call, status, validation, verdict = cell.decide(rec["tool_calls"], final_rows, rules, upto, vm)
+    n = checked_result_rows(rec["tool_calls"], final_rows, rules, upto=upto)
+    flags = second_arm.second_flag(validation, verdict)
+    query = call["arguments"]["query"] if call is not None else None
+    if verdict["status"] == "no_query":
+        p_status, p_reason, p_unknown = "unknown", "no_query", True
+    else:
+        p_status, p_reason, p_unknown = verdict["status"], None, verdict["any_unknown"]
+    # the adapted row: its own flag; else what the published validator said (a pass it still stands behind, an unknown, a
+    # no_query); a published flag the row drops is a pass of the row. substantive: it looked at some subject's predicates.
+    if p_reason == "no_query":
+        a_status, a_unknown = "unknown", True
+    elif flags["adapted"]:
+        a_status, a_unknown = "flagged", p_unknown
+    elif verdict["status"] == "unknown":
+        a_status, a_unknown = "unknown", True
+    else:
+        looked = bool(validation and validation["coverage"] and validation["coverage"]["subjects"] > 0)
+        a_status, a_unknown = ("substantive_pass" if looked else "vacuous_pass"), p_unknown
+    adapted = (validation or {}).get("adapted") or {"kinds": {}}
+    cut = bool(validation and validation["budget_exceeded"])
+    unchecked = list((validation or {}).get("unchecked_scopes") or [])
+    # the fields science asked to keep beside each report: the flag kinds, the cut at the lookup budget, the unchecked scopes
+    tooling = (["validation_cut"] if cut else []) + (["unchecked_scope"] if unchecked else [])
+    detail = {"kinds": verdict["kinds"], "validation_cut": cut, "unchecked_scopes": unchecked,
+              "adapted_kinds": adapted["kinds"], "message_chars": verdict.get("message_chars"),
+              "coverage": (validation or {}).get("coverage")}
+    rows = [arm_row(base, ARM_PUBLISHED, CHECK_PUBLISHED, p_status, p_unknown, query, status, p_reason,
+                    verdict["kinds"], n, tooling, detail),
+            arm_row(base, ARM_ADAPTED, CHECK_ADAPTED, a_status, a_unknown, query, status, p_reason,
+                    adapted["kinds"] if a_status == "flagged" else {}, n, tooling, detail)]
+    reach = {"model": rec["model"], "status": verdict["status"], "kinds": verdict["kinds"],
+             "budget_exceeded": bool(validation and validation["budget_exceeded"]),
+             "unchecked": bool(validation and validation["unchecked_scopes"]), **flags}
+    return rows, reach
+
+
+def sha256_file(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("--records", type=Path, nargs="+", required=True)
+    ap.add_argument("--voidmap", type=Path, required=True)
+    ap.add_argument("--voidmap-sha256")
+    ap.add_argument("--split", required=True, choices=("dev", "test"))
+    ap.add_argument("--cohort", default=NATURAL)
+    ap.add_argument("--out", type=Path, required=True)
+    args = ap.parse_args(argv)
+    if args.out.exists():
+        print("refused: --out exists", file=sys.stderr)
+        return 2
+    try:
+        vm = validator.load_voidmap(args.voidmap, args.voidmap_sha256)
+        attempts, cohorts = load_attempts(args.records)
+    except (OSError, ValueError, GridError) as exc:
+        print(f"refused: {type(exc).__name__}: {exc}", file=sys.stderr)
+        return 2
+    chosen = [r for r in attempts if cohorts.get(r["run_id"], r.get("condition")) == args.cohort]
+    other = [r["run_id"] for r in chosen if r.get("split") != args.split]
+    if other:
+        print(f"refused: {len(other)} records are not of split {args.split!r}", file=sys.stderr)
+        return 2
+    rows: list[dict] = []
+    reach_rows: list[dict] = []
+    failures = 0
+    for rec in sorted(chosen, key=lambda r: r["run_id"]):
+        try:
+            r, reach = rows_of(rec, args.cohort, vm)
+        except cell.IndexMismatch as exc:
+            print(f"refused: record {rec['run_id']}: {exc}", file=sys.stderr)
+            return 2
+        except Exception as exc:  # noqa: BLE001  (counted; nothing is written)
+            failures += 1
+            print(f"exception {type(exc).__name__} on record {rec['run_id']}", file=sys.stderr)
+            continue
+        rows += r
+        if reach is not None:
+            reach_rows.append(reach)
+    if failures:
+        print(f"{failures} validator exceptions: nothing written", file=sys.stderr)
+        return 3
+    args.out.mkdir(parents=True, mode=0o700)
+    write_jsonl_gz(args.out / "matrix.jsonl.gz", rows)
+    fd = os.open(args.out / "reach.json", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    with os.fdopen(fd, "w", encoding="utf-8") as fh:
+        json.dump({"schema": "sparqlllm-reach/2", "adapted_row": second_arm.SECOND_ARM_LABEL,
+                   "adapted_row_is": second_arm.SECOND_ARM_NOTE,
+                   "models": second_arm.reach(reach_rows, sorted({r["model"] for r in chosen}))}, fh, sort_keys=True,
+                  indent=1)
+        fh.write("\n")
+    up = load_upstream()
+    meta = {"schema": "sparqlllm-replay/1", "split": args.split, "cohort": args.cohort,
+            "records_read": len(attempts), "records_of_cohort": len(chosen), "matrix_rows": len(rows),
+            "index": vm.identity(), "validator": validator.VALIDATOR_VERSION, "cell": cell.CELL_VERSION,
+            "upstream": {"commit": up.pin["commit"], "files": up.hashes}, "libraries": validator.library_versions(),
+            "code": {name: sha256_file(Path(__file__).resolve().parent.parent / name) for name in (
+                "scripts/sparqlllm_replay.py", "harness/baselines/sparqlllm/cell.py",
+                "harness/baselines/sparqlllm/validator.py", "harness/baselines/sparqlllm/adapted.py",
+                "harness/baselines/sparqlllm/second_arm.py")}}
+    (args.out / "meta.json").write_text(json.dumps(meta, sort_keys=True, indent=1) + "\n", encoding="utf-8")
+    print(f"wrote {len(rows)} matrix rows for {len(chosen)} {args.cohort} records to {args.out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/sparqlllm_scan.py b/scripts/sparqlllm_scan.py
new file mode 100644
index 00000000..cd077f9f
--- /dev/null
+++ b/scripts/sparqlllm_scan.py
@@ -0,0 +1,188 @@
+#!/usr/bin/env python3
+"""Run SPARQL-LLM's validator over recorded natural outputs, offline (design log, AC3). No model, store or network.
+
+    python3 -I scripts/sparqlllm_scan.py --records RUN/uniprot/records --voidmap data/baselines/sparqlllm/G/voidmap.json \\
+        --model claude-sonnet-5-5 --limit 20 --seed 20261024 --out DECISIONS.jsonl
+
+For each selected record (a natural-cohort attempt that submitted an answer, ordered by the sha256 of
+'<seed>|<run id>' and cut at ``--limit``) it makes the decision the cell would make on the rule-22 checked query
+(harness.baselines.sparqlllm.cell.decide) and writes one JSON line per record to ``--out`` (mode 0600, created
+new): run id, model, split, the verdict, the errors' kinds, the SERVICE endpoints it could not check, the
+validation's wall time. It never reads or writes a score, an exact-match label or a gold row.
+
+What it prints depends on the records' split:
+
+* every record dev (the dev pilot, malfunctions only): counts of records seen, selected and checked, of
+  validator exceptions, of flags by error kind, of refused lookups, and the validation times;
+* any test record among the selected (blinding, entry 191): counts of records seen, selected and checked and of
+  exceptions only; no flag count or kind is printed, whatever the flags (they are in ``--out`` and belong in the
+  owner's private directory).
+
+Exit status: 0 done; 2 refused (an input is missing, ``--out`` exists, an unreadable record file is not
+skipped silently: it is counted and named by file name only, and fails the run with 3 when any exists);
+3 some record file could not be read or the validator raised.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import statistics
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+
+from harness.baselines.sparqlllm import cell, second_arm, validator  # noqa: E402
+from harness.checkloop.checked import rules_of, submissions  # noqa: E402
+from harness.checkloop.matrix import initial_of  # noqa: E402
+
+
+def order_key(seed: int, run_id: str) -> str:
+    return hashlib.sha256(f"{seed}|{run_id}".encode()).hexdigest()
+
+
+def selected_files(dirs: list[Path], model: str | None, cohort: str,
+                   retried: bool = False) -> tuple[list[tuple[str, Path]], int]:
+    """(run id, path) of every record file that is a natural attempt of ``model`` (or, with ``retried``, a SPARQL-LLM
+    cell's record that has a retry)."""
+    out, unreadable = [], 0
+    for d in dirs:
+        for path in sorted(d.glob("*.json")):
+            try:
+                rec = json.loads(path.read_text(encoding="utf-8"))
+            except (OSError, ValueError):
+                unreadable += 1
+                continue
+            if not isinstance(rec, dict) or "run_id" not in rec:
+                continue
+            if model is not None and rec.get("model") != model:
+                continue
+            if rec.get("condition") != cohort:
+                continue
+            chk = rec.get("checker")
+            if retried:
+                if chk is None or chk["settings"].get("mode") != cell.MODE or chk.get("retry") is None:
+                    continue
+            elif chk is not None:  # a branch record: not a natural output
+                continue
+            out.append((rec["run_id"], path))
+    return out, unreadable
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--records", nargs="+", required=True, type=Path)
+    ap.add_argument("--voidmap", required=True, type=Path)
+    ap.add_argument("--voidmap-sha256")
+    ap.add_argument("--model")
+    ap.add_argument("--cohort", default="none")
+    ap.add_argument("--retried", action="store_true",
+                    help="validate the retried outputs of SPARQL-LLM cell records (the native second round), "
+                         "instead of natural outputs")
+    ap.add_argument("--limit", type=int)
+    ap.add_argument("--seed", type=int, default=20261024)
+    ap.add_argument("--out", required=True, type=Path)
+    ap.add_argument("--summary-out", type=Path,
+                    help="a new mode-0600 JSON file: per model, the primary validator's status counts, the share it could "
+                         "not examine (vacuous passes) and the flag counts of the primary and the second arm "
+                         "(harness/baselines/sparqlllm/second_arm.py); never printed")
+    args = ap.parse_args(argv)
+    if args.retried and args.summary_out is not None:
+        ap.error("--summary-out reads initial outputs (the second arm and the reach are about them), not --retried")
+    for d in args.records:
+        if not d.is_dir():
+            print(f"refused: {d} is not a directory", file=sys.stderr)
+            return 2
+    if args.out.exists() or (args.summary_out is not None and args.summary_out.exists()):
+        print("refused: --out or --summary-out exists", file=sys.stderr)
+        return 2
+    try:
+        vm = validator.load_voidmap(args.voidmap, args.voidmap_sha256)
+    except (OSError, ValueError) as exc:
+        print(f"refused: {exc}", file=sys.stderr)
+        return 2
+    files, unreadable = selected_files(args.records, args.model, args.cohort, args.retried)
+    files.sort(key=lambda t: order_key(args.seed, t[0]))
+    if args.limit is not None:
+        files = files[: args.limit]
+    fd = os.open(args.out, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    seen = checked = exceptions = skipped = 0
+    splits: set[str | None] = set()
+    kinds: dict[str, int] = {}
+    statuses: dict[str, int] = {}
+    flagged = refused = budget_hits = 0
+    arm_rows: list[dict] = []
+    seen_models: set = set()
+    times: list[float] = []
+    with os.fdopen(fd, "w", encoding="utf-8") as out:
+        for run_id, path in files:
+            seen += 1
+            rec = json.loads(path.read_text(encoding="utf-8"))
+            splits.add(rec.get("split"))
+            seen_models.add(rec.get("model"))
+            try:
+                cell.check_binding(vm, rec["store"])
+                t0 = time.perf_counter()
+                if args.retried:
+                    second = cell.validate_retried(rec, vm)
+                    if second is None:
+                        skipped += 1
+                        continue
+                    status, validation, verdict = second["checked_query_status"], second["validation"], second["verdict"]
+                else:
+                    outcome, final_rows, score = initial_of(rec)
+                    if outcome["status"] != "submitted":
+                        skipped += 1
+                        continue
+                    upto = submissions(rec["tool_calls"])[-1]
+                    call, status, validation, verdict = cell.decide(rec["tool_calls"], final_rows, rules_of(score), upto,
+                                                                    vm)
+                elapsed = time.perf_counter() - t0
+            except Exception as exc:  # noqa: BLE001  (counted, never swallowed silently)
+                exceptions += 1
+                out.write(json.dumps({"run_id": run_id, "exception": type(exc).__name__}) + "\n")
+                continue
+            checked += 1
+            budget_hits += bool(validation and validation["budget_exceeded"])
+            times.append(elapsed)
+            flagged += bool(verdict["retry"])
+            statuses[verdict["status"]] = statuses.get(verdict["status"], 0) + 1
+            refused += bool(validation and validation["unchecked_scopes"])
+            for k, n in (verdict["kinds"] or {}).items():
+                kinds[k] = kinds.get(k, 0) + n
+            sa = None if args.retried else second_arm.second_flag(validation, verdict)  # about initial outputs only
+            if sa is not None:
+                arm_rows.append({"model": rec.get("model"), "status": verdict["status"], "kinds": verdict["kinds"],
+                                 "budget_exceeded": bool(validation and validation["budget_exceeded"]),
+                                 "unchecked": bool(validation and validation["unchecked_scopes"]), **sa})
+            out.write(json.dumps({"run_id": run_id, "model": rec.get("model"), "split": rec.get("split"),
+                                  "status": status, "verdict": verdict, "second_arm": sa,
+                                  "unchecked_scopes": validation["unchecked_scopes"] if validation else None,
+                                  "validation_s": round(elapsed, 4)}, sort_keys=True) + "\n")
+    if args.summary_out is not None:
+        sfd = os.open(args.summary_out, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+        with os.fdopen(sfd, "w", encoding="utf-8") as sf:
+            json.dump({"schema": "sparqlllm-reach/1", "adapted_row": second_arm.SECOND_ARM_LABEL,
+                       "adapted_row_id": second_arm.SECOND_ARM_ID, "adapted_row_is": second_arm.SECOND_ARM_NOTE, "models": second_arm.reach(arm_rows, sorted(seen_models))}, sf,
+                      sort_keys=True, indent=1)
+            sf.write("\n")
+    report = {"records_seen": seen, "natural_submitted_checked": checked, "no_submission_skipped": skipped,
+              "validator_exceptions": exceptions, "unreadable_files": unreadable, "output": str(args.out)}
+    if times:
+        report["validation_s"] = {"p50": round(statistics.median(times), 4), "max": round(max(times), 4)}
+    if splits <= {"dev"}:
+        report.update({**({} if args.retried else {"adapted_row_flagged": sum(r["adapted"] for r in arm_rows)}), "flagged": flagged, "statuses": dict(sorted(statuses.items())), "error_kinds": dict(sorted(kinds.items())),
+                       "outputs_with_unchecked_subpatterns": refused,
+                       "validations_over_budget": budget_hits})
+    else:
+        report["note"] = "a test record is among the selected: flag counts are in --out only (entry 191)"
+    print(json.dumps(report, sort_keys=True))
+    return 3 if exceptions or unreadable else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/sparqlllm_sib_absence.py b/scripts/sparqlllm_sib_absence.py
new file mode 100644
index 00000000..99b52bf9
--- /dev/null
+++ b/scripts/sparqlllm_sib_absence.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+"""Proof that no SIB example (question, query, instance-level IRI or literal) is in what the SPARQL-LLM validator loads.
+
+Reads a checkout of sib-swiss/sparql-examples at the pinned commit (``harness.sib.SIB_COMMIT``), extracts the
+patterns of its 218 UniProt and 124 Rhea examples (``harness/baselines/sparqlllm/sib_absence.py`` has the pattern
+types P1-P5) and scans the given files and directories for them. Offline: needs rdflib and the checkout.
+
+    python -I scripts/sparqlllm_sib_absence.py --examples-dir PATH/sparql-examples \\
+        --voidmap VOIDMAP.json --namespaces PREFIXES.json \\
+        --scan VOIDMAP.json --scan PREFIXES.json --scan harness/baselines/sparqlllm/validator.py \\
+        --scan harness/baselines/sparqlllm/loader.py --scan harness/baselines/sparqlllm/cell.py \\
+        --scan data/baselines/sparqlllm/upstream --report OUT.json
+
+(--scan every file or directory the validator loads or imports, by name: not the whole package directory, which
+holds this proof's own code. --voidmap and --namespaces say what is vocabulary, not what is scanned; scan those
+files too. Without them only the W3C namespaces are vocabulary.)
+
+Exit codes: 0 no match in any target; 1 at least one match (each printed with its pattern type, dataset, example
+file, target and a 12-digit sha256 prefix of the pattern, never the pattern); 2 refused (the checkout is not at the
+pin, an example count is wrong, a --scan path is missing or empty, or nothing was scanned). The report is written
+in every case, so a stale report cannot outlive a refused run.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from harness.baselines.sparqlllm import sib_absence as sa  # noqa: E402
+from harness.sib import SIB_COMMIT  # noqa: E402
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--examples-dir", required=True, help="the root of a sparql-examples checkout (holds examples/)")
+    ap.add_argument("--scan", action="append", default=[], metavar="PATH", help="a file or directory to scan (repeatable)")
+    ap.add_argument("--voidmap", help="voidmap.json whose classes, predicates and objects are vocabulary, not P4 patterns")
+    ap.add_argument("--namespaces", help="JSON file (the validator's prefix map) whose IRI strings are vocabulary namespaces")
+    ap.add_argument("--min-literal-chars", type=int, default=sa.MIN_LITERAL_CHARS, help="shortest P5 string literal")
+    ap.add_argument("--strict-vocabulary", action="store_true", help="object entries of the voidmap are not vocabulary")
+    ap.add_argument("--report", help="write the JSON report here")
+    ap.add_argument("--expect-commit", default=SIB_COMMIT, help="commit the checkout must be at (default: the pin)")
+    ap.add_argument("--expect-uniprot", type=int, default=sa.EXPECT_DEFAULT["uniprot"], help="UniProt example count")
+    ap.add_argument("--expect-rhea", type=int, default=sa.EXPECT_DEFAULT["rhea"], help="Rhea example count")
+    ap.add_argument("--max-print", type=int, default=200, help="match lines to print (all are counted and reported)")
+    args = ap.parse_args(argv)
+
+    try:
+        code, report, ps, matches = sa.run_proof(
+            args.examples_dir,
+            args.scan,
+            voidmap=args.voidmap,
+            namespaces=args.namespaces,
+            min_literal_chars=args.min_literal_chars,
+            strict_vocabulary=args.strict_vocabulary,
+            expect={"uniprot": args.expect_uniprot, "rhea": args.expect_rhea},
+            expect_commit=args.expect_commit,
+        )
+    except Exception as exc:  # noqa: BLE001 - an unexpected failure is a refusal, never exit 1 (that means a match)
+        code, ps, matches = 2, None, []
+        report = sa.report_dict(None, None, [], [], 2, None, f"unexpected {type(exc).__name__}")
+
+    if args.report:
+        out = Path(args.report)
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_text(json.dumps(report, indent=1, sort_keys=True) + "\n", encoding="utf-8")
+
+    if code == 2:
+        print(f"REFUSED: {report['refusal']}; nothing was proved")
+        return 2
+    c = report["counts"]
+    print(f"sparqlllm-sib-absence: examples commit {report['examples_commit']}; "
+          f"uniprot {c['examples']['uniprot']}, rhea {c['examples']['rhea']} examples; "
+          f"{c['patterns_distinct_total']} distinct patterns, set sha256 {report['pattern_set_sha256']}")
+    for ds in sa.DATASETS:
+        print(f"  patterns {ds}: " + ", ".join(f"{p}={c['patterns'][ds][p]}" for p in sa.PTYPES))
+    print(f"  P4: {c['p4_candidates_distinct']} distinct IRIs in the queries, excluded as vocabulary "
+          f"{c['p4_excluded_as_vocabulary']}, prefixed names without a declaration {c['unresolved_prefixed_names']}, "
+          f"read by {c['iri_extraction']}")
+    scanned = [t for t in report["targets"] if "skipped" not in t]
+    print(f"  scanned {len(scanned)} files ({sum(t['texts_scanned'] for t in scanned)} texts), "
+          f"skipped {len(report['targets']) - len(scanned)} binary")
+    for m in matches[: args.max_print]:
+        print(f"MATCH {m.ptype} {m.dataset} {m.example} {m.target} {m.pid}")
+    if len(matches) > args.max_print:
+        print(f"... and {len(matches) - args.max_print} more (all are in the report)")
+    print("  matches by type: " + ", ".join(f"{p}={report['match_counts'][p]}" for p in sa.PTYPES))
+    print(f"RESULT exit={code} matches={len(matches)}")
+    return code
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
