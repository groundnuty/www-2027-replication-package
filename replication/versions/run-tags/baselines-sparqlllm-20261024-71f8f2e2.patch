diff --git a/harness/baselines/sparqlllm/adapted.py b/harness/baselines/sparqlllm/adapted.py
new file mode 100644
index 00000000..5c8d7c3f
--- /dev/null
+++ b/harness/baselines/sparqlllm/adapted.py
@@ -0,0 +1,140 @@
+"""The one adapted, detection-only SPARQL-LLM row: "SPARQL-LLM validator, our adaptation" (design ruling, 24 Oct).
+
+The primary arm is the published validator, vendored byte for byte. This row is the same validator with exactly two changes,
+both read from upstream's own source and both ours:
+
+1. **Upstream's disabled rule is enabled.** ``validate_sparql_with_void`` carries a commented-out branch for a subject with
+   no type and no parent type: "we just check if the predicates used can be found in the VoID description", an error for a
+   predicate that no class has. Upstream switched it off because SIB's VoID file lacks predicates ("up:evidence is missing in
+   the VoID description"); an index rebuilt from the store lacks none the store has. It is reached for every untyped subject,
+   since the vendored top-level loop visits each subject with no parent. A variable predicate is skipped (the stale code would
+   flag every ``?p``); an inverse path counts by its IRI and a negated path is skipped.
+2. **Inference accepts ANY listed object class.** For an untyped variable reached from a typed subject, upstream tries only
+   the first object class the index lists for the parent's (class, predicate): both branches of its loop ``break``, so the
+   order of the list decides the verdict (upstream's order is the endpoint's, unordered; ours is sorted by IRI). Here the
+   variable is accepted when ANY listed class has every predicate the variable uses, and is flagged only when none has.
+
+Nothing else is changed. In particular the artefacts of the vendored code that the primary arm reports by kind stay in this
+row (a subject typed with a variable class, inverse and negated paths in the typed branch, a missing class beside another
+predicate), so that a difference between the two rows is due to the two changes and to nothing else.
+
+``adapted_check`` is a re-implementation of the vendored traversal (``validate_triple_pattern``), not a call of it, because the
+vendored code cannot be given these changes without editing it. Its fidelity is tested: with both changes off it must raise an
+error of the same kinds as the vendored validator on generated queries (tests/test_baselines_sparqlllm.py), and it works on the
+query dict that the vendored ``sparql_query_to_dict`` builds, so parsing, path expansion and the treatment of GRAPH / SERVICE /
+EXISTS are the vendored ones. Its traversal has upstream's depth limit (past 500 levels: a "recursion" issue) and remembers what
+it has explored at which depth, so a branching variable cycle costs nothing; a revisit of a variable already on the path is
+reported at once as the "recursion" upstream would end in at depth 500.
+
+One further difference, on purpose: upstream's commented-out rule is guarded by "only run this if no errors found yet, to avoid
+creating too many duplicates" (a variable, ``error_msgs``, that no longer exists in that function). The guard is not enabled: it
+could only remove issue kinds from a query that is flagged anyway, so the row's flag is the same with or without it.
+
+The result is detection only: ``flagged`` and the error kinds, no message, no retry. It is read offline from the recorded
+``validation.adapted`` field (second_arm.py).
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+RDF_TYPE = "http://www.w3.org/1999/02/22-rdf-syntax-ns#type"
+MAX_RECURSION = 500  # upstream's, for the record; a revisit on the path stands for reaching it
+STEP_CAP = 200_000  # a safety net on the work of one check; the traversal is memoised and does not come near it
+_INVERSE_PATH = re.compile(r"^Path\(~(\S+)\)$")
+
+ADAPTED_ID = "sparqlllm-adapted/1"
+ADAPTED_LABEL = "SPARQL-LLM validator, our adaptation"
+ADAPTED_NOTE = ("upstream's disabled rule enabled (a predicate no class has, on an untyped subject) and inference accepting "
+                "any listed object class")
+
+
+def _bare_predicate(pred: str) -> str | None:
+    """The predicate IRI the disabled rule checks, or None to skip it: a variable and a negated path are skipped, an
+    inverse path counts by its IRI, anything else is itself."""
+    if pred.startswith("?"):
+        return None
+    if pred.startswith("Path("):
+        m = _INVERSE_PATH.match(pred)
+        return m.group(1) if m else None
+    return pred
+
+
+def adapted_check(subj_dict: dict[str, dict[str, list[str]]], schema: dict[str, dict[str, list[str]]], *,
+                  any_match: bool = True, disabled_rule: bool = True) -> dict[str, Any]:
+    """The adapted row's reading of one query: ``subj_dict`` is ``sparql_query_to_dict(...)[endpoint]`` (subject ->
+    predicate -> objects), ``schema`` the index's class -> predicate -> object classes. Returns ``{"flagged", "kinds",
+    "budget_exceeded"}``; ``kinds`` counts the issues by kind. With ``any_match`` and ``disabled_rule`` both False it
+    reproduces the vendored traversal's issues, which is what the fidelity test compares."""
+    kinds: dict[str, int] = {}
+    steps = 0
+    exceeded = False
+    all_predicates: set[str] = {p for preds in schema.values() for p in preds}
+    done: dict[tuple[str, str | None, str | None], int] = {}  # key -> the depth it was last fully explored at
+    on_path: set[tuple[str, str | None, str | None]] = set()
+
+    def issue(kind: str) -> None:
+        kinds[kind] = kinds.get(kind, 0) + 1
+
+    def visit(subj: str, parent_type: str | None, parent_pred: str | None, depth: int = 0) -> None:
+        nonlocal steps, exceeded
+        steps += 1
+        if steps > STEP_CAP:
+            exceeded = True
+            return
+        if depth > MAX_RECURSION:  # upstream's depth limit
+            issue("recursion")
+            return
+        key = (subj, parent_type, parent_pred)
+        if key in on_path:  # a revisit on the path: upstream would recurse to its depth limit and report it
+            issue("recursion")
+            return
+        if done.get(key, -1) >= depth:  # explored before at least as deep: a deeper visit can only add limit issues
+            return
+        pred_dict = subj_dict.get(subj, {})
+        on_path.add(key)
+        try:
+            if RDF_TYPE in pred_dict:  # a direct type
+                for subj_type in pred_dict[RDF_TYPE]:
+                    for pred in pred_dict:
+                        if pred == RDF_TYPE:
+                            continue
+                        if subj_type not in schema and not subj_type.startswith("?"):
+                            issue("type_missing")
+                        elif pred not in schema.get(subj_type, {}) and not pred.startswith("?"):
+                            issue("predicate_variable_class" if subj_type.startswith("?")
+                                  else "predicate_path" if pred.startswith("Path(") else "predicate")
+                        for obj in pred_dict[pred]:
+                            if obj.startswith("?"):
+                                visit(obj, subj_type, pred, depth + 1)
+            elif parent_type and parent_pred:  # no direct type: infer one from the parent
+                potential_types = schema.get(parent_type, {}).get(parent_pred, [])
+                if potential_types:
+                    accepted = None
+                    for potential_type in potential_types:
+                        accepts = all(p in schema.get(potential_type, {}) for p in pred_dict)
+                        if accepts:
+                            accepted = potential_type
+                            break
+                        if not any_match:  # upstream: the first listed class decides, both branches break
+                            break
+                    if accepted is not None:
+                        for pred in pred_dict:
+                            for obj in pred_dict[pred]:
+                                if obj.startswith("?"):
+                                    visit(obj, accepted, pred, depth + 1)
+                    else:
+                        issue("predicate_inferred")
+            elif disabled_rule:  # no type and no parent type: upstream's commented-out branch
+                for pred in pred_dict:
+                    bare = _bare_predicate(pred)
+                    if bare is not None and bare not in all_predicates:
+                        issue("untyped_unknown_predicate")
+        finally:
+            on_path.discard(key)
+        done[key] = depth
+
+    for subj in subj_dict:  # the vendored top-level loop: every subject, with no parent
+        visit(subj, None, None)
+    return {"flagged": bool(kinds), "kinds": dict(sorted(kinds.items())), "budget_exceeded": exceeded}
diff --git a/harness/baselines/sparqlllm/agent_view.py b/harness/baselines/sparqlllm/agent_view.py
new file mode 100644
index 00000000..dd5ab549
--- /dev/null
+++ b/harness/baselines/sparqlllm/agent_view.py
@@ -0,0 +1,56 @@
+"""Everything of the index that an agent can be shown, as one text (design log, AC3; the opaque graphs' leak check).
+
+The validator's error lines are built from the index: the class IRIs ("Available classes are ..."), the predicates of a class
+("It can have the following predicates ..."), the predicates of an inferred object class, the endpoint key, and the prefix map
+that shortens IRIs and completes a query's declarations. An opaque graph's index must therefore hold no original name, and the
+independent leak check (scripts/check_opaque_leaks.py, against the held-out map, which only a job inside the private tree
+reads) is run on THIS view, not on the index files, so that it scans exactly what the agent can be sent and not the builder's
+bookkeeping (store names, the graph's registry name) the agent never sees.
+
+``agent_view`` returns a JSON-able dict: the endpoint key, the prefix map, every class / predicate / object entry of the index
+as the term list, and a corpus of rendered validator messages that covers each kind of line the validator can send for this
+index, produced by the real validator on synthetic queries over the index's own terms (an unknown class, an unknown predicate
+of each class, a wrong predicate on an untyped variable reached through each (class, predicate) with object classes, a
+subject typed with a variable class, an inverse path). No query of any agent is involved.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from harness.baselines.sparqlllm import validator
+
+RDF_TYPE = "http://www.w3.org/1999/02/22-rdf-syntax-ns#type"
+UNKNOWN_PREDICATE = "http://example.org/opaque/zz-not-in-the-index"
+UNKNOWN_CLASS = "http://example.org/opaque/zz-not-a-class"
+
+
+def _q(body: str) -> str:
+    return f"SELECT * WHERE {{ {body} }}"
+
+
+def synthetic_queries(vm: validator.VoidMap) -> list[str]:
+    """Queries over the index's own terms that make the validator send each kind of line it can send for it."""
+    out = [_q(f"?s a <{UNKNOWN_CLASS}> ; <{UNKNOWN_PREDICATE}> ?o ."), _q(f"?s a ?c ; <{UNKNOWN_PREDICATE}> ?o ."),
+           _q(f"?s ^<{UNKNOWN_PREDICATE}> ?o ."), _q("?s ")]
+    for cls, preds in sorted(vm.schema.items()):
+        out.append(_q(f"?s a <{cls}> ; <{UNKNOWN_PREDICATE}> ?o ."))
+        for pred, objs in sorted(preds.items()):
+            if pred == RDF_TYPE or not objs:
+                continue
+            out.append(_q(f"?s a <{cls}> ; <{pred}> ?o . ?o <{UNKNOWN_PREDICATE}> ?z ."))
+            out.append(_q(f"?s a <{cls}> ; ^<{pred}> ?o ."))
+    return out
+
+
+def agent_view(vm: validator.VoidMap) -> dict[str, Any]:
+    terms = sorted({vm.endpoint_key, *vm.schema, *(p for ps in vm.schema.values() for p in ps),
+                    *(o for ps in vm.schema.values() for objs in ps.values() for o in objs)})
+    messages: set[str] = set()
+    for q in synthetic_queries(vm):
+        out = validator.validate_query(q, vm)
+        messages.update(out["errors"])
+        if out["errors"]:
+            messages.add(validator.retry_message(out["original_query"], out["errors"]))
+    return {"endpoint_key": vm.endpoint_key, "prefixes": [list(p) for p in vm.prefixes], "terms": terms,
+            "rendered_messages": sorted(messages)}
diff --git a/harness/baselines/sparqlllm/audit.py b/harness/baselines/sparqlllm/audit.py
new file mode 100644
index 00000000..35a8706b
--- /dev/null
+++ b/harness/baselines/sparqlllm/audit.py
@@ -0,0 +1,143 @@
+"""The batch-level audit of a SPARQL-LLM cell's records (design log, AC3; External review r1 of 24 Oct).
+
+A SPARQL-LLM record replays from itself: ``replay_sparqlllm_decision`` loads the index the record's settings name (by graph
+and sha256) and decides again from the record's own tool calls. That shows the decision is consistent with the record, not
+that the record is what the cell makes of its parent, so three bindings the record cannot show are held here, over the whole
+batch, by the replay check (``replay_check.verify_batch``: the runner's closing gate runs it, and the analysis gate needs it to
+pass) and by the grid coverage check:
+
+* the index the record names is the index its CELL pins (the spec's ``voidmap``: graph and sha256), not another committed
+  index that also happens to replay;
+* the index was built under the store its PARENT record was produced on (``check_binding`` against the parent's store, which
+  is what ``make_checker`` checked when the record was made), and the record's own store is its parent's;
+* the record's initial phase is its parent's (identity, transcript up to the retry, tool calls, answer, submission, score:
+  the same comparison the judge cell's audit makes), so a record cannot replay another output under this parent's name.
+
+Problems name run ids and the part that differs, and some of them (a score that is not the parent's though no retry was
+made) say which way a record's retry went: the replay check writes them to a mode-600 file and fails with a message that names
+no record and counts none, and the coverage check keeps them off its console, as for the judge cell's audit (entry 191).
+"""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Iterable, Mapping
+from pathlib import Path
+from typing import Any
+
+from harness.baselines.judge_sealed import _same_attempt_as
+from harness.baselines.sparqlllm import cell, validator
+from harness.baselines.sparqlllm.scope import claims_cell, names_cell, pins_from_manifest, pins_sha256  # noqa: F401 - re-exported
+
+SETASIDE_SUFFIX = ".setaside.json"
+
+
+def in_scope(rec: dict, cell_ids: Iterable[str]) -> bool:
+    """Whether a run record is, or claims or hides being, a SPARQL-LLM cell's: ANY of its identifying fields says so (its
+    checker mode, version, validator block, its cell by ``load.arm`` or the branch arm), so a record cannot leave the audit by
+    changing the field it shows."""
+    chk = rec.get("checker") if isinstance(rec.get("checker"), dict) else {}
+    settings = chk.get("settings") if isinstance(chk.get("settings"), dict) else {}
+    initial = chk.get("initial") if isinstance(chk.get("initial"), dict) else {}
+    load = rec.get("load") if isinstance(rec.get("load"), dict) else {}
+    branch = chk.get("branch") if isinstance(chk.get("branch"), dict) else {}
+    names = set(cell_ids) | {cell.MODE}  # a grid record's branch arm is its cell's id; a bare branch_attempt's is the mode
+    arms = [a for a in (load.get("arm"), branch.get("arm")) if isinstance(a, str)]  # (an unhashable value names no cell)
+    return bool(settings.get("mode") == cell.MODE or settings.get("version") == cell.CELL_VERSION
+                or "validator" in settings or "validation" in initial or any(a in names for a in arms))
+
+
+def _store_key(store: Any) -> tuple:
+    store = store if isinstance(store, dict) else {}
+    return (store.get("name"), store.get("identity"))
+
+
+def audit_record(rec: dict, parent: dict | None, pin: Mapping[str, str] | None, *, voidmaps: dict | None = None) -> list[str]:
+    """The problems of one SPARQL-LLM record against its parent record and its cell's index pin (``pin``: {"graph", "sha256"},
+    None when the record names a cell the plan does not have). ``voidmaps``: a cache of loaded indexes by (graph, sha256)."""
+    name = rec.get("run_id")
+    chk = rec.get("checker") if isinstance(rec.get("checker"), dict) else {}
+    settings = chk.get("settings") if isinstance(chk.get("settings"), dict) else {}
+    problems: list[str] = []
+    load = rec.get("load") if isinstance(rec.get("load"), dict) else {}
+    branch = chk.get("branch") if isinstance(chk.get("branch"), dict) else {}
+    if pin is None:
+        return [f"{name}: its cell {load.get('arm')!r} is no SPARQL-LLM cell of the plan"]
+    if settings.get("mode") != cell.MODE or settings.get("version") != cell.CELL_VERSION:
+        problems.append("its checker is not the SPARQL-LLM cell's (mode or version)")
+    if branch.get("arm") not in (cell.MODE, load.get("arm")):
+        problems.append("its branch arm is not the SPARQL-LLM cell's")
+    validator_block = settings.get("validator") if isinstance(settings.get("validator"), dict) else {}
+    index = validator_block.get("index") if isinstance(validator_block.get("index"), dict) else {}
+    if (index.get("graph"), index.get("sha256")) != (pin["graph"], pin["sha256"]):
+        problems.append("the index named in its settings is not the one its cell pins (graph, voidmap sha256)")
+    pinned_settings = pin.get("settings")
+    if isinstance(pinned_settings, dict) and {k: v for k, v in settings.items() if k != "retry_budget"} != pinned_settings:
+        problems.append("its settings are not the settings its cell pins (the manifest's, without the retry budget)")
+    if parent is None:
+        return [f"{name}: {p}" for p in problems] + [f"{name}: its parent is missing, not exactly one, itself, or not an "
+                                                      f"initial record"]
+    problems += _same_attempt_as(rec, parent)
+    # the store IS its name and index identity (what the index is bound to); its endpoint and limits may differ between a
+    # record and its parent when the OUT runs on another copy of the same store
+    if _store_key(rec.get("store")) != _store_key(parent.get("store")):
+        problems.append("its store is not its parent's")
+    cache = voidmaps if voidmaps is not None else {}
+    key = (pin["graph"], pin["sha256"])
+    try:
+        if key not in cache:
+            cache[key] = validator.load_voidmap(cell.index_path(pin["graph"]), pin["sha256"])
+        cell.check_binding(cache[key], parent.get("store") if isinstance(parent.get("store"), dict) else None)
+    except (OSError, ValueError) as exc:  # IndexMismatch is a ValueError
+        problems.append(f"the pinned index does not fit its parent's store: {exc}")
+    return [f"{name}: {p}" for p in problems]
+
+
+def audit(records: Iterable[dict], pins: Mapping[str, Mapping[str, str]]) -> list[str]:
+    """``audit_record`` over every SPARQL-LLM record among ``records`` (every run record of the batch, parents included).
+    ``pins``: the plan's SPARQL-LLM cells, by cell id, each {"graph", "sha256"}. Two run records of one run id are a problem."""
+    by_id: dict[str, list[dict]] = {}
+    for rec in records:
+        by_id.setdefault(str(rec.get("run_id")), []).append(rec)
+    problems = [f"{run_id}: {len(recs)} run records of one run id" for run_id, recs in sorted(by_id.items()) if len(recs) > 1]
+    voidmaps: dict = {}
+    for run_id, recs in sorted(by_id.items()):
+        for rec in recs:
+            try:
+                if not in_scope(rec, pins):
+                    continue
+                chk = rec.get("checker") if isinstance(rec.get("checker"), dict) else {}
+                load = rec.get("load") if isinstance(rec.get("load"), dict) else {}
+                parents = by_id.get(str(chk.get("branched_from")), [])
+                # the parent is the one INITIAL record of that run id: not the record itself, and not another branch record
+                # (a no-retry branch record replays as its own parent)
+                parent = parents[0] if len(parents) == 1 and parents[0] is not rec and parents[0].get("checker") is None else None
+                problems += audit_record(rec, parent, pins.get(load.get("arm")), voidmaps=voidmaps)
+            except Exception as exc:  # noqa: BLE001 - a malformed record is a problem to report, never a crash of the gate
+                problems.append(f"{run_id}: its record cannot be audited ({type(exc).__name__}: {str(exc)[:200]})")
+    return problems
+
+
+def audit_dir(records_dir: Path, pins: Mapping[str, Mapping[str, str]]) -> list[str]:
+    """``audit`` over the run records in an OUT's records/ directory: every ``*.json`` file is read; a file that is not a JSON
+    object with a run id is skipped (the replay check reports an unreadable record at its load stage), and a file with a set-aside
+    name is a problem (sidecars are in harness/)."""
+    records, problems = [], []
+    for path in sorted(Path(records_dir).glob("*.json")):
+        if path.name.endswith(SETASIDE_SUFFIX):
+            # set-aside sidecars live in harness/, never among the records: a record under this name is neither replayed
+            # nor hashed by the replay check, and must not be a way for it to leave the audit
+            problems.append(f"{path.name}: a set-aside name among the records")
+            continue
+        try:
+            data = json.loads(path.read_bytes().decode("utf-8"))
+        except (OSError, ValueError):
+            continue
+        if isinstance(data, dict) and "run_id" in data:
+            records.append(data)
+    return problems + audit(records, pins)
+
+
+def pins_of(cells: Iterable[Mapping[str, Any]]) -> dict[str, dict[str, str]]:
+    """The SPARQL-LLM cells' index pins among a plan's branch cells (spec cell dicts), by cell id."""
+    return {c["id"]: dict(c["voidmap"]) for c in cells if c.get("mode") == cell.MODE}
diff --git a/harness/baselines/sparqlllm/cell.py b/harness/baselines/sparqlllm/cell.py
new file mode 100644
index 00000000..d271aa51
--- /dev/null
+++ b/harness/baselines/sparqlllm/cell.py
@@ -0,0 +1,262 @@
+"""SPARQL-LLM's validation as a branch cell of the checker loop (design log, AC3; proposal section 7.6).
+
+The cell is retry-on-empty's shape (harness/baselines/empty.py): ``branch_attempt(parent, SparqlLlmChecker(...),
+route, sparql)`` replays the parent's initial phase and calls the model only when the trigger fires. The trigger
+is SPARQL-LLM's metadata-grounded validation of the output's checked query (rule 22, the query every checker arm
+reads) against the index rebuilt from the graph's store (``void_build.py``): any error it reports triggers one
+retry, whose user turn is upstream's own fix request (``validator.RETRY_TEMPLATE``) closed by the set-aside
+sentence every arm's retry turn carries (entry 126).
+
+No model call and no store call is made by the decision, so it recomputes offline from the record
+(``replay_sparqlllm_decision``) given the index file named by the record's settings.
+
+Not in the cell, each one tabled in the baseline's documentation: SPARQL-LLM's question analysis, retrieval of
+example queries and class descriptions, answer generation and its entity search (the agent's own loop replaces
+them); upstream's automatic run of a valid query and its "no results" request to fix it (that is retry-on-empty's
+cell); and upstream's three fix rounds (the retry budget is the registered one, exactly one more submission).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import asdict
+from pathlib import Path
+from typing import Any
+
+from harness.agent.record import RunRecord
+from harness.agent.replay import ReplayDivergence
+from harness.baselines.sparqlllm import validator
+from harness.baselines.sparqlllm.loader import load_upstream
+from harness.checkloop.checked import checked_call, executed_queries
+from harness.checkloop.feedback import retry_turn_text
+from harness.checkloop.online import (
+    CheckInput,
+    Decision,
+    RetryBudget,
+    _matching,
+    recorded_set_aside,
+    set_aside_on,
+    set_aside_setting,
+)
+from harness.score import ScoringRules
+from harness.terms import row_from_json
+
+CELL_VERSION = "sparqlllm-cell/1"
+MODE = "sparqlllm"
+MESSAGE_KIND = "sparqlllm_retry"  # the retry user turn's kind; online.BASELINE_MODES maps MODE to it (integration commit)
+TRIGGER = ("upstream validate_sparql reports at least one error for the rule-22 checked query against the index "
+           "rebuilt from the graph's store")
+REPO_ROOT = Path(__file__).resolve().parents[3]
+INDEX_DIR = REPO_ROOT / "data" / "baselines" / "sparqlllm"
+
+
+def message_sha256() -> str:
+    return validator.retry_template_sha256()
+
+
+def index_path(graph: str) -> Path:
+    return INDEX_DIR / graph / "voidmap.json"
+
+
+def _verdict(validation: dict[str, Any] | None, voidmap: validator.VoidMap) -> dict[str, Any]:
+    """The four-way status of the S0.1 contract, for a check that can fail to look:
+
+    flagged          upstream reported at least one error and the validation finished (the only status that
+                     retries);
+    unknown          no error, but the check cannot be trusted: the index holds no class, the vendored code
+                     swallowed an exception while checking a subject, or the validation used up its lookups
+                     (validator.VALIDATION_BUDGET: a query whose variables point at each other in a branching cycle);
+    vacuous_pass     no error, and no subject had a constant class and a predicate to check (a query that types none of
+                     its subjects, or only with a variable: a lone `?s a ?t`; with another constant predicate a
+                     variable-typed subject is flagged, kind predicate_variable_class): nothing to find fault with;
+    substantive_pass no error, and at least one typed subject was checked;
+    no_query         the output has no checked query (never retried).
+
+    ``any_unknown`` also covers a part of the query the validator did not look at (``unchecked_scopes``: a SERVICE
+    block, or a FILTER EXISTS / NOT EXISTS sub-pattern), beside any status: a substantive pass says only that the
+    triples it did look at fit the index."""
+    if validation is None:
+        return {"status": "no_query", "retry": False, "any_unknown": True, "errors": 0, "kinds": {},
+                "prefix_fixed": False}
+    n = len(validation["errors"])
+    cov = validation["coverage"]
+    empty_index = not voidmap.schema
+    unfit = empty_index or validation["swallowed"] or validation["budget_exceeded"]
+    if validation["budget_exceeded"]:
+        status = "unknown"  # the validation did not finish: whatever errors it had found before stopping, no retry
+    elif n:
+        status = "flagged"
+    elif unfit:
+        status = "unknown"
+    elif cov is not None and cov["typed_examined"]:
+        status = "substantive_pass"
+    else:
+        status = "vacuous_pass"
+    return {"status": status, "retry": status == "flagged", "any_unknown": bool(unfit or validation["unchecked_scopes"]),
+        "errors": n, "kinds": validation["kinds"], "prefix_fixed": validation["prefix_fixed"]}
+
+
+def decide(tool_calls: list[dict], final_rows: list | None, rules: ScoringRules, upto: int,
+           voidmap: validator.VoidMap) -> tuple[dict | None, str, dict | None, dict[str, Any]]:
+    """(checked call, rule-22 status, validation or None, verdict) for the submission at log index ``upto``."""
+    calls = executed_queries(tool_calls, upto)
+    answer = [r if isinstance(r, tuple) else row_from_json(r) for r in (final_rows or [])]
+    call, status = checked_call(calls, answer, rules)
+    if call is None:
+        return None, status, None, _verdict(None, voidmap)
+    validation = validator.validate_query(call["arguments"]["query"], voidmap)
+    return call, status, validation, _verdict(validation, voidmap)
+
+
+class IndexMismatch(ValueError):
+    """The index was built from another store than the one the output was produced on."""
+
+
+def check_binding(voidmap: validator.VoidMap, store: dict[str, Any] | None) -> None:
+    """The index and the record's store must be one store: the record's store identity (the index digest the
+    server reported when the run started) equals the identity the index was built under. A map of another graph
+    would change the flags and the retry text while its hash still looked valid."""
+    identity = (store or {}).get("identity")
+    if not identity or identity != voidmap.store.get("name_index"):
+        raise IndexMismatch(f"the record's store identity {identity!r} is not the identity the index was built "
+                            f"under ({voidmap.store.get('name_index')!r})")
+
+
+class SparqlLlmChecker:
+    """The cell's checker, in the interface the agent loop and ``branch_attempt`` call (``budget``,
+    ``settings()``, ``check()``). ``voidmap``: the index rebuilt from the graph's store."""
+
+    mode = MODE
+    label = MODE  # its name among an output's branch arms (it has no ontology arm)
+
+    def __init__(self, voidmap: validator.VoidMap, *, budget: RetryBudget, store: dict[str, Any] | None,
+                 set_aside: bool | str | None = None):
+        check_binding(voidmap, store)  # no checker without the store its records are produced on
+        self.voidmap = voidmap
+        self.budget = budget
+        self.set_aside = set_aside_on(set_aside)  # entry 126: the retry turn's closing sentence, as in every arm
+
+    @classmethod
+    def pinned_settings(cls, voidmap: validator.VoidMap, budget: RetryBudget,
+                        set_aside: bool | str | None = None) -> dict[str, Any]:
+        """The settings a cell on this index would record, for a spec to pin before any record exists (the binding is
+        satisfied by the index's own store identity: no record is checked here)."""
+        return cls(voidmap, budget=budget, store={"identity": voidmap.store.get("name_index")},
+                   set_aside=set_aside).settings()
+
+    @classmethod
+    def for_record(cls, record: RunRecord | dict, voidmap: validator.VoidMap, *, budget: RetryBudget,
+                   set_aside: bool | str | None = None) -> SparqlLlmChecker:
+        """The cell for a recorded output (to branch from it): refused unless the index was built from the
+        store the record was produced on (``check_binding``)."""
+        store = record.store if isinstance(record, RunRecord) else record["store"]
+        return cls(voidmap, budget=budget, store=store, set_aside=set_aside)
+
+    def settings(self) -> dict[str, Any]:
+        up = load_upstream()
+        return {
+            "version": CELL_VERSION,
+            "mode": MODE,
+            "trigger": TRIGGER,
+            "validator": {
+                "version": validator.VALIDATOR_VERSION,
+                "upstream": {"repository": up.pin["repository"], "commit": up.pin["commit"],
+                             "describe": up.pin["describe"], "files": up.hashes},
+                "index": self.voidmap.identity(),
+                "error_order": "sorted",
+                "libraries": validator.library_versions(),
+            },
+            "message": {"id": validator.RETRY_ID, "sha256": message_sha256()},
+            "retry_budget": asdict(self.budget),
+            **set_aside_setting(self.set_aside),
+        }
+
+    def check(self, inp: CheckInput) -> Decision:
+        call, status, validation, verdict = decide(list(inp.tool_calls), inp.final_rows, inp.rules,
+                                                   inp.submission_index, self.voidmap)
+        r = inp.rules
+        initial = {
+            "matching": {"multiset": r.multiset, "rel_tol": r.rel_tol, "abs_tol": r.abs_tol,
+                         "column_order": r.column_order},
+            "checked_query": call["arguments"]["query"] if call is not None else None,
+            "checked_query_status": status,
+            "verdict": verdict,
+            "reports": [],  # no ontology checks run: the keys every checker decision carries
+            "store_log": None,
+            "validation": validation,
+            "store_accepted": None if call is None else not call.get("error"),  # a fallback query can be one the store refused
+        }
+        retry = verdict["retry"]
+        message = validator.retry_message(validation["original_query"], validation["errors"]) if retry else None
+        if retry:
+            verdict["message_chars"] = len(message)  # the volume of schema the retry turn lists (descriptive)
+        return Decision(retry, MESSAGE_KIND if retry else None, message,
+                        json.loads(json.dumps(initial, ensure_ascii=False)),
+                        retry_turn_text(message, self.set_aside) if retry else None)
+
+
+def replay_sparqlllm_decision(record: RunRecord | dict, voidmap: validator.VoidMap | None = None) -> Decision:
+    """Recompute a SPARQL-LLM cell's decision from the record's own tool-call log and the index file its settings
+    name, with no store and no model. Raises ReplayDivergence unless the validator code, the index, the prefix
+    table, the library versions, the checked query, the validation, the verdict, the message and the retry
+    decision are the recorded ones. ``voidmap``: the index to use; by default the repository's file for the
+    recorded graph, which must have the recorded sha256."""
+    rec = record if isinstance(record, RunRecord) else RunRecord.from_json(record)
+    chk = rec.checker
+    if chk is None or chk["settings"].get("mode") != MODE:
+        raise ValueError("the record is not a SPARQL-LLM cell's record")
+    initial = chk["initial"]
+    if initial["submission_index"] is None:
+        raise ValueError("the record has no checked initial submission")
+    settings = chk["settings"]
+    recorded = settings["validator"]
+    if voidmap is None:
+        try:
+            voidmap = validator.load_voidmap(index_path(recorded["index"]["graph"]), recorded["index"]["sha256"],
+                                             allow_incomplete=bool(recorded["index"].get("incomplete")))
+        except (OSError, ValueError) as exc:
+            raise ReplayDivergence(f"the recorded SPARQL-LLM index cannot be loaded: {exc}") from exc
+    try:
+        check_binding(voidmap, rec.store)
+    except IndexMismatch as exc:
+        raise ReplayDivergence(str(exc)) from exc
+    checker = SparqlLlmChecker(voidmap, budget=RetryBudget(**settings["retry_budget"]), store=rec.store,
+                               set_aside=recorded_set_aside(settings))
+    now = checker.settings()
+    for key in ("version", "mode", "trigger", "message"):
+        if now[key] != settings[key]:
+            raise ReplayDivergence(f"the SPARQL-LLM cell's {key} differs from the recorded one")
+    for key in ("version", "upstream", "index", "error_order", "libraries"):
+        if now["validator"][key] != recorded[key]:
+            raise ReplayDivergence(f"the SPARQL-LLM validator's {key} differs from the recorded one")
+    decision = checker.check(CheckInput(rec.tool_calls, initial["final_rows"], _matching(rec),
+                                        rec.store.get("row_cap"), initial["submission_index"]))
+    for key in ("checked_query", "checked_query_status", "verdict", "validation"):
+        if decision.initial[key] != initial[key]:
+            raise ReplayDivergence(f"the recomputed SPARQL-LLM decision differs at {key}")
+    retry = chk["retry"]
+    if decision.retry != (retry is not None) or (retry and (decision.message != retry["message"]
+                                                           or decision.message_kind != retry["message_kind"])):
+        raise ReplayDivergence("the recomputed retry decision, message or message kind differs from the recorded one")
+    return decision
+
+
+def validate_retried(record: RunRecord | dict, voidmap: validator.VoidMap) -> dict[str, Any] | None:
+    """The validator's verdict on the RETRIED output of a SPARQL-LLM cell's record (None when there was no retry
+    or it submitted nothing), computed offline from the tool-call log. It decides nothing in the cell, which
+    retries once; it says how many retried outputs upstream's own loop (up to three fix rounds, unlike this
+    cell's one) would have sent back again, which is the native configuration's second round, read from the same
+    records."""
+    rec = record.to_json() if isinstance(record, RunRecord) else record
+    chk = rec.get("checker")
+    if chk is None or chk["settings"].get("mode") != MODE or chk["retry"] is None:
+        return None
+    upto = chk["retry"]["submission_index"]
+    if upto is None:
+        return None
+    r = chk["initial"]["matching"]
+    rules = ScoringRules(multiset=r["multiset"], rel_tol=r["rel_tol"], abs_tol=r["abs_tol"],
+                         column_order=r["column_order"])
+    _call, status, validation, verdict = decide(rec["tool_calls"], rec["final_rows"], rules, upto, voidmap)
+    return {"checked_query_status": status, "verdict": verdict, "validation": validation}
diff --git a/harness/baselines/sparqlllm/loader.py b/harness/baselines/sparqlllm/loader.py
new file mode 100644
index 00000000..86533114
--- /dev/null
+++ b/harness/baselines/sparqlllm/loader.py
@@ -0,0 +1,165 @@
+"""Loads SPARQL-LLM's own validator code (design log, AC3) without its package.
+
+``upstream/validate_sparql.py`` and ``upstream/utils.py`` are copies of sib-swiss/sparql-llm at the commit
+named in ``upstream/PIN.json``, byte for byte: nothing in them is edited. They import
+``sparql_llm.utils`` and ``sparql_llm.config``, and the real package pulls in langchain, pydantic-settings
+and a vector database, none of which the validator uses. So this module
+
+* checks each vendored file against the sha256 in PIN.json and refuses to load a file that differs;
+* registers a private ``sparql_llm`` package whose only own module is a stand-in ``sparql_llm.config`` holding
+  ``SparqlEndpointLinks`` (a type annotation in utils.py), then executes the two vendored files under their
+  upstream module names;
+* re-routes the vendored validator's parser through the harness's process-wide lock (``harness.sparql_grammar``):
+  rdflib's SPARQL grammar is shared by the whole process and is not thread-safe (dress rehearsal F2), the runner
+  checks outputs on several threads, and the vendored code imports the unlocked parser directly. Its
+  ``prepare``-style entry point is replaced, after the file is executed, by ``sparql_grammar.prepare_query``, which
+  takes the same argument and holds ``PARSER_LOCK``. The file itself is not edited;
+* replaces ``utils.query_sparql`` with a function that raises. The vendored code reaches the network in
+  exactly two places, ``get_schema_for_endpoint`` and ``get_prefixes_for_endpoint``, and both call
+  ``query_sparql`` and catch what it raises. validate_sparql passes the endpoint of every SERVICE block it finds
+  in a query to ``get_schema_for_endpoint`` when that endpoint is not in the schema dict it was given; unpatched,
+  an agent query with a SERVICE block would fetch a live VoID description from whatever host it names. Patched,
+  the lookup returns an empty schema, which upstream skips ("if len(void_dict) == 0: continue"), and the
+  endpoint is recorded so that a report can say how many outputs had SERVICE blocks the validator could not
+  check. Calls are logged per thread (``blocked_calls``).
+
+Nothing here is a model call or a store call.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import logging
+import sys
+import threading
+import types
+import typing
+from pathlib import Path
+from typing import Any
+
+# The vendored files are third-party data, pinned by hash, so they live under data/ and not in the harness: a test
+# (tests/test_sparql_grammar_threads.py) scans harness/ and scripts/ for any use of rdflib's SPARQL grammar outside
+# harness/sparql_grammar.py, and the vendored validator is such a use until it is re-routed below.
+UPSTREAM_DIR = Path(__file__).resolve().parents[3] / "data" / "baselines" / "sparqlllm" / "upstream"
+PIN_PATH = UPSTREAM_DIR / "PIN.json"
+_PACKAGE = "sparql_llm"
+_LOAD_LOCK = threading.Lock()
+_STATE = threading.local()
+_LOADED: "Upstream | None" = None
+
+
+class UpstreamError(RuntimeError):
+    """The vendored validator is not the pinned one, or cannot be loaded."""
+
+
+def sha256_file(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def read_pin() -> dict[str, Any]:
+    return json.loads(PIN_PATH.read_text(encoding="utf-8"))
+
+
+def verify_vendored(pin: dict[str, Any] | None = None) -> dict[str, str]:
+    """{file name: sha256} of the vendored files, each equal to PIN.json's; UpstreamError otherwise."""
+    pin = pin or read_pin()
+    out: dict[str, str] = {}
+    for name, entry in sorted(pin["files"].items()):
+        path = UPSTREAM_DIR / name
+        if not path.is_file():
+            raise UpstreamError(f"vendored file {name} is missing")
+        got = sha256_file(path)
+        if got != entry["sha256"]:
+            raise UpstreamError(f"vendored file {name} has sha256 {got}, PIN.json says {entry['sha256']}")
+        out[name] = got
+    return out
+
+
+def blocked_calls() -> list[dict[str, Any]]:
+    """The network lookups the vendored code attempted on this thread since ``reset_blocked_calls``."""
+    return list(getattr(_STATE, "calls", []))
+
+
+def reset_blocked_calls() -> None:
+    _STATE.calls = []
+
+
+def _blocked_query_sparql(query: str, endpoint_url: str, *args: Any, **kwargs: Any) -> Any:
+    calls = getattr(_STATE, "calls", None)
+    if calls is None:
+        calls = _STATE.calls = []
+    calls.append({"endpoint": str(endpoint_url)})
+    raise RuntimeError("the SPARQL-LLM validator is run without network access: the lookup was refused")
+
+
+class Upstream:
+    """The loaded vendored modules."""
+
+    def __init__(self, validate_sparql: types.ModuleType, utils: types.ModuleType, pin: dict[str, Any],
+                 hashes: dict[str, str]):
+        self.validate_sparql = validate_sparql
+        self.utils = utils
+        self.pin = pin
+        self.hashes = hashes
+
+
+def _stand_in_config() -> types.ModuleType:
+    config = types.ModuleType(f"{_PACKAGE}.config")
+    config.__doc__ = "Stand-in for sparql_llm.config: the only name the vendored files import from it."
+
+    class SparqlEndpointLinks(typing.TypedDict, total=False):
+        endpoint_url: typing.Required[str]
+        void_file: str | None
+        examples_file: str | None
+        homepage_url: str | None
+        label: str | None
+        description: str | None
+
+    config.SparqlEndpointLinks = SparqlEndpointLinks  # type: ignore[attr-defined]
+    return config
+
+
+def _exec_vendored(module_name: str, path: Path) -> types.ModuleType:
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise UpstreamError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[module_name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def load_upstream() -> Upstream:
+    """The pinned validator, loaded once per process."""
+    global _LOADED
+    with _LOAD_LOCK:
+        if _LOADED is not None:
+            return _LOADED
+        pin = read_pin()
+        hashes = verify_vendored(pin)
+        existing = sys.modules.get(_PACKAGE)
+        if existing is not None and not getattr(existing, "__www2027_stand_in__", False):
+            raise UpstreamError("a different sparql_llm package is already imported in this process")
+        package = types.ModuleType(_PACKAGE)
+        package.__path__ = []  # type: ignore[attr-defined]
+        package.__www2027_stand_in__ = True  # type: ignore[attr-defined]
+        package.__version__ = pin["package_version"]  # type: ignore[attr-defined]
+        sys.modules[_PACKAGE] = package
+        sys.modules[f"{_PACKAGE}.config"] = _stand_in_config()
+        utils = _exec_vendored(f"{_PACKAGE}.utils", UPSTREAM_DIR / "utils.py")
+        # the vendored code logs through the "sparql_llm" logger; with no handler Python would print its warnings
+        logging.getLogger(_PACKAGE).addHandler(logging.NullHandler())
+        utils.query_sparql = _blocked_query_sparql  # type: ignore[attr-defined]
+        validate = _exec_vendored(f"{_PACKAGE}.validate_sparql", UPSTREAM_DIR / "validate_sparql.py")
+        from harness import sparql_grammar
+
+        # the vendored module's module-level name for rdflib's prepare function, bound by its import statement
+        if not hasattr(validate, "prepareQuery"):
+            raise UpstreamError("the vendored validator no longer has the parser entry point this loader re-routes")
+        validate.prepareQuery = sparql_grammar.prepare_query
+        package.utils = utils  # type: ignore[attr-defined]
+        package.validate_sparql = validate  # type: ignore[attr-defined]
+        _LOADED = Upstream(validate, utils, pin, hashes)
+        return _LOADED
diff --git a/harness/baselines/sparqlllm/scope.py b/harness/baselines/sparqlllm/scope.py
new file mode 100644
index 00000000..eb2a061c
--- /dev/null
+++ b/harness/baselines/sparqlllm/scope.py
@@ -0,0 +1,59 @@
+"""Where a SPARQL-LLM cell shows in an OUT, read without importing the cell (design log, AC3).
+
+``harness/agent/replay_check.py`` is shared by every OUT, so its test for "does this OUT have the SPARQL-LLM cell" must cost a
+manifest parse and import nothing of the cell, the vendored validator or the judge audit. This module holds only that: the mode's
+name (the same as ``cell.MODE``, tested), the pins a manifest records, the structural test, and the digest of the pins.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from collections.abc import Mapping
+from typing import Any
+
+MODE = "sparqlllm"
+
+
+def pins_from_manifest(manifest: Any) -> dict[str, dict[str, Any]]:
+    """The SPARQL-LLM cells' index pins as an OUT's manifest records them, by cell id: the branch phase's pinned arms
+    (``fingerprint.phases.branch.arms.<cell>.by_role.<role>.validator.index``, written by the runner from the spec's cell).
+    Roles that pin different indexes for one cell give a pin no record can match. Empty before the branch phase is pinned."""
+    fingerprint = manifest.get("fingerprint") if isinstance(manifest, dict) else None
+    phases = fingerprint.get("phases") if isinstance(fingerprint, dict) else None
+    branch = phases.get("branch") if isinstance(phases, dict) else None
+    arms = branch.get("arms") if isinstance(branch, dict) else None
+    pins: dict[str, dict[str, Any]] = {}
+    for cid, arm in (arms.items() if isinstance(arms, dict) else ()):
+        by_role = arm.get("by_role") if isinstance(arm, dict) else None
+        for settings in (by_role.values() if isinstance(by_role, dict) else ()):
+            if not isinstance(settings, dict) or settings.get("mode") != MODE:
+                continue
+            validator_block = settings.get("validator") if isinstance(settings.get("validator"), dict) else {}
+            index = validator_block.get("index") if isinstance(validator_block.get("index"), dict) else {}
+            pin = {"graph": index.get("graph"), "sha256": index.get("sha256"), "settings": settings}
+            pins[cid] = pin if cid not in pins or pins[cid] == pin else {"graph": None, "sha256": None, "settings": None}
+    return pins
+
+
+def names_cell(manifest: Any) -> bool:
+    """Whether a parsed OUT manifest names a SPARQL-LLM cell, by its structure and not by a word anywhere in it: a branch arm
+    pinned in the mode, or a cell of that mode among a built OUT's ``baseline_cells.cells`` (before the branch phase is pinned)."""
+    if pins_from_manifest(manifest):
+        return True
+    baseline = manifest.get("baseline_cells") if isinstance(manifest, dict) else None
+    cells = baseline.get("cells") if isinstance(baseline, dict) else None
+    return any(isinstance(c, dict) and c.get("mode") == MODE for c in (cells if isinstance(cells, list) else ()))
+
+
+def claims_cell(record: Any) -> bool:
+    """Whether a run record claims to be a SPARQL-LLM cell's (its checker mode): a record the manifest does not account for."""
+    checker = record.get("checker") if isinstance(record, dict) else None
+    settings = checker.get("settings") if isinstance(checker, dict) else None
+    return isinstance(settings, dict) and settings.get("mode") == MODE
+
+
+def pins_sha256(pins: Mapping[str, Any]) -> str:
+    """A digest of the pins a replay check audited the records against (the check keeps it; a stored check is current for
+    a manifest only while the manifest still pins the same indexes)."""
+    return hashlib.sha256(json.dumps(pins, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()
diff --git a/harness/baselines/sparqlllm/second_arm.py b/harness/baselines/sparqlllm/second_arm.py
new file mode 100644
index 00000000..975c72ce
--- /dev/null
+++ b/harness/baselines/sparqlllm/second_arm.py
@@ -0,0 +1,71 @@
+"""The one adapted, detection-only SPARQL-LLM row: "SPARQL-LLM validator, our adaptation" (design ruling, 24 Oct), and the
+primary arm's reach (a fact about the baseline).
+
+The primary arm is the published validator (vendored byte for byte), detection and one retry. The adapted row replaces the
+earlier "disabled rule only" second arm: upstream's disabled rule enabled AND inference accepting any listed object class
+(adapted.py), labelled as ours, read OFFLINE from the ``validation.adapted`` field the primary cell records for every output.
+No retry is run for it and no model is called. Its flags and the primary's are given side by side per output: ``adapted`` (the
+row's flag), ``published`` (the primary's), ``extra`` (the row flags, the primary does not) and ``dropped`` (the primary flags,
+the row does not: the inference artefacts the row no longer raises). Precision, recall and false-flag rate of the row are read
+by the analysis from these flags joined with the frozen scorer's labels, as for every offline checker.
+
+``reach`` also gives the primary arm's flags BY KIND as one breakdown (published flags with at least one error of each kind, and the
+published flags whose every error is of an artefact kind: ``predicate_inferred``, ``predicate_variable_class``, ``predicate_path``), the
+number of validations cut at the lookup budget and the number of outputs with an unchecked scope, and the share of outputs the
+published validator could not examine at all (``vacuous_pass``).
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from harness.baselines.sparqlllm.adapted import ADAPTED_ID, ADAPTED_LABEL, ADAPTED_NOTE
+
+SECOND_ARM_ID = ADAPTED_ID
+SECOND_ARM_LABEL = ADAPTED_LABEL
+SECOND_ARM_NOTE = ADAPTED_NOTE
+STATUSES = ("flagged", "substantive_pass", "vacuous_pass", "unknown", "no_query")
+KINDS = ("predicate_inferred", "predicate_variable_class", "predicate_path", "type_missing", "predicate", "parse",
+         "recursion", "other")
+ARTEFACT_KINDS = frozenset({"predicate_inferred", "predicate_variable_class", "predicate_path"})
+
+
+def second_flag(validation: dict[str, Any] | None, verdict: dict[str, Any]) -> dict[str, Any]:
+    """The row's reading of one output beside the primary's, from the primary cell's decision (``cell.decide``'s validation and
+    verdict). An output with no checked query is flagged by neither; a validation cut at the budget is not flagged by the
+    primary (unknown) and not by the row."""
+    published = bool(verdict["retry"])
+    adapted = (validation or {}).get("adapted")
+    adapted_flag = bool(adapted and adapted["flagged"] and not adapted["budget_exceeded"]
+                        and not (validation or {}).get("budget_exceeded"))
+    return {"published": published, "adapted": adapted_flag, "extra": adapted_flag and not published,
+            "dropped": published and not adapted_flag}
+
+
+def reach(rows: list[dict[str, Any]], models: list[str] | None = None) -> dict[str, Any]:
+    """Per model: how many outputs there are and how the primary validator's statuses fall. ``rows`` hold ``model``,
+    ``status`` (a verdict status), ``kinds`` (the verdict's error kinds), ``budget_exceeded``, ``unchecked`` and the flags of
+    ``second_flag``. ``vacuous_share`` is the fraction of all the model's outputs that the published validator could not examine
+    (status ``vacuous_pass``). ``flagged_outputs_by_kind`` counts the published flags with at least one error of each kind (one output
+    can count under several; a validation cut at the budget is `unknown`, never a flag, so it is not counted); ``flagged_only_artefact_kinds`` the flagged outputs whose every error is of an artefact kind."""
+    out: dict[str, Any] = {}
+    for model in sorted({r["model"] for r in rows} | set(models or ())):  # a model with no output is reported, with null shares
+        mine = [r for r in rows if r["model"] == model]
+        n = len(mine)
+        counts = {s: sum(1 for r in mine if r["status"] == s) for s in STATUSES}
+        flagged = [r for r in mine if r["published"]]
+        by_kind = {k: sum(1 for r in flagged if r["kinds"].get(k)) for k in KINDS}  # flags only: a cut validation is unknown
+        out[model] = {
+            "outputs": n,
+            "status_counts": counts,
+            "vacuous_share": counts["vacuous_pass"] / n if n else None,
+            "published_flags": len(flagged),
+            "flagged_outputs_by_kind": by_kind,
+            "flagged_only_artefact_kinds": sum(1 for r in flagged if r["kinds"] and set(r["kinds"]) <= ARTEFACT_KINDS),
+            "validations_cut_at_budget": sum(1 for r in mine if r["budget_exceeded"]),
+            "outputs_with_unchecked_scopes": sum(1 for r in mine if r["unchecked"]),
+            "adapted_row_flags": sum(r["adapted"] for r in mine),
+            "adapted_row_extra_flags": sum(r["extra"] for r in mine),
+            "adapted_row_dropped_flags": sum(r["dropped"] for r in mine),
+        }
+    return out
diff --git a/harness/baselines/sparqlllm/sib_absence.py b/harness/baselines/sparqlllm/sib_absence.py
new file mode 100644
index 00000000..1060d749
--- /dev/null
+++ b/harness/baselines/sparqlllm/sib_absence.py
@@ -0,0 +1,939 @@
+"""Proof that none of SIB's example questions or queries is in what the SPARQL-LLM validator loads (design log, AC3).
+
+SIB's UniProt and Rhea examples (sib-swiss/sparql-examples, the pinned commit of ``harness.sib``) are the held-out
+test. The validator reads a VoID map (class -> predicate -> object classes or datatypes, rebuilt from our store), a
+prefix map and fixed message text. Any trace of an example in those files, or in the code that loads them, is a leak.
+This module extracts patterns from the examples and scans files for them. It is a proof only because it can fail:
+``scripts/sparqlllm_sib_absence.py`` refuses (exit 2) when the pattern set could be empty or short, and
+``tests/test_sparqlllm_sib.py`` injects each kind of leak and expects exit 1.
+
+Patterns, per example (every text normalised: NFKC, case-folded, whitespace collapsed; HTML stripped from questions):
+
+  P1  a question text (the whole text, and the HTML original when it differs)
+  P2  the query text (whole, and with PREFIX declarations and/or comment lines removed)
+  P3  every window of 10 consecutive words of a question (a question under 10 words: its whole text)
+  P4  every instance-level IRI of the query: full ``<...>`` IRIs and prefixed names expanded, except vocabulary
+      (a class, predicate or object entry of the VoID map being scanned, or a W3C vocabulary namespace)
+  P5  every string literal of the query of at least 6 characters, except an XSD datatype IRI; matched as a whole
+      string only (a text equal to it), not as a substring
+
+Targets are files and directories (a directory recursively; a ``.gz`` file is decompressed; a file with a NUL byte
+is skipped and counted, and a run that scanned no text file is refused). Every file is searched as raw text and as
+raw text with backslash escapes decoded. A JSON file is also parsed and every string, key and value (duplicate keys
+kept) is a text of its own, plus the document's strings joined by spaces; a Python file is parsed with ``ast`` and
+every string literal is a text of its own, plus the literals joined. All texts are normalised like the patterns, so
+escapes, case and white space cannot hide a match; a text with markup is also searched with its tags removed, for
+P1 and P3. P4 patterns are IRIs: they are searched as written (raw and decoded texts, never case-folded).
+
+An occurrence that lies inside a vocabulary token is not a match. A token is the run of characters around the
+occurrence up to the next quote, bracket, comma, semicolon, backslash or white space; it is vocabulary if it is a
+class, predicate or object entry of the VoID map, a string of the prefix map (``namespaces``) or in a W3C namespace.
+Without this, a short literal such as a database name would "leak" into every IRI that spells it.
+
+A pattern is never printed: a match carries its type, dataset, example file, target and the first 12 hex digits of
+the pattern's sha256. The search is one pass per text with a regular expression of the patterns' trie (``Matcher``).
+"""
+
+from __future__ import annotations
+
+import ast
+import gzip
+import hashlib
+import json
+import re
+import subprocess
+import sys
+import unicodedata
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Iterator
+
+from harness.sib import SIB_COMMIT, load_prefixes, read_example, strip_html
+
+SCHEMA = "sparqlllm-sib-absence/1"
+DATASETS = ("uniprot", "rhea")
+DATASET_DIRS = {"uniprot": "UniProt", "rhea": "Rhea"}
+# The Rhea directory holds 124 examples and one ``prefixes.ttl`` (a prefix declaration file, not an example).
+NOT_EXAMPLES = frozenset({"prefixes.ttl"})
+EXPECT_DEFAULT = {"uniprot": 218, "rhea": 124}
+PTYPES = ("P1", "P2", "P3", "P4", "P5")
+SHINGLE_WORDS = 10
+MIN_LITERAL_CHARS = 6
+
+W3C_NAMESPACES = (
+    "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
+    "http://www.w3.org/2000/01/rdf-schema#",
+    "http://www.w3.org/2002/07/owl#",
+    "http://www.w3.org/2001/XMLSchema#",
+    "http://www.w3.org/2004/02/skos/core#",
+    "http://www.w3.org/ns/shacl#",
+    "http://rdfs.org/ns/void#",
+)
+XSD_NAMESPACE = "http://www.w3.org/2001/XMLSchema#"
+SEP = "\x00"
+
+
+class Refusal(Exception):
+    """The proof cannot be run as specified (exit 2); the message names no pattern text."""
+
+
+# ---------------------------------------------------------------------------
+# Normalisation
+
+
+def normalise(text: str) -> str:
+    """NFKC, case-folded, whitespace collapsed (the form of every text-type pattern and every scanned text)."""
+    t = unicodedata.normalize("NFKC", text)
+    t = unicodedata.normalize("NFKC", t.casefold())
+    return " ".join(t.split())
+
+
+def _strip_html_safe(text: str) -> str | None:
+    try:
+        return strip_html(text)
+    except Exception:  # noqa: BLE001 - html.parser rejects some malformed input; the view is then absent
+        return None
+
+
+# ---------------------------------------------------------------------------
+# SPARQL terms of a query: the parse tree when it parses, a lexer otherwise
+
+_TOKEN = re.compile(
+    r"""
+    (?P<long>\"\"\"(?:[^"\\]|\\.|"(?!""))*\"\"\"|'''(?:[^'\\]|\\.|'(?!''))*''')
+  | (?P<short>"(?:[^"\\\n\r]|\\.)*"|'(?:[^'\\\n\r]|\\.)*')
+  | (?P<comment>\#[^\n\r]*)
+  | (?P<iri><[^<>"{}|^`\\\x00-\x20]*>)
+  | (?P<var>[?$][A-Za-z0-9_]+)
+  | (?P<kw>\b(?:PREFIX|BASE)(?=\s))
+  | (?P<pname>(?:[A-Za-z][A-Za-z0-9_.-]*)?:(?:[A-Za-z0-9_:.%-]|\\.)*)
+    """,
+    re.VERBOSE | re.DOTALL | re.IGNORECASE,
+)
+_ESCAPES = {"t": "\t", "b": "\b", "n": "\n", "r": "\r", "f": "\f", '"': '"', "'": "'", "\\": "\\"}
+_ESCAPE = re.compile(r"\\(?:u([0-9A-Fa-f]{4})|U([0-9A-Fa-f]{8})|(.))", re.DOTALL)
+
+
+def _unescape(body: str) -> str:
+    def one(m: re.Match) -> str:
+        if m.group(1) or m.group(2):
+            try:
+                return chr(int(m.group(1) or m.group(2), 16))
+            except (ValueError, OverflowError):
+                return m.group(0)
+        return _ESCAPES.get(m.group(3), m.group(0))
+
+    return _ESCAPE.sub(one, body)
+
+
+@dataclass
+class QueryTerms:
+    iris: set[str] = field(default_factory=set)  # full IRIs written as <...>, no declaration IRIs
+    pnames: list[tuple[str, str]] = field(default_factory=list)  # (prefix, local name) as written
+    strings: set[str] = field(default_factory=set)  # decoded string literals
+    prefixes: dict[str, str] = field(default_factory=dict)  # the query's own PREFIX declarations
+    parsed: bool = True  # False when the lexer fallback produced the terms
+
+
+def _terms_from_tree(query: str) -> QueryTerms:
+    from pyparsing import ParseResults
+    from rdflib import Literal, URIRef
+    from rdflib.plugins.sparql.parserutils import CompValue
+
+    from harness.sparql_grammar import parse_query
+
+    tree = parse_query(query)
+    out = QueryTerms()
+
+    def visit(node: Any) -> None:
+        if isinstance(node, CompValue):
+            if node.name == "PrefixDecl":
+                out.prefixes[node.get("prefix") or ""] = str(node.get("iri"))
+                return
+            if node.name == "Base":
+                return
+            if node.name == "pname":
+                out.pnames.append((node.get("prefix") or "", node.get("localname") or ""))
+                return
+            for value in node.values():
+                visit(value)
+        elif isinstance(node, URIRef):
+            if str(node):
+                out.iris.add(str(node))
+        elif isinstance(node, Literal):
+            if node.datatype is None:  # a plain or language-tagged string; typed literals are numbers and booleans
+                out.strings.add(str(node))
+        elif isinstance(node, (list, tuple, ParseResults)):
+            for value in node:
+                visit(value)
+
+    visit(tree[0])
+    visit(tree[1])
+    return out
+
+
+def _terms_from_lexer(query: str) -> QueryTerms:
+    out = QueryTerms(parsed=False)
+    pending: str | None = None  # "PREFIX" / "BASE" keyword just seen
+    label: str | None = None  # the prefix label after PREFIX
+    for m in _TOKEN.finditer(query):
+        kind = m.lastgroup
+        text = m.group(0)
+        if kind == "kw":
+            pending, label = text.upper(), None
+            continue
+        if kind == "pname" and pending == "PREFIX" and label is None and text.endswith(":"):
+            label = text[:-1]
+            continue
+        if kind == "iri":
+            body = text[1:-1]
+            if pending == "PREFIX" and label is not None:
+                out.prefixes[label] = body
+            elif pending == "BASE":
+                pass
+            elif body:
+                out.iris.add(body)
+            pending, label = None, None
+            continue
+        pending, label = None, None
+        if kind == "pname":
+            prefix, _, local = text.partition(":")
+            out.pnames.append((prefix, local.rstrip(".")))
+        elif kind == "long":
+            out.strings.add(_unescape(text[3:-3]))
+        elif kind == "short":
+            out.strings.add(_unescape(text[1:-1]))
+    return out
+
+
+def query_terms(query: str) -> QueryTerms:
+    try:
+        return _terms_from_tree(query)
+    except Exception:  # noqa: BLE001 - any parse failure: fall back to the lexer
+        return _terms_from_lexer(query)
+
+
+# ---------------------------------------------------------------------------
+# Vocabulary (what is not an instance-level IRI)
+
+
+@dataclass
+class Vocabulary:
+    classes: frozenset[str] = frozenset()
+    predicates: frozenset[str] = frozenset()
+    objects: frozenset[str] = frozenset()
+    strict: bool = False  # object entries do not count as vocabulary on their own
+    sha256: str | None = None
+
+    def role(self, iri: str) -> str | None:
+        """Why ``iri`` is vocabulary (first reason), or None for an instance-level IRI."""
+        if iri.startswith(W3C_NAMESPACES):
+            return "w3c"
+        if iri in self.classes:
+            return "class"
+        if iri in self.predicates:
+            return "predicate"
+        if not self.strict and iri in self.objects:
+            return "object"
+        return None
+
+    def size(self) -> int:
+        return len(self.classes | self.predicates | self.objects)
+
+
+def read_voidmap_vocabulary(path: str | Path, strict: bool = False) -> Vocabulary:
+    """The vocabulary of a voidmap.json: ``{"classes": {class: {"entities": n, "properties": {pred: [objects]}}}}``."""
+    data = Path(path).read_bytes()
+    try:
+        doc = json.loads(data.decode("utf-8-sig"))
+    except (ValueError, UnicodeDecodeError) as exc:
+        raise Refusal(f"voidmap {Path(path).name} is not JSON ({type(exc).__name__})") from exc
+    classes = doc.get("classes") if isinstance(doc, dict) else None
+    if not isinstance(classes, dict):
+        raise Refusal(f"voidmap {Path(path).name} has no 'classes' object")
+    preds: set[str] = set()
+    objs: set[str] = set()
+    for cls, entry in classes.items():
+        props = entry.get("properties") if isinstance(entry, dict) else None
+        if not isinstance(props, dict):
+            raise Refusal(f"voidmap {Path(path).name}: a class entry has no 'properties' object")
+        for pred, targets in props.items():
+            preds.add(pred)
+            if not isinstance(targets, list):
+                raise Refusal(f"voidmap {Path(path).name}: a predicate entry is not a list")
+            objs.update(t for t in targets if isinstance(t, str))
+    return Vocabulary(frozenset(classes), frozenset(preds), frozenset(objs), strict, hashlib.sha256(data).hexdigest())
+
+
+def is_namespace(text: str) -> bool:
+    """An IRI that closes with ``/`` or ``#``: the shape of a prefix map's value."""
+    return "://" in text and text.endswith(("/", "#"))
+
+
+def _namespace_strings(node: Any, out: set[str]) -> None:
+    if isinstance(node, tuple):  # an object as its (key, value) pairs
+        for key, value in node:
+            if isinstance(key, str) and is_namespace(key):
+                out.add(key)
+            if isinstance(value, str) and is_namespace(value):
+                out.add(value)
+                if isinstance(key, str):
+                    out.add(key)  # the prefix label of a "label": "namespace" entry
+            else:
+                _namespace_strings(value, out)
+    elif isinstance(node, list):
+        for item in node:
+            _namespace_strings(item, out)
+    elif isinstance(node, str) and is_namespace(node):
+        out.add(node)
+
+
+def read_namespaces(path: str | Path) -> tuple[frozenset[str], str]:
+    """The namespaces of the validator's prefix map, a JSON file: its IRI strings that end in ``/`` or ``#``, and the
+    keys of the entries that hold one. Nothing else in the file counts, so the file cannot approve a leak by holding
+    it. Returns the set and the file's sha256. A file with no namespace is a refusal: it would add nothing and look
+    as if it did."""
+    data = Path(path).read_bytes()
+    try:
+        doc = json.loads(data.decode("utf-8-sig"), object_pairs_hook=_pairs_hook)
+    except (ValueError, UnicodeDecodeError) as exc:
+        raise Refusal(f"namespaces file {Path(path).name} is not JSON ({type(exc).__name__})") from exc
+    found: set[str] = set()
+    _namespace_strings(doc, found)
+    if not any(is_namespace(x) for x in found):
+        raise Refusal(f"namespaces file {Path(path).name} holds no namespace IRI")
+    return frozenset(found), hashlib.sha256(data).hexdigest()
+
+
+# ---------------------------------------------------------------------------
+# Examples
+
+
+def git_head(checkout: Path) -> str:
+    try:
+        done = subprocess.run(
+            ["git", "-C", str(checkout), "rev-parse", "HEAD"], capture_output=True, text=True, check=False, timeout=60
+        )
+    except (OSError, subprocess.SubprocessError) as exc:
+        raise Refusal(f"git is not usable on {checkout} ({type(exc).__name__})") from exc
+    if done.returncode != 0:
+        raise Refusal(f"{checkout} is not a git checkout")
+    return done.stdout.strip()
+
+
+def git_dirty(checkout: Path) -> bool:
+    done = subprocess.run(
+        ["git", "-C", str(checkout), "status", "--porcelain", "--untracked-files=no"],
+        capture_output=True, text=True, check=False, timeout=60,
+    )  # fmt: skip
+    return done.returncode != 0 or bool(done.stdout.strip())
+
+
+def load_examples(
+    checkout: str | Path, expect: dict[str, int] | None = None, expect_commit: str = SIB_COMMIT
+) -> tuple[dict[str, list[dict[str, Any]]], dict[str, str], str]:
+    """Verify the checkout, read the examples and assert the counts, before anything is scanned.
+
+    Returns ``({dataset: [example]}, root prefix map, commit)``; raises Refusal on a wrong commit, a modified
+    tracked file, a wrong count, a file that is not one example, or an example without a question or a query.
+    """
+    checkout = Path(checkout)
+    expect = {**EXPECT_DEFAULT, **(expect or {})}
+    if not checkout.is_dir():
+        raise Refusal(f"examples dir {checkout} does not exist")
+    head = git_head(checkout)
+    if head != expect_commit:
+        raise Refusal(f"examples checkout is at {head[:12]}, the pin is {expect_commit[:12]}")
+    if git_dirty(checkout):
+        raise Refusal("examples checkout has modified tracked files")
+    root = checkout / "examples"
+    out: dict[str, list[dict[str, Any]]] = {}
+    for ds in DATASETS:
+        directory = root / DATASET_DIRS[ds]
+        files = sorted(p for p in directory.glob("*.ttl") if p.name not in NOT_EXAMPLES) if directory.is_dir() else []
+        if len(files) != expect[ds]:
+            raise Refusal(f"{ds}: {len(files)} example files, expected {expect[ds]}")
+        examples = []
+        for f in files:
+            try:
+                ex = read_example(f)
+            except Exception as exc:  # noqa: BLE001
+                raise Refusal(f"{ds}/{f.name}: not one example ({type(exc).__name__})") from exc
+            if not any(c["text"] for c in ex["comments"]) or not ex["query_original"].strip():
+                raise Refusal(f"{ds}/{f.name}: no question text or no query")
+            examples.append(ex)
+        out[ds] = examples
+    try:
+        prefixes = load_prefixes(root / "prefixes.ttl")
+    except Exception as exc:  # noqa: BLE001
+        raise Refusal(f"examples/prefixes.ttl unreadable ({type(exc).__name__})") from exc
+    return out, prefixes, head
+
+
+# ---------------------------------------------------------------------------
+# Patterns
+
+_PREFIX_DECL = re.compile(r"\b(?:PREFIX\s+[A-Za-z0-9_.-]*:\s*<[^<>]*>|BASE\s+<[^<>]*>)", re.IGNORECASE)
+
+
+def _drop_comment_lines(query: str) -> str:
+    return "\n".join(line for line in query.splitlines() if not line.lstrip().startswith("#"))
+
+
+def query_variants(query: str) -> list[str]:
+    """The query text as written, without comment lines, without PREFIX/BASE declarations, without both."""
+    no_comments = _drop_comment_lines(query)
+    return [
+        query,
+        no_comments,
+        _PREFIX_DECL.sub(" ", query),
+        _PREFIX_DECL.sub(" ", no_comments),
+    ]
+
+
+@dataclass
+class PatternSet:
+    # (kind, text) -> {(ptype, dataset, example file)}; kind "text" is matched against normalised texts, "iri" as written
+    patterns: dict[tuple[str, str], set[tuple[str, str, str]]] = field(default_factory=dict)
+    counts: dict[str, dict[str, int]] = field(default_factory=dict)  # dataset -> ptype -> distinct patterns
+    examples: dict[str, int] = field(default_factory=dict)
+    iri_extraction: dict[str, int] = field(default_factory=lambda: {"parser": 0, "lexer": 0})
+    unresolved_prefixed_names: int = 0
+    p4_candidates: int = 0  # distinct IRIs of the queries before the vocabulary is removed
+    p4_excluded: dict[str, int] = field(default_factory=lambda: {"w3c": 0, "class": 0, "predicate": 0, "object": 0})
+    _matchers: dict[str, Any] = field(default_factory=dict, repr=False)
+    _questions: set[str] | None = field(default=None, repr=False)
+
+    def matcher(self, kind: str) -> "Matcher":
+        if kind not in self._matchers:
+            self._matchers[kind] = Matcher(text for k, text in self.patterns if k == kind)
+        return self._matchers[kind]
+
+    def question_texts(self) -> set[str]:
+        if self._questions is None:
+            self._questions = {
+                text for (k, text), src in self.patterns.items() if k == "text" and any(x[0] in ("P1", "P3") for x in src)
+            }
+        return self._questions
+
+    def digest(self) -> str:
+        texts = sorted({text for _, text in self.patterns})
+        return hashlib.sha256("\n".join(texts).encode("utf-8")).hexdigest()
+
+    def total(self) -> int:
+        return len({text for _, text in self.patterns})
+
+    def add(self, kind: str, text: str, ptype: str, dataset: str, example: str, seen: set) -> None:
+        if not text:
+            raise Refusal(f"{dataset}/{example}: an empty {ptype} pattern")
+        self.patterns.setdefault((kind, text), set()).add((ptype, dataset, example))
+        if (dataset, ptype, text) not in seen:
+            seen.add((dataset, ptype, text))
+            self.counts[dataset][ptype] += 1
+
+
+def pattern_id(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:12]
+
+
+def build_patterns(
+    examples: dict[str, list[dict[str, Any]]],
+    prefixes: dict[str, str],
+    vocab: Vocabulary | None = None,
+    min_literal_chars: int = MIN_LITERAL_CHARS,
+) -> PatternSet:
+    vocab = vocab or Vocabulary()
+    ps = PatternSet()
+    seen: set = set()
+    excluded_seen: set[str] = set()
+    candidates: set[str] = set()
+    for ds in DATASETS:
+        ps.counts[ds] = {p: 0 for p in PTYPES}
+        ps.examples[ds] = len(examples[ds])
+        for ex in examples[ds]:
+            name = ex["file"]
+            # P1 and P3: the question texts
+            for c in ex["comments"]:
+                text = normalise(c["text"])
+                if text:
+                    ps.add("text", text, "P1", ds, name, seen)
+                    words = text.split(" ")
+                    if len(words) < SHINGLE_WORDS:
+                        ps.add("text", text, "P3", ds, name, seen)
+                    for i in range(len(words) - SHINGLE_WORDS + 1):
+                        ps.add("text", " ".join(words[i : i + SHINGLE_WORDS]), "P3", ds, name, seen)
+                original = normalise(c["original"])
+                if original and original != text:
+                    ps.add("text", original, "P1", ds, name, seen)
+            # P2: the query text
+            for variant in query_variants(ex["query_original"]):
+                text = normalise(variant)
+                if text:
+                    ps.add("text", text, "P2", ds, name, seen)
+            # P4 and P5: the terms of the query
+            terms = query_terms(ex["query_original"])
+            ps.iri_extraction["parser" if terms.parsed else "lexer"] += 1
+            iris = set(terms.iris)
+            for prefix, local in terms.pnames:
+                ns = terms.prefixes.get(prefix, prefixes.get(prefix))
+                if ns is None:
+                    ps.unresolved_prefixed_names += 1
+                else:
+                    iris.add(ns + local)
+            for iri in sorted(iris):
+                candidates.add(iri)
+                role = vocab.role(iri)
+                if role is None:
+                    ps.add("iri", iri, "P4", ds, name, seen)
+                elif iri not in excluded_seen:
+                    excluded_seen.add(iri)
+                    ps.p4_excluded[role] += 1
+            for lit in sorted(terms.strings):
+                text = normalise(lit)
+                if len(text) >= min_literal_chars and not lit.startswith(XSD_NAMESPACE):
+                    ps.add("text", text, "P5", ds, name, seen)
+    ps.p4_candidates = len(candidates)
+    return ps
+
+
+# ---------------------------------------------------------------------------
+# Targets
+
+
+@dataclass
+class TargetResult:
+    path: str
+    sha256: str
+    texts_scanned: int
+    skipped: str | None = None
+
+
+def _json_strings(node: Any, out: list[str]) -> None:
+    if isinstance(node, str):
+        out.append(node)
+    elif isinstance(node, list):
+        for item in node:
+            _json_strings(item, out)
+    elif isinstance(node, tuple):  # an object as its (key, value) pairs: duplicate keys are all kept
+        for key, value in node:
+            _json_strings(key, out)
+            _json_strings(value, out)
+
+
+def _pairs_hook(pairs: list) -> tuple:
+    return tuple(pairs)
+
+
+def _json_texts(text: str) -> list[str] | None:
+    try:
+        doc = json.loads(text, object_pairs_hook=_pairs_hook)
+    except (ValueError, RecursionError):
+        return None
+    out: list[str] = []
+    _json_strings(doc, out)
+    return out
+
+
+def _json_lines_texts(text: str) -> list[str] | None:
+    out: list[str] = []
+    ok = False
+    for line in text.splitlines():
+        if line.strip():
+            part = _json_texts(line)
+            if part is None:
+                return None
+            out.extend(part)
+            ok = True
+    return out if ok else None
+
+
+def _fold_str(node: ast.AST) -> str | None:
+    if isinstance(node, ast.Constant) and isinstance(node.value, str):
+        return node.value
+    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
+        left, right = _fold_str(node.left), _fold_str(node.right)
+        if left is not None and right is not None:
+            return left + right
+    return None
+
+
+def _python_texts(text: str) -> list[str] | None:
+    try:
+        tree = ast.parse(text)
+    except (SyntaxError, ValueError, RecursionError):
+        return None
+    out: list[str] = []
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Constant):
+            if isinstance(node.value, str):
+                out.append(node.value)
+            elif isinstance(node.value, bytes):
+                out.append(node.value.decode("utf-8", errors="replace"))
+        elif isinstance(node, ast.BinOp):
+            folded = _fold_str(node)
+            if folded is not None:
+                out.append(folded)
+    return out
+
+
+def texts_of(name: str, data: bytes) -> tuple[list[str] | None, str | None]:
+    """The texts of one file: ``(texts, None)`` or ``(None, reason it was skipped)``."""
+    if name.endswith(".gz"):
+        try:
+            data = gzip.decompress(data)
+        except (OSError, EOFError):
+            return None, "unreadable gzip"
+        name = name[:-3]
+    if b"\x00" in data[:8192]:
+        return None, "binary"
+    text = data.decode("utf-8", errors="replace").lstrip("﻿")
+    texts = [text]
+    if "\\" in text:
+        texts.append(_unescape(text))  # Turtle, N-Triples and SPARQL escapes: backslash-quote, \n, \uXXXX
+    suffix = Path(name).suffix.lower()
+    structured: list[str] | None = None
+    if suffix == ".py":
+        structured = _python_texts(text)
+    elif suffix in (".jsonl", ".ndjson"):
+        structured = _json_lines_texts(text)
+    elif suffix == ".json" or text.lstrip()[:1] in ("{", "["):
+        structured = _json_texts(text)
+    if structured is not None:
+        texts.extend(structured)
+        if len(structured) > 1:
+            texts.append(" ".join(structured))  # a leak split over neighbouring strings
+    return texts, None
+
+
+def collect_targets(paths: list[str]) -> list[tuple[str, Path]]:
+    """Every file under the --scan paths, sorted; a missing, empty or file-less path is a refusal."""
+    import os
+
+    found: list[tuple[str, Path]] = []
+    for arg in paths:
+        p = Path(arg)
+        if not p.exists():
+            raise Refusal(f"--scan path {arg} does not exist")
+        if p.is_file():
+            if p.stat().st_size == 0:
+                raise Refusal(f"--scan file {arg} is empty")
+            found.append((os.path.normpath(arg), p))
+            continue
+        files = []
+        for root, dirs, names in os.walk(p, followlinks=False):
+            dirs.sort()
+            files.extend(Path(root, n) for n in sorted(names))
+        if not files:
+            raise Refusal(f"--scan directory {arg} holds no file")
+        found.extend((os.path.normpath(str(f)), f) for f in files)
+    return found
+
+
