+# Scanning
+
+
+@dataclass
+class Match:
+    ptype: str
+    dataset: str
+    example: str
+    target: str
+    pid: str
+
+    def key(self) -> tuple:
+        return (self.target, self.ptype, self.dataset, self.example, self.pid)
+
+
+_DELIMS = frozenset(" \t\r\n\x00\"'<>()[]{},;|^`\\")
+
+
+@dataclass
+class TokenFilter:
+    """Tokens that are vocabulary: an occurrence of a pattern inside one of them is not a leak.
+
+    A token is the run of characters around the occurrence up to the next delimiter (white space, quotes, brackets,
+    comma, semicolon, backslash), so a whole JSON string, a ``<...>`` IRI or a word of prose. Without it a short
+    literal such as a place or database name would "leak" into every class IRI that spells it, and an IRI that is
+    the beginning of a longer vocabulary IRI into that one. Vocabulary tokens (the VoID map's classes, predicates
+    and objects, and the W3C namespaces) cover every pattern. Namespace tokens (the prefix map) cover the text
+    patterns, and an IRI pattern only when it is the namespace without its closing ``/`` or ``#``.
+    """
+
+    vocab_raw: frozenset[str] = frozenset()
+    vocab_norm: frozenset[str] = frozenset()
+    ns_raw: frozenset[str] = frozenset()
+    ns_norm: frozenset[str] = frozenset()
+    w3c_raw: tuple[str, ...] = W3C_NAMESPACES
+    w3c_norm: tuple[str, ...] = tuple(normalise(n) for n in W3C_NAMESPACES)
+
+    @classmethod
+    def build(cls, vocab: Vocabulary | None, namespaces: frozenset[str] = frozenset()) -> "TokenFilter":
+        names: set[str] = set()
+        if vocab is not None:
+            names |= vocab.classes | vocab.predicates
+            if not vocab.strict:
+                names |= vocab.objects
+        return cls(
+            frozenset(names), frozenset(normalise(n) for n in names),
+            frozenset(namespaces), frozenset(normalise(n) for n in namespaces),
+        )  # fmt: skip
+
+    def allows(self, token: str, normalised: bool, kind: str, pattern: str) -> bool:
+        if normalised:
+            vocab, ns, w3c = self.vocab_norm, self.ns_norm, self.w3c_norm
+        else:
+            vocab, ns, w3c = self.vocab_raw, self.ns_raw, self.w3c_raw
+        token = token.rstrip(".:")
+        if token in vocab or token.startswith(w3c):
+            return True
+        if token not in ns:
+            return False
+        return kind == "text" or token[:-1] == pattern
+
+
+def _trie_regex(pats: list[str]) -> str:
+    """One regular expression for a sorted list of distinct non-empty strings: their trie, shared prefixes written
+    once, so the engine tests a position against the first characters instead of against every string. A node that
+    ends a string and continues is ``(?:...)?``, which is greedy: a search returns the longest string at a position."""
+
+    def build(lo: int, hi: int, depth: int) -> str:
+        # pats[lo:hi] all share pats[lo][:depth]; the only one that can end here is the first (sorted order)
+        terminal = len(pats[lo]) == depth
+        parts = []
+        i = lo + 1 if terminal else lo
+        while i < hi:
+            ch = pats[i][depth]
+            j = i
+            while j < hi and pats[j][depth] == ch:
+                j += 1
+            first, last = pats[i], pats[j - 1]
+            k = depth + 1
+            limit = min(len(first), len(last))
+            while k < limit and first[k] == last[k]:
+                k += 1
+            parts.append(re.escape(first[depth:k]) + build(i, j, k))
+            i = j
+        if not parts:
+            return ""
+        body = parts[0] if len(parts) == 1 else "(?:" + "|".join(parts) + ")"
+        return "(?:" + body + ")?" if terminal else body
+
+    return build(0, len(pats), 0)
+
+
+class Matcher:
+    """Every pattern that occurs in a text, overlapping and nested occurrences included, found in one pass.
+
+    ``find_all`` searches the trie regex from each position after a hit, so it returns the longest pattern at each
+    start; the shorter patterns that are prefixes of that match are found by their first ``HEAD`` characters.
+    """
+
+    HEAD = 12
+
+    def __init__(self, patterns: Any):
+        pats = sorted(set(patterns))
+        if any(not p for p in pats):
+            raise Refusal("an empty pattern")
+        self.heads: dict[str, list[str]] = {}
+        self.short: list[str] = []
+        for p in pats:
+            if len(p) < self.HEAD:
+                self.short.append(p)
+            else:
+                self.heads.setdefault(p[: self.HEAD], []).append(p)
+        old = sys.getrecursionlimit()
+        sys.setrecursionlimit(max(old, 20000))
+        try:
+            self.rx = re.compile(_trie_regex(pats)) if pats else None
+        finally:
+            sys.setrecursionlimit(old)
+
+    def find_all(self, view: str) -> Iterator[tuple[int, str]]:
+        rx = self.rx
+        pos = 0
+        while rx is not None:
+            m = rx.search(view, pos)
+            if m is None:
+                return
+            start, matched = m.start(), m.group(0)
+            if len(matched) >= self.HEAD:
+                for p in self.heads.get(matched[: self.HEAD], ()):
+                    if matched.startswith(p):
+                        yield start, p
+            for p in self.short:
+                if matched.startswith(p):
+                    yield start, p
+            pos = start + 1
+
+
+def _token_at(view: str, start: int, end: int) -> str:
+    left, right = start, end
+    while left > 0 and view[left - 1] not in _DELIMS:
+        left -= 1
+    while right < len(view) and view[right] not in _DELIMS:
+        right += 1
+    return view[left:right]
+
+
+def view_hits(view: str, matcher: Matcher, tf: TokenFilter, normalised: bool, kind: str) -> set[str]:
+    """The patterns that occur in ``view`` somewhere other than inside a vocabulary token."""
+    hits: set[str] = set()
+    for start, pat in matcher.find_all(view):
+        if pat not in hits and not tf.allows(_token_at(view, start, start + len(pat)), normalised, kind, pat):
+            hits.add(pat)
+    return hits
+
+
+def scan_target(label: str, texts: list[str], ps: PatternSet, tf: TokenFilter | None = None) -> list[Match]:
+    tf = tf or TokenFilter()
+    unique = list(dict.fromkeys(t.replace(SEP, " ") for t in texts))
+    raw_view = SEP.join(unique)
+    norm_view = SEP.join(dict.fromkeys(normalise(t) for t in unique))
+    # a question inside HTML markup: the texts with their tags removed, searched for P1 and P3 only
+    stripped = [s for t in unique if "<" in t or "&" in t for s in [_strip_html_safe(t)] if s is not None]
+    strip_view = SEP.join(dict.fromkeys(normalise(s) for s in stripped))
+    text_matcher, iri_matcher = ps.matcher("text"), ps.matcher("iri")
+    text_hits = view_hits(norm_view, text_matcher, tf, True, "text")
+    iri_hits = view_hits(raw_view, iri_matcher, tf, False, "iri")
+    question_hits: set[str] = set()
+    if strip_view:
+        question_hits = {t for t in view_hits(strip_view, text_matcher, tf, True, "text") if t in ps.question_texts()}
+    # P5 (a string literal of a query, six characters or more) is matched as a whole string only: a literal of six or
+    # seven letters is an ordinary word ("uniprot", "cancer"), which as a substring flags the graph's own name and
+    # the prose of any code. A literal inside a longer text of a leak is found through the question and query
+    # patterns (P1 to P3), which are matched as substrings.
+    whole = {normalise(t) for t in unique}
+    found: dict[tuple, Match] = {}
+    for kind, hits in (("text", text_hits), ("iri", iri_hits), ("question", question_hits)):
+        for text in hits:
+            sources = ps.patterns[("iri" if kind == "iri" else "text", text)]
+            if kind == "question":
+                sources = {x for x in sources if x[0] in ("P1", "P3")}
+            elif kind == "text":
+                sources = {x for x in sources if x[0] != "P5" or text in whole}
+            pid = pattern_id(text)
+            for ptype, dataset, example in sources:
+                m = Match(ptype, dataset, example, label, pid)
+                found[m.key()] = m
+    return [found[k] for k in sorted(found)]
+
+
+def scan(
+    targets: list[tuple[str, Path]], ps: PatternSet, tf: TokenFilter | None = None
+) -> tuple[list[TargetResult], list[Match]]:
+    results: list[TargetResult] = []
+    matches: list[Match] = []
+    for label, path in targets:
+        data = path.read_bytes()
+        digest = hashlib.sha256(data).hexdigest()
+        texts, skipped = texts_of(path.name, data)
+        if texts is None:
+            results.append(TargetResult(label, digest, 0, skipped))
+            continue
+        results.append(TargetResult(label, digest, len(texts)))
+        matches.extend(scan_target(label, texts, ps, tf))
+    return results, matches
+
+
+# ---------------------------------------------------------------------------
+# The proof
+
+
+def report_dict(
+    commit: str | None,
+    ps: PatternSet | None,
+    results: list[TargetResult],
+    matches: list[Match],
+    exit_code: int,
+    vocab: Vocabulary | None = None,
+    refusal: str | None = None,
+    namespaces: tuple[int, str] | None = None,
+    min_literal_chars: int = MIN_LITERAL_CHARS,
+) -> dict[str, Any]:
+    """The report: counts, digests, targets and match records. It holds no pattern text, only 12-digit hashes."""
+    counts: dict[str, Any] = {}
+    if ps is not None:
+        counts = {
+            "examples": dict(ps.examples),
+            "patterns": {ds: dict(ps.counts[ds]) for ds in DATASETS},
+            "patterns_distinct_total": ps.total(),
+            "iri_extraction": dict(ps.iri_extraction),
+            "unresolved_prefixed_names": ps.unresolved_prefixed_names,
+            "p4_candidates_distinct": ps.p4_candidates,
+            "p4_excluded_as_vocabulary": dict(ps.p4_excluded),
+        }
+    voidmap = None
+    if vocab is not None:
+        voidmap = {"sha256": vocab.sha256, "vocabulary_iris": vocab.size(), "strict": vocab.strict}
+    targets = []
+    for r in results:
+        entry: dict[str, Any] = {"path": r.path, "sha256": r.sha256, "texts_scanned": r.texts_scanned}
+        if r.skipped:
+            entry["skipped"] = r.skipped
+        targets.append(entry)
+    return {
+        "schema": SCHEMA,
+        "examples_commit": commit,
+        "counts": counts,
+        "pattern_set_sha256": ps.digest() if ps is not None else None,
+        "settings": {"shingle_words": SHINGLE_WORDS, "min_literal_chars": min_literal_chars},
+        "voidmap": voidmap,
+        "namespaces": None if namespaces is None else {"iris": namespaces[0], "sha256": namespaces[1]},
+        "targets": targets,
+        "matches": len(matches),
+        "match_counts": {p: sum(1 for m in matches if m.ptype == p) for p in PTYPES},
+        "match_list": [
+            {"type": m.ptype, "dataset": m.dataset, "example": m.example, "target": m.target, "pattern_sha12": m.pid}
+            for m in matches
+        ],
+        "refusal": refusal,
+        "exit": exit_code,
+    }
+
+
+def run_proof(
+    examples_dir: str | Path,
+    scan_paths: list[str],
+    *,
+    voidmap: str | Path | None = None,
+    namespaces: str | Path | None = None,
+    strict_vocabulary: bool = False,
+    expect: dict[str, int] | None = None,
+    expect_commit: str = SIB_COMMIT,
+    min_literal_chars: int = MIN_LITERAL_CHARS,
+) -> tuple[int, dict[str, Any], PatternSet | None, list[Match]]:
+    """Run the proof: ``(exit code, report, patterns, matches)``. Exit 0 clean, 1 a match, 2 refused."""
+    commit: str | None = None
+    ps: PatternSet | None = None
+    vocab: Vocabulary | None = None
+    ns_info: tuple[int, str] | None = None
+    results: list[TargetResult] = []
+    matches: list[Match] = []
+
+    def report(code: int, found: list[Match], why: str | None = None) -> dict[str, Any]:
+        return report_dict(commit, ps, results, found, code, vocab, why, ns_info, min_literal_chars)
+
+    try:
+        if not scan_paths:
+            raise Refusal("no --scan path given")
+        if min_literal_chars < 1:
+            raise Refusal("--min-literal-chars must be at least 1")
+        examples, prefixes, commit = load_examples(examples_dir, expect, expect_commit)
+        vocab = read_voidmap_vocabulary(voidmap, strict_vocabulary) if voidmap else None
+        ns_set: frozenset[str] = frozenset()
+        if namespaces:
+            ns_set, ns_sha = read_namespaces(namespaces)
+            ns_info = (len(ns_set), ns_sha)
+        ps = build_patterns(examples, prefixes, vocab, min_literal_chars)
+        missing = [ds for ds in DATASETS if any(ps.counts[ds][p] == 0 for p in ("P1", "P2", "P3"))]
+        if missing:
+            raise Refusal(f"no P1/P2/P3 patterns for {', '.join(missing)}")
+        targets = collect_targets(scan_paths)
+        results, matches = scan(targets, ps, TokenFilter.build(vocab, ns_set))
+        if not any(r.skipped is None for r in results):
+            raise Refusal("no text file was scanned (every target was skipped as binary)")
+    except Refusal as exc:
+        return 2, report(2, [], str(exc)), ps, []
+    code = 1 if matches else 0
+    return code, report(code, matches), ps, matches
