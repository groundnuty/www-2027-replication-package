+# Science, the design log:51Z (the follow-up of change-log entry 180): the Gateway routes' 600 s request
+# time-out cut probe replies, so a probe run takes a model's own request time-out from run_pilot's plain-path file,
+# read and applied by the same plain_runner_settings (grid_models), so that a probe route is rebuilt exactly as an agent
+# run's is. Nothing else of the run changes: without the flag the table is used as it is.
+def probe_runner_settings(path: Path, names: list[str], models: dict[str, ModelSpec]
+                          ) -> tuple[dict[str, ModelSpec], dict]:
+    """``--runner-settings``: (the table with each named model's route rebuilt with its request time-out, the file's
+    object). Refused as run_pilot refuses the file, and when it sets ``max_turns``: a probe is one call with no tools,
+    so a turn cap would cap nothing (a key that changes nothing is not accepted as if it did)."""
+    table, settings = plain_runner_settings(path, names, models)
+    if TURN_CAP_KEY in settings:
+        raise Refused(f"--runner-settings {path}: {TURN_CAP_KEY}: a probe is one call with no tools, so it has no turns "
+                      f"to cap; leave the key out")
+    return dict(table), settings
+
+
+# --- call-only plans ------------------------------------------------------------------------------
+# Science, the design log (23 Oct): the runs cannot call every attempt of the full plan by the cut, so a start may
+# be told to call a subset. The file is read once (the bytes hashed are the bytes parsed) and checked in two steps:
+# its own form and the models in run() (no question is loaded), its place in this run's order in _run (before anything
+# is written). A message names an attempt by its index in the file, never by its ids: a private graph's ids stay
+# in its directory.
+
+
+def _object_without_repeated_keys(pairs: list[tuple[str, Any]]) -> dict:
+    """json.loads keeps the last of a repeated key and drops the others, which could hide a list behind another."""
+    keys = [k for k, _ in pairs]
+    if len(set(keys)) != len(keys):
+        raise ValueError("a key is given twice")
+    return dict(pairs)
+
+
+def read_call_only(path: Path, models: list[str]) -> dict:
+    """``--call-only``: the file's sha256, order seed and attempts (as tuples), refused unless the schema and every
+    type are exact, no attempt is listed twice and every attempt names one of ``models``. ``True`` and ``1.0`` are not
+    repetitions (they compare equal to 1 inside a tuple, so a loose file would pass the order check)."""
+    try:
+        raw = path.read_bytes()
+    except OSError as exc:
+        raise Refused(f"--call-only {path}: cannot be read ({exc.strerror or type(exc).__name__})") from None
+    try:
+        data = json.loads(raw.decode("utf-8"), object_pairs_hook=_object_without_repeated_keys)
+    except ValueError:
+        raise Refused(f"--call-only {path}: not a JSON file, or a key is given twice in it") from None
+    if not isinstance(data, dict) or data.get("schema") != CALL_ONLY_SCHEMA:
+        raise Refused(f"--call-only {path}: not a {CALL_ONLY_SCHEMA} file")
+    extra = sorted(set(data) - {"schema", "order_seed", "attempts"})
+    if extra:
+        raise Refused(f"--call-only {path}: unknown key(s) {', '.join(map(str, extra))}")
+    seed, attempts = data.get("order_seed"), data.get("attempts")
+    if type(seed) is not int:
+        raise Refused(f"--call-only {path}: order_seed must be an integer")
+    if not isinstance(attempts, list):
+        raise Refused(f"--call-only {path}: attempts must be a list")
+    listed: list[tuple] = []
+    seen: set[tuple] = set()
+    for i, item in enumerate(attempts):
+        if not (isinstance(item, list) and len(item) == 4 and all(type(x) is str for x in item[:3])
+                and type(item[3]) is int and item[3] >= 0):
+            raise Refused(f"--call-only {path}: attempt #{i} is not [model, probe id, question id, repetition]")
+        attempt = tuple(item)
+        if attempt[0] not in models:
+            raise Refused(f"--call-only {path}: attempt #{i} is of a model that is not one of --models")
+        if attempt in seen:
+            raise Refused(f"--call-only {path}: attempt #{i} is listed twice")
+        seen.add(attempt)
+        listed.append(attempt)
+    return {"path": path, "file_sha256": hashlib.sha256(raw).hexdigest(), "order_seed": seed, "attempts": listed,
+            "set": frozenset(seen)}
+
+
+def check_call_only(given: dict, seed: int, order: list[tuple]) -> None:
+    """Refuse a call-only file whose order seed is not the run's, or that lists an attempt this run's full order
+    does not hold (another reps, probes, question set or limit)."""
+    path = given["path"]
+    if given["order_seed"] != seed:
+        raise Refused(f"--call-only {path}: order_seed {given['order_seed']} is not this run's order seed {seed}")
+    planned = set(order)
+    missing = [i for i, attempt in enumerate(given["attempts"]) if attempt not in planned]
+    if missing:
+        raise Refused(f"--call-only {path}: {len(missing)} of its {len(given['attempts'])} attempts are not in this "
+                      f"run's order (the first is attempt #{missing[0]}); nothing is written or called")
+
+
+def planned_order(args: argparse.Namespace, path: Path, questions: list[dict]) -> tuple[int, list[tuple]]:
+    """The run's order seed and full order of attempts, as ``_run_locked`` records them (and ``--call-only`` is
+    checked against)."""
+    seed = args.order_seed if args.order_seed is not None else default_order_seed(path)
+    model_names = list(dict.fromkeys(args.models))
+    order = interleaved_order(model_names, [get_probe(p).id for p in args.probes], [q["id"] for q in questions],
+                              args.reps, seed)
+    return seed, order
+
+
+def outstanding_batch_attempts(batches_dir: Path) -> set[tuple]:
+    """The attempts of Message Batches an earlier start submitted and did not collect: phase 1 collects them and keeps
+    their replies, whatever a call-only file lists, so a start's plan total counts them. A submission marker
+    (``submitting-*.json``, a create whose batch id was never written) is not counted: reconciling it may adopt its
+    batch or drop it, which cannot be known beforehand, so a call-only start refuses while one is left."""
+    found: set[tuple] = set()
+    if not batches_dir.is_dir():
+        return found
+    for path in sorted(batches_dir.glob("msgbatch*.json")):
+        state = json.loads(path.read_text(encoding="utf-8"))
+        if state.get("status") != "collected":
+            found.update(tuple(entry["attempt"]) for entry in (state.get("requests") or {}).values())
+    return found
+
+
+def plan_calls(order: list[tuple], *, recorded: Callable[[tuple], bool], kept: Callable[[tuple], bool],
+               listed: frozenset | None) -> tuple[list[tuple], int, int]:
+    """Phase 1's calls, in order: (the attempts to call, attempts with a record, attempts with a kept reply and no
+    record). An attempt with a record is skipped, one with a kept reply is not called again, and with ``listed`` only
+    a listed attempt is called; the full order is not filtered (phase 2 builds the records of every kept reply)."""
+    to_call: list[tuple] = []
+    n_recorded = n_kept = 0
+    for attempt in order:
+        if recorded(attempt):
+            n_recorded += 1
+        elif kept(attempt):
+            n_kept += 1
+        elif listed is None or attempt in listed:
+            to_call.append(attempt)
+    return to_call, n_recorded, n_kept
+
