@@ -0,0 +1,271 @@
+#!/usr/bin/env python3
+"""Call-only plan for a closed-book probe run (design log): which attempts a start of scripts/run_probes.py should call.
+
+    python3 scripts/probe_plan.py --graph rhea-142 --out OUT --models qwen3.8-27b --order-seed 20261022 \\
+        --probe-targets answer=1,query=1 --m 105 --write plan.json
+    python3 scripts/probe_plan.py --graph rhea-142 --out OUT --models qwen3.8-27b --order-seed 20261022 \\
+        --probe-targets answer=1,query=1 --table --m-list 0,52,105,158,210
+
+The plan file is run_probes.py's ``--call-only`` input (schema probe-call-only/1). Run it with the runner stopped: a
+reply that lands after the plan is made is not in it, and the next start then calls one attempt more than the plan
+needed (never one twice: a kept reply is not called again).
+
+Rule ("top up to a per-cell target"). A cell is (model, probe, question). Its target is the probe's ``--probe-targets``
+value (1: the registered plan is answer 1, query 1); for the query probe, the questions of the seeded subset S_M get
+one more: S_M is the first M of the question file's distinct BASE question ids (``base_question_id``, else the id)
+sorted by sha256 of ``SELECTION_SEED|base id`` (``--selection-seed``), so a natural graph and its opaque twin, which
+share base ids and not question ids, get the same subset. A cell with d attempts that have a kept reply is topped up with its first ``max(0, target - d)``
+not-yet-done attempts in the run's seeded order; attempts already done always stay (the runner builds a record for
+every kept reply whatever the plan says). The attempts are written in the run's order.
+
+Names only. The plan is made from the question file (test split: question id, base id, split), the run's order.json
+(rebuilt from --models, --probes, --reps, --limit, --order-seed and the questions, and refused unless it equals the
+file's order exactly) and the NAMES in OUT/<graph>/replies/, a kept reply being named by its attempt's digest
+(run_probes.attempt_digest). A reply, a record or a log is never opened. Records mean phase 2 already ran, which this
+plan is not for: records/ or harness/ holding any entry is refused. Names in replies/ that are no attempt of the order
+are counted and ignored. ``--write`` creates the file mode 0600 and never overwrites one. The output is counts and the
+file's sha256, never an id (a private graph's ids stay in its directory); ``--table`` prints integers only.
+
+Exit status: 0 done; 2 refused.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(REPO))
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+from harness.probe.prompts import get_probe  # noqa: E402
+from run_pilot import Refused, interleaved_order, order_sha256  # noqa: E402
+from run_probes import (  # noqa: E402
+    CALL_ONLY_SCHEMA,
+    DEFAULT_GRAPHS,
+    attempt_digest,
+    expand_models,
+    load_graphs,
+    questions_path,
+    refuse_heldout,
+)
+
+SELECTION_SEED = 20261026  # the registered seed of the second-repetition subset (science, the design log)
+SPLIT = "test"  # a plan is made for the test split only
+
+
+def parse_targets(text: str, probes: list[str]) -> dict[str, int]:
+    """``answer=1,query=1`` as {probe: target}: every probe of the run once, each with the one planned target, 1 (a
+    target of 0 or 2 would under- or over-deliver the registered plan, and no other target is planned)."""
+    targets: dict[str, int] = {}
+    for item in text.split(","):
+        name, _, raw = item.partition("=")
+        if name not in ("answer", "query") or raw != "1" or name in targets:
+            raise Refused(f"--probe-targets {text!r}: expected answer=1,query=1, each probe once, naming the run's "
+                          f"probes; 1 is the only planned target (a second query repetition comes from --m)")
+        targets[name] = 1
+    if set(targets) != set(probes):
+        raise Refused(f"--probe-targets {text!r} must name exactly the run's probes ({', '.join(probes)})")
+    return targets
+
+
+def read_questions(path: Path, limit: int | None) -> list[tuple[str, str]]:
+    """The test split's (question id, base question id) in file order, cut to ``limit`` as the runner cuts it. Only
+    the split, the id and the base id of a row are kept."""
+    rows: list[tuple[str, str]] = []
+    seen: set[str] = set()
+    with path.open(encoding="utf-8") as fh:
+        for n, line in enumerate(fh, start=1):
+            if not line.strip():
+                continue
+            try:
+                row = json.loads(line)
+                if row.get("split") != SPLIT:
+                    continue
+                qid = row["id"]
+                base = row.get("base_question_id") or qid
+                if not (isinstance(qid, str) and isinstance(base, str)):
+                    raise KeyError(qid)
+            except (ValueError, AttributeError, KeyError):
+                raise Refused(f"{path}:{n}: not a question row (an object with an id and a split)") from None
+            if qid in seen:
+                raise Refused(f"{path}:{n}: a question id is listed twice")
+            seen.add(qid)
+            rows.append((qid, base))
+    return rows[:limit]
+
+
+def base_subset(bases: set[str], m: int, selection_seed: int) -> frozenset[str]:
+    """The first ``m`` base ids by sha256 of ``seed|base id`` (ties by the id); all of them when ``m`` is larger."""
+    ranked = sorted(bases, key=lambda b: (hashlib.sha256(f"{selection_seed}|{b}".encode()).hexdigest(), b))
+    return frozenset(ranked[:m])
+
+
+class Run:
+    """What a plan needs of one run: its full order, the attempts with a kept reply, and each question's base id."""
+
+    def __init__(self, args: argparse.Namespace):
+        for path, what in ((args.graphs_config, "--graphs-config"), (args.out, "--out"), (args.write, "--write")):
+            refuse_heldout(path, what)
+        graphs = load_graphs(args.graphs_config)
+        if args.graph not in graphs:
+            raise Refused(f"unknown graph {args.graph!r}")
+        qpath = questions_path(graphs[args.graph])
+        if qpath is None or not qpath.is_file():
+            raise Refused(f"graph {args.graph}: no question file")
+        refuse_heldout(qpath, f"graph {args.graph}'s question file")
+        self.models = list(dict.fromkeys(expand_models(args.models)))
+        self.probes = list(args.probes)
+        self.reps = args.reps
+        self.seed = args.order_seed
+        self.targets = parse_targets(args.probe_targets, self.probes)
+        questions = read_questions(qpath, args.limit)
+        if not questions:
+            raise Refused(f"no {SPLIT}-split questions in the graph's question file")
+        self.base = dict(questions)
+        self.order = [tuple(a) for a in interleaved_order(
+            self.models, [get_probe(p).id for p in self.probes], [q for q, _ in questions], self.reps, self.seed)]
+        run_dir = args.out / args.graph
+        recorded = self._recorded_order(run_dir / "order.json", self.seed)
+        if len(recorded) != len(self.order) or order_sha256(recorded) != order_sha256(self.order):
+            raise Refused(f"{run_dir / 'order.json'}: its order is not the order these arguments rebuild "
+                          f"({len(recorded)} attempts there, {len(self.order)} here); check --models, --probes, "
+                          f"--reps, --limit, --order-seed and the question file")
+        for sub in ("records", "harness"):
+            d = run_dir / sub
+            if d.is_dir() and any(d.iterdir()):
+                raise Refused(f"{d} is not empty: records mean phase 2 already ran, which a call-only plan is not "
+                              f"for")
+        replies = run_dir / "replies"
+        names = {p.stem for p in replies.glob("*.json")} if replies.is_dir() else set()
+        self.done = {a for a in self.order if attempt_digest(a) in names}
+        self.foreign_names = len(names) - len(self.done)
+        self.name_of = {get_probe(p).id: p for p in self.probes}
+
+    @staticmethod
+    def _recorded_order(path: Path, seed: int) -> list[tuple]:
+        """The run's order.json (an order file, not a reply or a record), refused unless it is the run's seed."""
+        try:
+            data = json.loads(path.read_text(encoding="utf-8"))
+            recorded = [tuple(a) for a in data["order"]]
+            recorded_seed = data["seed"]
+        except (OSError, ValueError, KeyError, TypeError):
+            raise Refused(f"{path}: cannot be read as the run's order.json") from None
+        if recorded_seed != seed:
+            raise Refused(f"{path}: the run's order seed is {recorded_seed}, not {seed}")
+        return recorded
+
+    def plan(self, m: int, selection_seed: int) -> list[tuple]:
+        """The attempts to call for ``m`` second query repetitions, in the run's order."""
+        selected = base_subset(set(self.base.values()), m, selection_seed) if "query" in self.probes else frozenset()
+        cells: dict[tuple, list[tuple]] = {}
+        for attempt in self.order:  # a cell's attempts, in the run's order
+            cells.setdefault(attempt[:3], []).append(attempt)
+        chosen: set[tuple] = set()
+        for (_, probe_id, qid), attempts in cells.items():
+            name = self.name_of[probe_id]
+            target = self.targets[name] + (1 if name == "query" and self.base[qid] in selected else 0)
+            if target > self.reps:
+                raise Refused(f"a cell's target {target} is above the run's {self.reps} repetition(s)")
+            need = max(0, target - sum(a in self.done for a in attempts))
+            chosen.update([a for a in attempts if a not in self.done][:need])
+        return [a for a in self.order if a in chosen]
+
+
+def plan_bytes(seed: int, attempts: list[tuple]) -> bytes:
+    """The plan file: fixed separators, sorted keys, no time or host (the same inputs give the same bytes)."""
+    body = {"schema": CALL_ONLY_SCHEMA, "order_seed": seed, "attempts": [list(a) for a in attempts]}
+    return (json.dumps(body, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n").encode("utf-8")
+
+
+def write_new(path: Path, data: bytes) -> None:
+    """Create ``path`` mode 0600 and write ``data``; an existing file is never touched, and a failed write removes
+    the file this call made."""
+    try:
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    except FileExistsError:
+        raise Refused(f"{path} exists; a plan file is never overwritten") from None
+    except OSError as exc:
+        raise Refused(f"{path}: cannot be created ({exc.strerror or type(exc).__name__})") from None
+    try:
+        os.fchmod(fd, 0o600)
+        with os.fdopen(fd, "wb") as fh:
+            fh.write(data)
+            fh.flush()
+            os.fsync(fh.fileno())
+    except BaseException:
+        try:
+            os.unlink(path)
+        except OSError:
+            pass
+        raise
+
+
+def parse_args(argv: list[str] | None) -> argparse.Namespace:
+    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    p.add_argument("--graphs-config", type=Path, default=DEFAULT_GRAPHS)
+    p.add_argument("--graph", required=True, help="the graph's name in --graphs-config")
+    p.add_argument("--out", type=Path, required=True, help="the run's OUT directory (OUT/<graph>/order.json, replies/)")
+    p.add_argument("--models", nargs="+", required=True, help="as the run's --models")
+    p.add_argument("--probes", nargs="+", choices=("answer", "query"), default=["answer", "query"],
+                   help="as the run's --probes")
+    p.add_argument("--reps", type=int, default=3, help="as the run's --reps")
+    p.add_argument("--limit", type=int, default=None, help="as the run's --limit")
+    p.add_argument("--order-seed", type=int, required=True, help="the run's order seed")
+    p.add_argument("--selection-seed", type=int, default=SELECTION_SEED, help="the seed of the subset S_M")
+    p.add_argument("--probe-targets", required=True, metavar="answer=N,query=N",
+                   help="the attempts each cell of a probe is topped up to")
+    mode = p.add_mutually_exclusive_group(required=True)
+    mode.add_argument("--write", type=Path, metavar="FILE", help="write the plan for --m (mode 0600, never overwrites)")
+    mode.add_argument("--table", action="store_true", help="print integers only, for each M of --m-list")
+    p.add_argument("--m", type=int, default=None, help="the size of the subset S_M (with --write)")
+    p.add_argument("--m-list", default=None, metavar="M,M,...", help="the subset sizes to size (with --table)")
+    args = p.parse_args(argv)
+    if args.reps < 1 or (args.limit is not None and args.limit < 1):
+        p.error("--reps and --limit must be positive")
+    if args.write is not None:
+        if args.m is None or args.m < 0:
+            p.error("--write needs --m (not negative)")
+        args.m_values = [args.m]
+    else:
+        if args.m is not None or not args.m_list:
+            p.error("--table needs --m-list and takes no --m")
+        try:
+            args.m_values = [int(x) for x in args.m_list.split(",")]
+        except ValueError:
+            p.error("--m-list must be whole numbers separated by commas")
+        if any(m < 0 for m in args.m_values):
+            p.error("--m-list must not hold a negative number")
+    return args
+
+
+def main(argv: list[str] | None = None, *, out=None) -> int:
+    out = out or sys.stdout
+    args = parse_args(argv)
+    try:
+        run = Run(args)
+        if args.table:
+            print("M order_total done to_call", file=out)
+            for m in args.m_values:
+                print(f"{m} {len(run.order)} {len(run.done)} {len(run.plan(m, args.selection_seed))}", file=out)
+            return 0
+        attempts = run.plan(args.m, args.selection_seed)
+        data = plan_bytes(run.seed, attempts)
+        write_new(args.write, data)
+        print(f"order_total={len(run.order)} done={len(run.done)} replies_outside_order={run.foreign_names} "
+              f"m={args.m} to_call={len(attempts)} file_sha256={hashlib.sha256(data).hexdigest()}", file=out)
+        return 0
+    except Refused as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+    except (OSError, ValueError) as exc:  # a question file or order.json that cannot be read: refused, not a traceback
+        print(f"error: {type(exc).__name__}: {exc}", file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main())
