+# Science, the design log:51Z (the follow-up of change-log entry 180): the Gateway routes' 600 s request
+# time-out cut probe replies, so a probe run takes a model's own request time-out from run_pilot's plain-path file,
+# read and applied by the same plain_runner_settings (grid_models), so that a probe route is rebuilt exactly as an agent
+# run's is. Nothing else of the run changes: without the flag the table is used as it is.
+def probe_runner_settings(path: Path, names: list[str], models: dict[str, ModelSpec]
+                          ) -> tuple[dict[str, ModelSpec], dict]:
+    """``--runner-settings``: (the table with each named model's route rebuilt with its request time-out, the file's
+    object). Refused as run_pilot refuses the file, and when it sets ``max_turns``: a probe is one call with no tools,
+    so a turn cap would cap nothing (a key that changes nothing is not accepted as if it did)."""
+    table, settings = plain_runner_settings(path, names, models)
+    if TURN_CAP_KEY in settings:
+        raise Refused(f"--runner-settings {path}: {TURN_CAP_KEY}: a probe is one call with no tools, so it has no turns "
+                      f"to cap; leave the key out")
+    return dict(table), settings
+
+
