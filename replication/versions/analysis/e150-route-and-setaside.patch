+def test_a_move_between_two_names_of_one_stack_is_no_redeployment(world):
+    def one_stack(m):
+        m["entry150"]["new_deployment"]["stack"]["from"] = STACK_NEW
+
+    bad = _e150(world, edit_manifest=one_stack, edit_identity=_set("stack_override", "from", value=STACK_NEW))
+    assert ex.e150_redeploy(ex.Out.read(bad)) is None
+    with pytest.raises(F.refusals, match=ROUTE_MISMATCH):
+        _check([bad])
+
+
+def test_an_ordinary_out_with_two_routes_is_refused_and_one_with_one_route_passes(world):
+    plain = _e150(world, "uniprot-e150-plain", edit_manifest=_drop("entry150"), parents_on=NEW)  # no block, one route
+    assert ex.e150_redeploy(ex.Out.read(plain)) is None
+    _check([plain])
+    two = _e150(world, "uniprot-e150-plain-two", edit_manifest=_drop("entry150"))  # no block, two routes
+    with pytest.raises(F.refusals, match=ROUTE_MISMATCH):
+        _check([two])
