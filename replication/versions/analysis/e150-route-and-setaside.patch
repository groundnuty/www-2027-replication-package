+++ b/results/e189-exploratory-20261022/tests/test_e150_routes.py
@@ -0,0 +1,377 @@
+"""Tests of the entry-150 retry OUTs' two routes (exploratory.e150_redeploy, e150_stack_check, e150_disclosure; science,
+26 Oct: the entry-150 looks of redeployed models).
+
+An entry-150 OUT of a redeployed model holds the model's Tier 1 parents (copied by file, naming the parents' route base URL)
+and its retry rows (naming the new route): check_one_stack refuses it for naming two. The call admits exactly the two route
+base URLs the OUT's own manifest records for the move, the parents' on the copied parents and the new one on the retry
+rows, and every other OUT keeps check_one_stack as it was.
+
+Hand-derived facts the tests rely on (never the script's output): the repository's grid-full fixture holds, for Qwen, twelve
+parent records (cells none, alpha, beta: four each) and six retry rows (the checker cells fb:curated and gen:any: three each);
+the fixture's records name no route base URL, so the tests set them. Gemma's records of the fixture are left out of the
+OUT (an entry-150 OUT is one model's), except in the test that keeps them to be refused.
+
+Every refusal test has its accepted baseline in the same test. Run: the e189 suite's python (numpy) from the repository root:
+``python -m pytest results/e189-exploratory-20261022/tests``."""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import shutil
+import types
+from pathlib import Path
+
+import pytest
+
+import test_exploratory as T
+from test_exploratory import world  # noqa: F401  (the suite's fixture)
+
+ex, F = T.ex, T.F
+OLD, NEW, NEW2, THIRD = (f"http://{h}.example:8000/v1" for h in ("parents", "retry", "retry-two", "third"))
+SOURCE = "/host/uniprot-qwen3.8-27b"  # the Tier 1 OUT the builder copied the parents from
+NAME = "uniprot-e150-qwen3.8-27b-p1"
+PARENTS, RETRIES = 12, 6
+STACK_OLD, STACK_NEW = "stack-old", "stack-new"
+RUNNER = "qwen3.8-27b"
+ROUTE_MISMATCH = r"2 route base URLs"  # check_one_stack's refusal, named by hashes
+OTHER_URL = r"route base URL other than the one its manifest records"
+
+
+def _sha(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def _edit_json(path: Path, edit) -> None:
+    doc = json.loads(path.read_text(encoding="utf-8"))
+    edit(doc)
+    path.write_text(json.dumps(doc, indent=1) + "\n", encoding="utf-8")
+
+
+def _e150(world, name: str = NAME, *, old: str = OLD, new: str = NEW, parents_on: str | None = None,
+          retries_on: str | None = None, keep_gemma: bool = False, fp_of=None, edit_manifest=None,
+          edit_identity=None, copied: int = PARENTS) -> Path:
+    """An entry-150 OUT of Qwen made from the fixture: its parents on ``old`` (or ``parents_on``), its retry rows on
+    ``new`` (or ``retries_on``), the manifest's entry150 block and route, and the identity of a builder-derived OUT.
+    ``fp_of(record)``: each turn's served fingerprint (baseline FP_A in the identity and in served-models.json)."""
+    out = world["tmp"] / name
+    batch = T.FIXTURE / "batch"
+    shutil.copytree(batch, out, ignore=shutil.ignore_patterns("claims", "records"))
+    (out / "records").mkdir()
+    for f in sorted((batch / "records").glob("*.json")):
+        r = json.loads(f.read_text(encoding="utf-8"))
+        if r["model"] != T.QWEN and not keep_gemma:
+            continue
+        retry = r.get("checker") is not None
+        r["route"]["base_url"] = (retries_on or new) if retry else (parents_on or old)
+        if fp_of is not None:
+            for t in r["tokens"]["per_turn"]:
+                t["system_fingerprint"] = fp_of(r)
+        (out / "records" / f.name).write_text(json.dumps(r, indent=1) + "\n", encoding="utf-8")
+
+    def manifest(m: dict) -> None:
+        m["entry150"] = {"source_out": SOURCE, "copied": {"records": copied, "claims": copied},
+                         "new_deployment": {"route_base_url": {"from": old, "to": new},
+                                            "stack": {"from": STACK_OLD, "to": STACK_NEW}}}
+        m["fingerprint"]["routes"][RUNNER]["base_url"] = new
+        if edit_manifest is not None:
+            edit_manifest(m)
+
+    _edit_json(out / "manifest.json", manifest)
+    ident = {"out": f"/host/{name}", "graph": "s01", "stacks_by_route_model": {T.QWEN: STACK_NEW},
+             "store": {"out": f"/host/{name}"},
+             "stack_override": {"from": STACK_OLD, "to": STACK_NEW, "model": RUNNER},
+             "derived_from": {"by": "entry150_run.py build", "path": SOURCE, "sha256": "0" * 64}}
+    if fp_of is not None:
+        ident["sitea"] = {"model": RUNNER, "system_fingerprint": T.FP_A,
+                         "identity": {"vllm_version": "0.32.0", "snapshot": T.CHECKPOINT}}
+        _edit_json(out / "served-models.json",
+                   lambda s: [e.update(system_fingerprint=T.FP_A) for e in s["models"].values()])
+    if edit_identity is not None:
+        edit_identity(ident)
+    T._write_identity(out, ident)
+    T._recheck(out)
+    return out
+
+
+def _go(world, outs, **kw):
+    return T._run(world, list(outs), record=False, **kw)
+
+
+def _batches(outs) -> list[tuple]:
+    """What load_inputs hands the stack check: each OUT's path, its records (attempts and retry rows) and identity."""
+    return [(out, [*(b := F.inputs.load_batch(out, F.gate.grid_cells(out))).records, *b.branch],
+             json.loads((out / "deployment-identity.json").read_text(encoding="utf-8"))) for out in outs]
+
+
+def _check(outs) -> None:
+    ex.e150_stack_check(F, [ex.Out.read(o) for o in outs])(_batches(outs))
+
+
+# --- the OUT passes, and everything else is as it was ---------------------------------------------------------------------
+
+
+def test_the_two_route_out_passes_where_check_one_stack_refuses_it(world):
+    out = _e150(world)
+    assert ex.e150_redeploy(ex.Out.read(out)) == (OLD, NEW, T.QWEN, PARENTS, STACK_OLD)
+    result = _go(world, [out])
+    assert result["arms"]
+    (entry,) = result["exploratory"]["outs"]
+    assert entry["e150_routes"] == {"rule": ex.E150_ROUTES_RULE, "parents_route_sha256": _sha(OLD),
+                                    "new_route_sha256": _sha(NEW)}
+    with pytest.raises(F.refusals, match=ROUTE_MISMATCH):  # the frozen check, on the same records
+        F.inputs.check_one_stack(_batches([out]), require_route=False)
+
+
+def test_the_two_route_out_is_accepted_by_the_frozen_check_only_with_its_parents_standing_in_for_the_new_route(world):
+    out = _e150(world)
+    batches = _batches([out])
+    before = copy.deepcopy(batches)
+    ex.e150_stack_check(F, [ex.Out.read(out)])(batches)  # the very objects load_inputs goes on to use
+    assert batches == before  # never touched: a copy of each parent stood in
+    assert {r["route"]["base_url"] for _, records, _ in batches for r in records} == {OLD, NEW}
+
+
+def test_an_e150_out_that_is_not_a_grid_out_is_refused(world):
+    out = _e150(world)
+    batches = _batches([out])
+    grid = types.SimpleNamespace(gate=types.SimpleNamespace(grid_cells=lambda path: None), inputs=F.inputs)
+    with pytest.raises(ex.Refused, match="not a grid OUT"):
+        ex.e150_stack_check(grid, [ex.Out.read(out)])(batches)
+    ex.e150_stack_check(F, [ex.Out.read(out)])(batches)  # the baseline
+
+
+def test_a_third_route_is_refused(world):
+    _check([_e150(world)])
+    for kw in ({"parents_on": THIRD}, {"retries_on": THIRD}, {"parents_on": THIRD, "retries_on": THIRD}):
+        with pytest.raises(ex.Refused, match=OTHER_URL):
+            _check([_e150(world, f"uniprot-e150-third-{len(kw)}{sorted(kw)[0]}", **kw)])
+    with pytest.raises(ex.Refused, match=OTHER_URL):
+        _go(world, [_e150(world, "uniprot-e150-third-run", retries_on=THIRD)])
+
+
+@pytest.mark.parametrize("kw", [{"parents_on": NEW}, {"retries_on": OLD}, {"parents_on": NEW, "retries_on": OLD},
+                                {"retries_on": OLD, "parents_on": OLD}, {"parents_on": NEW, "retries_on": NEW}])
+def test_each_url_is_bound_to_its_role_a_swap_or_one_url_for_both_is_refused(world, kw):
+    _check([_e150(world)])
+    with pytest.raises(ex.Refused, match=OTHER_URL):
+        _check([_e150(world, "uniprot-e150-role", **kw)])
+
+
+def test_a_record_naming_no_route_is_refused(world):
+    out = _e150(world)
+    _check([out])
+    for f in sorted((out / "records").glob("*.json"))[:1]:
+        _edit_json(f, lambda r: r["route"].update(base_url=None))
+    T._recheck(out)
+    with pytest.raises(ex.Refused, match=r"other than the one its manifest records for them \(none\)"):
+        _check([out])
+
+
+def test_the_refusal_names_the_urls_by_hash_alone(world):
+    out = _e150(world, retries_on=THIRD)
+    with pytest.raises(ex.Refused) as exc:
+        _check([out])
+    text = str(exc.value)
+    assert f"sha256:{_sha(THIRD)[:12]}" in text and "example" not in text and "http" not in text
+
+
+def test_records_of_another_model_than_the_identitys_one_are_refused(world):
+    _check([_e150(world)])
+    with pytest.raises(ex.Refused, match="records of another model"):
+        _check([_e150(world, "uniprot-e150-two-models", keep_gemma=True)])
+
+
+@pytest.mark.parametrize("copied", [PARENTS - 1, PARENTS + 1, 0])
+def test_other_parent_records_than_the_builder_copied_are_refused(world, copied):
+    with pytest.raises(ex.Refused, match="not exactly the Tier 1 parents"):
+        _check([_e150(world, copied=copied)])
+
+
+# every one of these defects makes the OUT no entry-150 retry OUT (or a different one): it is judged by check_one_stack
+# as every other OUT, which refuses its two routes
+def _drop(*keys):
+    def edit(d):
+        for k in keys[:-1]:
+            d = d[k]
+        del d[keys[-1]]
+    return edit
+
+
+def _set(*keys, value):
+    def edit(d):
+        for k in keys[:-1]:
+            d = d[k]
+        d[keys[-1]] = value
+    return edit
+
+
+MANIFEST_DEFECTS = {
+    "no new_deployment": _drop("entry150", "new_deployment"),
+    "no route urls": _drop("entry150", "new_deployment", "route_base_url"),
+    "no from url": _drop("entry150", "new_deployment", "route_base_url", "from"),
+    "empty to url": _set("entry150", "new_deployment", "route_base_url", "to", value=""),
+    "same urls": lambda m: m["entry150"]["new_deployment"]["route_base_url"].update({"from": NEW}),
+    "no stacks": _drop("entry150", "new_deployment", "stack"),
+    "same stacks": _set("entry150", "new_deployment", "stack", "from", value=STACK_NEW),
+    "other from stack": _set("entry150", "new_deployment", "stack", "from", value="stack-x"),
+    "other to stack": _set("entry150", "new_deployment", "stack", "to", value="stack-x"),
+    "the manifest's own route is another": _set("fingerprint", "routes", RUNNER, "base_url", value=THIRD),
+    "the manifest's own route is the parents'": _set("fingerprint", "routes", RUNNER, "base_url", value=OLD),
+    "the manifest's own route names no model": _drop("fingerprint", "routes", RUNNER, "model"),
+    "no entry150 route of the override's model": lambda m: m["fingerprint"]["routes"].pop(RUNNER),
+    "another source": _set("entry150", "source_out", value="/host/another-out"),
+    "no source": _drop("entry150", "source_out"),
+    "copied.records is a bool": _set("entry150", "copied", "records", value=True),
+    "copied.records is a string": _set("entry150", "copied", "records", value=str(PARENTS)),
+    "negative copied.records": _set("entry150", "copied", "records", value=-1),
+    "no copied": _drop("entry150", "copied"),
+}
+IDENTITY_DEFECTS = {
+    "no stack override": _drop("stack_override"),
+    "override from another stack": _set("stack_override", "from", value="stack-x"),
+    "override to another stack": _set("stack_override", "to", value="stack-x"),
+    "override of another model": _set("stack_override", "model", value="gemma-4-31b"),
+    "override without a model": _drop("stack_override", "model"),
+    "a second model named": lambda i: i["stacks_by_route_model"].update({"google/gemma-4-31B": STACK_NEW}),
+    "the model on the old stack": _set("stacks_by_route_model", T.QWEN, value=STACK_OLD),
+    "another route model": lambda i: i.update(stacks_by_route_model={"google/gemma-4-31B": STACK_NEW}),
+    "not derived": _drop("derived_from"),
+    "derived by another builder": _set("derived_from", "by", value="hand"),
+    "derived from another OUT": _set("derived_from", "path", value="/host/another-out"),
+    "an on-host path of another name": _set("out", value="/host/uniprot-qwen3.8-27b-p1"),
+    "no on-host path": _drop("out"),
+}
+
+
+@pytest.mark.parametrize("defect", sorted(MANIFEST_DEFECTS))
+def test_an_out_failing_a_manifest_binding_is_no_retry_out_and_keeps_the_frozen_refusal(world, defect):
+    ok = _e150(world)
+    assert ex.e150_redeploy(ex.Out.read(ok)) is not None
+    bad = _e150(world, "uniprot-e150-defect", edit_manifest=MANIFEST_DEFECTS[defect])
+    assert ex.e150_redeploy(ex.Out.read(bad)) is None
+    with pytest.raises(F.refusals, match=ROUTE_MISMATCH):
+        _check([bad])
+    with pytest.raises(F.refusals, match=ROUTE_MISMATCH):
+        _go(world, [bad])
+
+
+@pytest.mark.parametrize("defect", sorted(IDENTITY_DEFECTS))
+def test_an_out_failing_an_identity_binding_is_no_retry_out_and_keeps_the_frozen_refusal(world, defect):
+    bad = _e150(world, "uniprot-e150-defect", edit_identity=IDENTITY_DEFECTS[defect])
+    assert ex.e150_redeploy(ex.Out.read(bad)) is None
+    with pytest.raises((*F.refusals, ex.Refused)):  # the frozen check (two routes), or its stack rules for a named model
+        _check([bad])
+
+
+def test_an_out_not_named_for_entry_150_with_the_same_manifest_and_identity_is_refused_as_any_other(world):
+    ok = _e150(world)
+    _check([ok])
+    other = _e150(world, "uniprot-qwen3.8-27b-p1")  # same files, any other directory name
+    assert ex.e150_redeploy(ex.Out.read(other)) is None
+    with pytest.raises(F.refusals, match=ROUTE_MISMATCH):
+        _check([other])
+    with pytest.raises(F.refusals, match=ROUTE_MISMATCH):
+        _go(world, [other])
+
+
+def test_the_directory_and_the_identitys_on_host_path_must_each_be_named_for_entry_150(world):
+    bad = _e150(world, "uniprot-qwen3.8-27b-p1", edit_identity=_set("out", value=f"/host/{NAME}"))  # the host path alone
+    assert ex.e150_redeploy(ex.Out.read(bad)) is None
+    with pytest.raises(F.refusals, match=ROUTE_MISMATCH):
+        _check([bad])
+    bad = _e150(world, edit_identity=_set("out", value="/host/uniprot-qwen3.8-27b-p1"))  # the directory alone
+    assert ex.e150_redeploy(ex.Out.read(bad)) is None
+
