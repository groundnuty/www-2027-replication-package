+
+def _old_run(old, world, batches, ledgers, *, record=False) -> dict:
+    cm, rec = T._map()
+    call = old.Call(tuple(batches), (world["questions"],), "s01", "dev", (world["voided"],), world["record"] if record else None,
+                    tuple(ledgers), 1, None)
+    return old.run(old.load_frozen(T.ROOT), call, K_clusters=None, cluster_map=cm, map_record=rec)
+
+
+def _same(a: dict, b: dict, old) -> None:
+    """Equal as sorted JSON text, but for the one directory the script itself sits in (its attribution module's name and the
+    path of its admitted-fingerprints file are the old copy's)."""
+    here, there = Path(ex.__file__).resolve().parent, Path(old.__file__).resolve().parent
+    text = json.dumps(b, sort_keys=True, allow_nan=False).replace(str(there), str(here))
+    text = text.replace(f"results/{there.name}/", f"results/{here.name}/")
+    assert json.dumps(a, sort_keys=True, allow_nan=False) == text
+    assert a["arms"]
+
+
+def test_an_out_without_a_sidecar_gives_the_bytes_of_227e758a(world, old):
+    _same(_baseline(world), _old_run(old, world, [world["single"]], [world["ledger"]]), old)
+    _same(T._run(world, world["parts"], record=True, ledgers=(world["ledger"],)),
+          _old_run(old, world, world["parts"], [world["ledger"]], record=True), old)
+
