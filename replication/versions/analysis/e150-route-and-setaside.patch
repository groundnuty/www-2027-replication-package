+@pytest.fixture(scope="module")
+def old(tmp_path_factory):
+    """The script's directory as it was at 227e758a (the approved look route), its exploratory.py loaded as a second module;
+    skipped without git history."""
+    d = tmp_path_factory.mktemp("old-exploratory")
+    try:
+        archive = subprocess.run(["git", "-C", str(T.ROOT), "archive", f"{OLD_COMMIT}:results/e189-exploratory-20261022"],
+                                 capture_output=True, check=True).stdout
+        subprocess.run(["tar", "-x", "-C", str(d)], input=archive, check=True)
+    except (OSError, subprocess.CalledProcessError):
+        pytest.skip("the 227e758a commit is not available here")
+    spec = importlib.util.spec_from_file_location("e189_exploratory_227e758a", d / "exploratory.py")
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules["e189_exploratory_227e758a"] = mod
+    spec.loader.exec_module(mod)
+    return mod
