+# --- entry 150's retry OUTs of a redeployed model: the two recorded routes ---------------------------------------------
+# Change-log entry 150's UniProt OUTs hold the model's Tier 1 parents, copied by file, and the retry rows made in the
+# OUT. Where the model was redeployed since its parents ran, the parents' records name the parents' route base URL and
+# the retry rows the new one, and check_one_stack refuses the OUT for naming two. For such an OUT alone (science, 26 Oct:
+# the entry-150 looks) the call admits exactly the two route base URLs the OUT's own manifest records for the move
+# (entry150.new_deployment.route_base_url from/to), the parents' on the copied parents and the new one on the retry
+# rows, and nothing else: the model stays under check_fingerprints and the admitted set, and every other OUT keeps
+# check_one_stack as it was.
+E150_PREFIX = "uniprot-e150-"  # the directory name of every entry-150 OUT of UniProt
+E150_BUILDER = "entry150_run.py build"  # the derived_from.by its builder writes
+E150_ROUTES_RULE = ("an entry-150 retry OUT of a redeployed model (its manifest's entry150.new_deployment names the "
+                    "route base URL and the stack it moved from and to) admits exactly those two route base URLs, "
+                    "the first on its copied Tier 1 parents and the second on its retry rows, in place of "
+                    "check_one_stack's one-route-URL refusal for that OUT alone (science, 26 Oct: the entry-150 "
+                    "looks); every other OUT keeps check_one_stack unchanged")
+
+
+def e150_redeploy(o: Out) -> tuple[str, str, str, int, str] | None:
+    """The route move of an entry-150 retry OUT of a redeployed model, or None where the OUT is not one (every OUT but
+    these goes to check_one_stack unchanged). Returns (parents' route base URL, new route base URL, route model, the
+    number of Tier 1 parents the builder copied, the stack the parents ran on). It is one only when all of these hold, each read from the OUT's own
+    manifest and deployment identity: the directory and the identity's on-host path both start with E150_PREFIX; the
+    manifest's entry150.new_deployment names two different route base URLs and two stacks; the identity's
+    stack_override names the same two stacks and the model, the manifest's own route for that model (its
+    fingerprint.routes) is the new URL and names the route model, the identity names that one route model alone, on the
+    new stack; the identity is derived (by the builder) from the OUT the manifest's entry150 names as its source; and
+    entry150.copied.records is an integer."""
+    manifest, ident = o.manifest, o.identity
+    block = manifest.get("entry150") if isinstance(manifest, dict) else None
+    new = block.get("new_deployment") if isinstance(block, dict) else None
+    if not (isinstance(new, dict) and isinstance(ident, dict)):
+        return None
+    urls, stacks = new.get("route_base_url"), new.get("stack")
+    if not (isinstance(urls, dict) and isinstance(stacks, dict)):
+        return None
+    old_url, new_url = urls.get("from"), urls.get("to")
+    if not all(isinstance(u, str) and u for u in (old_url, new_url)) or old_url == new_url:
+        return None
+    if not all(isinstance(stacks.get(k), str) and stacks[k] for k in ("from", "to")) or stacks["from"] == stacks["to"]:
+        return None
+    on_host = ident.get("out")
+    if not (o.path.name.startswith(E150_PREFIX) and isinstance(on_host, str)
+            and on_host.rstrip("/").rsplit("/", 1)[-1].startswith(E150_PREFIX)):
+        return None
+    override = ident.get("stack_override")
+    if not (isinstance(override, dict) and override.get("from") == stacks["from"] and override.get("to") == stacks["to"]
+            and isinstance(override.get("model"), str) and override["model"]):
+        return None
+    fingerprint = manifest.get("fingerprint")
+    routes = fingerprint.get("routes") if isinstance(fingerprint, dict) else None
+    own = routes.get(override["model"]) if isinstance(routes, dict) else None
+    if not (isinstance(own, dict) and own.get("base_url") == new_url and isinstance(own.get("model"), str)
+            and own["model"]):
+        return None
+    if ident.get("stacks_by_route_model") != {own["model"]: stacks["to"]}:
+        return None
+    derived = ident.get("derived_from")
+    if not (isinstance(derived, dict) and derived.get("by") == E150_BUILDER and isinstance(derived.get("path"), str)
+            and derived["path"] and derived["path"] == block.get("source_out")):
+        return None
+    copied = block.get("copied")
+    n = copied.get("records") if isinstance(copied, dict) else None
+    if type(n) is not int or n < 0:
+        return None
+    return old_url, new_url, own["model"], n, stacks["from"]
+
+
+def _url_label(url: Any) -> str:
+    return "none" if not url else "sha256:" + sha256_text(str(url))[:12]  # as check_one_stack names one: no host
+
+
+def e150_disclosure(o: Out) -> dict[str, Any]:
+    """What the results say of an OUT whose two routes were admitted (``e150_redeploy``): the rule and the sha256 of each
+    route base URL (never a host); nothing for any other OUT, whose entry is what it was."""
+    move = e150_redeploy(o)
+    if move is None:
+        return {}
+    return {"e150_routes": {"rule": E150_ROUTES_RULE, "parents_route_sha256": sha256_text(move[0]),
+                            "new_route_sha256": sha256_text(move[1])}}
+
+
+def e150_stack_check(F: Frozen, outs: Sequence[Out]) -> Callable[[list[tuple]], None]:
+    """check_one_stack, unchanged, with one exception: an OUT ``e150_redeploy`` recognises is first held to its two
+    recorded routes, then given to check_one_stack with its parents' route base URL stood in by its new one (a copy of
+    each parent record: the loaded records are never touched), so the checks across OUTs (one route base URL, one stack
+    per model and graph) stay the frozen ones. An OUT so recognised is refused when its records are of another model
+    than the route model its identity names, when it holds other parent records than the builder copied (its
+    ``copied.records``), when a copied parent names any route base URL but the parents', or a retry row any but the new
+    one (a third URL, a swap, none). Two such OUTs of one model and graph in a call must record the same parents' route
+    base URL and the same stack for the parents (with the parents stood in by each OUT's own new URL, a third route, or
+    one URL under two stacks, across OUTs would otherwise pass, where check_one_stack refuses both)."""
+    by_path = {str(o.path): o for o in outs}
+
+    def check(batches: list[tuple]) -> None:
+        views, problems = [], []
+        # (graph, route model) -> the parents' URL and stack, and the OUT that recorded them
+        parents_route: dict[tuple, tuple[tuple[str, str], str]] = {}
+        for path, records, identity in batches:
+            o = by_path.get(str(path))
+            move = None if o is None else e150_redeploy(o)
+            if move is None:
+                views.append((path, records, identity))
+                continue
+            old_url, new_url, route_model, copied, old_stack = move
+            cells = F.gate.grid_cells(Path(path))
+            if cells is None:
+                problems.append(f"{path}: an entry-150 OUT of a redeployed model that is not a grid OUT")
+                continue
+            if {r["model"] for r in records} - {route_model}:
+                problems.append(f"{path}: records of another model than its deployment identity's one route model")
+                continue
+            clash = [(parents_route[key][1], parents_route[key][0]) for graph in sorted({F.inputs.store_name(r) for r in records})
+                     for key in [(graph, route_model)]
+                     if parents_route.setdefault(key, ((old_url, old_stack), str(path)))[0] != (old_url, old_stack)]
+            if clash:  # (the stood-in view would hide it)
+                problems.append(f"{path}: its manifest records another route base URL or stack for the parents "
+                                f"({_url_label(old_url)}, {old_stack}) than {clash[0][0]} does for the same model and "
+                                f"graph ({_url_label(clash[0][1][0])}, {clash[0][1][1]})")
+                continue
+            parents = [r for r in records if F.inputs.record_cohort(r, cells) is not None]
+            if len(parents) != copied:
+                problems.append(f"{path}: not exactly the Tier 1 parents its manifest says the builder copied")
+                continue
+            parent_ids = {id(r) for r in parents}
+            wrong = {"parents": {(r.get("route") or {}).get("base_url") or None for r in parents} - {old_url},
+                     "retries": {(r.get("route") or {}).get("base_url") or None for r in records
+                                 if id(r) not in parent_ids} - {new_url}}
+            if any(wrong.values()):
+                problems += [f"{path}: its {role} name a route base URL other than the one its manifest records for "
+                             f"them ({', '.join(sorted(_url_label(u) for u in urls))})"
+                             for role, urls in wrong.items() if urls]
+                continue
+            views.append((path, [({**r, "route": {**r["route"], "base_url": new_url}} if id(r) in parent_ids else r)
+                                 for r in records], identity))
+        if problems:
+            raise Refused("the entry-150 retry OUTs' two routes (" + E150_ROUTES_RULE + "): " + " | ".join(problems))
+        F.inputs.check_one_stack(views, require_route=False)
+
+    return check
+
