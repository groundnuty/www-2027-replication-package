+def test_a_divergence_set_aside_in_a_plain_runs_out_is_the_frozen_paths(world, old):
+    """A plain run's OUT has no branch cells: a checker_divergence sidecar there is read by no one (the frozen loaders
+    count its record as a harness set-aside), and loading it gives 227e758a's loading, field for field."""
+    for keep in (False, True):
+        out = world["tmp"] / f"plain-{keep}"
+        shutil.copytree(PLAIN / "batch", out, ignore=shutil.ignore_patterns("claims"))
+        f = sorted((out / "records").glob("*.json"))[0]
+        raw, rec = f.read_bytes(), json.loads(f.read_bytes())
+        (out / "harness").mkdir()
+        (shutil.copy2 if keep else shutil.move)(f, out / "harness" / f.name)
+        doc = {"schema": "setaside/1", "run_id": rec["run_id"], "record": f.name, "sha256": hashlib.sha256(raw).hexdigest(),
+               "question_id": rec["question_id"], "model": rec["model"], "repetition": rec["repetition"],
+               "label": "failed:harness", "failure_type": "harness_defect", "classification": "checker_divergence"}
+        (out / "harness" / (f.name.removesuffix(".json") + ".setaside.json")).write_text(json.dumps(doc), encoding="utf-8")
+        check = json.loads((PLAIN / "batch" / "replay-check.json").read_text(encoding="utf-8"))
+        inputs = F.gate.batch_inputs(out)
+        replay = [r for r in inputs if F.gate.input_kind(r) == "replay"]
+        check.update(n_records=len(replay), n_ok=len(replay), failures=[], records_sha256=F.gate.inputs_sha256(out),
+                     hashed_only=[r for r in inputs if F.gate.input_kind(r) == "hashed"])
+        (out / "replay-check.json").write_text(json.dumps(check, indent=1) + "\n", encoding="utf-8")
+        assert ex.setaside_exclusions(F, out, F.inputs.load_batch(out, F.gate.grid_cells(out))) is None
+        kw = dict(split="dev", n_reps=2, ledgers=[], tier_if_missing=None, stack_check=lambda b: None)
+        new = ex.load_inputs(F, [out], [PLAIN / "questions.jsonl"], exclude_setaside=True, **kw)
+        was = old.load_inputs(F, [out], [PLAIN / "questions.jsonl"], **kw)
+        assert new.excluded == [] and new.attempts
+        for field in ("attempts", "ledger", "side", "settings", "messages", "output_cap_hits", "graphs"):
