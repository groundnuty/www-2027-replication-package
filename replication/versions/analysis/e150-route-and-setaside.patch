diff --git a/results/e189-exploratory-20261022/tests/test_setaside_exclusion.py b/results/e189-exploratory-20261022/tests/test_setaside_exclusion.py
new file mode 100644
index 0000000..0c65580
--- /dev/null
+++ b/results/e189-exploratory-20261022/tests/test_setaside_exclusion.py
@@ -0,0 +1,404 @@
+"""Tests of the checker_divergence set-aside exclusion (exploratory.setaside_exclusions, without_setaside_parents,
+excluded_disclosure; science, 26 Oct: an entry-150 retry OUT with one retry record set aside by
+scripts/relabel_harness_failure.py --diverged).
+
+The frozen analysis (harness/analysis/metrics.py build_arms) refuses an arm when a scored output of its cohort has no ledger
+row, and a set-aside retry leaves its PARENT attempt without a row in that retry's arm. The call drops each such parent,
+named by the moved record's own checker.branched_from, from every arm (its attempt and its ledger rows, all sources), only
+in an OUT holding a checker_divergence sidecar, and says so in ``exploratory.excluded_setaside_parents``.
+
+Hand-derived facts the tests rely on (never the script's output): the repository's grid-full fixture holds, for Qwen and for
+Gemma alike, four dev questions in each of the prompt cells none, alpha and beta, and one retry record per question in each
+of the checker cells fb:curated and gen:any, whose parents are the cell beta's records of the same question and model. The
+fixture's Qwen fb:curated record of s01-noquery (run id RETRY) names the Qwen beta record of s01-noquery (run id PARENT) as
+its parent (checker.branched_from), which also parents the Qwen gen:any record of s01-noquery. Every arm of Qwen's beta cohort
+therefore holds four units in the fixture and three without PARENT, and every other arm is the same with or without it.
+
+A divergence set-aside of anything else than a grid OUT's branch-cell record (a natural or prompted record, any record of a
+plain run's OUT) is the frozen path's: no exclusion and no refusal of this script's own, so its results are the 227e758a
+call's bytes. The same holds for a branch-cell sidecar whose attempt has a record in records/ again.
+
+Every refusal test has its accepted baseline in the same test. Run: the e189 suite's python (numpy) from the repository root:
+``python -m pytest results/e189-exploratory-20261022/tests/test_setaside_exclusion.py``."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+import test_e150_routes as R
+import test_exploratory as T
+from test_exploratory import world  # noqa: F401  (the suite's fixture)
+
+ex, F = T.ex, T.F
+PARENT = "7ea813fb-7f6d-406c-8477-2cb949f096da"  # Qwen, beta, s01-noquery
+RETRY = "4818f779-bd9b-47f6-b4d4-33073070dde5"  # Qwen, fb:curated, s01-noquery: checks PARENT
+OTHER_RETRY = "bf21e20f-26a2-4738-a243-d5922b75fc8c"  # Qwen, gen:any, s01-noquery: also checks PARENT
+GEMMA = "google/gemma-4-31B"
+NO_ROW = r"no ledger row for 1 scored outputs"
+OLD_COMMIT = "227e758adb09f0c0defae6c1adf347ddda8a23e3"  # the look route before the exclusion
+
+
+def _model_out(world, name: str, model: str, base: Path | None = None) -> Path:
+    """The fixture's OUT (``single``, or ``base``) kept to one model's records, with its identity and a fresh replay check."""
+    out = world["tmp"] / name
+    shutil.copytree(base or world["single"], out, ignore=shutil.ignore_patterns("records"))
+    (out / "records").mkdir()
+    for f in sorted(((base or world["single"]) / "records").glob("*.json")):
+        if json.loads(f.read_text(encoding="utf-8"))["model"] == model:
+            shutil.copy2(f, out / "records" / f.name)
+    T._recheck(out)
+    return out
+
+
+def _find(out: Path, run_id: str) -> Path:
+    return next(f for f in sorted((out / "records").glob("*.json")) if f.name.endswith(f".{run_id}.json"))
+
+
+def _sidecar(rec: dict, name: str, raw: bytes, kind: str) -> dict:
+    doc = {"schema": "setaside/1", "run_id": rec["run_id"], "record": name, "question_id": rec["question_id"],
+           "model": rec["model"], "repetition": rec["repetition"], "arm": rec["load"]["arm"],
+           "defect": "synthetic", "ruling": "https://example.invalid/ruling", "set_aside_at": "2026-10-26T00:00:00Z"}
+    if kind == "checker_divergence":  # scripts/relabel_harness_failure.py --diverged (replay_check.divergence_sidecar)
+        doc.update(sha256=hashlib.sha256(raw).hexdigest(), label="failed:harness", failure_type="harness_defect",
+                   classification="checker_divergence", phase="branch",
+                   divergence={"online": None, "offline": None, "error": "synthetic"})
+    elif kind == "infrastructure":  # the attempt path's decision (relabel_harness_failure._decision), no classification
+        doc.update(label="failed:infrastructure", original_label=None, original_failure_type="infrastructure")
+    else:
+        doc.update(sha256=hashlib.sha256(raw).hexdigest(), label="failed:infrastructure", classification=kind)
+    return doc
+
+
+def _set_aside(world, name: str, run_id: str = RETRY, *, kind: str | None = "checker_divergence", base: Path | None = None,
+               model: str | None = None, keep: bool = False, edit=None, export: bool = True) -> tuple[Path, Path]:
+    """An OUT made from the fixture (``single``, or ``base``, or one model's part of it) whose record ``run_id`` is moved to
+    harness/ unchanged (``keep``: also left in records/, as a re-run attempt has it) beside a sidecar of the given kind
+    (None: none), with a fresh replay check, and the frozen exporter's ledger of what is left in records/."""
+    out = _model_out(world, name, model, base) if model else world["tmp"] / name
+    if not model:
+        shutil.copytree(base or world["single"], out)
+    f = _find(out, run_id)
+    raw = f.read_bytes()
+    rec = json.loads(raw)
+    (out / "harness").mkdir(exist_ok=True)
+    (shutil.copy2 if keep else shutil.move)(f, out / "harness" / f.name)
+    if kind is not None:
+        doc = _sidecar(rec, f.name, raw, kind)
+        if edit is not None:
+            edit(doc)
+        (out / "harness" / (f.name.removesuffix(".json") + ".setaside.json")).write_text(
+            json.dumps(doc, indent=1, sort_keys=True), encoding="utf-8")
+    T._recheck(out)
+    ledger = world["tmp"] / f"{name}-ledger.jsonl"
+    if not export:  # the exporter refuses retries whose parent is gone: the whole fixture's ledger stands in
+        return out, world["ledger"]
+    assert T.exporter.main(["--split", "dev", "--records", str(out), "--out", str(ledger)]) == 0
+    return out, ledger
+
+
+def _go(world, outs, ledgers, **kw):
+    return T._run(world, list(outs), record=False, ledgers=tuple(ledgers), **kw)
+
+
+def _baseline(world) -> dict:
+    return _go(world, [world["single"]], [world["ledger"]])
+
+
+def _arms_of(result: dict, *, model: str, cohort: str | None = None) -> dict:
+    return {k: v for k, v in result["arms"].items() if f"|{model}|" in k and (cohort is None or f"|{cohort}|" in k)}
+
+
+# --- the production failure, and the exclusion that answers it ------------------------------------------------------------
+
+
+def test_a_set_aside_retry_without_the_exclusion_leaves_its_parent_without_a_row_and_the_look_refuses(world):
+    out, ledger = _set_aside(world, "sa-nosidecar", kind=None)
+    T._refused(world, [out], NO_ROW, record=False, ledgers=(ledger,))
+    assert _baseline(world)["arms"]  # the same OUT whole passes: the refusal is the set-aside's
+
+
+def test_a_checker_divergence_set_aside_drops_the_parent_from_every_arm(world):
+    out, ledger = _set_aside(world, "sa-div")
+    base = _baseline(world)
+    result = _go(world, [out], [ledger])
+    # the parent is absent from the attempts and from every ledger row, all sources (prepare's own population)
+    cm, rec = T._map()
+    loaded, _union, _ctx = ex.prepare(F, T._call(world, [out], record=False, ledgers=(ledger,)), cluster_map=cm, map_record=rec)
+    assert PARENT not in {a.run_id for a in loaded.attempts}
+    assert PARENT not in {c.run_id for c in loaded.ledger} and not any(a.run_id.startswith("missing:") for a in loaded.attempts)
+    assert RETRY not in {c.run_id for c in loaded.ledger}
+    # every arm of Qwen's beta cohort (the prompt arm and every checker arm) is on the same three units, every other arm is as
+    # in the whole fixture
+    beta = _arms_of(result, model=T.QWEN, cohort="beta")
+    assert len(beta) >= 3 and all(a["counts"]["N_att"] == 3 for a in beta.values())
+    assert all(a["counts"]["N_att"] == 4 for a in _arms_of(base, model=T.QWEN, cohort="beta").values())
+    for model, cohort in ((T.QWEN, "none"), (T.QWEN, "alpha"), (GEMMA, None)):
+        assert _arms_of(result, model=model, cohort=cohort) == _arms_of(base, model=model, cohort=cohort)
+    assert set(result["arms"]) == set(base["arms"])
+    # the disclosure: run ids and a count, no outcome
+    block = result["exploratory"]["excluded_setaside_parents"]
+    assert block["count"] == 1 and block["rule"] == ex.SETASIDE_RULE
+    (entry,) = block["outs"]
+    assert entry == {"out": str(out), "count": 1, "run_ids": [PARENT], "setaside_records": [RETRY],
+                     "sidecars": [next(f.name for f in (out / "harness").glob("*.setaside.json"))]}
+    assert "excluded_setaside_parents" not in base["exploratory"]
+
+
+def test_the_exclusion_runs_the_deployment_and_store_sections_too(world):
+    out, ledger = _set_aside(world, "sa-sections")
+    result = _go(world, [out], [ledger])
+    assert result["deployments"] and result["stores"]["copies"] is not None
+    (entry,) = result["exploratory"]["excluded_setaside_parents"]["outs"]
+    assert set(entry) == {"out", "count", "run_ids", "setaside_records", "sidecars"}  # run ids and counts, no outcome
+
+
+def test_a_second_retry_of_the_same_parent_set_aside_is_counted_once(world):
+    out, _ = _set_aside(world, "sa-two")
+    f = _find(out, OTHER_RETRY)
+    raw, rec = f.read_bytes(), json.loads(f.read_bytes())
+    shutil.move(f, out / "harness" / f.name)
+    (out / "harness" / (f.name.removesuffix(".json") + ".setaside.json")).write_text(
+        json.dumps(_sidecar(rec, f.name, raw, "checker_divergence")), encoding="utf-8")
+    T._recheck(out)
+    ledger = world["tmp"] / "sa-two-ledger.jsonl"
+    assert T.exporter.main(["--split", "dev", "--records", str(out), "--out", str(ledger)]) == 0
+    (entry,) = _go(world, [out], [ledger])["exploratory"]["excluded_setaside_parents"]["outs"]
+    assert entry["count"] == 1 and entry["run_ids"] == [PARENT] and entry["setaside_records"] == sorted([RETRY, OTHER_RETRY])
+
+
+@pytest.mark.parametrize("kind", ["infrastructure", "infrastructure_fault_window", "something_else"])
+def test_a_sidecar_of_another_classification_changes_nothing(world, kind):
+    out, ledger = _set_aside(world, f"sa-{kind}", kind=kind)
+    none, ledger_none = _set_aside(world, f"sa-none-{kind}", kind=None)
+    assert ledger.read_bytes() == ledger_none.read_bytes()
+    with pytest.raises(F.refusals, match=NO_ROW) as with_sidecar:
+        _go(world, [out], [ledger])
+    with pytest.raises(F.refusals, match=NO_ROW) as without:
+        _go(world, [none], [ledger_none])
+    assert str(with_sidecar.value).replace(str(out), "X") == str(without.value).replace(str(none), "X")
+
+
+def test_an_unreadable_sidecar_is_left_alone_as_the_frozen_loaders_leave_it(world):
+    out, ledger = _set_aside(world, "sa-unreadable")
+    side = next((out / "harness").glob("*.setaside.json"))
+    side.write_text("{not json", encoding="utf-8")
+    T._recheck(out)
+    T._refused(world, [out], NO_ROW, record=False, ledgers=(ledger,))
+
+
+def test_a_set_aside_whose_attempt_was_re_run_excludes_nothing(world):
+    kept, ledger = _set_aside(world, "sa-rerun", keep=True)  # the retry is in records/ and in harness/ with its sidecar
+    other, ledger_other = _set_aside(world, "sa-rerun-other", keep=True, kind="infrastructure")
+    a, b = _go(world, [kept], [ledger]), _go(world, [other], [ledger_other])
+    assert "excluded_setaside_parents" not in a["exploratory"]
+    a["exploratory"]["outs"][0].pop("path"), b["exploratory"]["outs"][0].pop("path")
+    assert json.dumps(a["arms"], sort_keys=True) == json.dumps(b["arms"], sort_keys=True)
+    assert all(x["counts"]["N_att"] == 4 for x in _arms_of(a, model=T.QWEN, cohort="beta").values())
+
+
+# --- the sidecar is bound to its record, or the call is refused ------------------------------------------------------------
+
+
+def _refuse_edit(world, name: str, match: str, edit=None, *, tamper=None) -> None:
+    out, ledger = _set_aside(world, name, edit=edit)
+    if tamper is not None:
+        tamper(out)
+        T._recheck(out)
+    T._refused(world, [out], match, record=False, ledgers=(ledger,))
+
+
+def test_a_sidecar_naming_other_bytes_than_its_record_is_refused(world):
+    _refuse_edit(world, "sa-sha", "bytes are not the ones the sidecar holds", lambda d: d.update(sha256="0" * 64))
+
+
+def test_a_sidecar_naming_another_record_than_the_one_beside_it_is_refused(world):
+    _refuse_edit(world, "sa-record", "does not name the record", lambda d: d.update(record="other.json"))
+
+
+@pytest.mark.parametrize("field,value", [("run_id", "another-run"), ("repetition", 7)])
+def test_a_sidecar_naming_another_attempt_than_its_record_is_refused(world, field, value):
+    _refuse_edit(world, f"sa-{field}", "is not the attempt the sidecar names", lambda d: d.update({field: value}))
+
+
+@pytest.mark.parametrize("field,value", [("question_id", "s01-pass"), ("model", GEMMA), ("arm", "gen:any")])
+def test_a_sidecar_naming_an_attempt_that_has_a_record_excludes_nothing_and_the_frozen_refusal_stands(world, field, value):
+    """The attempt it names has a record in records/, so no row of it is missing and nothing is excluded; the real retry's
+    parent still lacks its row, which the frozen path refuses as without any sidecar."""
+    _refuse_edit(world, f"sa-{field}", NO_ROW, lambda d: d.update({field: value}))
+
+
+@pytest.mark.parametrize("value", ["drop", None, "", ["fb:curated"]])
+def test_a_grid_sidecar_without_a_cell_is_refused(world, value):
+    def edit(d):
+        d.pop("arm") if value == "drop" else d.update(arm=value)
+    _refuse_edit(world, "sa-noarm", "names no cell", edit)
+
+
+def test_a_divergence_record_missing_from_harness_is_refused(world):
+    _refuse_edit(world, "sa-gone", "is not in harness/",
+                 tamper=lambda out: next(p for p in (out / "harness").glob("*.json") if not p.name.endswith(".setaside.json")).unlink())
+
+
+def test_a_divergence_record_whose_parent_is_not_in_the_out_is_refused(world):
+    out, ledger = _set_aside(world, "sa-orphan")
+    parent = _find(out, PARENT)
+    shutil.move(parent, out / "harness" / parent.name)  # the parent is gone from records/
+    T._recheck(out)
+    with pytest.raises(F.refusals, match=PARENT):  # inputs._check_branch's refusal of the set-aside's parent, by run id
+        _go(world, [out], [ledger])
+
+
+# --- the pooled call applies it per OUT -------------------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("side", ["qwen", "gemma"])
+def test_a_pooled_call_applies_the_exclusion_to_the_out_that_holds_the_sidecar_only(world, side):
+    qwen, q_ledger = _set_aside(world, "pool-qwen", model=T.QWEN, kind="checker_divergence" if side == "qwen" else None) \
+        if side == "qwen" else (None, None)
+    if side == "gemma":
+        qwen = _model_out(world, "pool-qwen", T.QWEN)
+        q_ledger = world["tmp"] / "pool-qwen-ledger.jsonl"
+        assert T.exporter.main(["--split", "dev", "--records", str(qwen), "--out", str(q_ledger)]) == 0
+        gemma_retry = next(f for f in sorted((world["single"] / "records").glob("*.json"))
+                           if (r := json.loads(f.read_text(encoding="utf-8")))["model"] == GEMMA and r["load"]["arm"] == "fb:curated")
+        gemma, g_ledger = _set_aside(world, "pool-gemma", run_id=json.loads(gemma_retry.read_text(encoding="utf-8"))["run_id"],
+                                     model=GEMMA)
+    else:
+        gemma = _model_out(world, "pool-gemma", GEMMA)
+        g_ledger = world["tmp"] / "pool-gemma-ledger.jsonl"
+        assert T.exporter.main(["--split", "dev", "--records", str(gemma), "--out", str(g_ledger)]) == 0
+    base = _baseline(world)
+    result = _go(world, [qwen, gemma], [q_ledger, g_ledger])
+    block = result["exploratory"]["excluded_setaside_parents"]
+    held = qwen if side == "qwen" else gemma
+    assert block["count"] == 1 and [o["out"] for o in block["outs"]] == [str(held)]
+    held_model, other_model = (T.QWEN, GEMMA) if side == "qwen" else (GEMMA, T.QWEN)
+    assert _arms_of(result, model=other_model) == _arms_of(base, model=other_model)  # the other OUT's arms are untouched
+    assert all(a["counts"]["N_att"] == 3 for a in _arms_of(result, model=held_model, cohort="beta").values())
+    assert _arms_of(result, model=held_model, cohort="none") == _arms_of(base, model=held_model, cohort="none")
+
+
+# --- a partition union keeps the frozen refusal ----------------------------------------------------------------------------
+
+
+def test_an_out_of_a_partition_union_keeps_the_frozen_refusal(world):
+    k = T.K3["s01-noquery"]
+    out, ledger = _set_aside(world, "sa-part", base=world["parts"][k])
+    assert T.exporter.main(["--split", "dev", "--records", str(out), "--out", str(ledger)]) == 0
+    parts = [out if i == k else p for i, p in enumerate(world["parts"])]
+    ledgers = [ledger if i == k else world["tmp"] / f"plain-{i}.jsonl" for i in range(3)]
+    for i, p in enumerate(world["parts"]):
+        if i != k:
+            assert T.exporter.main(["--split", "dev", "--records", str(p), "--out", str(ledgers[i])]) == 0
+    with pytest.raises(F.refusals, match=NO_ROW):
+        T._run(world, parts, record=True, ledgers=tuple(ledgers))
