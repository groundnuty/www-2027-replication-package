+def test_the_checks_across_outs_stay_the_frozen_ones(world):
+    one, two = _e150(world, "uniprot-e150-qwen3.8-27b-p1"), _e150(world, "uniprot-e150-qwen3.8-27b-p2")
+    _check([one, two])  # the same two routes in both
+    other = _e150(world, "uniprot-e150-qwen3.8-27b-p3", new=NEW2)  # another new route: another URL for the model and graph
+    with pytest.raises(F.refusals, match=ROUTE_MISMATCH):
+        _check([one, other])
+    # two retry OUTs of one model and graph whose parents ran on different routes, both retried on the same new one:
+    # three route base URLs in the call, which the stood-in view alone would show as one
+    third_parents = _e150(world, "uniprot-e150-qwen3.8-27b-p5", old=THIRD)
+    assert {r["route"]["base_url"] for _, records, _ in _batches([one, third_parents]) for r in records} == {OLD, THIRD, NEW}
+    for pair in ([one, third_parents], [third_parents, one]):
+        with pytest.raises(ex.Refused, match="another route base URL or stack for the parents"):
+            _check(pair)
+    # the same parents' route base URL recorded under two stacks (a forward re-pointed behind an unchanged URL): the frozen
+    # check refuses one URL under two stacks, and so does the call
+    def other_stack(m):
+        m["entry150"]["new_deployment"]["stack"]["from"] = "stack-other"
+
+    other = _e150(world, "uniprot-e150-qwen3.8-27b-p6", edit_manifest=other_stack,
+                  edit_identity=_set("stack_override", "from", value="stack-other"))
+    assert ex.e150_redeploy(ex.Out.read(other))[4] == "stack-other"
+    for pair in ([one, other], [other, one]):
+        with pytest.raises(ex.Refused, match="another route base URL or stack for the parents"):
+            _check(pair)
+    _check([one, two])
+    # another graph is another (graph, model): the parents' route there is its own (as check_one_stack groups them)
+    elsewhere = _e150(world, "uniprot-e150-qwen3.8-27b-p7", old=THIRD)
+    for f in sorted((elsewhere / "records").glob("*.json")):
+        _edit_json(f, lambda r: r["store"].update(name="s02"))
+    T._recheck(elsewhere)
+    _check([one, elsewhere])
+    plain = _e150(world, "uniprot-plain", edit_manifest=_drop("entry150"), parents_on=OLD, retries_on=OLD)
+    with pytest.raises(F.refusals, match=ROUTE_MISMATCH):  # an OUT of the model on the parents' route beside the retry OUT
+        _check([one, plain])
+    stacked = _e150(world, "uniprot-e150-qwen3.8-27b-p4", edit_identity=lambda i: i["stack_override"].update(to=STACK_NEW))
+    _edit_json(stacked / "deployment-identity.json", lambda i: i["stacks_by_route_model"].update({T.QWEN: STACK_OLD}))
+    T._recheck(stacked)  # (not an e150 OUT any more: its model is on the old stack) and the one stack rule still holds
+    with pytest.raises(F.refusals):
+        _check([one, stacked])
+
+
+# --- the model stays under check_fingerprints and the admitted set ---------------------------------------------------------
+
+
+def _unadmitted(r: dict) -> str:
+    """Qwen's retry rows on s01-flag served by another fingerprint than the baseline's (FP_A)."""
+    return T.FP_B if r["question_id"] == "s01-flag" and r.get("checker") is not None else T.FP_A
+
+
+def _entry(**over) -> dict:
+    return {**T.ADMIT_B, "stack": STACK_NEW, **over}
+
+
+def test_an_unadmitted_fingerprint_of_the_retry_rows_is_refused(world, tmp_path):
+    out = _e150(world, fp_of=_unadmitted)
+    empty = T._admissions(tmp_path / "empty.json")
+    with pytest.raises(F.refusals, match="served fingerprints not admitted"):
+        _go(world, [out], admissions=empty)
+    # the baseline: the same OUT admitted for its model on its new stack, by the config
+    result = _go(world, [out], admissions=T._admissions(tmp_path / "admit.json", _entry()))
+    (change,) = result["deployments"]["fingerprint_changes"]
+    assert (change["route_model"], change["stack"], change["system_fingerprint"]) == (T.QWEN, STACK_NEW, T.FP_B)
+
+
+@pytest.mark.parametrize("over", [{"stack": STACK_OLD}, {"route_model": "google/gemma-4-31B"},
+                                  {"system_fingerprint": "vllm-0.32.0-cccc0003"}, {"vllm_version": "0.33.0"},
+                                  {"checkpoint": "0" * 40}])
+def test_an_admission_for_another_stack_model_fingerprint_version_or_checkpoint_does_not_admit(world, tmp_path, over):
+    out = _e150(world, fp_of=_unadmitted)
+    with pytest.raises(F.refusals, match="served fingerprints not admitted|not the baseline's|stack's are"):
+        _go(world, [out], admissions=T._admissions(tmp_path / "admit.json", _entry(**over)))
