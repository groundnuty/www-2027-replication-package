+        outs = list(world.outs)
+        outs[i] = dataclasses.replace(world.outs[i], manifest={"partition": block})
+        return outs
+
+    foreign = with_block(0, excluded_digests=sorted([d0, d1]))  # a digest of partition 1 in partition 0's list
+    with pytest.raises(ex.Refused, match="not its share of the fold"):
+        bind(world, outs=foreign)
+    short = with_block(1, excluded_digests=[], exclude_file={**world.outs[1].manifest["partition"]["exclude_file"],
+                                                              "digests_of_this_partition": 0})  # the union lacks a line
