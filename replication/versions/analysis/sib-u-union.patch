+def _pop_ids(tag_keys):
+    """Run ids by the world's own rule (a uuid5 of "<question id>/<repetition>/<tag>"), typed here from that rule and not read from
+    the code under test: ``tag_keys`` is a list of (tag, question index, repetition)."""
+    ids = toy_ids()
+    return sorted(str(uuid.uuid5(uuid.NAMESPACE_DNS, f"{ids[i]}/{rep}/{tag}")) for tag, i, rep in tag_keys)
+
+
+def _pop_dir(tmp_path):
+    pop = tmp_path / "pop"
+    pop.mkdir()
+    pop.chmod(0o700)
+    return pop
+
+
+def _pop_setup(tmp_path):
+    import numpy as np
+
+    w = _scored_union_world(tmp_path)
+    F = ex.load_frozen(HERE.parents[2])
+    cm = F.prereg.ClusterMap.singletons(w.ids)
+    map_record = {"graph": ex.SIB, "store": "rhea-test", "questions_sha256": w.qsha}
+
+    def call(view, completed, population):
+        exclude, exclude_sha, fact, fact_sha = w.fold(completed)
+        return ex.Call(tuple(w.parts), (w.questions,), ex.SIB, "test", (w.voided,),
+            partition_record=w.record, partition_record_sha256=w.record_sha,
+            n_reps=2, ledgers=tuple(w.ledgers[p] for p in w.parts), source_ledger=w.ledgers[w.source],
+            fold=exclude, fold_sha256=exclude_sha, fold_fact=fact, fold_fact_sha256=fact_sha, fold_view=view,
+            source_batch=w.source, source_order=w.order, source_order_sha256=ex.sha256_file(w.order),
+            source_manifest=w.source / "manifest.json", sib_analysis_questions=w.analysis, sib_analysis_pin=w.pin,
+            population_out=population)
+
+    def go(view, completed, population, units):
+        return ex.run_with_population(F, call(view, completed, population), K_clusters=np.ones((2, units)),
+                                      cluster_map=cm, map_record=map_record, cfg=SimpleNamespace())
+
+    return w, call, go
+
