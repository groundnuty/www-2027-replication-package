+def test_a_sib_ledger_row_of_an_excluded_question_is_refused_even_when_its_run_id_is_an_included_attempts(world, monkeypatch):
+    """The frozen arm build matches a row to an attempt by run id and compares the base question and the label, never the
+    question id: a row whose run id is an included attempt's and whose question_id is an excluded question's is counted by it
+    (shown here on the build itself) and refused by this call."""
+    out, qa, pin, ledger, rows = _store_call(world, monkeypatch, ex.SIB)
+    first = rows[0]
+    assert first["question_id"] != EXCLUDED
+    forged = [{**r, "question_id": EXCLUDED} if r is first else r for r in rows]
+    # the frozen build alone accepts it (so the refusal is this script's): the same attempts and rows, no analysis-set check
+    loaded, _, _ = ex.prepare(F, _sib_call(world, out, qa))
+    F.metrics.build_arms(loaded.attempts, F.pipeline.ledger_source_names(
+        [F.inputs.CheckedOutput(**{k: v for k, v in r.items() if k != "split"}) for r in forged], None))
+    message = r"^--ledger: a row of a question outside the analysis set, or of another base question than the set's$"
+    for label, changed in (
+            ("question id", [{**r, "question_id": EXCLUDED} if r is first else r for r in rows]),
+            ("base question", [{**r, "base_question_id": EXCLUDED} if r is first else r for r in rows]),
+            ("both", [{**r, "question_id": EXCLUDED, "base_question_id": EXCLUDED} if r is first else r for r in rows]),
+            ("a question of no set", [{**r, "question_id": "s01-nowhere", "base_question_id": "s01-nowhere"}
+                                      if r is first else r for r in rows]),
+            ("another included question", [{**r, "question_id": "s01-abstain", "base_question_id": "s01-abstain"}
+                                           if r is first and r["question_id"] != "s01-abstain" else r for r in rows])):
+        if label == "another included question":  # a question of the set: this check passes it (the arm build compares the base)
+            with pytest.raises(F.refusals) as exc:
+                ex.run(F, _sib_ledger_call(world, out, qa, pin, [_rewrite_ledger(world, changed, f"{label}.jsonl")]))
+            assert not re.search(message, str(exc.value)), label
+            continue
+        with pytest.raises(ex.Refused, match=message):
+            ex.run(F, _sib_ledger_call(world, out, qa, pin, [_rewrite_ledger(world, changed, f"{label}.jsonl")]))
+    assert ex.run(F, _sib_ledger_call(world, out, qa, pin, [ledger]))["real_output_ledger"]["rows"]  # the twin
