+def test_prepare_run_derived_forms_and_refusing_twins(world, tmp_path, monkeypatch):
+    """The form sources feed the frozen estimator: A=2/3, B=1/3 by hand on three singleton questions. The form is never given: the
+    union derives it from the real fact file (written below and read by SibFact.read under its sha256) and the analysis set."""
+    import numpy as np
+
+    root = HERE.parents[2]
