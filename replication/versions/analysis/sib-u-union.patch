+def test_non_empty_ledger_denominators_and_model_pooling_with_unequal_repetitions():
+    """m has 3 q1 outputs and 1 q2 output; m2 has 1 q1 and 2 q2. Empty results are still attempts.
+    Catches per question in the pooled row: (2/4,1/3), hence 5/12; only c1 and d1 catch on
+    non-empty outputs: (1/4,1/3), hence 7/24. False flags: (1/4,2/3), hence 11/24;
+    only a2 is non-empty, so (1/4,0) gives 1/8. These denominators stay at all attempts."""
+    rows = [("a1", "q1", 0, False, "F", 0, "m"),
+            ("a2", "q1", 1, True, "F", 1, "m"),
+            ("a3", "q1", 2, False, "U", 0, "m"),
+            ("b1", "q2", 0, True, "F", 0, "m"),
+            ("c1", "q1", 0, False, "F", 1, "m2"),
+            ("d1", "q2", 0, False, "F", 1, "m2"),
+            ("d2", "q2", 1, True, "F", 0, "m2")]
+    attempts = [attempt(r, q, rep, correct, model=model) for r, q, rep, correct, _, _, model in rows]
+    ledger = [dataclasses.replace(checked(r, q, correct, status, True, model=model), result_rows=count)
+              for r, q, _, correct, status, count, model in rows]
+    index = F.prereg.index_from_questions(QUESTIONS, "dev")
+    table = P.real_output_ledger(M.build_arms(attempts, ledger), index, K, LEVEL, None, K)
+    (pooled,) = table["rows"]
+    by_model = {row["model"]: row for row in table["by_model"]}
+    assert pooled["counts"]["N_att"] == 7
+    assert pooled["non_empty"]["outputs"] == {"returns_rows": 3, "empty": 4, "no_row_count": 0}
+    assert pooled["per_attempt"]["catches"]["estimate"] == pytest.approx(5 / 12)
+    assert pooled["non_empty"]["catches"]["estimate"] == pytest.approx(7 / 24)
+    assert pooled["per_attempt"]["false_flags"]["estimate"] == pytest.approx(11 / 24)
+    assert pooled["non_empty"]["false_flags"]["estimate"] == pytest.approx(1 / 8)
+    assert pooled["non_empty"]["catches"]["ci"] == pytest.approx([5 / 18, 11 / 36])
+    assert {model: row["counts"]["N_att"] for model, row in by_model.items()} == {"m": 4, "m2": 3}
+    assert by_model["m"]["non_empty"]["outputs"] == {"returns_rows": 1, "empty": 3, "no_row_count": 0}
+    assert by_model["m2"]["non_empty"]["outputs"] == {"returns_rows": 2, "empty": 1, "no_row_count": 0}
+    assert by_model["m"]["per_attempt"]["catches"]["estimate"] == pytest.approx(1 / 6)
+    assert by_model["m"]["non_empty"]["catches"]["estimate"] == 0.0
+    assert by_model["m2"]["per_attempt"]["catches"]["estimate"] == pytest.approx(3 / 4)
+    assert by_model["m2"]["non_empty"]["catches"]["estimate"] == pytest.approx(3 / 4)
+    assert by_model["m"]["non_empty"]["false_flags"]["estimate"] == pytest.approx(1 / 6)
+    assert by_model["m2"]["non_empty"]["false_flags"]["estimate"] == 0.0
+
