+def _rhea_pin(world, qa: Path, *, salt=SALT, salt_mode=0o600, pin_name="rhea.pin.json", salt_name="gold-salt", **change):
+    """A sib-rhea-analysis-pin/1 for ``qa`` with its raw 32-byte salt file (toy values), both mode 600."""
+    salt_path = world["tmp"] / salt_name
+    salt_path.write_bytes(salt)
+    os.chmod(salt_path, salt_mode)
+    raw = qa.read_bytes()
+    pin = {"schema": ex.SIB_RHEA_PIN_SCHEMA, "questions_analysis_sha256": hashlib.sha256(raw).hexdigest(),
+           "public_salted_sha256": hashlib.sha256(salt + raw).hexdigest(), "gold_provenance_sha256": "7" * 64,
+           "salt_file": str(salt_path), **change}
+    pin_path = world["tmp"] / pin_name
+    pin_path.write_text(json.dumps(pin), encoding="utf-8")
+    os.chmod(pin_path, 0o600)
+    return pin_path
+
+
