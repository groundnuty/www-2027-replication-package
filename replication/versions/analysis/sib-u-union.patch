+def test_the_checks_of_the_attribution_run_on_every_record_and_only_what_is_served_and_counted_is_narrowed(world, monkeypatch):
+    """Opus r2: the fingerprint and front-join refusals are whole-OUT validity checks; an unlisted record may not escape them."""
+    out = _plain_out(world)
+    seen: list[set] = []
+    real = ex.check_fingerprints
+
+    def spy(at, code, path, records, admissions):
+        seen.append({r.question_id for r in records})
+        return real(at, code, path, records, admissions)
+
+    monkeypatch.setattr(ex, "check_fingerprints", spy)
+    _plain_run(world, out, ["t01-q1", "t01-q2"])
+    assert seen[0] == {"t01-q1", "t01-q2", "t02-q3"}  # the check: every record, the unlisted question's too
+    assert seen[1] == {"t01-q1", "t01-q2"}  # the changes reported: the kept ones
+    seen.clear()
+    _plain_run(world, out)
+    assert len(seen) == 1 and seen[0] == {"t01-q1", "t01-q2", "t02-q3"}  # without the option: one call, as it was
+
+    def refuse_unlisted(at, code, path, records, admissions):
+        if any(r.question_id == "t02-q3" for r in records):
+            raise ex.Refused("a fingerprint the admissions do not cover")
+        return real(at, code, path, records, admissions)
+
+    monkeypatch.setattr(ex, "check_fingerprints", refuse_unlisted)
+    with pytest.raises(ex.Refused, match="a fingerprint the admissions do not cover"):
+        _plain_run(world, out, ["t01-q1", "t01-q2"])  # a refusal on an unlisted record still refuses
+
