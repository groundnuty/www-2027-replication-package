+def test_a_question_with_no_attempt_in_an_arm_is_an_empty_draw_there(world):
+    """A second model m2 ran only q1, twice (both right): in its arm q2 has no attempt. The estimate is over the question present, 1.0;
+    on K2 = [[0, 2], [1, 1]] the first resample draws only q2 (absent): its denominator is 0, so the draw is undefined, and the second
+    draw is 1.0: the undefined share is 1/2 and the interval is that of the one defined draw, [1, 1]. The arm of m, with both
+    questions, is defined in both: accuracy draws (0*2/3 + 2*0)/2 = 0 and (2/3 + 0)/2 = 1/3: [0, 1/3]."""
+    attempts, ledger, index, arms = world
+    other = [attempt("c1", "q1", 0, True, model="m2"), attempt("c2", "q1", 1, True, model="m2")]
+    all_arms = M.build_arms([*attempts, *other], ledger)
+    k2 = np.array([[0, 2], [1, 1]], dtype=float)
+    key2 = next(k for k in all_arms if k.model == "m2")
+    acc2 = P._arm_result(key2, all_arms[key2], index, k2, LEVEL, {}, True)["metrics"]["accuracy"]
+    assert acc2["estimate"] == 1.0 and acc2["undefined_share"] == 0.5 and acc2["ci"] == pytest.approx([1.0, 1.0])
+    key1 = key_of(all_arms, "prompt") if key_of(all_arms, "prompt").model == MOD else next(
+        k for k in all_arms if k.model == MOD and k.use == "prompt")
+    acc1 = P._arm_result(key1, all_arms[key1], index, k2, LEVEL, {}, True)["metrics"]["accuracy"]
+    assert acc1["estimate"] == pytest.approx(1 / 3) and acc1["ci"] == pytest.approx([0.0, 1 / 3])
+
