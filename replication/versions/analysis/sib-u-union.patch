+                         {}, {"split": "test"}, {}, {}, {}, {}, {qsha}, {ex.SIB}, questions)
+
+    monkeypatch.setattr(ex, "load_inputs", selected_loader)
+    cm = F.prereg.ClusterMap.singletons(questions)
+    map_record = {"graph": ex.SIB, "store": ex.SIB, "questions_sha256": qsha}
+
+    def call(view="primary", reps=1, **kw):
+        w = state.w
+        fields = dict(partition_record=w.rec_path, n_reps=reps, partition_record_sha256=w.rec_sha,
+            fold=tmp_path / "fold.txt", fold_sha256=w.exclude_sha, fold_fact=tmp_path / "fact.json",
+            fold_fact_sha256=state.sha, fold_view=view,
