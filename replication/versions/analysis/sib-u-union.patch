+def test_a_stratum_and_a_restricted_set_of_units_follow_the_same_rule(world):
+    """strata: template t1 holds q1 alone, t2 holds q2 alone, on the call's index and K. The t1 stratum's accuracy is q1's 2/3 (q2 is an
+    empty draw there: every K row has q1 at least once, so the interval is [2/3, 2/3]); the t2 stratum's is 0. The restricted units of a
+    deployment (the deployment section's restriction: units removed, never made missing) are the same function on a subset: the units of
+    q1 alone give 2/3 with n_questions 1."""
+    attempts, ledger, index, arms = world
+    key = key_of(arms, "prompt")
+    result = P._arm_result(key, arms[key], index, K, LEVEL, {}, True)
+    t1 = result["strata"]["template"]["t1"]
+    assert t1["counts"]["N_att"] == 3 and t1["counts"]["n_questions"] == 1
+    assert t1["metrics"]["accuracy"]["estimate"] == pytest.approx(2 / 3) and t1["metrics"]["accuracy"]["ci"] == pytest.approx([2 / 3, 2 / 3])
+    assert result["strata"]["template"]["t2"]["metrics"]["accuracy"]["estimate"] == 0.0
+    only_q1 = [u for u in arms[key] if u.cluster == "q1"]
+    restricted = P._arm_result(key, only_q1, index, K, LEVEL, {}, True)
+    assert restricted["counts"]["N_att"] == 3 and restricted["metrics"]["accuracy"]["estimate"] == pytest.approx(2 / 3)
