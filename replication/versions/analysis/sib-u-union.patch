+def test_the_ledger_on_real_outputs_of_a_prefix_with_unequal_repetitions_end_to_end(world):
+    """The call's own path over the plain-run toy (t01-q1 one listed attempt, t01-q2 two): the replay ledger's rows come from the real
+    matrix code and the frozen exporter. By hand, the toy records submit without running a query, so the checker cannot check any output:
+    every output of every source is status U (unknown, no query), none flagged, no row count recorded. So, per source: N_att 3, N_out 3,
+    unknown 3, catches 0, false_flags 0; the per-attempt rates 0; the unknown rate U/out = 3/3 = 1; the non-empty stratum all 'no row
+    count' (3), not estimable. The weighting under unequal repetitions is pinned by hand in test_unequal_repetitions.py."""
+    out = _prefix_out(world, drop=(("t02-q3", 0), ("t02-q3", 1), ("t01-q1", 1)))
+    ledger, rows = _plain_ledger(world, out)
+    assert {r["status"] for r in rows} == {"U"} and {r["result_rows"] for r in rows} == {None}
+    result = ex.run(F, dataclasses.replace(_key_call(world, out), ledgers=(ledger,)), **_plain_args())
+    table = result["real_output_ledger"]
+    assert len(table["rows"]) == 8  # the seven sources (census-t5 reported as census) and the union: one row each
+    for row in table["rows"]:
+        assert row["counts"] == {"N_att": 3, "N_out": 3, "catches": 0, "false_flags": 0, "fixes": 0, "corruptions": 0, "unknown": 3,
+                                 "vacuous_passes": 0, "retried": 0}, row["source"]
+        assert row["per_attempt"]["catches"]["estimate"] == 0.0 and row["per_attempt"]["false_flags"]["estimate"] == 0.0
+        assert row["unknown_rate"]["estimate"] == 1.0
+        assert row["non_empty"]["outputs"] == {"returns_rows": 0, "empty": 0, "no_row_count": 3} and not row["non_empty"]["estimable"]
+    # and the result has exactly the sections of the exploratory path, no between-arm or paired estimate among them
+    assert set(result) == {"arms", "confirmatory", "deployments", "exploratory", "model_settings", "output_cap_hits",
+                           "real_output_ledger", "refusals", "scorer_changes", "settings", "stores", "schema"}
+    assert result["confirmatory"] is None
