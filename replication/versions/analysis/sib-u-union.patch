+# --- SIB U: the unit's own store check and the source's post-hoc proof, accepted only under a sib-u-partition/1 binding -----
+# A partition OUT a sib-u-partition/1 record bound has a store block whose check text is the unit check's own ('checked') and an
+# identity partition block that records the sha256 of that unit check file (store_check_sha256). prepare hands those sha256s to
+# check_stores; with one, the entry's storecheck may be that sib-unit-store-check/1 file. The unit check may have been READ
+# through a spoke forward to the copy: that is disclosed in the proof row, never required (science, 25 Oct ~22:15Z), so an entry
+# cites no forward record (a read_through key is refused). The source OUT (U) is proven post hoc by an ident.py file that names its
+# one copy at a forward address, with the known answers at the OUT's own endpoint. Nothing else reads these.
+
+DISCLOSURE = "read through the spoke forward (disclosed, not required)"
+
+
+def _sib_unit_check(path: Path, ep: str, copy: str, **over) -> Path:
+    doc = {"schema": ex.SIB_U_STORECHECK_SCHEMA, "checked_utc": CHECKED_AT, "differ": [], "endpoint": ep,
+           "identical_to_reference": True, "identity_check": "checked", "image_sha256": "ab" * 32,
+           "index_identity": NAME_INDEX, "reference": "http://ref.invalid:7039", "replica": copy, **over}
+    path.write_text(json.dumps(doc, indent=1) + "\n", encoding="utf-8")
+    return path
+
+
+def _sib_union_copies(world) -> tuple[list[Path], list[dict], dict[str, str]]:
+    """Partition p on its own copy's endpoint, proven by the unit's own check file (no forward record); the identity's
+    check text is 'checked'."""
+    files, entries, bound = [], [], {}
+    for p, out in enumerate(world["parts"]):
+        endpoint = f"http://10.1.1.{p}:70{p}0/"
+        _set_endpoints(out, lambda r, e=endpoint: e)
+        sc, ka = _sib_unit_check(world["tmp"] / f"sib-sc-p{p}.json", endpoint, f"copy-{p}"), _load10(
+            world["tmp"] / f"sib-ka-p{p}.json", endpoint)
+        _edit_identity(out, lambda i, e=endpoint: i["store"].update(endpoint=e, identity_check="checked"))
+        files += [sc, ka]
+        entries.append(_entry(out.name, endpoint, f"copy-{p}", (sc, ka)))
+        bound[str(out)] = _sha(sc)
+    return files, entries, bound
+
+
+def _sib_check_stores(world, files, entries, bound, outs=None, source=None):
+    config = _store_config(world["tmp"] / "sib-proofs.json", *entries)
+    classes = _classes_file(world["tmp"] / "classes.json")
+    return ex.check_stores(ex.load_attribution(), [ex.Out.read(o) for o in (outs or world["parts"])], "s01", tuple(files),
+                           config, None, classes, None, bound, source)
+
+
+def test_a_sib_u_partitions_unit_check_proves_its_copy_only_under_the_record_binding(world, ref):
+    files, entries, bound = _sib_union_copies(world)
+    st = _sib_check_stores(world, files, entries, bound)  # bound: each partition's own copy, proven by its unit check
+    assert sorted(st.copies) == ["copy-0", "copy-1", "copy-2"]
+    # the very same files and entries with no binding (a union no sib-u-partition/1 record bound): refused, as before
+    with pytest.raises(ex.Refused, match="its storecheck is not a entry180-store-check/2 file"):
+        _sib_check_stores(world, files, entries, None)
+    with pytest.raises(ex.Refused, match="its storecheck is not a entry180-store-check/2 file"):
+        _sib_check_stores(world, files, entries, {k: v for k, v in bound.items() if k != str(world["parts"][1])})  # one OUT
+    # a binding that names another sha256 than the file the entry cites
+    other = _sib_unit_check(world["tmp"] / "sib-sc-other.json", "http://10.1.1.1:7010/", "copy-1",
+                            checked_utc="2026-10-23T09:05:00Z")
+    wrong = {**bound, str(world["parts"][1]): _sha(other)}
+    with pytest.raises(ex.Refused, match=r"\(copy-1\): its SIB unit storecheck is not the one the partition identity binds"):
+        _sib_check_stores(world, files, entries, wrong)
+    assert sorted(_sib_check_stores(world, files, entries, bound).copies) == ["copy-0", "copy-1", "copy-2"]  # the twin
+
