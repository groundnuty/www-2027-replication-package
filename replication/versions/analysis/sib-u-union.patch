+@dataclasses.dataclass(frozen=True)
+class QuestionSubset:
+    """An explicit input restriction of the design to the listed base questions (science, 25 Oct 09:2xZ, SIB U: "analyse it on
+    COMPLETE QUESTIONS within its done-prefix; the remaining questions are 'not run', never missing; coverage stated"). The file
+    is pinned by the sha256 given beside it; its refusals name no question id and no count."""
+
+    path: Path
+    sha256: str  # of the file's bytes: the one the call was given
+    rule: str  # the rule text the file carries
+    ids: frozenset[str]
+    repetitions: int | None = None  # the repetitions per cell the file's rule counted (complete_questions.py --repetitions)
+    order_sha256: str | None = None  # the sha256 of the OUT's order file the file was made from
+
+    @classmethod
+    def read(cls, path: Path, expected_sha256: str) -> QuestionSubset:
+        if not (isinstance(expected_sha256, str) and re.fullmatch(r"[0-9a-f]{64}", expected_sha256)):
+            raise Refused("--question-subset-sha256: not 64 lower-case hex digits")
+        try:
+            raw = Path(path).read_bytes()
+        except OSError as exc:
+            raise Refused(f"--question-subset: cannot be read ({type(exc).__name__})") from None
+        if len(raw) > SUBSET_MAX_BYTES:
+            raise Refused(f"--question-subset: larger than {SUBSET_MAX_BYTES} bytes")
+        if sha256_bytes(raw) != expected_sha256:
+            raise Refused("--question-subset: not the file --question-subset-sha256 names")
+        try:
+            doc = json.loads(raw.decode("utf-8"))
+        except ValueError:
+            raise Refused("--question-subset: not valid JSON") from None
+        if not isinstance(doc, dict) or set(doc) != SUBSET_KEYS or doc["schema"] != SUBSET_SCHEMA:
+            raise Refused(f"--question-subset: not a {SUBSET_SCHEMA} file with exactly its keys")
+        if not (isinstance(doc["rule"], str) and doc["rule"].strip()):
+            raise Refused("--question-subset: no rule text")
+        hexed = re.compile(r"[0-9a-f]{64}")
+        if not all(isinstance(doc[k], str) and hexed.fullmatch(doc[k]) for k in ("pin_sha256", "order_sha256")):
+            raise Refused("--question-subset: a hash is not 64 lower-case hex digits")
+        if not (isinstance(doc["repetitions"], int) and not isinstance(doc["repetitions"], bool) and doc["repetitions"] >= 1):
+            raise Refused("--question-subset: repetitions is not a positive integer")
+        ids = doc["questions"]
+        if not (isinstance(ids, list) and ids and all(isinstance(i, str) and i for i in ids)):
+            raise Refused("--question-subset: the list of questions is empty or holds something that is not an id")
+        if len(set(ids)) != len(ids):
+            raise Refused("--question-subset: a question id twice in the list")
+        return cls(Path(path), expected_sha256, doc["rule"], frozenset(ids), doc["repetitions"], doc["order_sha256"])
+
+    def check(self, questions: Mapping[str, dict], split: str) -> None:
+        """Every listed question is a question of the batch's full set and of the analysed split."""
+        for qid in self.ids:
+            known = questions.get(qid)
+            if known is None:
+                raise Refused("--question-subset: a listed question is no question of the batch's full question set")
+            if known.get("split") != split:
+                raise Refused("--question-subset: a listed question is not a question of the analysed split")
+
+    def skips(self, question_id: Any) -> bool:
+        """A record of a question the list does not name is 'not run' (a record without a string id is no listed question's)."""
+        return not (isinstance(question_id, str) and question_id in self.ids)
+
+    def check_bases_whole(self, full: Mapping[str, dict]) -> None:
+        """The unit of the ruling is the BASE question, and the index counts a base once: a base question of the full question
+        set (the analysed split's, not only the analysis set's) whose question ids are some listed and some not is refused, as
+        ``check_bases_whole`` refuses a partition subset that splits one (the file lists ids; a base with two ids is complete
+        only when both are)."""
+        listed: set[str] = set()
+        unlisted: set[str] = set()
+        for qid, q in full.items():
+            (unlisted if self.skips(qid) else listed).add(q.get("base_question_id") or qid)
+        if listed & unlisted:
+            raise Refused("--question-subset: a base question of the design has question ids both listed and unlisted")
+
+    def check_repetitions(self, n_reps: int) -> None:
+        """The file counted complete questions by this many repetitions per cell: the call's design must have as many."""
+        if self.repetitions != n_reps:
+            raise Refused("--question-subset: made for another number of repetitions than the call's design")
+
+    def bind_order(self, order_sha256: str) -> None:
+        """The OUT's own order file (order-natural.json beside its records, when the batch has it) is the one the list was made from."""
+        if order_sha256 != self.order_sha256:
+            raise Refused("--question-subset: not made from this OUT's order file")
+
+    def check_complete(self, full: Mapping[str, dict], wide: Mapping[str, dict], present: Mapping[str, set], cells: set,
+                       n_reps: int) -> None:
+        """The list is the complete BASE questions of this OUT, read from its records by presence alone (a covered key of a done
+        prefix is a record; an exception is a key with none). A question id is record-complete when it has a record for every
+        (model, cohort) the OUT has and every repetition 0..n_reps-1; a base question is complete when every id of it in the full
+        question set of the split is (an id outside the batch, such as one the analysis set leaves out, has no record there, so
+        its base cannot be shown complete and cannot be listed). The listed ids of the design must be exactly the ids of the
+        complete bases: one listed but incomplete would show as a missing row, and one with every record whose base-mate has not
+        is out with its base, as complete_questions.py leaves it. The (model, cohort) cells are those of the records, so a cell
+        with no record at all is not checked by this comparison (the tool counts its keys). The bases are those of ``full``
+        (the batch's question file); complete_questions.py takes its own from ``--questions``: they must be the same file, and
+        where they differ this check refuses (a split, or a list that is not the complete bases). Nothing of an outcome."""
+        expected = {(model, cohort, rep) for model, cohort in cells for rep in range(n_reps)}
+        done = {qid for qid in full if present.get(qid, set()) >= expected}
+        ids_of_base: dict[str, set[str]] = defaultdict(set)
+        for qid, q in full.items():
+            ids_of_base[q.get("base_question_id") or qid].add(qid)
+        complete = {qid for ids in ids_of_base.values() if ids <= done for qid in ids}
+        if {qid for qid in wide if not self.skips(qid)} != {qid for qid in wide if qid in complete}:
+            raise Refused("--question-subset: not the complete questions of this OUT's records (a listed question lacks a "
+                          "record, or a base question with every record is not listed)")
+
+    def record(self, design: Mapping[str, dict], wide: Mapping[str, dict], questions: Mapping[str, dict], split: str,
+               analysis: bool) -> dict[str, Any]:
+        """What the results state: the file's hash, the rule, that unlisted questions are 'not run', and the coverage in
+        counts (the results are private and already hold the SIB counts). With the analysis set, its own questions of the split
+        are counted too, so the coverage of the analysed population can be read."""
+        coverage = {"listed": len(self.ids), "in_the_design": len(design),
+                    "questions_of_the_split": sum(1 for q in questions.values() if q.get("split") == split)}
+        if analysis:
+            coverage["analysis_questions_of_the_split"] = len(wide)
+        return {"sha256": self.sha256, "rule": self.rule, "unlisted": SUBSET_NOT_RUN, "coverage": coverage}
+
