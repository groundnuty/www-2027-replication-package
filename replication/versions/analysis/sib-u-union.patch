+    qsha = ex.sha256_file(question_file)
+    state = SimpleNamespace(w=world, fact=None, sha=None)  # the world, and the fact file (real, pinned by its sha256)
+
+    def publish(fact):
+        """The fact of record: written to the file the call names, whose sha256 the call pins."""
+        state.fact, state.sha = fact, write_fact(tmp_path / "fact.json", fact)
+
+    publish(world.fact())
+    analysis = SimpleNamespace(questions=questions, record=lambda *_: {})
+    monkeypatch.setattr(ex.AnalysisSet, "read", lambda *_: analysis)
+    monkeypatch.setattr(ex.SibFold, "read", lambda *_: state.w.fold)
+    monkeypatch.setattr(ex, "frozen_config", lambda *_: (SimpleNamespace(), {}))
+    monkeypatch.setattr(ex, "reference_pin", lambda *_: None)
+    monkeypatch.setattr(ex, "read_voided", lambda *_: (set(), []))
+    monkeypatch.setattr(ex, "check_not_voided", lambda *_: None)
+    monkeypatch.setattr(F.gate, "require_replay_check", lambda *_: None)
+    monkeypatch.setattr(F.gate, "select_questions", lambda *_: question_file)
+    monkeypatch.setattr(F.inputs, "load_questions", lambda *_: questions)
+    monkeypatch.setattr(ex, "check_union", lambda _F, outs, record, sha, *_args, **_kw:
+                        ex.Union(record, sha, 3, {str(o.path): i for i, o in enumerate(outs)}, {}))
+    monkeypatch.setattr(ex, "check_stores", lambda *_args: {})
+    monkeypatch.setattr(ex, "attribute", lambda *_args, **_kw: None)
+    monkeypatch.setattr(ex, "deployment_section", lambda *_args: {})
+    monkeypatch.setattr(ex, "store_section", lambda *_args: {})
+    monkeypatch.setattr(ex, "check_union_ledger", lambda *_args: None)
+    monkeypatch.setattr(ex, "cluster_counts", lambda _F, _m, _i, _cfg, K:
+                        (np.ones((2, len(_i.questions))), SimpleNamespace(summary=lambda: {})))
+
+    def selected_loader(_F, batches, _questions, *, fold_sources, **_kw):
+        w = state.w
+        attempts = []
+        for path in batches:
+            for qid, rep in fold_sources.allowed[path]:
+                i = w.ids.index(qid)
+                right = (path != w.source.path and i in (0, 2))
+                attempts.append(F.inputs.Attempt(run_id=f"{path.name}-{i}-{rep}", graph=ex.SIB, model="route",
+                    cohort="arm", question_id=qid, base_question_id=qid, template=qid, split="test", repetition=rep,
+                    status="submitted", output=True, correct=right, f1=float(right), wall_s=1.0))
+        design = {a.question_id: questions[a.question_id] for a in attempts}
