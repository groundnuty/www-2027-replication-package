+"""Names-only toys for the SIB partition adapter, its binding to the OUTs and the two fold forms, in the REAL formats.
+
+The record, identity, manifest and fact fixtures below are built with hashlib and json alone (not with the code under test),
+from the key sets the operator gave (sib_partition.py's assign, deployment_identity and partition_block).
+"""
+from __future__ import annotations
+
+import dataclasses
+import hashlib
+import importlib.util
+import json
+import os
+import shutil
+import sys
+import uuid
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location("sib_u_exploratory", HERE.parent / "exploratory.py")
+ex = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = ex
+spec.loader.exec_module(ex)
+fact_spec = importlib.util.spec_from_file_location(
+    "sib_union_fact_for_u", HERE.parents[1] / "sib-checker-look-20261025" / "sib_union_fact.py")
+fact_tool = importlib.util.module_from_spec(fact_spec)
+sys.modules[fact_spec.name] = fact_tool
+fact_spec.loader.exec_module(fact_tool)
+
+K = 3
+FACT_AT = "2026-10-26T02:00:00Z"
+
+
+def h(text: str) -> str:
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def toy_ids() -> list[str]:
+    # Independently calculated sha256("20261022|" + id) mod 3: 0, 1, 2.
+    return ["toy-question-0", "toy-question-8", "toy-question-1"]
+
+
+ID_DIGESTS = (
+    ("4d3e09677bc75a8081b230b4f3cf0f224d606264f83120a168fed1df7cb3dcff",
+     "b1601895051ea09dcf7728c80f5487f8777238724304d8d4c2818bf6efc76ad4"),
+    ("baea943f83870c0a387c20b541c85ce543d93f03f5f3034adf8617c6d14095c1",
+     "6666f1b7a1d8e25ed1b2e1b675c80b85298ed52348f98687f57029ed479ee47a"),
+    ("154ab252f7ce5a79fe78a3bb3b936209e443477a5b8aa28c27261e52a1bee7bb",
+     "26c00c221f110600a82f823cd4cbcd145d80fbbbbd9aef3822d46b38a6f3e7b5"),
+)
+CLAIM_DIGESTS = ("246f19c84712c2fa9dbe91eaf423a495c30eab6e",
+                 "77b9659898dd4e74d675213ae7d9c33248809eb2",
+                 "0f7d312023ad9cf191e76241a520cf3cbf7c9776")
+# Vectors from running the reviewed sib_partition.py on six toy ids and two toy claim keys
+SIX_IDS = ["toy-a", "toy-b", "toy-c", "toy-d", "toy-e", "toy-f"]
+SIX_PARTITIONS = [1, 2, 1, 2, 1, 0]  # sib_partition.partition_of(id, 3)
+SIX_IDS_DIGEST = "3ffbd504a4e2781a7c1e3a2c29a8ccc444285a53c2014f24d4fd819587f7d318"  # ids_digest
+SIX_IDS_JOINED = "7b6af02f789b5ac222ab8eca86d5799961ad8c8b7f527b7bcd3d7a271587716c"  # ids_digest_joined
+CLAIM_ASCII = "83ddbc00f58e98f8a4314766b3817ab4f4a01ae8"  # claim_digest(["arm", "q-1", "route", 0])
+CLAIM_NON_ASCII = "52bf4a1fbefa6d9871090b3dac69fd675648f983"  # claim_digest(["arm", "qü-1", "route", 0])
