+def test_the_source_outs_forward_address_needs_its_recorded_mapping_and_nothing_else_stands_in(world, u_world):
+    entry = u_world["entry"]
+    files = u_world["files"][:3]
+    # no forward record given (--store-proof): the forward address is not the OUT's endpoint and nothing maps it
+    with pytest.raises(ex.Refused, match="no forward record given .* records its mapping to the OUT's endpoint for this replica"):
+        _u_check_stores(world, u_world, [entry], files=files)
+    # a plain watchdog log's start line maps nothing by command line: it is no frozen record
+    plain = _forward_log(world["tmp"] / "plain-u.log", ("2026-10-23T08:00:01Z copy-u ssh pid 4102 127.0.0.1:47711 -> 10.2.2.2:27711",))
+    with pytest.raises(ex.Refused, match="no forward record given"):
+        _u_check_stores(world, u_world, [entry], files=[*files, plain])
+    # two frozen records of the same mapping are one too many (which one the proof rests on would be a guess)
+    twin = _frozen(world["tmp"] / "u-forward-twin.txt", **{"# frozen on the spoke": "# frozen again on the spoke"})
+    with pytest.raises(ex.Refused, match="two forward records record the same mapping"):
+        _u_check_stores(world, u_world, [entry], files=[*files, u_world["record"], twin])
+    # the record is evidence of the mapping only: the file's content is held to the same checks as ever
