+def restricted_side_counts(F: Frozen, path: Path, batch: Any, cells: Any,
+                           keep: Callable[[dict], bool]) -> dict[tuple[str, str, str], Counter]:
+    """``batch.side_counts`` (the frozen ``load_batch``: infrastructure finals, earlier infrastructure tries and
+    ``failed:harness`` set-asides, per graph, model and cohort) over the records ``keep`` accepts only (it is given the record). The
+    same three counts from the same files, with the question filter the frozen loader has no place for; with ``keep`` true for
+    all it equals ``batch.side_counts`` (a test)."""
+    I = F.inputs
+    counts: dict[tuple[str, str, str], Counter] = defaultdict(Counter)
+
+    def count(r: dict, what: str) -> None:
+        cohort = I.record_cohort(r, cells)
+        if cohort is not None:  # a branch cell's side counts are the batch's branch_side, not these
+            counts[(I.store_name(r), r["model"], cohort)][what] += 1
+
+    for r in batch.records:
+        if keep(r) and I.is_infrastructure(r):
+            count(r, "infra_final")
+    finals = {r["run_id"] for r in [*batch.records, *batch.branch]}
+    for r in I._read_json_dir(Path(path) / "infrastructure"):
+        if r["run_id"] not in finals and keep(r):
+            count(r, "infra_tries")
+    for r in I._read_json_dir(Path(path) / "harness"):
+        if keep(r):
+            count(r, "failed_harness")
+    return dict(counts)
