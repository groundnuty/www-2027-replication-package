+def test_the_per_question_means_weigh_a_question_by_its_own_attempts_not_by_how_many_it_has(world):
+    """A question with two attempts of mixed outcome beside a question with one: (1/2 + 1) / 2, not the pooled 2/3."""
+    out = _prefix_out(world, drop=(("t02-q3", 0), ("t02-q3", 1), ("t01-q2", 0)))  # t01-q1 r0 r1 right, t01-q2 r1 wrong
+    for f in (out / "records").glob("*.json"):  # make t01-q1's second attempt wrong: a mixed question
+        r = json.loads(f.read_text())
+        if (r["question_id"], r["repetition"]) == ("t01-q1", 1):
+            r["score"] = {**r["score"], "exact": False}
+            f.write_text(json.dumps(r), encoding="utf-8")
+    _recheck_here(out)
+    keys = [("t01-q1", 0), ("t01-q1", 1), ("t01-q2", 1)]
+    arm = _key_run(world, out, keys)["arms"][PLAIN_ARM]
+    assert arm["counts"]["N_att"] == 3
+    assert arm["metrics"]["accuracy"]["estimate"] == pytest.approx((0.5 + 0.0) / 2)  # q1: (1 + 0) / 2, q2: 0 (not pooled 1/3)
+
