+# --- the source OUT (U): a post-hoc proof, its identity check ('checked') accepted only with its entry ----------------------
+
+EU = "http://10.2.2.2:27711/"
+
+
+FROZEN_RECORD = """# frozen on the spoke (a toy of the format: the watchdog's and its ssh child's command lines, the listener, the log's line)
+== pid 4101
+    PID    PPID                  STARTED ELAPSED STAT
+   4101       1 Fri Oct 23 08:00:00 2026   23512 Ss
+cmdline: bash /home/x/siteb-forwards/spoke_forward_watchdog.sh copy-u 47711 10.2.2.2 27711 /home/x/siteb-forwards 
+== pid 4102
+cmdline: ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -L 127.0.0.1:47711:10.2.2.2:27711 user@login.invalid 
+== listener
+LISTEN 0      128        127.0.0.1:47711      0.0.0.0:*    users:(("ssh",pid=4102,fd=4))    
+== fwd log (all lines, <=20)
+2026-10-23T08:00:01Z copy-u ssh pid 4102 127.0.0.1:47711 -> 10.2.2.2:27711
+"""
+
+
+def _frozen(path: Path, text: str = FROZEN_RECORD, **swap: str) -> Path:
+    for old, new in swap.items():
+        assert text.count(old) >= 1, old
+        text = text.replace(old, new)
+    path.write_text(text, encoding="utf-8")
+    return path
+
+
+@pytest.fixture
+def u_world(world, monkeypatch):
+    """The fixture's one OUT as SIB U's source: one copy at EU, identity check 'checked' with no store check sha256, proven by an
+    ident.py file that names its one copy at a spoke forward address (127.0.0.1:47711), a frozen forward record that records that
+    address's mapping to EU, and the known answers at its own endpoint."""
+    out, tmp = world["single"], world["tmp"]
+    _set_endpoints(out, lambda r: EU)
+    _edit_identity(out, lambda i: i["store"].update(endpoint=EU, replica="copy-u", identity_check="checked"))
+    reference = _ident(tmp / "ref-u.json", {"http://ref.invalid:7022": dict(STATS)}, checked_utc="2026-10-23T08:00:00Z")
+    monkeypatch.setitem(ex.REFERENCE_STATS_SHA256, "s01", _sha(reference))
+    monkeypatch.setitem(ex.REFERENCE_NAME_INDEX, "s01", NAME_INDEX)
+    ident = _ident(tmp / "ident-u.json", {"http://127.0.0.1:47711/": dict(STATS)})
+    ka = _load10(tmp / "ka-u.json", EU)
+    ka_doc = json.loads(ka.read_text(encoding="utf-8"))
+    ka_doc["checked_utc"] = "20261025T154238Z"
+    ka.write_text(json.dumps(ka_doc), encoding="utf-8")
+    record = _frozen(tmp / "u-forward-frozen.txt")
+    return {"out": out, "files": [reference, ident, ka, record], "ident": ident, "ka": ka, "reference": reference,
+            "record": record, "entry": _entry("single", EU, "copy-u", (ident, ka), **OLD)}
