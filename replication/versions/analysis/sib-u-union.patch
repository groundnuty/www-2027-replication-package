+# --- a key subset (science, 25 Oct 13:2xZ, SIB U): ALL the attempts of a done-prefix, per-question means over the repetitions present --------
+# The plain-run fixture as a drained prefix of an order of six keys, by hand. The order (index: question, repetition):
+#   0 t01-q2 r0 | 1 t02-q3 r0 | 2 t01-q1 r0 | 3 t02-q3 r1 | 4 t01-q2 r1 | 5 t01-q1 r1
+# The prefix is indices 0 to 4: the records of 0, 2 and 4 exist; 1 and 3 (t02-q3, whose records the harness set aside) are the
+# pin's exceptions, not covered; 5 is beyond the prefix. So the covered keys are (t01-q2, 0), (t01-q1, 0) and (t01-q2, 1), t01-q2's
+# repetitions far apart in the order, t01-q1 has ONE attempt, t02-q3 none. By hand: t01-q1's one attempt is right (mean 1), t01-q2's
+# two are wrong (mean 0), so accuracy is the mean of the per-question means, (1 + 0) / 2 = 1/2 (pooled over attempts it would be 1/3),
+# over 3 attempts of 2 questions; t02-q3 is 'not run'.
+
+KEY_ORDER = [("t01-q2", 0), ("t02-q3", 0), ("t01-q1", 0), ("t02-q3", 1), ("t01-q2", 1), ("t01-q1", 1)]
+KEY_COVERED = [("t01-q2", 0), ("t01-q1", 0), ("t01-q2", 1)]
+PLAIN_NAME = "fake"  # the order's name for the fixture's route model (its served-models.json)
+
+
+def _prefix_out(world, name="prefix-out", drop=(("t01-q1", 1), ("t02-q3", 0), ("t02-q3", 1))) -> Path:
+    """The plain-run OUT with the records of ``drop`` (question, repetition) taken away: a done-prefix."""
+    out = _plain_out(world, name, incomplete=())
+    for f in list((out / "records").glob("*.json")):
+        r = json.loads(f.read_text())
+        if (r["question_id"], r["repetition"]) in set(drop):
+            f.unlink()
+    _recheck_here(out)
+    return out
+
+
+def _key_file(world, keys=KEY_COVERED, name="keys.json", **change) -> tuple[Path, str]:
+    """A sib-prefix-keys/1 file for ``keys`` (what prefix_keys.py writes) and the sha256 of its bytes."""
+    doc = {"schema": ex.KEY_SUBSET_SCHEMA, "rule": SUBSET_RULE, "pin_sha256": "1" * 64, "order_sha256": "2" * 64,
+           "keys": [[PLAIN_NAME, "none", q, r] for q, r in keys], **change}
+    path = world["tmp"] / name
+    path.write_text(json.dumps(doc), encoding="utf-8")
+    return path, hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _key_call(world, out, keys=KEY_COVERED, *, path=None, sha=None, **kw):
+    if path is None:
+        path, sha = _key_file(world, keys)
+    return dataclasses.replace(_plain_call(world, out), key_subset=path, key_subset_sha256=sha, **kw)
+
+
+def _key_run(world, out, keys=KEY_COVERED, **kw):
+    return ex.run(F, _key_call(world, out, keys, **kw), **_plain_args())
+
+
+def test_the_key_subset_uses_every_attempt_of_the_prefix_and_the_mean_of_the_per_question_means(world):
+    out = _prefix_out(world)
+    result = _key_run(world, out)
+    arm = result["arms"][PLAIN_ARM]
+    counts = arm["counts"]
+    assert (counts["N_att"], counts["missing"], counts["capped"], counts["n_questions"]) == (3, 0, 0, 2)
+    assert arm["metrics"]["accuracy"]["estimate"] == 0.5  # (1 + 0) / 2, not the pooled 1/3: unequal repetitions are weighed per question
+    assert result["exploratory"]["clusters"] == {"questions": 2, "clusters": 2, "sizes": {"1": 2}, "largest": 1}
+    loaded, _, _ = ex.prepare(F, _key_call(world, out), **_plain_args())
+    assert sorted(loaded.design) == ["t01-q1", "t01-q2"] and sorted(loaded.index.questions) == ["t01-q1", "t01-q2"]
+    assert sorted((a.question_id, a.repetition) for a in loaded.attempts) == [("t01-q1", 0), ("t01-q2", 0), ("t01-q2", 1)]
+    assert not [a for a in loaded.attempts if a.run_id.startswith("missing:")]  # a missing row for no key that is not listed
+    # the interval is over the two questions, whose per-question means are 1 and 0: a draw of two questions with replacement gives the
+    # mean 0, 1/2 or 1 (probabilities 1/4, 1/2, 1/4), so the percentile interval is [0, 1] with no undefined draw (by hand)
+    assert arm["metrics"]["accuracy"]["ci"] == [0.0, 1.0] and arm["metrics"]["accuracy"]["undefined_share"] == 0.0
+
