+@pytest.mark.parametrize("over,message", [
+    ({"identical_to_reference": False}, "not identical to the reference"),
+    ({"identical_to_reference": 1}, "not identical to the reference"),
+    ({"differ": ["num-triples-normal"]}, "not identical to the reference"),
+    ({"endpoint": "http://10.9.9.9:7090/"}, "another endpoint or replica"),
+    ({"replica": "copy-9"}, "another endpoint or replica"),
+    ({"index_identity": "s01@" + "ee" * 32}, "does not name the reference index"),
+    ({"checked_utc": None}, "no check time"),
+    ({"surprise": 1}, "does not have the keys of its schema"),
+    ({"schema": "sib-unit-store-check/2"}, "its storecheck is not a entry180-store-check/2 file"),
