+# --- a GRID-layout batch: one initial cell and no branch cell is a batch of the union; any other grid is refused ----------------------
+# The scored world above is a plain layout. The same world is rewritten here into the grid layout (manifest schema, fingerprint of
+# shared, routes and phases) with the records unchanged: they already name their cell (load.arm "none") and their prompt, which the
+# manifest's one initial cell pins field by field. The expected values are the plain world's, derived by hand in the tests above.
+
+GRID_SCHEMA = "pilot-grid-manifest/1"  # the grid launcher's OUT manifest schema (harness/checkloop/grid.py GRID_MANIFEST)
+GRID_PINS = {"condition": "none", "prompt_id": "none-v1",  # the prompt the toy records carry (gate.PROMPT_PINS fields, toy values)
+             "template_sha256": "be9c9657dd5a68fd8daa10b3860ae3cdccd7b8734594589a246752148099637e",
+             "nudge_sha256": "839b4fb58e351e01101447e259f5a219d257da1b52d34114ec4a90b9a4d97658",
+             "ontology_block_sha256": None}
+ONE_CELL = {"natural": {"arms": {"none": GRID_PINS}}}
+TWO_CELLS = {"natural": {"arms": {"none": GRID_PINS}},
+             "prompted": {"arms": {"other": {**GRID_PINS, "condition": "other", "prompt_id": "other-v1"}}}}
+BRANCH_CELL = {"natural": {"arms": {"none": GRID_PINS}}, "branch": {"arms": {"check": {"parent": "none"}}}}
+
+
+def _to_grid(w, phases=ONE_CELL, **own_phases):
+    """Rewrite the manifests of the source and the three partitions into the grid layout, every OUT with ``phases`` (one OUT with
+    its own, by ``source``, ``part0``, ``part1`` or ``part2``). The partitions cite the source's manifest sha256, so the source goes
+    first and each partition's citation is rewritten; the replay checks are made again over the changed files."""
+    outs = {"source": w.source, "part0": w.parts[0], "part1": w.parts[1], "part2": w.parts[2]}
+
+    def regrid(name, source_sha=None):
+        out = outs[name]
+        manifest = json.loads((out / "manifest.json").read_text())
+        shared = manifest["fingerprint"]["shared"] if manifest["schema"] == GRID_SCHEMA else manifest["fingerprint"]
+        manifest["schema"] = GRID_SCHEMA
+        manifest["fingerprint"] = {"shared": shared, "routes": {},
+                                   "phases": json.loads(json.dumps(own_phases.get(name, phases)))}
+        if source_sha is not None:
+            manifest["partition"]["source_manifest_sha256"] = source_sha
+        put(out / "manifest.json", manifest)
+
+    regrid("source")
+    source_sha = ex.sha256_file(w.source / "manifest.json")
+    for name in ("part0", "part1", "part2"):
+        regrid(name, source_sha)
+    for out in outs.values():
+        w.recheck(out)
+
+
+def _grid_union(tmp_path, phases=ONE_CELL, **own_phases):
+    """The scored world in the grid layout, and the union's calls on it: ``call(view, completed, population)``."""
+    import numpy as np
+
+    w = _scored_union_world(tmp_path)
+    _to_grid(w, phases, **own_phases)
+    F = ex.load_frozen(HERE.parents[2])
+    cm = F.prereg.ClusterMap.singletons(w.ids)
+    map_record = {"graph": ex.SIB, "store": "rhea-test", "questions_sha256": w.qsha}
+
+    def go(view, completed, units=3, population=None):
+        exclude, exclude_sha, fact, fact_sha = w.fold(completed)
+        call = ex.Call(tuple(w.parts), (w.questions,), ex.SIB, "test", (w.voided,),
+            partition_record=w.record, partition_record_sha256=w.record_sha,
+            n_reps=2, ledgers=tuple(w.ledgers[p] for p in w.parts), source_ledger=w.ledgers[w.source],
+            fold=exclude, fold_sha256=exclude_sha, fold_fact=fact, fold_fact_sha256=fact_sha, fold_view=view,
+            source_batch=w.source, source_order=w.order, source_order_sha256=ex.sha256_file(w.order),
+            source_manifest=w.source / "manifest.json", sib_analysis_questions=w.analysis, sib_analysis_pin=w.pin,
+            population_out=population)
+        return ex.run_with_population(F, call, K_clusters=np.ones((2, units)), cluster_map=cm, map_record=map_record,
+                                      cfg=SimpleNamespace())
+
+    return w, go
+
+
+def test_a_grid_world_with_one_initial_cell_has_the_plain_worlds_views_and_populations(tmp_path):
+    """The plain world's hand derivations (test_real_sib_union_forms_and_refusing_twins and the population test above), on the same
+    records under the grid layout. Estimates (accuracy, output rate): FORM A primary (1/3, 5/6), companion (1/4, 1/2); FORM B
+    primary (1/6, 2/3), companion (1/2, 1). Populations ('o' the original's run id, 'r' the re-run's): FORM A primary r(0,0) r(0,1)
+    r(1,0) o(1,1) o(2,0), companion o(0,0) o(0,1); FORM B primary o(0,0) o(0,1) o(1,1) o(2,0), companion r(0,0) r(1,0)."""
+    w, go = _grid_union(tmp_path)
+    pop = _pop_dir(tmp_path)
+    all_done, some_done = [(0, 0), (0, 1), (1, 0)], [(0, 0), (1, 0)]
+    cases = (
+        ("A", "primary", all_done, 3, (1 / 3, 5 / 6),
+         _pop_ids([("rerun", 0, 0), ("rerun", 0, 1), ("rerun", 1, 0), ("original", 1, 1), ("original", 2, 0)])),
+        ("A", "companion", all_done, 2, (1 / 4, 1 / 2), _pop_ids([("original", 0, 0), ("original", 0, 1)])),
+        ("B", "primary", some_done, 3, (1 / 6, 2 / 3),
+         _pop_ids([("original", 0, 0), ("original", 0, 1), ("original", 1, 1), ("original", 2, 0)])),
+        ("B", "companion", some_done, 2, (1 / 2, 1.0), _pop_ids([("rerun", 0, 0), ("rerun", 1, 0)])))
+    for form, view, completed, units, expected, run_ids in cases:
+        result, doc = go(view, completed, units, pop / f"{form}-{view}.json")
+        row = result["arms"]["rhea-test|oracle-model|none|prompt|-"]
+        assert result["exploratory"]["fold"]["form"] == form and result["exploratory"]["fold"]["view"] == view
+        assert (row["metrics"]["accuracy"]["estimate"], row["metrics"]["output_rate"]["estimate"]) == pytest.approx(expected)
+        assert doc["run_ids"] == run_ids
+        assert result["real_output_ledger"]["rows"]
+    # the explicit empty companion (FORM B, no re-run in the fact) is the same on the grid layout
+    empty, doc = go("companion", [])
+    assert doc is None and empty["exploratory"]["fold"]["status"] == "no companion" and "arms" not in empty
+
