+def test_the_ratio_metrics_are_pooled_counts_a_three_attempt_question_weighs_three_times_a_one_attempt_one(world):
+    """The replay arm. Per question (q1, q2): outputs (3, 1); F (flags: a2, a3) = (2, 0); W (wrong outputs: a2; b1) = (1, 1); W_F = (1, 0);
+    C (right outputs with a status: a1, a3) = (2, 0); C_F = (1, 0); P (passes: a1) = (1, 0); W_P = 0; PU (P or U: a1; b1) = (1, 1);
+    W_PU = (0, 1); U = (0, 1); substantive outputs (a1, a2, a3) = (3, 0); P_sub = (1, 0); number-traceability flags 0; delta 0.
+    Ratio metrics are sum num / sum den over the questions:
+      flag_rate F/out = 2/4; flag_precision W_F/F = 1/2; false_flag_rate C_F/C = 1/2; recall W_F/W = 1/2; error_certified W_P/P = 0/1;
+      error_not_intervened W_PU/PU = 1/2; unknown_rate U/out = 1/4; substantive_coverage 3/4; substantive_pass_share P_sub/P = 1/1;
+      number_traceability_flag_rate 0/4; repair_yield delta/out = 0/4; fix_rate and corruption_rate: no retried output, 0/0 = not estimable.
+    The per-question means of flag_rate would be (2/3 + 0)/2 = 1/3, not 1/2: the three-attempt question weighs three times the other."""
+    attempts, ledger, index, arms = world
+    key = key_of(arms, "replay")
+    m = P._arm_result(key, arms[key], index, K, LEVEL, {}, True)["metrics"]
+    expected = {"flag_rate": 0.5, "flag_precision": 0.5, "false_flag_rate": 0.5, "recall": 0.5, "error_certified": 0.0,
+                "error_not_intervened": 0.5, "unknown_rate": 0.25, "substantive_coverage": 0.75, "substantive_pass_share": 1.0,
+                "number_traceability_flag_rate": 0.0, "repair_yield": 0.0}
+    for name, value in expected.items():
+        assert m[name]["estimate"] == pytest.approx(value), name
+    assert m["fix_rate"]["estimate"] is None and m["corruption_rate"]["estimate"] is None
+    assert m["flag_rate"]["estimate"] != pytest.approx(1 / 3)  # not the mean of the per-question means
+    # the PROPORTION metrics of the same arm are the per-question means again: accuracy_final = accuracy (no retry), net_change = 0
+    assert m["accuracy_final"]["estimate"] == pytest.approx(1 / 3) and m["net_change"]["estimate"] == 0.0
