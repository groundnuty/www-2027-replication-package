+def test_a_between_arm_difference_uses_each_arms_present_question_means():
+    # Both arms have q1, but A has two attempts (one right, one wrong) and B has one wrong attempt.
+    # Only A has q2 (one right attempt). Thus A = ((1/2) + 1)/2 = 3/4 and B = 0/1 = 0;
+    # their descriptive difference A - B is 3/4. Pooling A's attempts would give 2/3.
+    a = [attempt("a1", "q1", 0, True), attempt("a2", "q1", 1, False), attempt("a3", "q2", 0, True)]
+    b = [attempt("b1", "q1", 0, False, model="m2")]
+    arms = M.build_arms([*a, *b], [])
+    index = F.prereg.index_from_questions(QUESTIONS, "dev")
+    estimates = {key.model: P._arm_result(key, units, index, K, LEVEL, {}, True)["metrics"]["accuracy"]["estimate"]
+                 for key, units in arms.items()}
+    assert estimates == {"m": 0.75, "m2": 0.0}
+    assert estimates["m"] - estimates["m2"] == 0.75
+
