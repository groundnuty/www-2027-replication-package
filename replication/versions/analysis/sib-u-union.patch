+def _scored_union_world(tmp_path, analysis_ids=None):
+    """Build a plain scored batch per partition from local toy records, with real replay gates and ledgers. ``analysis_ids``
+    (default: every question) is the analysis set: the scored batches hold the analysis questions' records only (as the
+    reviewed score job leaves them), while the partitions' manifests, the exclude file and the fact still cover every fold key."""
+    from harness.checkloop.ledger import FIELDS, write_ledger
+
+    root = HERE.parents[2]
+    fixture = root / "tests" / "fixtures" / "analysis" / "plain-run" / "batch"
+    ids = toy_ids()
+    templates = {}
+    for path in (fixture / "records").glob("*.json"):
+        row = json.loads(path.read_text())
+        if row["repetition"] == 0:
+            templates[row["question_id"]] = row
+    shapes = {"R": templates["t01-q1"], "W": templates["t01-q2"], "C": templates["t02-q3"]}
+    questions = tmp_path / "questions.jsonl"
+    qrows = []
+    for i, qid in enumerate(ids):
+        qrows.append({"id": qid, "base_question_id": qid, "template": f"toy-{i}",
+                      "split": "test", "question": f"toy {i}", "answer_columns": ["r"],
+                      "gold_rows": [], "scoring_rules": {}})
+    questions.write_text("".join(json.dumps(q) + "\n" for q in qrows))
+    qsha = ex.sha256_file(questions)
+    voided = tmp_path / "voided.jsonl"
+    voided.write_text("".join(json.dumps({"out": name}) + "\n" for name in ex.KNOWN_VOIDED))
+    analysis_path = tmp_path / "analysis.jsonl"
+    analysis_path.write_text("".join(json.dumps({"id": q["id"], "base_question_id": q["id"],
+        "template": q["template"], "split": "test", "sib_stratum": "toy",
+        "gold_row_count": 1, "gold_type": "SELECT"}) + "\n" for q in qrows
+        if analysis_ids is None or q["id"] in analysis_ids))
+    salt = bytes(range(32))
+    put(tmp_path / "analysis.pin.json", {"schema": ex.SIB_PIN_SCHEMA,
+        "questions_analysis_sha256": ex.sha256_file(analysis_path), "salt_hex": salt.hex(),
+        "public_salted_sha256": hashlib.sha256(salt + analysis_path.read_bytes()).hexdigest()})
+
+    source = tmp_path / "source"
+    parts = [tmp_path / f"part-{i}" for i in range(3)]
+    for out in [source, *parts]:
+        shutil.copytree(fixture, out, ignore=shutil.ignore_patterns("claims", "records", "runs.jsonl"))
+        (out / "records").mkdir()
+        (out / "records").chmod(0o700)
+        manifest = json.loads((out / "manifest.json").read_text())
+        manifest["fingerprint"]["questions_sha256"] = qsha
+        put(out / "manifest.json", manifest)
+        put(out / "served-models.json", {"schema": "served-models/1", "models": {
+            "fake": {"at": "time", "question_id": ids[0], "repetition": 0,
+                     "route_model": "oracle-model", "served_model": "oracle-model"}}})
+        out.chmod(0o700)
+    source_manifest_sha = ex.sha256_file(source / "manifest.json")
+    order = [["fake", "none", qid, rep] for qid in ids for rep in (0, 1)]
+    put(source / "order.json", {"order": order})
+    put(source / "order-natural.json", {"order": order})
+    order_sha = ex.sha256_file(source / "order.json")
+    map_record = real_record(ids, reps=2, order_sha=order_sha, model="fake", arm="none", route="oracle-model")
+    record_path = tmp_path / "partition.json"
+    put(record_path, map_record)
+    record_sha = ex.sha256_file(record_path)
+    record, _ = ex.read_record(record_path, record_sha)
+
+    put(source / "deployment-identity.json", {"out": "/host/source",
+        "stacks_by_route_model": {"oracle-model": "stack"},
+        "store": {"endpoint": "http://sparql.invalid/"}})
+    digests = {key: claim("none", ids[key[0]], "oracle-model", key[1]) for key in ORIGINALS}
+    names = {key: (rec_name(digests[key], "original"), rec_name(digests[key], "rerun")) for key in ORIGINALS}
+    shares = {i: sorted(digests[key] for key in RERUNS if key[0] == i) for i in range(3)}
+    exclude = tmp_path / "exclude.txt"
+    exclude.write_text("".join(d + "\n" for d in sorted(digests[key] for key in RERUNS)))
+    exclude.chmod(0o600)
+    exclude_sha = ex.sha256_file(exclude)
+
+    def row_of(key, shape, tag):
+        i, rep = key
+        row = json.loads(json.dumps(shapes[shape]))
+        row.update(question_id=ids[i], base_question_id=ids[i], template=f"toy-{i}", split="test",
+                   repetition=rep, run_id=str(uuid.uuid5(uuid.NAMESPACE_DNS, f"{ids[i]}/{rep}/{tag}")))
+        return row
+
+    for key, shape in ORIGINALS.items():
+        if analysis_ids is not None and ids[key[0]] not in analysis_ids:
+            continue  # the scored batches hold the analysis questions' records only
+        original = row_of(key, shape, "original")
+        put(source / "records" / names[key][0], original)
+        if key in RERUNS:  # folded: the partition holds a re-run under a new name, never the original
+            put(parts[key[0]] / "records" / names[key][1], row_of(key, RERUNS[key], "rerun"))
+        else:  # not folded: the very same record (one run id) is copied into its partition
+            put(parts[key[0]] / "records" / names[key][0], original)
+
+    for i, out in enumerate(parts):
+        put(out / "deployment-identity.json", sib_identity(out, i, record, record_sha))
+        manifest = json.loads((out / "manifest.json").read_text())
+        manifest["partition"] = sib_block(i, record, record_sha, source_manifest_sha, shares[i], exclude_sha,
+                                          len(RERUNS), pending=len(shares[i]))
+        put(out / "manifest.json", manifest)
+
+    frozen = ex.load_frozen(root)
+
+    def recheck(out):
+        """The replay check of an OUT after its record files changed (the gate itself stays real)."""
+        replay = json.loads((out / "replay-check.json").read_text())
+        inputs = frozen.gate.batch_inputs(out)
+        checked = [p for p in inputs if frozen.gate.input_kind(p) == "replay"]
+        replay.update(n_records=len(checked), n_ok=len(checked), failures=[],
+                      records_sha256=frozen.gate.inputs_sha256(out),
+                      hashed_only=[p for p in inputs if frozen.gate.input_kind(p) == "hashed"])
+        put(out / "replay-check.json", replay)
+
+    def ledger(out):
+        rows = []
+        for path in (out / "records").glob("*.json"):
+            rec = json.loads(path.read_text())
+            if rec["outcome"]["status"] != "submitted" or rec["score"]["outcome"] != "scored":
+                continue
+            # The row is checked against its scored attempt by the real loader and arm builder.
+            row = {key: value for key, value in FIELDS.items()}
+            row.update(split="test", run_id=rec["run_id"], graph="rhea-test",
+                       model="oracle-model", cohort="none", source="curated", use="replay",
+                       question_id=rec["question_id"], base_question_id=rec["base_question_id"],
+                       initial_correct=bool(rec["score"]["exact"]), status="P",
+                       substantive=True, questions_sha256=qsha)
+            rows.append(row)
+        write_ledger(out / "ledger.jsonl", rows, split="test")
+        (out / "ledger.jsonl").chmod(0o600)
+        return out / "ledger.jsonl"
+
+    for out in [source, *parts]:
+        recheck(out)
+    ledgers = {out: ledger(out) for out in [source, *parts]}
+
+    def fold(completed):
+        """The fold's files: the exclude file, and the fact naming the keys of ``completed`` as having a new record name."""
+        shas = {i: ex.sha256_file(parts[i] / "manifest.json") for i in range(3)}
+        fact = fact_of(shas, shares, [digests[key] for key in completed], exclude_sha)
+        fact_path = tmp_path / "fact.json"
+        return exclude, exclude_sha, fact_path, write_fact(fact_path, fact)
+
+    return SimpleNamespace(ids=ids, parts=parts, source=source, names=names, questions=questions, digests=digests,
+        qsha=qsha, voided=voided, analysis=analysis_path, pin=tmp_path / "analysis.pin.json",
+        record=record_path, record_sha=record_sha, order=source / "order.json",
+        ledgers=ledgers, fold=fold, recheck=recheck, ledger=ledger)
+
