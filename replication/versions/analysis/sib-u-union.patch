+def test_the_chain_pin_and_order_to_complete_questions_to_the_e189_call_over_the_plain_run_fixture(world, tmp_path):
+    """The whole path on toys: a done-prefix pin and the OUT's order file -> complete_questions.py (given a NO-GOLD copy of the
+    question file) -> its output into the e189 call, accepted, with the 'not run' questions the pin's exception leaves out.
+    By hand: the order has 6 keys (2 repetitions of 3 questions); the key of t02-q3's second repetition (index 3) is an exception
+    of the prefix, so t02-q3 is incomplete, t01-q1 and t01-q2 are the complete questions, and t02-q3 is 'not run'."""
+    cq = importlib.util.module_from_spec(importlib.util.spec_from_file_location(
+        "complete_questions_chain", ROOT / "results" / "sib-checker-look-20261025" / "complete_questions.py"))
+    cq.__spec__.loader.exec_module(cq)
+    out = _plain_out(world)  # t02-q3's second record is gone: the exception of the prefix
+    keys = [("t01-q1", 0), ("t01-q2", 0), ("t02-q3", 0), ("t02-q3", 1), ("t01-q1", 1), ("t01-q2", 1)]
+    order_raw = json.dumps({"seed": 1, "rule": "toy", "order": [["fake", "none", q, r] for q, r in keys]}).encode()
+    (out / "order-natural.json").write_bytes(order_raw)  # the OUT's own order file, which the call binds the list to
+    digest = lambda i: hashlib.sha256(f"toy key {i}".encode()).hexdigest()[:40]  # noqa: E731
+    covered, exceptions = [0, 1, 2, 4, 5], {3: "set aside by the harness"}
+    k = "".join(f"K\t{i}\t{digest(i)}\n" for i in covered)
+    x = "".join(f"X\t{i}\t{digest(i)}\t{r}\n" for i, r in exceptions.items())
+    h = "H\tdrain\n"
+    pin = (f"PREFIX n_order=6 N=6 covered=5 exceptions=1 setasides=0 claims=5 records=5 keyset={cq.keyset_sha(digest(i) for i in covered)} "
+           f"list={cq.sha(k)} exc={cq.sha(x)} order={hashlib.sha256(order_raw).hexdigest()} holds=1 holdsha={cq.sha(h)}\n") + k + x + h
+    (world["tmp"] / "pin.txt").write_text(pin, encoding="utf-8")
+    # the no-gold copy of the question file: the fixture's lines without their gold, hashed as its manifest would pin it
+    no_gold = [{k_: v for k_, v in json.loads(line).items() if k_ != "gold_rows"}
+               for line in (PLAIN / "questions.jsonl").read_text().splitlines()]
+    assert all("gold_rows" not in r for r in no_gold) and any("gold_rows" in line for line in
+                                                               (PLAIN / "questions.jsonl").read_text().splitlines())
+    qfile = world["tmp"] / "no-gold-questions.jsonl"
+    qfile.write_text("".join(json.dumps(r) + "\n" for r in no_gold), encoding="utf-8")
+    subset = world["tmp"] / "chain-subset.json"
+    code = cq.main(["--pin", str(world["tmp"] / "pin.txt"), "--order", str(out / "order-natural.json"), "--out", str(subset),
+                    "--repetitions", "2", "--questions", str(qfile), "--questions-sha256", hashlib.sha256(qfile.read_bytes()).hexdigest()])
+    assert code == 0
+    doc = json.loads(subset.read_text())
+    assert doc["questions"] == ["t01-q1", "t01-q2"] and doc["repetitions"] == 2 and doc["order_sha256"] == hashlib.sha256(order_raw).hexdigest()
+    # its output into the call: accepted, the order file bound, the repetitions the call's, t02-q3 'not run'
+    call = _plain_call(world, out, subset_path=subset, sha=hashlib.sha256(subset.read_bytes()).hexdigest())
+    loaded, _, _ = ex.prepare(F, call, **_plain_args())
+    split_questions = {q for q, v in loaded.questions.items() if v.get("split") == "dev"}
+    assert sorted(loaded.design) == ["t01-q1", "t01-q2"] and split_questions - set(loaded.design) == {"t02-q3"}  # the 'not run' set
+    result = ex.run(F, call, **_plain_args())
+    counts = result["arms"][PLAIN_ARM]["counts"]
+    assert (counts["N_att"], counts["missing"], counts["capped"], counts["n_questions"]) == (4, 0, 0, 2)
+    assert result["arms"][PLAIN_ARM]["metrics"]["accuracy"]["estimate"] == 0.5
+    assert result["exploratory"]["question_subset"]["coverage"] == {"listed": 2, "in_the_design": 2, "questions_of_the_split": 3}
