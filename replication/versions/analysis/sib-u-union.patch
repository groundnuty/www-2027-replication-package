+def served_names(batch: Path) -> dict[str, str]:
+    """The OUT's route model -> the order's name for it, from its served-models.json (a names file: ``models`` maps a name to
+    ``route_model``); one name per route model, or the key list cannot be read against the records."""
+    try:
+        doc = json.loads((Path(batch) / "served-models.json").read_text(encoding="utf-8"))
+        models = doc["models"]
+        names = {name: v["route_model"] for name, v in models.items()}
+    except (OSError, ValueError, KeyError, TypeError, AttributeError):
+        raise Refused("--key-subset: the OUT's served-models.json cannot be read") from None
+    if not names or not all(isinstance(n, str) and isinstance(r, str) and r for n, r in names.items()):
+        raise Refused("--key-subset: the OUT's served-models.json names no route model, or a malformed one")
+    if len(set(names.values())) != len(names):
+        raise Refused("--key-subset: two model names of the OUT's served-models.json share a route model")
+    return {route: name for name, route in names.items()}
