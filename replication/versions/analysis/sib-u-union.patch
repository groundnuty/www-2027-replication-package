+def legacy_union(world, identity_check):
+    """An entry180-style union over the same three toy questions: its OUTs' identities name a partition block of that
+    schema and a store block whose identity check is ``identity_check``."""
+    ids = world.ids
+    k = 3
+    raw = {"schema": "entry180-partition/1", "salt": ex.SALT, "graph": ex.SIB, "split": "test", "k": k,
+           "questions": {"sha256": h("questions")}, "all_ids_sha256": lined(ids), "n_questions": len(ids),
+           "partitions": [{"index": p, "n_questions": 1, "ids_sha256": ID_DIGESTS[p][0], "copy": f"copy-{p}",
+                           "question_id_sha256": [h(ids[p])]} for p in range(k)]}
+    sha = h(json.dumps(raw))
+    outs = []
+    for p in range(k):
+        ident = {"out": f"/host/legacy-{p}", "stacks_by_route_model": {"route": "stack"},
+                 "partition": {"index": p, "k": k, "record_sha256": sha, "ids_sha256": ID_DIGESTS[p][0], "copy": f"copy-{p}"},
+                 "store": {"replica": f"copy-{p}", "endpoint": f"http://store-{p}/", "identity_check": identity_check}}
+        outs.append(ex.Out(Path(f"/stage/legacy-{p}"), ident, {}))
+    try:
+        ex.check_union(f_stub(), outs, raw, sha, ids, ex.SIB, "test", h("questions"), base_of={q: q for q in ids})
+    except ex.Refused as exc:
+        return {"refused": True, "message": str(exc)}
+    return {"refused": False, "message": ""}
