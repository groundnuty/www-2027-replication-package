+def replaced(o, ident=None, block=None):
+    """The OUT with its identity's partition block or manifest's partition block changed by the given functions."""
+    identity = json.loads(json.dumps(o.identity))
+    manifest = json.loads(json.dumps(o.manifest))
+    if ident:
+        ident(identity)
+    if block:
+        block(manifest["partition"])
+    return dataclasses.replace(o, identity=identity, manifest=manifest)
