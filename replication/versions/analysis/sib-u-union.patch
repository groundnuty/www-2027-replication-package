+def test_the_ratio_draws_are_sums_over_the_resampled_questions(world):
+    """flag_rate draws: num_q = F = (2, 0), den_q = out = (3, 1); K row (1, 1): 2/4; (1, 2): 2/5; (2, 1): 4/7. Sorted 2/5, 1/2, 4/7: the
+    interval [2/5, 4/7]. The per-question means would give (2/3)/2 = 1/3, (2/3)/3 = 2/9, (4/3)/3 = 4/9: not these."""
+    attempts, ledger, index, arms = world
+    key = key_of(arms, "replay")
+    m = P._arm_result(key, arms[key], index, K, LEVEL, {}, True)["metrics"]
+    assert m["flag_rate"]["ci"] == pytest.approx([2 / 5, 4 / 7])
+    # flag_precision: num_q = W_F = (1, 0), den_q = F = (2, 0): q2 is drawn out of both sums, every draw is 1/2, 2/... = K@(1,0) / K@(2,0)
+    assert m["flag_precision"]["ci"] == pytest.approx([0.5, 0.5])
