+def put(path: Path, doc: object) -> None:
+    path.write_text(json.dumps(doc) + "\n", encoding="utf-8")
+    path.chmod(0o600)
+
+
+def touch_private(path: Path) -> None:
+    path.touch()
+    path.chmod(0o600)
+
+
+def uid(*parts) -> str:
+    return str(uuid.uuid5(uuid.NAMESPACE_DNS, "/".join(map(str, parts))))
+
+
+def claim(arm: str, qid: str, route: str, rep: int) -> str:
+    return h(json.dumps([arm, qid, route, rep], ensure_ascii=False))[:40]
+
+
+def rec_name(digest: str, tag: str) -> str:
+    """A record name as the runner writes it: <claim digest>.<run id>.json."""
+    return f"{digest}.{uid(digest, tag)}.json"
+
+
+def joined(ids) -> str:
+    return h("\n".join(sorted(ids)))
+
+
+def lined(ids) -> str:
+    return h("".join(f"{q}\n" for q in sorted(ids)))
+
+
+def real_record(ids: list[str], *, k: int = K, reps: int, order_sha: str, model: str = "model", arm: str = "arm",
+                route: str = "route") -> dict:
+    """sib_partition.assign's record, made here with hashlib: the rule int(sha256('20261022|' + id), 16) mod k."""
+    mine = [[q for q in sorted(ids) if int(h("20261022|" + q), 16) % k == p] for p in range(k)]
+    units = [{"partition": p, "router_base_url": f"http://router-{p}/v1", "store_endpoint": f"http://store-{p}/",
+              "unit": f"COPY {10 + p}", "workers": 4} for p in range(k)]
+    parts = [{"index": p, "unit": units[p]["unit"], "n_questions": len(m), "n_keys": len(m) * reps,
+              "ids_sha256": lined(m), "ids_sha256_joined": joined(m),
+              "question_id_sha256": sorted(h(q) for q in m)} for p, m in enumerate(mine)]
+    return {"schema": ex.SIB_U_RECORD_SCHEMA, "rule": ex.SIB_U_RULE, "salt": "20261022|", "seed": 20261022, "k": k,
+            "units": units, "model": model, "arm": arm, "route_model": route, "reps": reps,
+            "n_base_questions": len(ids), "n_keys": len(ids) * reps, "all_ids_sha256": lined(ids),
+            "all_ids_sha256_joined": joined(ids), "base_spec_sha256": h("base"), "seed_file_sha256": h("seed"),
+            "plan_file_sha256": h("plan"), "order_file_sha256": order_sha,
+            "question_ids_in_base_spec": "null (the split's questions)", "partitions": parts}
+
+
+def store_block(out_name: str, p: int, record: dict) -> dict:
+    ep = record["units"][p]["store_endpoint"]
+    return {"out": f"/host/{out_name}", "replica": f"copy-{p}", "endpoint": ep, "store_json": f"/host/store-{p}.json",
+            "store_json_sha256": h(f"store-json-{p}"), "image_sha256": h("image"), "index_identity": "index",
+            "identity_check": f"store check sha256 {h(f'store-check-{p}')}: identical to the reference, endpoint {ep}",
+            "stats_read": "time"}
+
+
+def sib_identity(out: Path, p: int, record: dict, record_sha: str) -> dict:
+    """The partition OUT's deployment-identity.json (the tool's keys; the source's own keys are the ones a check reads)."""
+    rp = record["partitions"][p]
+    return {"at": "time", "derived_from": {"by": "sib_partition.py build", "path": "/host/source", "sha256": h("source")},
+            "freeze_commit": "c" * 40, "graph": ex.SIB, "out": f"/host/{out.name}", "ruling": "toy",
+            "sitea": {"router_base_url": record["units"][p]["router_base_url"], "workers": 4},
+            "schema": "deployment-identity/2", "sib": {}, "stack_assignment_sha256": h("stacks"),
+            "stacks": {record["model"]: "stack"}, "stacks_by_route_model": {record["route_model"]: "stack"},
+            "store": store_block(out.name, p, record),
+            "partition": {"ids_sha256": rp["ids_sha256"], "k": record["k"], "n_questions": rp["n_questions"],
+                          "partition": p, "record_sha256": record_sha, "schema": ex.SIB_U_IDENTITY_SCHEMA,
+                          "stack_assignment_sha256_is": "the source's value; not recomputed here",
+                          "store_check_sha256": h(f"store-check-{p}"), "tool_sha256": h("tool"), "unit": rp["unit"]}}
+
+
+def sib_block(p: int, record: dict, record_sha: str, source_manifest_sha: str, share, exclude_sha, in_file: int,
+              *, pending: int, build_complete: bool = True) -> dict:
+    """The manifest's 'partition' block (sib_partition.partition_block's 34 keys)."""
+    rp = record["partitions"][p]
+    return {"at": "time", "barrier": None, "base_spec_sha256": record["base_spec_sha256"],
+            "build_complete": build_complete, "by": "sib_partition.py build",
+            "code": {"clamp": None, "source_harness": {}, "starts_emptied": False},
+            "copy_list_lines": rp["n_keys"] - pending,
+            "exclude_file": {"digests_in_file": in_file, "digests_of_this_partition": len(share), "sha256": exclude_sha},
+            "excluded_digests": sorted(share), "ids_sha256": rp["ids_sha256"], "infrastructure_names_in_source": 0,
+            "k": record["k"],
+            "keys": {"copied": rp["n_keys"] - pending, "excluded_complete_in_source": len(share),
+                     "in_flight_in_source": 0, "not_started_in_source": 0, "partition": rp["n_keys"],
+                     "pending": pending},
+            "left_out": [], "n_questions": rp["n_questions"], "natural_pins": {}, "partition": p,
+            "plan_file_sha256": record["plan_file_sha256"], "record_sha256": record_sha, "rerun_excluded": bool(share),
+            "router_change": {"from": "http://old/v1", "to": record["units"][p]["router_base_url"]},
+            "rule": record["rule"], "schema": ex.SIB_U_MANIFEST_SCHEMA, "seed_file_sha256": record["seed_file_sha256"],
+            "served_models": {}, "source_grid_order_history": [], "source_manifest_sha256": source_manifest_sha,
+            "source_out": "/host/source", "spec": {"path_on_host": "/host/spec.json", "sha256": h("spec")},
+            "store_change_note": "toy", "store_changed_keys": ["endpoint"], "tool_sha256": h("tool"), "topups": [],
+            "unit": rp["unit"]}
+
+
+def fact_doc(fact: ex.SibFact) -> dict:
+    return {"schema": ex.SIB_U_FACT_SCHEMA, "at": fact.at, "exclude_sha256": fact.exclude_sha256, "k": fact.k,
+            "all_complete": fact.all_complete,
+            "partitions": [{"index": i, "manifest_sha256": p.manifest_sha256, "all_complete": p.all_complete,
+                            "new_record_digests": sorted(p.new_digests)} for i, p in sorted(fact.parts.items())]}
+
+
+def write_fact(path: Path, fact: ex.SibFact) -> str:
+    put(path, fact_doc(fact))
+    return ex.sha256_file(path)
+
+
+def fact_of(manifest_shas: dict, shares: dict, done, exclude_sha: str, *, at: str = FACT_AT) -> ex.SibFact:
+    """The fact for the digests ``done`` (those with a new record name at the instant)."""
+    parts = {}
+    for i in range(K):
+        new = frozenset(d for d in done if d in shares[i])
+        parts[i] = ex.FactPart(manifest_shas[i], new == frozenset(shares[i]), new)
+    return ex.SibFact(h("fact"), at, exclude_sha, K, all(p.all_complete for p in parts.values()), parts)
+
+
+def private_dir(path: Path) -> Path:
+    path.mkdir()
+    path.chmod(0o700)
+    (path / "records").mkdir()
+    (path / "records").chmod(0o700)
+    return path
+
+
+def build_world(tmp_path: Path, *, reps: int = 1, selected=((0, 0), (1, 0))) -> SimpleNamespace:
+    """Three questions (one per partition) x ``reps``, a fold of the keys ``selected`` (question index, repetition): every
+    original is in the source; a selected key's partition holds a re-run under a new name, any other key a copy of its
+    original."""
+    ids = toy_ids()
+    source = private_dir(tmp_path / "source")
+    put(source / "manifest.json", {"source": "toy"})
+    source_manifest_sha = ex.sha256_file(source / "manifest.json")
+    order = [["model", "arm", qid, rep] for qid in ids for rep in range(reps)]
+    put(source / "order.json", {"order": order})
+    put(source / "order-natural.json", {"order": order})
+    order_sha = ex.sha256_file(source / "order.json")
+    put(source / "served-models.json", {"models": {"model": {"route_model": "route"}}})
+    put(source / "deployment-identity.json", {"out": "/host/source"})
+    rec_path = tmp_path / "partition.json"
+    put(rec_path, real_record(ids, reps=reps, order_sha=order_sha))
+    rec_sha = ex.sha256_file(rec_path)
+    record, _ = ex.read_record(rec_path, rec_sha)
+    digests = {(i, r): claim("arm", ids[i], "route", r) for i in range(K) for r in range(reps)}
+    originals = {key: rec_name(d, "original") for key, d in digests.items()}
+    reruns = {key: rec_name(digests[key], "rerun") for key in selected}
+    fold_digests = sorted(digests[key] for key in selected)
+    exclude = tmp_path / "exclude.txt"
+    exclude.write_text("".join(d + "\n" for d in fold_digests))
+    exclude.chmod(0o600)
+    exclude_sha = ex.sha256_file(exclude)
+    shares = {i: sorted(digests[key] for key in selected if key[0] == i) for i in range(K)}
+    outs = []
+    for i in range(K):
+        out = private_dir(tmp_path / f"part-{i}")
+        manifest = {"partition": sib_block(i, record, rec_sha, source_manifest_sha, shares[i], exclude_sha,
+                                           len(fold_digests), pending=len(shares[i]))}
+        ident = sib_identity(out, i, record, rec_sha)
+        put(out / "manifest.json", manifest)
+        put(out / "deployment-identity.json", ident)
+        outs.append(ex.Out(out, ident, manifest))
+    for key in digests:
+        touch_private(source / "records" / originals[key])
+        touch_private(outs[key[0]].path / "records" / (reruns[key] if key in reruns else originals[key]))
+    w = SimpleNamespace(ids=ids, source=ex.Out.read(source), outs=outs, record=record, rec_sha=rec_sha, rec_path=rec_path,
+                        order=source / "order.json", manifest=source / "manifest.json", digests=digests,
+                        originals=originals, reruns=reruns, shares=shares, exclude=exclude, exclude_sha=exclude_sha,
+                        fold=ex.SibFold(exclude_sha, frozenset(fold_digests)), reps=reps, selected=tuple(selected))
+
+    def fact(done=None, **kw) -> ex.SibFact:
+        keys = selected if done is None else done
+        shas = {i: ex.sha256_file(outs[i].path / "manifest.json") for i in range(K)}
+        return fact_of(shas, shares, [digests[key] for key in keys], exclude_sha, **kw)
+
+    w.fact = fact
+    return w
