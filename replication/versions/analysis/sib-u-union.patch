+def test_the_population_of_each_view_is_the_run_ids_of_its_final_ledger_in_both_forms(tmp_path):
+    """Expected values by hand, from the world's records. Originals R (0,0), W (0,1), C (1,0), W (1,1), W (2,0), C (2,1): a capped
+    record has no ledger row. The fold: (0,0), (0,1), (1,0), whose re-runs are W, R, R (rows all). 'o' is the original's run id
+    (shared by the source's record and its copy in a partition), 'r' the re-run's.
+      FORM A (all three re-runs in the fact): primary = the partitions: r(0,0) r(0,1) r(1,0), and the copies o(1,1) o(2,0).
+                                              companion = the source's originals of the fold keys: o(0,0) o(0,1) (o(1,0) is capped).
+      FORM B (the fact names (0,0) and (1,0)): primary = the source's originals of the fold keys o(0,0) o(0,1), and the copies
+                                              o(1,1) o(2,0) from the partitions; companion = the re-runs the fact names r(0,0) r(1,0)."""
+    w, call, go = _pop_setup(tmp_path)
+    pop = _pop_dir(tmp_path)
+    all_done, some_done = [(0, 0), (0, 1), (1, 0)], [(0, 0), (1, 0)]
+    expected = {
+        ("A", "primary", "all"): _pop_ids([("rerun", 0, 0), ("rerun", 0, 1), ("rerun", 1, 0), ("original", 1, 1), ("original", 2, 0)]),
+        ("A", "companion", "all"): _pop_ids([("original", 0, 0), ("original", 0, 1)]),
+        ("B", "primary", "some"): _pop_ids([("original", 0, 0), ("original", 0, 1), ("original", 1, 1), ("original", 2, 0)]),
+        ("B", "companion", "some"): _pop_ids([("rerun", 0, 0), ("rerun", 1, 0)])}
+    units = {("A", "primary"): 3, ("A", "companion"): 2, ("B", "primary"): 3, ("B", "companion"): 2}
+    docs = {}
+    for (form, view, which), run_ids in expected.items():
+        target = pop / f"{form}-{view}.json"
+        result, doc = go(view, all_done if which == "all" else some_done, target, units[form, view])
+        _, _, fact, fact_sha = w.fold(all_done if which == "all" else some_done)
+        # the exact keys, in the schema's order, and each value
+        assert list(doc) == ["schema", "view", "form", "fold_fact_sha256", "fold_sha256", "run_ids", "run_ids_sha256"]
+        assert doc["schema"] == "sib-u-population/1" == ex.POPULATION_SCHEMA
+        assert (doc["view"], doc["form"]) == (view, form) == (result["exploratory"]["fold"]["view"], result["exploratory"]["fold"]["form"])
+        assert doc["fold_fact_sha256"] == fact_sha and doc["fold_sha256"] == ex.sha256_file(w.fold(all_done)[0])
+        assert doc["run_ids"] == run_ids and run_ids == sorted(set(run_ids))
+        assert doc["run_ids_sha256"] == hashlib.sha256(("\n".join(run_ids) + "\n").encode()).hexdigest()  # recomputed by the test
+        docs[form, view] = doc
+        ex.write_population(target, doc)  # the writer: a new file, mode 600, the same document back
+        assert json.loads(target.read_text(encoding="utf-8")) == doc and target.stat().st_mode & 0o777 == 0o600
+    # the two views of a form are disjoint here, and the forms differ exactly by the source's originals of the fold keys: FORM A's
+    # primary leaves out the source's originals of fold keys that have re-runs, FORM B's primary keeps them
+    assert not set(docs["A", "primary"]["run_ids"]) & set(docs["A", "companion"]["run_ids"])
+    originals_of_fold = set(_pop_ids([("original", 0, 0), ("original", 0, 1)]))
+    assert not originals_of_fold & set(docs["A", "primary"]["run_ids"]) and originals_of_fold <= set(docs["B", "primary"]["run_ids"])
+    assert docs["A", "primary"]["run_ids_sha256"] != docs["B", "primary"]["run_ids_sha256"]
+    # nothing was requested, nothing is made: a call without --population-out has no population, and `run` is unchanged
+    assert go("primary", all_done, None, 3)[1] is None
+    # the explicit empty companion has no ledger and no population
+    empty_target = pop / "empty-companion.json"
+    result, doc = go("companion", [], empty_target, 3)
+    assert doc is None and result["exploratory"]["fold"]["status"] == "no companion" and not empty_target.exists()
+
