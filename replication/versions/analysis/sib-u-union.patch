+def test_an_unjoined_fronted_turn_of_an_unlisted_record_still_refuses_but_is_not_counted(world, monkeypatch):
+    """Opus r2: the front-join refusal is a whole-OUT validity check over every record's own turns; the turn counts reported
+    are the kept records'."""
+    import types
+    out = _plain_out(world)
+    real_load = ex.load_attribution
+
+    class Proxy:
+        def __init__(self, bad):
+            self.real, self.bad = real_load(), bad
+
+        def __getattr__(self, name):
+            return getattr(self.real, name)
+
+        def attempt(self, rec, attributor):
+            a = self.real.attempt(rec, attributor)
+            if rec.question_id in self.bad:
+                return types.SimpleNamespace(own=[types.SimpleNamespace(how="unjoined", fingerprint_mismatch=0)],
+                                             served_by=a.served_by)
+            return a
+
+    for bad in ({"t02-q3"}, {"t01-q1"}):  # an unlisted question's record, and a listed one's
+        monkeypatch.setattr(ex, "load_attribution", lambda bad=bad: Proxy(bad))
+        with pytest.raises(ex.Refused, match=r"fronted turns that do not join to one backend"):
+            _plain_run(world, out, ["t01-q1", "t01-q2"])
+    monkeypatch.setattr(ex, "load_attribution", lambda: Proxy(set()))
+    assert _plain_run(world, out, ["t01-q1", "t01-q2"])["arms"]  # the twin: nothing unjoined
+
