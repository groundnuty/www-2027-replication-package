+# --- SIB's analysis question set (science, entry 168 and the ruling relayed 23 Oct ~18:15Z) --------------------------
+# Toy only: the fixture's questions stand for SIB's full set (its manifest names it), s01-flag for an excluded question.
+
+EXCLUDED = "s01-flag"
+SIB_MAP = {"rule": "singletons"}  # SIB's rule: each question of the index its own cluster, nothing read for it
+
+
+def _sib_world(world, drop=(EXCLUDED,), name="sib-out") -> Path:
+    """The fixture's OUT without the records of ``drop``'s questions, as the score step's batch/ holds only the accuracy
+    questions' records; its manifest still names the whole question file."""
+    batch = FIXTURE / "batch"
+    out = world["tmp"] / name
+    shutil.copytree(batch, out, ignore=shutil.ignore_patterns("claims", "records"))
+    (out / "records").mkdir()
+    for f in (batch / "records").glob("*.json"):
+        if json.loads(f.read_text(encoding="utf-8"))["question_id"] not in drop:
+            shutil.copy2(f, out / "records" / f.name)
+    _recheck(out)
+    _write_identity(out, _identity(out))
+    return out
+
+
+def _qa_rows() -> list[dict]:
+    """The score step's questions-analysis.jsonl fields, invented values: the three accuracy questions of the toy."""
+    return [{"id": q, "split": "dev", "graph": "s01", "base_question_id": q, "template": "t", "sib_stratum": "toy",
+             "gold_row_count": n, "gold_type": "SELECT"}
+            for q, n in (("s01-pass", 2), ("s01-abstain", 0), ("s01-noquery", 5))]
+
+
+SALT = bytes(range(32))  # toy only: a real salt is random and private
+
+
+def _write_pin(path: Path, qa: Path, *, mode=0o600, **change) -> Path:
+    """A private pin file for the analysis-set file ``qa`` (toy values), mode 600; ``change`` overrides fields."""
+    raw = qa.read_bytes()
+    pin = {"schema": ex.SIB_PIN_SCHEMA, "questions_analysis_sha256": hashlib.sha256(raw).hexdigest(),
+           "salt_hex": SALT.hex(), "public_salted_sha256": hashlib.sha256(SALT + raw).hexdigest(), **change}
+    path.write_text(json.dumps(pin), encoding="utf-8")
+    os.chmod(path, mode)
+    return path
+
+
+def _pin_of(qa: Path) -> Path:
+    return qa.with_suffix(".pin.json")
+
+
+def _qa(world, monkeypatch, rows=None, *, text=None, name="qa.jsonl") -> Path:
+    """An analysis-set file and its private pin file beside it (so the refusals under test are not the pin's)."""
+    path = world["tmp"] / name
+    path.write_text(text if text is not None else "".join(json.dumps(r) + "\n" for r in (rows or _qa_rows())),
+                    encoding="utf-8")
+    _write_pin(_pin_of(path), path)
+    return path
+
+
+def _sib_call(w, out, qa=None, *, graph=ex.SIB, split="dev", pin=..., **kw):
+    return ex.Call((out,), (w["questions"],), graph, split, (w["voided"],), None, (), 1, None,
+                   sib_analysis_questions=qa, sib_analysis_pin=(_pin_of(qa) if qa is not None else None) if pin is ... else pin,
+                   **kw)
+
+
+def _sib_args(**kw):
+    _, rec = _map()
+    return {"cluster_map": None, "map_record": {**rec, **SIB_MAP}, **kw}
+
+
+def _sib_refused(w, out, qa, match, **kw):
+    with pytest.raises(F.refusals, match=match):
