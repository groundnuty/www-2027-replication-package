+def test_the_population_follows_the_not_run_removal_of_a_re_run_after_the_cut(tmp_path):
+    """FORM B's companion: the record of (0,1)'s re-run exists in the partition but is after the fact's cut, so it is 'not run' and
+    its run id is not in the population (r(0,1) absent); the same files, the fact naming it, put it in (FORM A primary above)."""
