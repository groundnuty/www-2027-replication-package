+def test_retries_pin_nonzero_fix_corruption_and_final_accuracy_draws():
+    """q1 has three outputs: wrong fixed, right corrupted, wrong not fixed. q2 has two: wrong fixed, right kept.
+    Thus fixed=(1,1), wrong flagged and retried=(2,1), corrupted=(1,0), right flagged and retried=(1,1),
+    delta=(0,1), outputs=(3,2). The proportion vectors divide by attempts: delta=(0,1/2),
+    final_correct=(1/3,1). K rows are (1,1), (1,2), (2,1), all at question granularity."""
+    rows = [("a1", "q1", 0, False, True), ("a2", "q1", 1, True, False),
+            ("a3", "q1", 2, False, False), ("b1", "q2", 0, False, True),
+            ("b2", "q2", 1, True, True)]
+    attempts = [attempt(r, q, rep, correct) for r, q, rep, correct, _ in rows]
+    ledger = [dataclasses.replace(checked(r, q, correct, "F", True), use="checker", retried=True,
+                                  retry_status="submitted", retry_correct=after)
+              for r, q, _, correct, after in rows]
+    index = F.prereg.index_from_questions(QUESTIONS, "dev")
+    arms = M.build_arms(attempts, ledger)
+    key = key_of(arms, "checker")
+    m = P._arm_result(key, arms[key], index, K, LEVEL, {}, True)["metrics"]
+    expected = {
+        "fix_rate": (2 / 3, [3 / 5, 3 / 4]),  # K@(1,1) / K@(2,1)
+        "corruption_rate": (1 / 2, [1 / 3, 2 / 3]),  # K@(1,0) / K@(1,1)
+        "repair_yield": (1 / 5, [1 / 8, 2 / 7]),  # K@(0,1) / K@(3,2)
+        "net_change": (1 / 4, [1 / 6, 1 / 3]),  # K@(0,1/2) / K@(1,1)
+        "accuracy_final": (2 / 3, [5 / 9, 7 / 9]),  # K@(1/3,1) / K@(1,1)
+    }
+    for metric, (estimate, ci) in expected.items():
+        assert m[metric]["estimate"] == pytest.approx(estimate), metric
+        assert m[metric]["ci"] == pytest.approx(ci), metric
+
