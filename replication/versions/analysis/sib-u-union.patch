+# --- a question subset (science, 25 Oct 09:2xZ, SIB U): the complete questions of a drained prefix, the rest 'not run' --------
+# The repository's plain-run fixture (tests/fixtures/analysis/plain-run: a plain OUT of the kind SIB's are): 3 questions of the dev
+# split x 2 repetitions of one model, store rhea-test. By hand, from its records: t01-q1 right twice, t01-q2 wrong twice (both
+# submitted), t02-q3 capped twice (not an output, scored wrong). A drained PREFIX is made of it by taking records away: by default
+# t02-q3's second record (its repetition 1) is gone, so the complete questions, by presence of every record, are t01-q1 and
+# t01-q2. Then, by hand: all three questions, accuracy (1 + 0 + 0) / 3 = 1/3 over 6 attempts (one capped, one missing: t02-q3's
+# gap); the subset {t01-q1, t01-q2}: (1 + 0) / 2 = 1/2 over 4 attempts, no capped, no missing; and with t01-q2 incomplete too,
+# {t01-q1}: 1 over 2.
+
+PLAIN = ROOT / "tests" / "fixtures" / "analysis" / "plain-run"
+PLAIN_STORE = "rhea-test"
+PLAIN_MODEL = "oracle-model"
+PLAIN_ARM = f"{PLAIN_STORE}|{PLAIN_MODEL}|none|prompt|-"
+SUBSET_RULE = "a toy rule text"
+
+
+def _plain_out(world, name="plain-out", incomplete=("t02-q3",)) -> Path:
+    """The plain-run OUT as a drained prefix: the second record (repetition 1) of each question in ``incomplete`` is gone."""
+    out = world["tmp"] / name
+    shutil.copytree(PLAIN / "batch", out, ignore=shutil.ignore_patterns("claims"))
+    _write_identity(out, {"out": f"/host/{name}", "stacks_by_route_model": {PLAIN_MODEL: "stack-a"},
+                          "store": {"out": f"/host/{name}"}})
+    for f in list((out / "records").glob("*.json")):
+        r = json.loads(f.read_text())
+        if r["question_id"] in incomplete and r["repetition"] == 1:
+            f.unlink()
+    _recheck_here(out)
+    return out
+
+
+def _recheck_here(out: Path) -> None:
+    """The OUT's own replay-check/2 over its files as they now are (the fixture's template, its files changed here)."""
+    check = json.loads((out / "replay-check.json").read_text(encoding="utf-8"))
+    inputs = F.gate.batch_inputs(out)
+    replay = [r for r in inputs if F.gate.input_kind(r) == "replay"]
+    check.update(n_records=len(replay), n_ok=len(replay), failures=[], records_sha256=F.gate.inputs_sha256(out),
+                 hashed_only=[r for r in inputs if F.gate.input_kind(r) == "hashed"])
+    (out / "replay-check.json").write_text(json.dumps(check, indent=1) + "\n", encoding="utf-8")
+
+
+def _plain_questions(world, out: Path, edit, name="q-variant.jsonl") -> Path:
+    """The plain-run questions with ``edit(rows)`` applied, written beside the OUT, whose manifest now names that file."""
+    rows = edit([json.loads(line) for line in (PLAIN / "questions.jsonl").read_text().splitlines()])
+    path = world["tmp"] / name
+    path.write_text("".join(json.dumps(r) + "\n" for r in rows), encoding="utf-8")
+    manifest = json.loads((out / "manifest.json").read_text())
+    manifest["fingerprint"]["questions_sha256"] = hashlib.sha256(path.read_bytes()).hexdigest()
+    (out / "manifest.json").write_text(json.dumps(manifest, indent=1) + "\n", encoding="utf-8")
+    _recheck_here(out)
+    return path
+
+
+def _subset_file(world, ids, name="subset.json", **change) -> tuple[Path, str]:
+    """A sib-complete-questions/1 file for ``ids`` (what complete_questions.py writes) and the sha256 of its bytes."""
+    doc = {"schema": ex.SUBSET_SCHEMA, "rule": SUBSET_RULE, "pin_sha256": "1" * 64, "order_sha256": "2" * 64,
+           "repetitions": 2, "questions": list(ids), **change}
+    path = world["tmp"] / name
+    path.write_text(json.dumps(doc), encoding="utf-8")
+    return path, hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _plain_call(world, out, ids=None, *, graph=ex.SIB, sha=None, subset_path=None, questions=None, **kw):
+    path, digest = (subset_path, sha) if subset_path is not None else (_subset_file(world, ids) if ids is not None
+                                                                       else (None, None))
+    return ex.Call((out,), (questions or PLAIN / "questions.jsonl",), graph, "dev", (world["voided"],), None, (), 2, None,
+                   question_subset=path, question_subset_sha256=sha if sha is not None else digest, **kw)
+
+
+def _plain_args(questions=None):
+    qsha = hashlib.sha256((questions or PLAIN / "questions.jsonl").read_bytes()).hexdigest()
+    return {"cluster_map": None, "map_record": {"graph": ex.SIB, "store": PLAIN_STORE, "path": "test", "sha256": "test",
+                                                  "questions_sha256": qsha, **SIB_MAP}}
+
+
+def _plain_run(world, out, ids=None, **kw):
+    return ex.run(F, _plain_call(world, out, ids, **kw), **_plain_args(kw.get("questions")))
+
