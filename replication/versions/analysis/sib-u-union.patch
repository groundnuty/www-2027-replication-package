+    for outs in (("partition", "source"), ("partition",)):  # the source OUT among the call's OUTs, or only its path given
+        assert _outcome(old, lambda mod: w.call(mod, w.files, outs=outs))[0] == "refused", outs
+        assert _outcome(ex, lambda mod: w.call(mod, w.files, outs=outs))[0] == "accepted", outs
