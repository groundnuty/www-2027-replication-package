+            "neither": dict(binding=False, is_source=False), "the source alone": dict(outs=("source",), binding=False),
+            "the partition alone, bound, no source": dict(outs=("partition",), is_source=False)}
+    for name, kw in same.items():
+        assert _outcome(old, lambda mod, kw=kw: w.call(mod, w.files, **kw)) == _outcome(ex, lambda mod, kw=kw: w.call(mod, w.files, **kw)), name
