+def mutate(doc, path, value):
+    """doc with the item at ``path`` (keys and indexes) replaced; a value of KeyError removes the key."""
+    doc = json.loads(json.dumps(doc))
+    node = doc
+    for step in path[:-1]:
+        node = node[step]
+    if value is KeyError:
+        del node[path[-1]]
+    else:
+        node[path[-1]] = value
+    return doc
