+    b = bind(world, "B", ids=analysis, fact=none_done)
+    assert (b.analysis_complete, b.outside_analysis) == (False, 1)
+    assert b.allowed[world.source.path] == {(ids[0], 0)} and not b.allowed[world.outs[1].path]
+    # the whole analysis set: the fact's all_complete and the union's test agree, nothing is dropped
+    full = bind(world, "A")
+    assert (full.analysis_complete, full.outside_analysis) == (True, 0) and full.fact.all_complete is True
