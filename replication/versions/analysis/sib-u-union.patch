+def test_the_rhea_pin_is_checked_like_the_other_form(world, monkeypatch):
+    out = _sib_world(world)
+    qa = _qa(world, monkeypatch)
+
+    def refused_with(pin, match):
+        with pytest.raises(ex.Refused, match=match) as exc:
