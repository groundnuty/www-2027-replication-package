+def bind(w, form=None, view="primary", fact=None, **kw):
+    """bind_fold, which DERIVES the form from the fact and the analysis set (it is never an input of it). ``form`` is only what
+    the test expects it to derive, asserted here."""
+    args = dict(fold=w.fold, fact=fact or w.fact(), outs=w.outs, source=w.source, record=w.record, order=w.order,
