+def write_private_key_result(out: Path, body: str, *, strict_ancestors: bool = False) -> None:
+    """Write a restricted SIB disclosure into a fresh private directory outside a Git worktree."""
+    if strict_ancestors and (not out.is_absolute() or "superseded" in out.parts):
+        raise Refused("SIB fold: --out must be absolute and outside superseded")
+    if ".." in out.parts:
+        raise Refused("--key-subset: --out path must not contain parent traversal")
+    target = Path(os.path.abspath(out))  # absolute without resolving a symlink
+    if target.exists() or target.is_symlink():
+        raise Refused("--key-subset: --out must be a new private directory")
+    private_boundary = False
+    for parent in (target.parent, *target.parent.parents):
+        try:
+            mode = parent.lstat().st_mode
+        except OSError:
+            raise Refused("--key-subset: --out needs an existing directory path without links") from None
+        if not stat.S_ISDIR(mode):
+            raise Refused("--key-subset: --out path contains a link or is not a directory")
+        if strict_ancestors and not private_boundary and stat.S_IMODE(mode) & 0o022:
+            raise Refused("SIB fold: --out ancestor is writable by another user")
+        if strict_ancestors and parent == target.parent and parent.stat().st_uid != os.getuid():
+            raise Refused("SIB fold: --out parent must belong to this user")
+        if strict_ancestors and parent.stat().st_uid == os.getuid() and stat.S_IMODE(mode) & 0o077 == 0:
+            private_boundary = True
+        git_marker = parent / ".git"
+        if git_marker.is_file() or (git_marker.is_dir() and (git_marker / "config").is_file()):
+            raise Refused("--key-subset: --out must be outside a Git worktree")
+    try:
+        target.mkdir(mode=0o700)
+        directory = target.stat()
+        if directory.st_uid != os.getuid() or stat.S_IMODE(directory.st_mode) != 0o700:
+            raise Refused("--key-subset: --out must be owned by this user with mode 700")
+        fd = os.open(target / "results.json", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+        with os.fdopen(fd, "w", encoding="utf-8") as handle:
+            handle.write(body)
+        if stat.S_IMODE((target / "results.json").stat().st_mode) != 0o600:
+            raise Refused("--key-subset: results.json must have mode 600")
+    except OSError:
