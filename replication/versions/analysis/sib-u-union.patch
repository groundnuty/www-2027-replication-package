+def test_fold_is_the_pinned_exclude_file_alone(world, tmp_path):
+    ds = sorted(world.fold.digests)
+    path = tmp_path / "fold.txt"
+
+    def write(text, mode=0o600):
+        path.write_text(text)
+        os.chmod(path, mode)
+        return ex.sha256_file(path)
+
+    sha = write("".join(d + "\n" for d in ds))
+    assert ex.SibFold.read(path, sha) == ex.SibFold(sha, frozenset(ds))
+    sha = write("\n".join(ds))  # no final newline: at most one is allowed, none is fine
+    assert ex.SibFold.read(path, sha).digests == frozenset(ds)
+    for text in ("", "\n", "\n".join(ds) + "\n\n", "\n".join(reversed(ds)) + "\n", ds[0] + "\n" + ds[0] + "\n",
+                 ds[0].upper() + "\n", ds[0][:-1] + "\n", ds[0] + "\r\n", "x" * 40 + "\n", ds[0] + " \n"):
+        sha = write(text)
+        with pytest.raises(ex.Refused, match="malformed exclude-digest file"):
+            ex.SibFold.read(path, sha)
+    sha = write("".join(d + "\n" for d in ds), 0o644)
+    with pytest.raises(ex.Refused, match="mode 600 required|not this user's file with mode 600"):
+        ex.SibFold.read(path, sha)
+    sha = write("".join(d + "\n" for d in ds))
+    with pytest.raises(ex.Refused, match="sha256 differs"):
+        ex.SibFold.read(path, h("wrong"))
+    with pytest.raises(ex.Refused, match="must be a sha256"):
+        ex.SibFold.read(path, "abc")
+    with pytest.raises(ex.Refused, match="normalized absolute path"):
+        ex.read_sib_private(str(path) + "/", "SIB fold", 1_000_000)
+    assert ex.SibFold.read(path, sha).digests == frozenset(ds)
+    old_mode = tmp_path.stat().st_mode & 0o777
+    tmp_path.chmod(old_mode | 0o020)
+    with pytest.raises(ex.Refused, match="parent must be this user's"):
+        ex.SibFold.read(path, sha)
+    tmp_path.chmod(old_mode)
+    assert ex.SibFold.read(path, sha).digests == frozenset(ds)
+
