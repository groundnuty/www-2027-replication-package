+def test_the_side_counts_and_the_attribution_are_those_of_the_listed_keys_and_the_checks_run_on_every_record(world, monkeypatch):
+    import types
+    out = _prefix_out(world, drop=(("t02-q3", 0), ("t02-q3", 1)))
+    template = json.loads(next((out / "records").glob("*.json")).read_text())
+    for sub, qid, rep, run in (("infrastructure", "t01-q1", 0, "infra-listed"), ("infrastructure", "t01-q1", 1, "infra-unlisted"),
+                               ("harness", "t01-q2", 0, "harness-listed"), ("harness", "t01-q1", 1, "harness-unlisted")):
+        (out / sub).mkdir(exist_ok=True)
+        (out / sub / f"{run}.json").write_text(json.dumps({**template, "run_id": run, "question_id": qid, "base_question_id": qid,
+                                                           "repetition": rep}), encoding="utf-8")
+    _recheck_here(out)
+    counts = _key_run(world, out)["arms"][PLAIN_ARM]["counts"]
+    assert (counts["infra_tries"], counts["failed_harness"]) == (1, 1)  # by hand: the listed key's two, not the unlisted key's two
+    whole = _key_run(world, out, [*KEY_COVERED, ("t01-q1", 1)])["arms"][PLAIN_ARM]["counts"]
+    assert (whole["infra_tries"], whole["failed_harness"]) == (2, 2)
+    # the attribution's turns are the listed keys' records'; an unjoined fronted turn of an UNLISTED key's record still refuses
+    result = _key_run(world, out)
+    recs = [json.loads(p.read_text()) for sub in ("records", "infrastructure", "harness") for p in (out / sub).glob("*.json")]
+    turns = sum(len([t for t in r["transcript"] if t.get("role") == "assistant"]) for r in recs
+                if (r["question_id"], r["repetition"]) in set(KEY_COVERED))  # (the set-aside tries' turns are counted too)
+    assert sum(result["deployments"]["attribution"]["own_turns_by_how"].values()) == turns > 0
+    real_load = ex.load_attribution
+
+    class Proxy:
+        def __init__(self, bad):
+            self.real, self.bad = real_load(), bad
+
+        def __getattr__(self, name):
+            return getattr(self.real, name)
+
+        def attempt(self, rec, attributor):
+            a = self.real.attempt(rec, attributor)
+            if (rec.question_id, rec.repetition) == self.bad:
+                return types.SimpleNamespace(own=[types.SimpleNamespace(how="unjoined", fingerprint_mismatch=0)], served_by=a.served_by)
+            return a
+
+    monkeypatch.setattr(ex, "load_attribution", lambda: Proxy(("t01-q1", 1)))
+    with pytest.raises(ex.Refused, match=r"fronted turns that do not join to one backend"):
+        _key_run(world, out)
+    monkeypatch.setattr(ex, "load_attribution", lambda: Proxy(("t09", 0)))
+    assert _key_run(world, out)["arms"]  # the twin
+
