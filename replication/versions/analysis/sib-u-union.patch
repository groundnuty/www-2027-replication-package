+        ex.prepare(F, call(fold_fact_sha256=pinned), cluster_map=cm, map_record=map_record, cfg=SimpleNamespace())
+    publish(world.fact())  # (the pinned one again)
+    assert state.sha == pinned
+    # the form cannot be asked for: a call carries no field for it
+    with pytest.raises(TypeError):
+        call(form="B")
+
+    (world.outs[1].path / "records" / world.reruns[1, 0]).unlink()
+    publish(world.fact(done=[(0, 0)]))  # one analysis-set re-run is missing from the fact: the union derives FORM B
+    assert accuracy() == pytest.approx(1 / 3)
+    assert accuracy("companion") == 1
+    fold = ex.run(F, call(), K_clusters=np.ones((2, 3)), cluster_map=cm, map_record=map_record,
+                  cfg=SimpleNamespace())["exploratory"]["fold"]
+    assert (fold["form"], fold["fact"]["all_complete"], fold["analysis_all_complete"]) == ("B", False, False)
+
+    (world.outs[0].path / "records" / world.reruns[0, 0]).unlink()
+    publish(world.fact(done=[]))
+    empty = ex.run(F, call("companion"), K_clusters=np.ones((2, 3)), cluster_map=cm,
+                   map_record=map_record, cfg=SimpleNamespace())
+    assert empty["exploratory"]["fold"]["status"] == "no companion" and "arms" not in empty
+    assert empty["exploratory"]["fold"]["fact"]["all_complete"] is False
+    assert empty["exploratory"]["fold"]["form"] == "B"
+    assert accuracy() == pytest.approx(1 / 3)
+
+    bad = tmp_path / "wrong-manifest.json"
+    put(bad, {"source": "wrong"})
+    with pytest.raises(ex.Refused, match="supplied manifest differs"):
+        ex.prepare(F, dataclasses.replace(call(), source_manifest=bad), cluster_map=cm,
+                   map_record=map_record, cfg=SimpleNamespace())
+    assert accuracy() == pytest.approx(1 / 3)
+
+    # Unequal completed repetitions beside FORM B: one question has two re-runs, one has one.
+    (tmp_path / "w2").mkdir(mode=0o700)
+    w2 = build_world(tmp_path / "w2", reps=2, selected=((0, 0), (0, 1), (1, 0), (1, 1)))
+    (w2.outs[1].path / "records" / w2.reruns[1, 0]).unlink()  # q1.r0 has no re-run record
+    state.w = w2
+    publish(w2.fact(done=[(0, 0), (0, 1), (1, 1)]))
+    monkeypatch.setattr(ex, "cluster_counts", lambda _F, _m, _i, _cfg, _K:
+                        (np.array([[1.0, 1.0], [2.0, 1.0]]), SimpleNamespace(summary=lambda: {})))
+    result = ex.run(F, call("companion", reps=2), cluster_map=cm, map_record=map_record, cfg=SimpleNamespace())
+    row = next(v for k, v in result["arms"].items() if "|prompt|" in k)
+    assert row["metrics"]["accuracy"]["estimate"] == pytest.approx(0.5)
+    assert row["metrics"]["accuracy"]["ci"] == pytest.approx([0.5, 2 / 3])
+    # the record's repetitions are the design's
+    with pytest.raises(ex.Refused, match="full question/repetition design"):
+        ex.prepare(F, call("companion", reps=1), cluster_map=cm, map_record=map_record, cfg=SimpleNamespace())
