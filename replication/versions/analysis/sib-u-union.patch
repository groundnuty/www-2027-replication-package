+    for graph in ex.SIB_GRAPHS:
+        result = ex.run(F, _sib_call(world, out, qa, graph=graph, pin=pin), **_sib_args())
+        block = result["exploratory"]["sib_analysis_set"]
+        assert block["public_salted_sha256"] == hashlib.sha256(SALT + qa.read_bytes()).hexdigest()
+        text = json.dumps(result, sort_keys=True)
+        assert _plain(qa) not in text and SALT.hex() not in text and str(pin) not in text and "7" * 64 not in text
+        assert "salt_file" not in text and "gold-salt" not in text
+
