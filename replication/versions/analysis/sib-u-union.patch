+def test_the_ledger_on_real_outputs_under_unequal_repetitions(world):
+    """real_output_ledger (one row of the source, its counts and rates), by hand from the toy above, result_rows = 1 on every output
+    (so every output is in the non-empty stratum). Counts: N_att 4, N_out 4, catches (W_F) 1, false_flags (C_F) 1, fixes 0, corruptions
+    0, unknown (W_U + C_U) 1, vacuous passes 0, retried 0. Per-attempt rates are PROPORTIONS (the mean of the per-question means):
+    catches: q1 W_F 1/3, q2 0: (1/3 + 0)/2 = 1/6; false_flags: q1 C_F 1/3, q2 0: 1/6; fixes 0; corruptions 0. The unknown rate is a
+    RATIO, pooled: U/out = 1/4. The non-empty rates: catches 1/6 and false flags 1/6 again (every output returned rows)."""
+    attempts, ledger, index, arms = world
+    table = P.real_output_ledger(arms, index, K, LEVEL, None, K)
+    (row,) = table["rows"]
+    assert row["counts"] == {"N_att": 4, "N_out": 4, "catches": 1, "false_flags": 1, "fixes": 0, "corruptions": 0, "unknown": 1,
+                             "vacuous_passes": 0, "retried": 0}
+    assert row["per_attempt"]["catches"]["estimate"] == pytest.approx(1 / 6)
+    assert row["per_attempt"]["false_flags"]["estimate"] == pytest.approx(1 / 6)
+    assert row["per_attempt"]["fixes"]["estimate"] == 0.0 and row["per_attempt"]["corruptions"]["estimate"] == 0.0
+    assert row["unknown_rate"]["estimate"] == pytest.approx(0.25)  # pooled counts: not the mean (0 + 1) / 2 of the per-question rates
+    assert row["non_empty"]["outputs"] == {"returns_rows": 4, "empty": 0, "no_row_count": 0} and row["non_empty"]["estimable"]
+    assert row["non_empty"]["catches"]["estimate"] == pytest.approx(1 / 6)
+    assert row["non_empty"]["false_flags"]["estimate"] == pytest.approx(1 / 6)
+    # the draws: catches num_q = (1/3, 0), den_q = (1, 1): K rows give (1/3)/2 = 1/6, (1/3)/3 = 1/9, (2/3)/3 = 2/9: interval [1/9, 2/9]
+    assert row["per_attempt"]["catches"]["ci"] == pytest.approx([1 / 9, 2 / 9])
+    # the unknown rate's draws: num_q = U = (0, 1), den_q = out = (3, 1): 1/4, 2/5, 1/7: interval [1/7, 2/5]
+    assert row["unknown_rate"]["ci"] == pytest.approx([1 / 7, 2 / 5])
+    (by_model,) = table["by_model"]
+    assert by_model["counts"] == row["counts"] and by_model["per_attempt"]["catches"]["estimate"] == pytest.approx(1 / 6)
+
