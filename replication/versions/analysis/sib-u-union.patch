+def test_fact_tool_output_is_what_bind_fold_reads(world, tmp_path):
+    """The seam: the tool's own file (a names-only listing of the toy OUTs) is parsed by SibFact and bound by bind_fold."""
+    fact_path = tmp_path / "tool-fact.json"
+    argv = ["--exclude-digests", str(world.exclude), "--exclude-sha256", world.exclude_sha, "--source-out",
+            str(world.source.path), "--at", FACT_AT, "--out", str(fact_path), "--local"]
+    for o in world.outs:
+        argv += ["--partition-out", str(o.path)]
+    assert fact_tool.main(argv) == 0
+    fact = ex.SibFact.read(fact_path, ex.sha256_file(fact_path))
+    assert fact.all_complete and fact.at == FACT_AT and fact.parts[1].new_digests == frozenset([world.digests[1, 0]])
+    assert bind(world, "A", fact=fact).allowed[world.outs[0].path]  # the tool's complete fact derives FORM A
+    (world.outs[1].path / "records" / world.reruns[1, 0]).unlink()  # a re-run missing at the listing
+    os.remove(fact_path)
+    assert fact_tool.main(argv) == 0
+    fact = ex.SibFact.read(fact_path, ex.sha256_file(fact_path))
+    assert not fact.all_complete and not fact.parts[1].new_digests
+    assert bind(world, "B", "companion", fact=fact).allowed[world.outs[0].path]  # the incomplete one derives FORM B
+    assert bind(world, fact=fact).form == "B"
