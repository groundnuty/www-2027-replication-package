+def test_a_population_file_is_a_new_private_file_in_a_private_directory(tmp_path):
+    pop = _pop_dir(tmp_path)
+    doc = {"schema": ex.POPULATION_SCHEMA, "view": "primary", "form": "A", "fold_fact_sha256": "a" * 64, "fold_sha256": "b" * 64,
+           "run_ids": ["x"], "run_ids_sha256": "c" * 64}
+    target = pop / "p.json"
+    ex.write_population(target, doc)
+    assert target.stat().st_mode & 0o777 == 0o600 and json.loads(target.read_text()) == doc
+    # never overwritten: a second write to the same name is refused and the first stays
+    with pytest.raises(ex.Refused, match="must be a new file"):
+        ex.write_population(target, {**doc, "view": "companion"})
+    assert json.loads(target.read_text()) == doc
+    # a link in the file's place (a dangling one included), or an existing file of any kind
+    (pop / "dangling.json").symlink_to(pop / "nowhere.json")
+    (pop / "linked.json").symlink_to(target)
+    for name in ("dangling.json", "linked.json"):
+        with pytest.raises(ex.Refused, match="must be a new file"):
+            ex.write_population(pop / name, doc)
+    assert not (pop / "nowhere.json").exists()  # (nothing was written through the dangling link)
+    # a link on the directory path
+    (tmp_path / "pop-link").symlink_to(pop)
+    with pytest.raises(ex.Refused, match="contains a link or is not a directory"):
+        ex.write_population(tmp_path / "pop-link" / "q.json", doc)
+    # a directory others can enter, a relative path, a parent traversal, a missing directory, a Git worktree
+    open_dir = tmp_path / "open"
+    open_dir.mkdir()
+    open_dir.chmod(0o755)
+    with pytest.raises(ex.Refused, match="mode 700 or tighter"):
+        ex.write_population(open_dir / "q.json", doc)
+    group = tmp_path / "group"
+    group.mkdir()
+    group.chmod(0o750)
+    with pytest.raises(ex.Refused, match="mode 700 or tighter"):
+        ex.write_population(group / "q.json", doc)
+    with pytest.raises(ex.Refused, match="absolute path"):
+        ex.write_population(Path("q.json"), doc)
+    with pytest.raises(ex.Refused, match="absolute path"):
+        ex.write_population(pop / ".." / "pop" / "q.json", doc)
+    with pytest.raises(ex.Refused, match="existing directory path"):
+        ex.write_population(pop / "missing" / "q.json", doc)
+    repo = tmp_path / "repo"
+    (repo / ".git").mkdir(parents=True)
+    (repo / ".git" / "config").write_text("[core]\n")
+    inside = repo / "pop"
+    inside.mkdir()
+    inside.chmod(0o700)
