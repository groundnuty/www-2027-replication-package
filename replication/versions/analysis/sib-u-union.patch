+def _refused_when_absent_or_altered(e, endpoint, files, tmp_path):
+    for kind in ("storecheck", "known_answers"):
+        sha = e[f"{kind}_sha256"]
+        # absent
+        problems = ex.prove(e, GRAPH, endpoint, {k: v for k, v in files.items() if k != sha}, e["replica"], None, False)
+        assert any(p.startswith(f"its {kind} file (sha256 {sha[:12]}) was not given") for p in problems), problems
+        # altered by one byte (a letter of the first 'uniprot' in the file: still JSON): the loader keys files by the sha256 of
+        # their content, so the altered file is not the file the entry pins
+        raw = Path(e["sources"][kind]["hub"]).read_bytes()
+        at = raw.index(b"uniprot")
+        altered = tmp_path / e["sources"][kind]["hub"].rsplit("/", 1)[1]
+        altered.write_bytes(raw[:at] + bytes([raw[at] ^ 1]) + raw[at + 1:])
+        loaded = ex.read_proof_files([altered])
+        assert sha not in loaded
+        problems = ex.prove(e, GRAPH, endpoint, {**{k: v for k, v in files.items() if k != sha}, **loaded}, e["replica"], None, False)
+        assert any(p.startswith(f"its {kind} file (sha256 {sha[:12]}) was not given") for p in problems), problems
+
