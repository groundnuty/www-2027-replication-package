+def test_real_sib_union_forms_and_refusing_twins(tmp_path):
+    """Two repetitions through ex.run with nothing stubbed: mixed-source questions and unequal repetitions.
+
+    Fixture templates give each attempt (correct, output): R = (1, 1), W = (0, 1), C = (0, 0). An estimate is the mean over
+    the design's questions of the mean over that question's attempts, so the hand derivations below are per question.
+    Keys are qI.rJ (question I, repetition J). Originals: q0.r0 R, q0.r1 W, q1.r0 C, q1.r1 W, q2.r0 W, q2.r1 C. Folded
+    keys and their re-runs: q0.r0 W, q0.r1 R, q1.r0 R (q1.r1 and all of q2 are copied from the source into their partition).
+
+    FORM A primary (partition records, re-runs substituted):
+      q0 = re-runs W, R      -> accuracy 1/2, output 1
+      q1 = re-run R, copy W  -> accuracy 1/2, output 1
+      q2 = copies W, C       -> accuracy 0,   output 1/2
+      accuracy (1/2 + 1/2 + 0) / 3 = 1/3, output rate (1 + 1 + 1/2) / 3 = 5/6.
+    FORM A companion (the source originals of the folded keys only; q2 has none, so it is not in the design):
+      q0 = originals R, W    -> accuracy 1/2, output 1
+      q1 = original C        -> accuracy 0,   output 0   (one repetition against q0's two)
+      accuracy (1/2 + 0) / 2 = 1/4, output rate (1 + 0) / 2 = 1/2 (pooled over the three attempts it would be 1/3 and 2/3).
+    FORM B primary (copies from the partitions, folded keys from the source originals):
+      q0 = source originals R, W            -> accuracy 1/2, output 1
+      q1 = source original C + copy W       -> accuracy 0,   output 1/2  (mixed sources inside one question)
+      q2 = copies W, C                      -> accuracy 0,   output 1/2
+      accuracy (1/2 + 0 + 0) / 3 = 1/6, output rate (1 + 1/2 + 1/2) / 3 = 2/3.
+    FORM B companion with the fact naming q0.r0 and q1.r0 (q0.r1 was not completed at its instant, even though its record
+    sits in the partition now; the design is q0 and q1, and the repetition-1 keys are 'not run', never missing):
+      q0 = re-run W (q0.r0)  -> accuracy 0, output 1
+      q1 = re-run R (q1.r0)  -> accuracy 1, output 1
+      accuracy (0 + 1) / 2 = 1/2, output rate 1. (With the q0.r1 re-run leaked in it would be accuracy 3/4; with the two
+      repetition-1 keys counted as missing attempts, accuracy 1/4 and output rate 1/2.)
+    """
+    import numpy as np
+
+    w = _scored_union_world(tmp_path)
+    F = ex.load_frozen(HERE.parents[2])
+    cm = F.prereg.ClusterMap.singletons(w.ids)
+    map_record = {"graph": ex.SIB, "store": "rhea-test", "questions_sha256": w.qsha}
+    all_done = [(0, 0), (0, 1), (1, 0)]  # FORM A: every selected re-run completed
+    some_done = [(0, 0), (1, 0)]  # FORM B: q0.r1 is not completed
+
+    def call(view, completed):
+        # no form is given: the union derives it from the fact. The partitions' ledgers are --ledger; the source's is
+        # --source-ledger, which a call reads only when its view reads the source OUT (the derived form decides which)
+        exclude, exclude_sha, fact, fact_sha = w.fold(completed)
+        return ex.Call(tuple(w.parts), (w.questions,), ex.SIB, "test", (w.voided,),
+            partition_record=w.record, partition_record_sha256=w.record_sha,
+            n_reps=2, ledgers=tuple(w.ledgers[p] for p in w.parts), source_ledger=w.ledgers[w.source],
+            fold=exclude, fold_sha256=exclude_sha, fold_fact=fact, fold_fact_sha256=fact_sha, fold_view=view,
+            source_batch=w.source, source_order=w.order, source_order_sha256=ex.sha256_file(w.order),
+            source_manifest=w.source / "manifest.json", sib_analysis_questions=w.analysis,
+            sib_analysis_pin=w.pin)
+
+    def run(form, view, completed, units):
+        """``form`` is the form the union is expected to derive from this fact: asserted from the private result."""
+        result = ex.run(F, call(view, completed), K_clusters=np.ones((2, units)),
+                        cluster_map=cm, map_record=map_record, cfg=SimpleNamespace())
+        row = result["arms"]["rhea-test|oracle-model|none|prompt|-"]
+        assert result["exploratory"]["fold"]["form"] == form, (form, view)
+        return (row["metrics"]["accuracy"]["estimate"],
+                row["metrics"]["output_rate"]["estimate"], result)
+
+    def refused(view, completed, message):
+        with pytest.raises(ex.Refused, match=message):
+            ex.run(F, call(view, completed), cluster_map=cm, map_record=map_record, cfg=SimpleNamespace())
+
+    # FORM A: all three re-runs completed.
+    for view, units, expected in (("primary", 3, (1 / 3, 5 / 6)), ("companion", 2, (1 / 4, 1 / 2))):
+        accuracy, output_rate, result = run("A", view, all_done, units)
+        assert (accuracy, output_rate) == pytest.approx(expected)
+        assert result["real_output_ledger"]["rows"]
+        assert result["exploratory"]["fold"]["fact"]["at"] == FACT_AT  # the one fact, in both views
+        assert result["exploratory"]["fold"]["analysis_all_complete"] is True
+
+    # FORM B: the same record trees, a fact naming two of the three re-runs.
+    for view, units, expected in (("primary", 3, (1 / 6, 2 / 3)), ("companion", 2, (1 / 2, 1.0))):
+        accuracy, output_rate, result = run("B", view, some_done, units)
+        assert (accuracy, output_rate) == pytest.approx(expected)
+        assert result["real_output_ledger"]["rows"]
+        assert result["exploratory"]["fold"]["analysis_all_complete"] is False
+        assert result["exploratory"]["fold"]["fact"]["all_complete"] is False
+
+    # The same FORM B results when the unfinished re-run has no record at all.
+    unfinished = w.parts[0] / "records" / w.names[0, 1][1]
+    unfinished_row = json.loads(unfinished.read_text())
+    unfinished.unlink()
+    w.recheck(w.parts[0])
+    w.ledger(w.parts[0])
+    for view, units, expected in (("primary", 3, (1 / 6, 2 / 3)), ("companion", 2, (1 / 2, 1.0))):
+        assert run("B", view, some_done, units)[:2] == pytest.approx(expected)
+    put(unfinished, unfinished_row)
+    w.recheck(w.parts[0])
+    w.ledger(w.parts[0])
+
+    # Refusing twin: a kept partition record of a non-folded repetition (q1.r1, a copy) goes missing.
+    assert run("B", "primary", some_done, 3)[:2] == pytest.approx((1 / 6, 2 / 3))
+    kept = w.parts[1] / "records" / w.names[1, 1][0]
+    kept_row = json.loads(kept.read_text())
+    kept.unlink()
+    w.recheck(w.parts[1])
+    refused("primary", some_done, "nonselected key has zero or two partition records")
+    refused("primary", all_done, "nonselected key has zero or two partition records")
+    put(kept, kept_row)
+    w.recheck(w.parts[1])
+    assert run("B", "primary", some_done, 3)[:2] == pytest.approx((1 / 6, 2 / 3))
+
+    # A folded key's original is absent from the source.
+    original = w.source / "records" / w.names[0, 0][0]
+    original_row = json.loads(original.read_text())
+    original.unlink()
+    w.recheck(w.source)
+    refused("primary", some_done, "source original absent")
+    put(original, original_row)
+    w.recheck(w.source)
+    assert run("B", "primary", some_done, 3)[:2] == pytest.approx((1 / 6, 2 / 3))
+
+    # The copied original sits in the partition where the folded key's re-run belongs.
+    rerun = w.parts[0] / "records" / w.names[0, 0][1]
+    rerun_row = json.loads(rerun.read_text())
+    copied = w.parts[0] / "records" / original.name
+    rerun.unlink()
+    put(copied, original_row)
+    w.recheck(w.parts[0])
+    refused("primary", all_done, "new partition record name")
+    copied.unlink()
+    put(rerun, rerun_row)
+    w.recheck(w.parts[0])
+    assert run("A", "primary", all_done, 3)[:2] == pytest.approx((1 / 3, 5 / 6))
+
+    # Two partition records for one folded key.
+    second = w.parts[1] / "records" / rec_name(w.digests[1, 0], "second")
+    put(second, json.loads((w.parts[1] / "records" / w.names[1, 0][1]).read_text()))
+    w.recheck(w.parts[1])
+    refused("primary", some_done, "two partition records")
+    second.unlink()
+    w.recheck(w.parts[1])
+    assert run("B", "primary", some_done, 3)[:2] == pytest.approx((1 / 6, 2 / 3))
+
+    # No re-run completed: the primary stands, the companion is the explicit empty view.
+    assert run("B", "primary", [], 3)[:2] == pytest.approx((1 / 6, 2 / 3))
+    empty = ex.run(F, call("companion", []), cluster_map=cm, map_record=map_record, cfg=SimpleNamespace())
+    assert empty["exploratory"]["fold"]["status"] == "no companion" and "arms" not in empty
+    assert empty["exploratory"]["fold"]["form"] == "B"
+
+    # A stray ledger row of the source, naming a run that is in no record.
+    ledger = w.ledgers[w.source]
+    lines = ledger.read_text().splitlines()
+    bad_row = json.loads(lines[1])
+    bad_row["run_id"] = "absent-toy-run"
+    lines[1] = json.dumps(bad_row)
+    ledger.write_text("\n".join(lines) + "\n")
+    refused("primary", [], "no record of the union")
+
