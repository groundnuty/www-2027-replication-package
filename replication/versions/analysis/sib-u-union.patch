+def test_real_sib_union_with_a_fold_key_outside_the_analysis_set(tmp_path):
+    """Through ex.run with nothing stubbed: the second question (q1, with the fold key q1.r0) is outside the analysis set, so
+    its records are not in the scored batches and its key is dropped. The fact names q0.r0 and q0.r1 only, so its own all_complete
+    is False while every analysis-set fold key has a re-run: the union's test chooses FORM A.
+
+    Analysis set q0, q2. FORM A primary (re-runs of the fold keys, copies for the rest):
+      q0 = re-runs W, R      -> accuracy 1/2, output 1
+      q2 = copies W, C       -> accuracy 0,   output 1/2
+      accuracy (1/2 + 0) / 2 = 1/4, output rate (1 + 1/2) / 2 = 3/4.
+    FORM A companion (the source originals of the analysis fold keys: q0 R, W): accuracy 1/2, output 1 over one question.
+    With the fact naming q0.r0 only, q0.r1 (an analysis key) is missing: FORM B, whose companion is the one re-run, q0.r0 W:
+    accuracy 0, output 1; its primary has q0's originals R, W and q2's copies: accuracy 1/4, output rate 3/4."""
+    import numpy as np
+
+    ids = toy_ids()
+    w = _scored_union_world(tmp_path, analysis_ids={ids[0], ids[2]})
+    F = ex.load_frozen(HERE.parents[2])
+    cm = F.prereg.ClusterMap.singletons([ids[0], ids[2]])
+    map_record = {"graph": ex.SIB, "store": "rhea-test", "questions_sha256": w.qsha}
+
+    def call(view, completed):
+        exclude, exclude_sha, fact, fact_sha = w.fold(completed)
+        return ex.Call(tuple(w.parts), (w.questions,), ex.SIB, "test", (w.voided,),
+            partition_record=w.record, partition_record_sha256=w.record_sha, n_reps=2,
+            ledgers=tuple(w.ledgers[p] for p in w.parts), source_ledger=w.ledgers[w.source], fold=exclude,
+            fold_sha256=exclude_sha, fold_fact=fact, fold_fact_sha256=fact_sha, fold_view=view,
+            source_batch=w.source, source_order=w.order, source_order_sha256=ex.sha256_file(w.order),
+            source_manifest=w.source / "manifest.json", sib_analysis_questions=w.analysis, sib_analysis_pin=w.pin)
+
+    def run(form, view, completed, units):
+        result = ex.run(F, call(view, completed), K_clusters=np.ones((2, units)), cluster_map=cm,
+                        map_record=map_record, cfg=SimpleNamespace())
+        row = result["arms"]["rhea-test|oracle-model|none|prompt|-"]
+        assert result["exploratory"]["fold"]["form"] == form, (form, view)  # the derived form
+        return row["metrics"]["accuracy"]["estimate"], row["metrics"]["output_rate"]["estimate"], result
+
+    both_q0 = [(0, 0), (0, 1)]  # the fact: q1.r0 (outside the analysis set) has no re-run record in it
+    for view, units, expected in (("primary", 2, (1 / 4, 3 / 4)), ("companion", 1, (1 / 2, 1.0))):
+        accuracy, output_rate, result = run("A", view, both_q0, units)
+        assert (accuracy, output_rate) == pytest.approx(expected), view
+        fold = result["exploratory"]["fold"]  # both verdicts and the dropped key, in the private result
+        assert fold["fact"]["all_complete"] is False and fold["analysis_all_complete"] is True
+        assert fold["fold_keys_outside_analysis_dropped"] == 1
+        assert fold["fact"]["sha256"] == w.fold(both_q0)[3]  # the fact the form was derived from
+    # an analysis-set fold key without a re-run in the fact: FORM B
+    q00 = [(0, 0)]
+    for view, units, expected in (("primary", 2, (1 / 4, 3 / 4)), ("companion", 1, (0.0, 1.0))):
+        accuracy, output_rate, result = run("B", view, q00, units)
+        assert (accuracy, output_rate) == pytest.approx(expected), view
+        assert result["exploratory"]["fold"]["analysis_all_complete"] is False
+        assert result["exploratory"]["fold"]["fold_keys_outside_analysis_dropped"] == 1
