+"""Every reported estimate of the exploratory call under UNEQUAL repetitions per question (the shape of a drained prefix analysed by the
+key subset: science, 25 Oct 13:2xZ, "per-question means over the repetitions present"), by hand, on toys.
+
+The frozen functions are called directly on Attempt and CheckedOutput objects built here, with a resample matrix K written by hand, so
+the expected numbers below are LITERALS derived in the comments from the toy, never taken from the code. The frozen code is
+harness/analysis:
+- metrics.py:76-111 METRICS (the weighting of each metric), :136 indicators, :183 build_arms, :235 question_vectors, :252-261
+  metric_arrays (PROPORTION: a question's numerator and denominator divided by its own attempt count; RATIO: the raw counts), :270
+  point_estimate, :276 arm_counts; stats.py:101 ratio_draws (counts @ num / counts @ den); pipeline.py:245 _summary, :261 _metrics,
+  :267 _by_check_type, :309 _costs, :332 _arm_result (counts, metrics, strata), :412 _real_output_row and :453 real_output_ledger.
+What the tests show, and what each estimate does with a question that has 3 attempts beside one that has 1:
+- PROPORTION metrics (accuracy, mean_f1, output_rate, missing_rate, silent_failure, accuracy_final, net_change; the ledger's per-attempt
+  rates and its non-empty rates): the mean of the per-question means, so a one-attempt question weighs as much as a three-attempt one;
+- RATIO metrics (flag_rate, flag_precision, false_flag_rate, recall, error_certified, error_not_intervened, fix_rate, corruption_rate,
+  unknown_rate, substantive_coverage, substantive_pass_share, number_traceability_flag_rate, repair_yield; the ledger's unknown_rate):
+  POOLED COUNTS, by the frozen definition (prereg section 3), so a question weighs as many times as it has outputs or flags: with
+  unequal repetitions the three-attempt question weighs three times the one-attempt one. This is what the frozen definition does with
+  any unequal outputs; it is pinned here, not changed;
+- counts, costs (per-attempt distributions) and the deployment and store shares are over attempts by definition;
+- a question with no attempt in an arm (or in a stratum, or in a deployment's restricted units) is an EMPTY DRAW there: its numerator and
+  denominator are 0, the estimate is over the questions present, and a resample that draws only absent questions is undefined (NaN).
+The exploratory path has no between-arm difference or paired estimate: its result has no section for one (the last test).
+"""
+
+import importlib.util
+import dataclasses
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+
+_spec = importlib.util.spec_from_file_location("e189_exploratory_unequal", HERE.parent / "exploratory.py")
+ex = importlib.util.module_from_spec(_spec)
+sys.modules["e189_exploratory_unequal"] = ex
+_spec.loader.exec_module(ex)
+F = ex.load_frozen(ROOT)
+P, M, I = F.pipeline, F.metrics, F.inputs
+G, MOD = "g", "m"
+
+# The toy, by hand. Two questions (one cluster each), one model, one cohort "none":
+#   q1: three attempts  a1 right, a2 wrong, a3 right      q2: one attempt  b1 wrong
+# and the replay checker's status on each output: a1 P (a substantive pass), a2 F (a flag, rightly), a3 F (a false flag),
+# b1 U (unknown, not substantive). The resample matrix: three resamples over the index (q1, q2) with q1 drawn 1, 1, 2 times and q2 drawn
+# 1, 2, 1 times: K = [[1, 1], [1, 2], [2, 1]].
+K = np.array([[1, 1], [1, 2], [2, 1]], dtype=float)
+LEVEL = ex.LEVEL
+QUESTIONS = {"q1": {"id": "q1", "base_question_id": "q1", "template": "t1", "split": "dev"},
+             "q2": {"id": "q2", "base_question_id": "q2", "template": "t2", "split": "dev"}}
+ROWS = [("a1", "q1", 0, True, "P", True), ("a2", "q1", 1, False, "F", True), ("a3", "q1", 2, True, "F", True),
+        ("b1", "q2", 0, False, "U", False)]
+WALL = {"a1": 1.0, "a2": 2.0, "a3": 3.0, "b1": 10.0}
+
+
+def attempt(run_id, qid, rep, correct, model=MOD, output=True, wall=None):
+    return I.Attempt(run_id=run_id, graph=G, model=model, cohort="none", question_id=qid, base_question_id=qid,
+                     template=QUESTIONS[qid]["template"], split="dev", repetition=rep,
+                     status="submitted" if output else "abstained", output=output, correct=correct and output,
+                     f1=1.0 if correct and output else 0.0, wall_s=wall)
+
+
+def checked(run_id, qid, correct, status, substantive, model=MOD):
+    return I.CheckedOutput(run_id=run_id, graph=G, model=model, cohort="none", source="src", use="replay", question_id=qid,
+                           base_question_id=qid, initial_correct=correct, status=status, substantive=substantive,
+                           checked_query="aligned", result_rows=1, flagged_check_types=("T",) if status == "F" else ())
+
+
+@pytest.fixture
+def world():
+    attempts = [attempt(r, q, rep, c, wall=WALL[r]) for r, q, rep, c, _, _ in ROWS]
+    ledger = [checked(r, q, c, st, sub) for r, q, _, c, st, sub in ROWS]
+    index = F.prereg.index_from_questions(QUESTIONS, "dev")
+    arms = M.build_arms(attempts, ledger)
+    return attempts, ledger, index, arms
+
+
+def key_of(arms, use, source=None):
+    return next(k for k in arms if k.use == use and (source is None or k.source == source))
+
+
+def test_the_index_is_the_two_questions_and_the_arms_are_the_prompt_arm_and_the_replay_arm(world):
+    attempts, ledger, index, arms = world
+    assert list(index.questions) == ["q1", "q2"]
+    assert sorted(k.label for k in arms) == [f"{G}|{MOD}|none|prompt|-", f"{G}|{MOD}|none|replay|src"]
+    assert M.arm_counts(arms[key_of(arms, "prompt")])["N_att"] == 4
+
+
+def test_the_proportion_metrics_are_the_mean_of_the_per_question_means(world):
+    """accuracy: q1 right 2 of 3 attempts = 2/3, q2 right 0 of 1 = 0; the mean of the two means is 1/3 (pooled over attempts it would
+    be 2/4). mean_f1 is the same numbers (f1 = 1 for a right output, else 0). output_rate: every attempt is an output = 1.
+    silent_failure (wrong outputs / attempts): q1 1/3, q2 1; the mean (1/3 + 1) / 2 = 2/3 (pooled 2/4). missing_rate 0."""
+    attempts, ledger, index, arms = world
+    result = P._arm_result(key_of(arms, "prompt"), arms[key_of(arms, "prompt")], index, K, LEVEL, {}, True)
+    m = result["metrics"]
+    assert m["accuracy"]["estimate"] == pytest.approx(1 / 3)
+    assert m["mean_f1"]["estimate"] == pytest.approx(1 / 3)
+    assert m["output_rate"]["estimate"] == 1.0
+    assert m["silent_failure"]["estimate"] == pytest.approx(2 / 3)
+    assert m["missing_rate"]["estimate"] == 0.0
+    assert result["counts"]["N_att"] == 4 and result["counts"]["N_out"] == 4 and result["counts"]["n_questions"] == 2
+
+
+def test_the_bootstrap_resamples_questions_and_the_proportion_draws_use_the_per_question_means(world):
+    """K row r draws q1 K[r,0] times and q2 K[r,1] times. accuracy: num_q = (2/3, 0), den_q = (1, 1), so the draws are
+    (1*2/3)/(1+1) = 1/3, (1*2/3)/(1+2) = 2/9 and (2*2/3)/(2+1) = 4/9; the percentile interval of three draws is [2/9, 4/9]. Pooling
+    attempts instead (num = (2, 0), den = (3, 1)) would give the draws 2/4, 2/5 and 4/7, the interval [2/5, 4/7]: not this."""
+    attempts, ledger, index, arms = world
+    acc = P._arm_result(key_of(arms, "prompt"), arms[key_of(arms, "prompt")], index, K, LEVEL, {}, True)["metrics"]["accuracy"]
+    assert acc["ci"] == pytest.approx([2 / 9, 4 / 9]) and acc["undefined_share"] == 0.0
+    assert acc["ci"] != pytest.approx([2 / 5, 4 / 7])
