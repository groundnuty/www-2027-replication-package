+    assert {a.question_id for a in loaded.attempts} == {"t01-q1", "t01-q2"}
+    assert not [a for a in loaded.attempts if a.run_id.startswith("missing:")]
+    one = _plain_run(world, _plain_out(world, "out-one", incomplete=("t01-q2", "t02-q3")), ["t01-q1"])
