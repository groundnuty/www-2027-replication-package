+
+    good = json.loads(_rhea_pin(world, qa).read_text())
+    refused_with(_rhea_pin(world, qa, salt_mode=0o644), r"salt file: not this user's file with mode 600")
+    refused_with(_rhea_pin(world, qa, salt=SALT[:31]), r"salt file is not 32 raw bytes")
+    refused_with(_rhea_pin(world, qa, salt=SALT + b"x"), r"salt file: larger than 32 bytes")
+    refused_with(_rhea_pin(world, qa, salt=b"x" * 5_000_000), r"salt file: larger than 32 bytes")
+    refused_with(_rhea_pin(world, qa, salt=b""), r"salt file is not 32 raw bytes")
+    refused_with(_rhea_pin(world, qa, salt_file="gold-salt"), r"not an absolute normalised path")
+    refused_with(_rhea_pin(world, qa, salt_file=str(world["tmp"]) + "/../gold-salt"), r"not an absolute normalised path")
+    refused_with(_rhea_pin(world, qa, salt_file=str(world["tmp"]) + "//gold-salt"), r"not an absolute normalised path")
+    refused_with(_rhea_pin(world, qa, salt_file=7), r"not an absolute normalised path")
+    refused_with(_rhea_pin(world, qa, salt_file=str(world["tmp"] / "absent-salt")), r"salt file: cannot be opened")
+    link = world["tmp"] / "salt-link"
+    os.symlink(world["tmp"] / "gold-salt", link)
+    refused_with(_rhea_pin(world, qa, salt_file=str(link)), r"salt file: a symlink")
+    real_dir = world["tmp"] / "real-dir"
+    real_dir.mkdir()
+    _rhea_pin(world, qa, salt_name="real-dir/gold-salt", pin_name="x.json")
+    os.symlink(real_dir, world["tmp"] / "dir-link")  # a symlink in a PARENT component
+    refused_with(_rhea_pin(world, qa, salt_file=str(world["tmp"] / "dir-link" / "gold-salt")), r"salt file: a symlink")
+    refused_with(_rhea_pin(world, qa, salt_file="//" + str(world["tmp"])[1:] + "/gold-salt"), r"not an absolute normalised path|a symlink \(or an unusual form\)")
+    refused_with(_rhea_pin(world, qa, salt_file=str(world["tmp"]) + "/gold-salt\x00x"), r"salt file: cannot be opened \(ValueError\)")
+    refused_with(_rhea_pin(world, qa, salt_file=str(world["tmp"])), r"salt file: not a regular file")  # a directory
+    refused_with(_rhea_pin(world, qa, salt_file="/dev/null"), r"salt file: not a regular file")  # a device
+    refused_with(_rhea_pin(world, qa, salt=SALT[::-1], public_salted_sha256=good["public_salted_sha256"]),
+                 r"public_salted_sha256 is not sha256\(salt")
+    refused_with(_rhea_pin(world, qa, questions_analysis_sha256="0" * 64), r"not the file the private pin names")
+    refused_with(_rhea_pin(world, qa, gold_provenance_sha256="XYZ"), r"not 64 lower-case hex digits")
+    for drop in ("gold_provenance_sha256", "salt_file", "public_salted_sha256"):
+        pin = _rhea_pin(world, qa, pin_name=f"no-{drop}.json")
+        doc = json.loads(pin.read_text())
+        doc.pop(drop)
+        pin.write_text(json.dumps(doc))
+        refused_with(pin, r"exactly its keys")
+    extra = _rhea_pin(world, qa, pin_name="extra.json", salt_hex=SALT.hex())  # the other form's key is not this form's
+    refused_with(extra, r"exactly its keys")
+    mixed = _write_pin(world["tmp"] / "mixed.pin.json", qa, salt_file="/x")  # this form with the other's key
+    refused_with(mixed, r"exactly its keys")
+    reordered = _rhea_pin(world, qa, pin_name="reordered.json")
+    reordered.write_text(json.dumps(dict(reversed(list(json.loads(reordered.read_text()).items())))))
+    assert ex.run(F, _sib_call(world, out, qa, graph=ex.SIB_RHEA, pin=reordered), **_sib_args())["arms"]  # key order is free
+    assert ex.run(F, _sib_call(world, out, qa, graph=ex.SIB_RHEA, pin=_rhea_pin(world, qa)), **_sib_args())["arms"]  # twin
