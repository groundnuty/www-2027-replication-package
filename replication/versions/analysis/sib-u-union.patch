+def test_the_chain_pin_and_order_through_prefix_keys_into_the_e189_call_with_scattered_repetitions(world, tmp_path):
+    """The whole path on toys: the pin and the OUT's order file -> prefix_keys.py (run as a program) -> the e189 call. The two
+    repetitions of t01-q2 are far apart in the order (indices 0 and 4), t02-q3's are exceptions of the prefix, t01-q1's second is
+    beyond it."""
+    out = _prefix_out(world, drop=(("t02-q3", 0), ("t02-q3", 1)))  # t01-q1 r1 stays on disk: the OUT ran past the pin's prefix
+    order_raw = json.dumps({"seed": 1, "rule": "toy", "order": [[PLAIN_NAME, "none", q, r] for q, r in KEY_ORDER]}).encode()
+    (out / "order-natural.json").write_bytes(order_raw)
+    digest = lambda i: hashlib.sha256(f"toy key {i}".encode()).hexdigest()[:40]  # noqa: E731
+    sha = lambda text: hashlib.sha256(text.encode()).hexdigest()  # noqa: E731
+    k = "".join(f"K\t{i}\t{digest(i)}\n" for i in (0, 2, 4))
+    x = "".join(f"X\t{i}\t{digest(i)}\tset aside by the harness\n" for i in (1, 3))
+    h = "H\tdrain\n"
+    keyset = sha("".join(d + "\n" for d in sorted(digest(i) for i in (0, 2, 4))))
+    pin = (f"PREFIX n_order=6 N=5 covered=3 exceptions=2 setasides=2 claims=5 records=3 keyset={keyset} list={sha(k)} exc={sha(x)} "
+           f"order={hashlib.sha256(order_raw).hexdigest()} holds=1 holdsha={sha(h)}\n") + k + x + h
+    (world["tmp"] / "pin.txt").write_text(pin, encoding="utf-8")
+    keys_file = world["tmp"] / "chain-keys.json"
+    done = subprocess.run([sys.executable, "-I", str(ROOT / "results" / "sib-checker-look-20261025" / "prefix_keys.py"), "--pin",
+                           str(world["tmp"] / "pin.txt"), "--order", str(out / "order-natural.json"), "--out", str(keys_file)],
+                          capture_output=True, text=True)
+    assert done.returncode == 0 and re.fullmatch(r"prefix keys written; sha256 [0-9a-f]{64}\n", done.stdout), (done.stdout, done.stderr)
+    doc = json.loads(keys_file.read_text())
+    assert doc["keys"] == [[PLAIN_NAME, "none", q, r] for q, r in KEY_COVERED]  # K lines only, in the order's own order
+    call = _key_call(world, out, path=keys_file, sha=done.stdout.split()[-1])
+    loaded, _, _ = ex.prepare(F, call, **_plain_args())  # the order file bound, the records bound by presence
+    assert sorted(a.run_id.startswith("missing:") for a in loaded.attempts) == [False] * 3
+    result = ex.run(F, call, **_plain_args())
+    arm = result["arms"][PLAIN_ARM]
+    assert (arm["counts"]["N_att"], arm["counts"]["n_questions"], arm["metrics"]["accuracy"]["estimate"]) == (3, 2, 0.5)
+    assert result["exploratory"]["key_subset"]["coverage"]["records_not_run"] == 1  # t01-q1 r1: on disk, beyond the prefix
+
