+
+    def accuracy(view="primary"):
+        result = ex.run(F, call(view), K_clusters=np.ones((2, 3)), cluster_map=cm,
+                        map_record=map_record, cfg=SimpleNamespace())
+        row = next(v for k, v in result["arms"].items() if "|prompt|" in k)
+        return row["metrics"]["accuracy"]["estimate"]
+
+    assert accuracy() == pytest.approx(2 / 3)  # every re-run is in the fact: the union derives FORM A
+    assert accuracy("companion") == 0
+    result = ex.run(F, call(), K_clusters=np.ones((2, 3)), cluster_map=cm, map_record=map_record, cfg=SimpleNamespace())
+    fold = result["exploratory"]["fold"]  # the private result records the derived form, the fold and the one fact
+    assert (fold["form"], fold["view"], fold["sha256"]) == ("A", "primary", world.exclude_sha)
+    assert fold["fact"]["at"] == FACT_AT and fold["fact"]["sha256"] == state.sha and "form_fact_sha256" not in fold["fact"]
+    assert (fold["fact"]["all_complete"], fold["analysis_all_complete"], fold["fold_keys_outside_analysis_dropped"]) == (
+        True, True, 0)
+    assert result["exploratory"]["partition_union"]["graph"] == ex.SIB
+    # a fact file other than the one pinned (another sha256, or a file altered after it was pinned) is refused, both views
+    for view in ("primary", "companion"):
+        with pytest.raises(ex.Refused, match="SIB fold fact: sha256 differs"):
+            ex.prepare(F, call(view, fold_fact_sha256=h("a later fact")), cluster_map=cm, map_record=map_record,
+                       cfg=SimpleNamespace())
+    pinned = state.sha
+    put(tmp_path / "fact.json", {**fact_doc(state.fact), "at": "2026-10-26T03:00:00Z"})  # a later cut under the same name
