+# --- several stack names over the union: one stack_assignment_sha256 and one fingerprint over the partitions' and the source's identities --
+# The scored world above has one stack name in every identity. The deployments of a real union may run one assignment on several stack
+# names; the union's stack check then accepts the several names only when every partition identity and the source identity carry the
+# same stack_assignment_sha256 and the same serving fingerprint, and the names are disclosed in the private result. Toy values only.
+
+ASSIGN = "a" * 64  # the one stack assignment the toy deployments share (a toy value)
+FINGERPRINT = "toy-fingerprint"
+STACK_NAMES = {"part0": "stack-0", "part1": "stack-1", "part2": "stack-2", "source": "stack-src"}
+STACK_MESSAGE = r"^one stack per \(model, graph\) over the partition union \(entries 144, 184\): "
+
+
+def _stack_union(tmp_path, names=None):
+    """The scored world with the identities of the source and the three partitions carrying ``names`` (default: four different
+    stack names), one stack_assignment_sha256 and one serving fingerprint. Returns the world, ``go(view, completed, units,
+    population)`` (as in _grid_union, on the plain layout) and ``edit(who, fn)``, which rewrites one identity with ``fn`` and
+    returns the function that puts it back."""
+    import numpy as np
+
+    w = _scored_union_world(tmp_path)
+    outs = {"source": w.source, "part0": w.parts[0], "part1": w.parts[1], "part2": w.parts[2]}
+
+    def edit(who, fn):
+        path = outs[who] / "deployment-identity.json"
+        before = path.read_text(encoding="utf-8")
+        ident = json.loads(before)
+        fn(ident)
+        put(path, ident)
+
+        def restore():
+            path.write_text(before, encoding="utf-8")
+            path.chmod(0o600)
+        return restore
+
+    for who, name in (STACK_NAMES if names is None else names).items():
+        def own(ident, name=name):
+            ident["stacks_by_route_model"] = {"oracle-model": name}
+            ident["stack_assignment_sha256"] = ASSIGN
+            ident.setdefault("sitea", {})["evidence"] = {"fingerprint": {"live": FINGERPRINT, "identity_record": FINGERPRINT}}
+        edit(who, own)
+
+    F = ex.load_frozen(HERE.parents[2])
+    cm = F.prereg.ClusterMap.singletons(w.ids)
+    map_record = {"graph": ex.SIB, "store": "rhea-test", "questions_sha256": w.qsha}
+
+    def go(view="primary", completed=((0, 0), (0, 1), (1, 0)), units=3, population=None):
+        exclude, exclude_sha, fact, fact_sha = w.fold(list(completed))
+        call = ex.Call(tuple(w.parts), (w.questions,), ex.SIB, "test", (w.voided,),
+            partition_record=w.record, partition_record_sha256=w.record_sha,
+            n_reps=2, ledgers=tuple(w.ledgers[p] for p in w.parts), source_ledger=w.ledgers[w.source],
+            fold=exclude, fold_sha256=exclude_sha, fold_fact=fact, fold_fact_sha256=fact_sha, fold_view=view,
+            source_batch=w.source, source_order=w.order, source_order_sha256=ex.sha256_file(w.order),
+            source_manifest=w.source / "manifest.json", sib_analysis_questions=w.analysis, sib_analysis_pin=w.pin,
+            population_out=population)
+        return ex.run_with_population(F, call, K_clusters=np.ones((2, units)), cluster_map=cm, map_record=map_record,
+                                      cfg=SimpleNamespace())
+
+    return w, go, edit
+
