+def test_the_sib_stratum_reaches_every_checker_arm_from_the_analysis_set_alone(world, monkeypatch):
+    out, qa, pin, ledger, rows = _store_call(world, monkeypatch, ex.SIB)
+    ref = _empty_retry_ledger(world, rows)
