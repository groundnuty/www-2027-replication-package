+# --- SIB with --ledger: the checker look's call (the replay rows of the offline replay beside the analysis set) --------
+# Toy only. The frozen exporter writes the replay rows from a matrix made by the real matrix code over the fixture's
+# records (its compilers are the repository's s01 fixture sources under the eight arm names), so no row is forged.
+
+SIB_STORES = {ex.SIB: "uniprot-sp-2026_03", ex.SIB_RHEA: "rhea-142"}  # the store each SIB graph's records name
+CHECKER_ARMS = ("curated", "census-t5", "census-t2", "census-t20", "generated-1", "generated-2", "generated-3")
+# the arms the analysis names: the checker loop's "census-t5" is the config's "census" (pipeline.LEDGER_SOURCES), every
+# other name stays
+ANALYSIS_ARMS = ("curated", "census", "census-t2", "census-t20", "generated-1", "generated-2", "generated-3", "union")
+COHORTS = ("alpha", "beta", "none")  # the fixture's three cells that are attempts
+
+
+def _checker_arms():
+    """The matrix's arms over the s01 fixture's two sources; the fixture store stands for the SIB store."""
+    if str(ROOT / "tests") not in sys.path:
+        sys.path.append(str(ROOT / "tests"))
+    from checkloop_support import Env
+
+    from harness.checkloop.matrix import Arms
+    from harness.checks.compiler import CheckCompiler
+    env = Env("F1", sources=("source.json", "source-census-q3.json"))
+    compilers = {a: CheckCompiler(env.sources[0 if a == "curated" else 1], env.hierarchy) for a in CHECKER_ARMS}
+    return Arms(compilers, {"union": ("curated", "census-t5")}), env
+
+
+def _sib_store_world(world, graph, drop=(EXCLUDED,), name=None) -> Path:
+    """``_sib_world`` with every record naming the SIB graph's real store, as the SIB records do."""
+    out = _sib_world(world, drop=drop, name=name or f"out-{graph}")
+    for f in (out / "records").glob("*.json"):
+        r = json.loads(f.read_text(encoding="utf-8"))
+        r["store"]["name"] = SIB_STORES[graph]
+        f.write_text(json.dumps(r, indent=1) + "\n", encoding="utf-8")
+    _recheck(out)
+    return out
+
+
+def _replay_ledger(world, out: Path, name="replay-ledger.jsonl") -> tuple[Path, list[dict]]:
+    """The checker-ledger/2 of the OUT's replay matrix, through the frozen exporter's export() and write_ledger():
+    (the file, its rows)."""
+    from harness.checkloop.ledger import write_ledger
+    from harness.checkloop.matrix import MATRIX_VERSION, load_attempts, run_matrix, write_jsonl_gz
+    arms, env = _checker_arms()
+    attempts, cohorts = load_attempts([out])
+    rows, _ = run_matrix(attempts, arms, live_client=env.client, cohorts=cohorts)
+    matrix = world["tmp"] / f"{name}.matrix.jsonl.gz"
+    write_jsonl_gz(matrix, [{"version": MATRIX_VERSION, **r} for r in rows])
+    exported, _ = exporter.export(matrix, [out], split="dev")
+    # a SIB OUT is a plain run (cohort none) with no checker cell: only its replay rows exist; the fixture's grid cells
+    # and branch records are not SIB's
+    ledger_rows = [r for r in exported if r["use"] == "replay" and r["cohort"] == "none"]
+    return write_ledger(world["tmp"] / name, ledger_rows, split="dev"), ledger_rows
+
+
+def _empty_retry_ledger(world, rows: list[dict], name="empty-retry.jsonl") -> Path:
+    """Retry on empty's real-output rows beside the replay rows (no ledger writer exports them yet): one per curated
+    row, flagged exactly where the checked query returned no rows, unknown where that is not recorded."""
+    from harness.checkloop.ledger import write_ledger
+    ref = []
+    for r in rows:
+        if r["source"] != "curated":
+            continue
+        n = r["result_rows"]
+        letter = "U" if n is None else "F" if n == 0 else "P"
+        ref.append({**r, "source": "empty-retry", "status": letter, "substantive": letter != "U", "any_unknown": n is None,
+                    "flagged_check_types": [], "branch_local_only": False, "data_fault": False,
+                    "number_traceability": None, "evidence_triples": None})
+    return write_ledger(world["tmp"] / name, ref, split="dev")
+
+
+def _sib_ledger_call(w, out, qa, pin, ledgers, graph=ex.SIB, **kw):
+    return dataclasses.replace(_sib_call(w, out, qa, graph=graph, pin=pin, **kw), ledgers=tuple(ledgers))
+
+
+def _real_graph(monkeypatch, graph):
+    """The graph as registered, except its question set is the fixture's (so the call goes through cluster_map_for and
+    the registered store name)."""
+    monkeypatch.setitem(ex.GRAPHS[graph], "questions_sha256", hashlib.sha256((FIXTURE / "questions.jsonl").read_bytes())
+                        .hexdigest())
+
+
+def _rewrite_ledger(world, rows: list[dict], name: str) -> Path:
+    from harness.checkloop.ledger import write_ledger
+    return write_ledger(world["tmp"] / name, rows, split="dev")
+
+
+def _pin_for(world, qa: Path, form: str) -> Path:
+    return _pin_of(qa) if form == "salt inline" else _rhea_pin(world, qa)
+
+
+def _store_call(world, monkeypatch, graph, form="salt inline", drop=(EXCLUDED,), name=None):
+    """(OUT, the analysis set, its pin, replay ledger file, its rows) of a SIB toy on ``graph``'s registered store."""
+    _real_graph(monkeypatch, graph)
+    out = _sib_store_world(world, graph, drop=drop, name=name)
+    qa = _qa(world, monkeypatch)
+    ledger, rows = _replay_ledger(world, out)
+    return out, qa, _pin_for(world, qa, form), ledger, rows
+
+
+# By hand, on the toy: the analysis set holds s01-pass, s01-abstain and s01-noquery; the fixture's natural cell ("none")
+# has the two models and one attempt per question, so a source's row pools 6 attempts; s01-abstain abstained (no output)
+# and the other two submitted, so 4 outputs; both are right (the toy's golds), the pass is no flag, and s01-noquery ran
+# no query, which the checker cannot check (unknown, no_query): 2 unknown, no catch, no false flag, no retry.
+TOY_ROW_COUNTS = {"N_att": 6, "N_out": 4, "catches": 0, "false_flags": 0, "fixes": 0, "corruptions": 0, "unknown": 2,
+                  "retried": 0}
+
+
+@pytest.mark.parametrize("form", ["salt inline", "salt file"])
+@pytest.mark.parametrize("graph", ex.SIB_GRAPHS)
+def test_a_sib_call_with_the_replay_ledgers_reports_every_source_on_the_records_store(world, monkeypatch, graph, form):
+    out, qa, pin, ledger, rows = _store_call(world, monkeypatch, graph, form)
+    store = SIB_STORES[graph]
+    assert graph != store and {r["graph"] for r in rows} == {store}  # the ledger names the store, the call the graph
+    assert {r["source"] for r in rows} == set(CHECKER_ARMS) | {"union"}
+    ref = _empty_retry_ledger(world, rows)
+    result = ex.run(F, _sib_ledger_call(world, out, qa, pin, [ledger, ref], graph=graph))
+    table = result["real_output_ledger"]
+    assert table["reference_present"] is True
+    pooled = {(r["graph"], r["cohort"], r["use"], r["source"]): r for r in table["rows"]}
+    # the analysis names the checker loop's census-t5 arm "census" (pipeline.LEDGER_SOURCES); every other name stays
+    assert set(pooled) == {(store, "none", "replay", s) for s in (*ANALYSIS_ARMS, "empty-retry")}
+    assert [s for (_, _, _, s), r in pooled.items() if r["reference"]] == ["empty-retry"]
+    for key, row in pooled.items():
+        assert {k: row["counts"][k] for k in TOY_ROW_COUNTS} == TOY_ROW_COUNTS, key
+    assert {(r["model"], r["source"]) for r in table["by_model"]} == {
+        (m, s) for m in MODELS for s in (*ANALYSIS_ARMS, "empty-retry")}
+    assert result["exploratory"]["sib_analysis_set"]["public_salted_sha256"] == hashlib.sha256(SALT + qa.read_bytes()).hexdigest()
+    assert all(k.startswith(f"{store}|") for k in result["arms"])  # arm labels carry the store, never the call's graph
+    # without the empty-retry ledger the reference row is absent, and the result says so
+    alone = ex.run(F, _sib_ledger_call(world, out, qa, pin, [ledger], graph=graph))["real_output_ledger"]
+    assert alone["reference_present"] is False and "no ledger rows of the reference source" in alone["reference_note"]
+    assert {r["source"] for r in alone["rows"]} == set(ANALYSIS_ARMS) and not any(r["reference"] for r in alone["rows"])
+
