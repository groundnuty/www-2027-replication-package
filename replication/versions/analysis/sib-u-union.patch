+    bad = _sib_unit_check(world["tmp"] / "sib-sc-bad.json", endpoint, f"copy-{p}", **over)
+    files = [bad if f == files[2 * p] else f for f in files]
+    entries[p] = {**entries[p], "storecheck_sha256": _sha(bad)}
+    bound = {**bound, str(world["parts"][p]): _sha(bad)}  # bound to the file cited: the content is what refuses
